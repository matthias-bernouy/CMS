{
    "$schema": "./node_modules/knip/schema.json",
    "include": [
        "files",
        "dependencies",
        "devDependencies",
        "optionalPeerDependencies",
        "exports",
        "types"
    ],
    "entry": [
        "build.ts",
        "packages/runtimes/ulvia-cli/src/runtime/stack/orchestration/definitions/mongo/*.js"
    ],
    "project": [
        "*.ts",
        "infra/**/*.js",
        "quality/**/*.ts",
        "infra/**/*.ts"
    ],
    "ignoreDependencies": [
        "@bernouy/binary-media",
        "@bernouy/auth",
        "@bernouy/files",
        "@bernouy/cms-edge",
        "@bernouy/envelope-crypto",
        "@bernouy/image-processing",
        "@bernouy/rate-limiter",
        "@bernouy/secret-store",
        "@bernouy/ulvia-cli",
        "image-size",
        "sharp"
    ],
    "workspaces": {
        "packages/features/content": {
            "entry": [
                "src/browser/entries/*.ts",
                "src/runtime-assets/build.ts"
            ]
        },
        "packages/surfaces/cms-edge": {
            "entry": [
                "src/index.ts",
                "tests/contracts/publicReader.fixture.ts"
            ]
        },
        "packages/runtimes/ulvia-provider-server": {
            "entry": [
                "src/index.ts",
                "src/checkRetention.ts",
                "src/maintenance/index.ts",
                "tests/hosting/tls/run.ts"
            ]
        },
        "packages/platform/sdk": {
            "entry": [
                "tests/types/definitions.fixture.ts"
            ]
        },
        ".": {
            "entry": [
                "infra/**/ulvia.release.ts",
                "infra/workspace.ts",
                "infra/bootstrap.ts",
                "infra/cli/build.ts",
                "infra/images/build.ts",
                "infra/distribution/publish.ts",
                "infra/models/prepare.ts",
                "quality/**/check.ts",
                "quality/ci/check-all/index.ts",
                "tests/performance/benchmarks/run.ts",
                "tests/performance/benchmarks/collections/repository/run.ts",
                "tests/performance/assessment/probe.ts",
                "tests/performance/assessment/run.ts",
                "tests/performance/compatibility/run.ts",
                "tests/performance/assessment/initialization.ts",
                "tests/performance/assessment/administration.ts",
                "tests/performance/assessment/stability.ts",
                "tests/performance/fixtures/administration/restore-program.ts",
                "tests/performance/harness/instrumentation/preload.ts",
                "tests/performance/harness/docker/cleanup/namespace-program.ts",
                "tests/performance/delivery/run.ts",
                "tests/performance/public-cache/run.ts",
                "tests/integration/instance/documentation/evaluation/host.ts",
                "tests/integration/instance/documentation/evaluation/client.ts",
                "tests/performance/command/run.ts",
                "tests/performance/command/check.ts",
                "tests/integration/content/worker.ts"
            ]
        },
        "packages/foundation/browser-capture": {
            "entry": [
                "src/playwright/worker.ts"
            ]
        }
    },
    "ignoreFiles": [
        "**/dist/**",
        "**/runtime/stack/orchestration/definitions/mongo/*.js",
        "maquette/**"
    ],
    "ignoreIssues": {
        "**/tests/**": [
            "exports",
            "types"
        ],
        "infra/**": [
            "exports",
            "types"
        ],
        "quality/**": [
            "exports",
            "types"
        ]
    },
    "bun": {
        "entry": [
            "**/*.{test,spec}.{js,jsx,ts,tsx}",
            "**/*_{test,spec}.{js,jsx,ts,tsx}"
        ]
    }
}
