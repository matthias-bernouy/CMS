{
    "$schema": "./node_modules/knip/schema.json",
    "include": [
        "files",
        "dependencies",
        "devDependencies",
        "optionalPeerDependencies",
        "exports",
        "types"
    ],
    "entry": [
        "build.ts",
        "packages/runtimes/ulvia-cli/src/runtime/stack/orchestration/definitions/mongo/*.js"
    ],
    "project": [
        "*.ts",
        "infra/**/*.js",
        "quality/**/*.ts"
    ],
    "ignoreDependencies": [
        "@bernouy/binary-media",
        "@bernouy/auth",
        "@bernouy/files",
        "@bernouy/cms-edge",
        "@bernouy/envelope-crypto",
        "@bernouy/image-processing",
        "@bernouy/rate-limiter",
        "@bernouy/secret-store",
        "@bernouy/ulvia-cli",
        "image-size",
        "sharp"
    ],
    "workspaces": {
        "packages/features/content": {
            "entry": [
                "src/browser/entries/*.ts",
                "src/runtime-assets/build.ts"
            ]
        },
        "packages/surfaces/cms-edge": {
            "entry": [
                "src/index.ts",
                "tests/contracts/publicReader.fixture.ts"
            ]
        },
        "packages/runtimes/ulvia-provider-server": {
            "entry": [
                "src/index.ts",
                "src/checkRetention.ts"
            ]
        },
        "packages/platform/sdk": {
            "entry": [
                "tests/types/definitions.fixture.ts"
            ]
        },
        ".": {
            "entry": [
                "infra/**/ulvia.release.ts"
            ]
        }
    },
    "ignoreFiles": [
        "**/dist/**",
        "**/runtime/stack/orchestration/definitions/mongo/*.js",
        "maquette/**",
        "packages/official-repository/**",
        "resources/base/**"
    ],
    "ignoreIssues": {
        "**/tests/**": [
            "exports",
            "types"
        ],
        "infra/**": [
            "exports",
            "types"
        ],
        "quality/**": [
            "exports",
            "types"
        ],
        "packages/official-repository/**": [
            "files",
            "exports",
            "types"
        ]
    }
}
