# Copy to .env and keep the resulting file private.
CMS_REPOSITORY_IMAGE=
CMS_REPOSITORY_NETWORK_NAME=cms_repository

# Host paths for four independently generated credentials. Create each file as
# mode 0600 for container UID/GID 1000. Their values must never be stored here
# or in Compose source; no pair may contain the same credential.
CMS_REPOSITORY_MANAGEMENT_TOKEN_SECRET_FILE=./secrets/repository-management-token
CMS_REPOSITORY_MAINTENANCE_TOKEN_SECRET_FILE=./secrets/repository-maintenance-token
CMS_REPOSITORY_WORKER_TOKEN_SECRET_FILE=./secrets/repository-worker-token
CMS_REPOSITORY_WORKER_CAPABILITY_KEY_SECRET_FILE=./secrets/repository-worker-capability-key

CMS_REPOSITORY_MANAGEMENT_RATE_LIMIT=30
CMS_REPOSITORY_MANAGEMENT_RATE_LIMIT_WINDOW_SECONDS=60
CMS_REPOSITORY_WORKER_RATE_LIMIT=120
CMS_REPOSITORY_WORKER_RATE_LIMIT_WINDOW_SECONDS=60

# Candidates expire after 24 hours. A claimed verification job receives a
# five-minute renewable lease. Values are milliseconds.
CMS_REPOSITORY_CANDIDATE_TTL_MS=86400000
CMS_REPOSITORY_WORKER_LEASE_DURATION_MS=300000

# Internal CMS clients do not send X-Forwarded-For. Delivery applies the public
# per-client limit before forwarding; keep the standalone listener disabled.
# If an operator later places a real forwarding proxy directly in front of this
# listener, use trusted-proxy and count that proxy plus every preceding CDN.
CMS_HTTP_CLIENT_ADDRESS_MODE=disabled
CMS_HTTP_TRUSTED_PROXY_HOPS=0
CMS_INTEGRATION_PACKAGE_DOWNLOAD_LIMIT=60
CMS_INTEGRATION_PACKAGE_DOWNLOAD_WINDOW_SECONDS=60
