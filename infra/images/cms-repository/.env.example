# Copy to .env and keep the resulting file private.
CMS_REPOSITORY_IMAGE=
CMS_REPOSITORY_NETWORK_NAME=cms_repository
CMS_INTEGRATION_VERIFIER_IMAGE=
CMS_INTEGRATION_VERIFIER_RUNNER_IMAGE_DIGEST=
CMS_INTEGRATION_VERIFIER_CONTROL_NETWORK_NAME=cms_verifier_control
CMS_INTEGRATION_VERIFIER_DATABASE_NETWORK_NAME=cms_verifier_database

# File-backed Compose secrets keep their host ownership; uid/gid/mode mount
# attributes are ignored. Create each file as mode 0600 with the numeric owner
# stated below. Values stay out of this file and Compose source. Management,
# maintenance, worker, capability, signing, and database credentials are
# logically distinct; only the explicitly named cross-UID copies are equal.
#
# UID/GID 1000: repository and management CMS.
CMS_REPOSITORY_MANAGEMENT_TOKEN_SECRET_FILE=./secrets/repository-management-token
CMS_REPOSITORY_MAINTENANCE_TOKEN_SECRET_FILE=./secrets/repository-maintenance-token
CMS_REPOSITORY_WORKER_TOKEN_SECRET_FILE=./secrets/repository-worker-token
CMS_REPOSITORY_WORKER_CAPABILITY_KEY_SECRET_FILE=./secrets/repository-worker-capability-key
# UID/GID 1001: verifier supervisor. The worker-token copy must contain the
# exact same bytes as the repository-owned copy above. The isolated preflight
# compares both copies and blocks every long-running service on mismatch.
CMS_INTEGRATION_VERIFIER_WORKER_TOKEN_SECRET_FILE=./secrets/verifier-worker-token
CMS_INTEGRATION_VERIFIER_SANDBOX_SIGNING_KEY_SECRET_FILE=./secrets/verifier-sandbox-ed25519-private.pem
# The public verification key is not secret and must be readable by UID/GID 1002.
CMS_INTEGRATION_VERIFIER_SANDBOX_VERIFICATION_KEY_FILE=./secrets/verifier-sandbox-ed25519-public.pem
# UID/GID 1001 client copy and UID/GID 70 server copy. Both password files must
# contain the exact same bytes; the same preflight compares them before startup.
CMS_INTEGRATION_VERIFIER_POSTGRES_PASSWORD_SECRET_FILE=./secrets/verifier-postgres-password
CMS_INTEGRATION_VERIFIER_POSTGRES_SERVER_PASSWORD_SECRET_FILE=./secrets/verifier-postgres-server-password

CMS_REPOSITORY_MANAGEMENT_RATE_LIMIT=30
CMS_REPOSITORY_MANAGEMENT_RATE_LIMIT_WINDOW_SECONDS=60
CMS_REPOSITORY_WORKER_RATE_LIMIT=120
CMS_REPOSITORY_WORKER_RATE_LIMIT_WINDOW_SECONDS=60

# Candidates expire after 24 hours. A claimed verification job receives a
# five-minute renewable lease. Values are milliseconds.
CMS_REPOSITORY_CANDIDATE_TTL_MS=86400000
CMS_REPOSITORY_WORKER_LEASE_DURATION_MS=300000
# Private candidate objects survive interrupted writes for one day. Terminal
# records remain for seven days, their prune audit for thirty days, and the
# non-overlapping collector runs every six hours. Values are milliseconds.
CMS_REPOSITORY_CANDIDATE_GC_INTERVAL_MS=21600000
CMS_REPOSITORY_CANDIDATE_OBJECT_GRACE_MS=86400000
CMS_REPOSITORY_CANDIDATE_TERMINAL_RETENTION_MS=604800000
CMS_REPOSITORY_CANDIDATE_PRUNE_AUDIT_RETENTION_MS=2592000000

CMS_INTEGRATION_VERIFIER_WORKER_ID=verifier-1
CMS_INTEGRATION_VERIFIER_SANDBOX_CAPABILITY_LIFETIME_MS=15000
CMS_INTEGRATION_VERIFIER_SANDBOX_TIMEOUT_MS=600000
CMS_INTEGRATION_VERIFIER_SANDBOX_TERMINATION_GRACE_MS=2000
CMS_INTEGRATION_VERIFIER_SANDBOX_MAX_INPUT_BYTES=41943040
CMS_INTEGRATION_VERIFIER_SANDBOX_MAX_OUTPUT_BYTES=1048576
CMS_INTEGRATION_VERIFIER_SANDBOX_MAX_ERROR_BYTES=65536
CMS_INTEGRATION_VERIFIER_POSTGRES_STATEMENT_TIMEOUT_MS=120000
CMS_INTEGRATION_VERIFIER_POLL_INTERVAL_MS=5000
CMS_INTEGRATION_VERIFIER_ERROR_BACKOFF_MS=10000

# Internal CMS clients do not send X-Forwarded-For. Delivery applies the public
# per-client limit before forwarding; keep the standalone listener disabled.
# If an operator later places a real forwarding proxy directly in front of this
# listener, use trusted-proxy and count that proxy plus every preceding CDN.
CMS_HTTP_CLIENT_ADDRESS_MODE=disabled
CMS_HTTP_TRUSTED_PROXY_HOPS=0
CMS_INTEGRATION_PACKAGE_DOWNLOAD_LIMIT=60
CMS_INTEGRATION_PACKAGE_DOWNLOAD_WINDOW_SECONDS=60
