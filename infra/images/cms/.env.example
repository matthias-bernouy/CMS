# Copy this file to `.env` in a dedicated directory for one CMS instance.
# Never commit the resulting `.env` file.

DOMAIN=client.example.com
CMS_IMAGE=

# All instances use the shared application account from `infra/.env`, but each
# URL must select a different database (`cms_<instance>`). The generated
# application password is hexadecimal and therefore URL-safe.
MONGO_URL=mongodb://cms_runtime:REPLACE_WITH_SHARED_MONGO_APP_PASSWORD@mongo:27017/cms_client?authSource=admin

CMS_SESSION_SECRET=
CMS_KEK_HEX=
CMS_ADMIN_EMAIL=admin@client.example.com
CMS_ADMIN_PASSWORD=

# Keep this stable across restarts if analytics are enabled.
ANALYTICS_SALT_SECRET=

# Optional public authentication configuration.
CMS_AUTH_SITE_NAME=CMS
CMS_AUTH_EMAIL_COOLDOWN_SECONDS=300
# CMS_AUTH_EMAIL_VERIFICATION_URL=https://client.example.com/auth/confirm-email
# CMS_AUTH_PASSWORD_RESET_URL=https://client.example.com/auth/reset-password
# CMS_CONTROL_AUTH_EMAIL_VERIFICATION_URL=https://admin.client.example.com/auth/verify-email
# CMS_CONTROL_AUTH_PASSWORD_RESET_URL=https://admin.client.example.com/auth/reset-password

# Optional remote integration catalog.
# P9R_INTEGRATION_REPOSITORY_URL=https://example.com/integrations

# Optional secrets forwarded when deploying Supabase connector functions.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_REPLY_TO=
