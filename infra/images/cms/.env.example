# Copy this file to `.env` in a dedicated directory for one CMS instance.
# Never commit the resulting `.env` file.

DOMAIN=client.example.com
CMS_IMAGE=

# Provider control-plane account. It can create/open isolated instance databases
# and is never passed to the Kernel.
ULVIA_PROVIDER_MONGO_URL=mongodb://provider_control:REPLACE_WITH_PROVIDER_PASSWORD@mongo:27017/ulvia_provider_control?authSource=admin

# Provision this instance's own account after the operator API allocates its
# storage key, then fill these phase-two values before starting the Kernel.
# Its user has read/write access to this database only.
MONGO_URL=

CMS_SESSION_SECRET=
CMS_KEK_HEX=
ULVIA_PROVIDER_OPERATOR_TOKEN=
ULVIA_INSTANCE_TOKEN=
ULVIA_INSTANCE_STORAGE_KEY=
ULVIA_REPOSITORY_TOKEN=

# Optional public authentication configuration.
CMS_AUTH_SITE_NAME=CMS
CMS_AUTH_EMAIL_COOLDOWN_SECONDS=300
CMS_COLLECTION_MIGRATION_ROLLBACK_RETENTION=100
# CMS_AUTH_EMAIL_VERIFICATION_URL=https://client.example.com/auth/confirm-email
# CMS_AUTH_PASSWORD_RESET_URL=https://client.example.com/auth/reset-password

# Optional SMTP configuration.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_REPLY_TO=
