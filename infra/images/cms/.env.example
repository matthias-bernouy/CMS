# Copy this file to `.env` in a dedicated directory for one CMS instance.
# Never commit the resulting `.env` file.

DOMAIN=client.example.com
CMS_IMAGE=

# All instances use the shared application account from `infra/.env`, but each
# URL must select a different database (`cms_<instance>`). The generated
# application password is hexadecimal and therefore URL-safe.
MONGO_URL=mongodb://cms_runtime:REPLACE_WITH_SHARED_MONGO_APP_PASSWORD@mongo:27017/cms_client?authSource=admin

CMS_SESSION_SECRET=
CMS_KEK_HEX=
CMS_ADMIN_EMAIL=admin@client.example.com
CMS_ADMIN_PASSWORD=

# Required. Keep this stable across restarts and shared across replicas.
ANALYTICS_SALT_SECRET=
# Set true only behind a proxy that overwrites client-supplied forwarding headers.
ANALYTICS_TRUST_PROXY=false

# Public integration-package download protection. The standard deployment has
# one trusted ingress hop (nginx-proxy). Set the hop count to 2 when a CDN that
# appends or overwrites X-Forwarded-For is placed in front of nginx-proxy.
# This trust policy is independent of ANALYTICS_TRUST_PROXY.
CMS_HTTP_CLIENT_ADDRESS_MODE=trusted-proxy
CMS_HTTP_TRUSTED_PROXY_HOPS=1
CMS_INTEGRATION_PACKAGE_DOWNLOAD_LIMIT=60
CMS_INTEGRATION_PACKAGE_DOWNLOAD_WINDOW_SECONDS=60

# Dedicated durable package cache. Keep this outside CMS_FILES_DIR; Compose
# mounts ./integration-packages at the same path.
CMS_INTEGRATION_PACKAGE_CACHE_DIR=/var/lib/cms/integration-packages

# Endpoint performance aggregates are enabled by default. Set this false as an
# emergency kill switch without deleting existing TTL-managed rollups.
ENDPOINT_PERFORMANCE_ENABLED=true
# Uniform detailed diagnostic sample rate from 0 to 1. Aggregate metrics still
# cover every accepted source request.
SOURCE_TIMING_SAMPLE_RATE=0.01
# Errors and requests at or above this duration are diagnosed in a separate
# forced cohort.
SOURCE_SLOW_REQUEST_THRESHOLD_MS=1000

# Source image optimization is dark by default. Enable transforms first, then
# public responsive markup, then private responsive markup after observing
# authenticated reauthorization under representative traffic.
CMS_SOURCE_IMAGE_TRANSFORMS_ENABLED=false
CMS_RESPONSIVE_PUBLIC_SOURCE_IMAGES_ENABLED=false
CMS_RESPONSIVE_PRIVATE_SOURCE_IMAGES_ENABLED=false

# Optional public authentication configuration.
CMS_AUTH_SITE_NAME=CMS
CMS_AUTH_EMAIL_COOLDOWN_SECONDS=300
# CMS_AUTH_EMAIL_VERIFICATION_URL=https://client.example.com/auth/confirm-email
# CMS_AUTH_PASSWORD_RESET_URL=https://client.example.com/auth/reset-password
# CMS_CONTROL_AUTH_EMAIL_VERIFICATION_URL=https://admin.client.example.com/auth/verify-email
# CMS_CONTROL_AUTH_PASSWORD_RESET_URL=https://admin.client.example.com/auth/reset-password

# Optional public, anonymous global integration catalog. When set, Delivery
# re-serves only this remote catalog from its same-origin repository routes.
# No read token is used.
# P9R_INTEGRATION_REPOSITORY_URL=https://example.com/integrations

# Designated repository-management CMS only. Keep these commented for ordinary
# CMS instances. The management override supplies the private URLs and secret
# mount; configure the stable opaque `sub` of the one allowed administrator.
# P9R_INTEGRATION_REPOSITORY_ADMIN_SUBJECT_IDENTIFIER=
# P9R_INTEGRATION_REPOSITORY_MANAGEMENT_TIMEOUT_MS=60000
# CMS_REPOSITORY_MANAGEMENT_TOKEN_SECRET_FILE=/opt/cms-repository/secrets/repository-management-token
# CMS_REPOSITORY_NETWORK_NAME=cms_repository

# Optional secrets forwarded when deploying Supabase connector functions.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_REPLY_TO=
