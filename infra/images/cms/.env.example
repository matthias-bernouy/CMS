# Copy this file to `.env` in a dedicated directory for one CMS instance.
# Never commit the resulting `.env` file.

DOMAIN=client.example.com
CMS_IMAGE=

# Provision this instance's own account with `provision-site-user.js`. Its user
# lives in and has read/write access to this database only.
MONGO_URL=mongodb://cms_client:REPLACE_WITH_SITE_MONGO_PASSWORD@mongo:27017/cms_client?authSource=cms_client

CMS_SESSION_SECRET=
CMS_KEK_HEX=
CMS_ADMIN_EMAIL=admin@client.example.com
CMS_ADMIN_PASSWORD=
CMS_CORE_PROVIDER_TOKEN=
ULVIA_REPOSITORY_TOKEN=
# Optional stable site scope. The bundled CMS Core provider defaults to "default".
CMS_GATEWAY_SITE_ID=default

# Optional public authentication configuration.
CMS_AUTH_SITE_NAME=CMS
CMS_AUTH_EMAIL_COOLDOWN_SECONDS=300
CMS_COLLECTION_MIGRATION_ROLLBACK_RETENTION=100
# CMS_AUTH_EMAIL_VERIFICATION_URL=https://client.example.com/auth/confirm-email
# CMS_AUTH_PASSWORD_RESET_URL=https://client.example.com/auth/reset-password
# CMS_CONTROL_AUTH_EMAIL_VERIFICATION_URL=https://admin.client.example.com/auth/verify-email
# CMS_CONTROL_AUTH_PASSWORD_RESET_URL=https://admin.client.example.com/auth/reset-password

# Optional SMTP configuration.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_REPLY_TO=
