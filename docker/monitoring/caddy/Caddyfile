# Caddy reverse proxy in front of Grafana. Auto-issues a Let's Encrypt
# cert for ${GRAFANA_DOMAIN} via HTTP-01 (port 80 must be reachable on
# the monitoring VPS, only Caddy listens on it). ACME account email is
# the ${LEGO_EMAIL} from the compose env.
#
# Grafana itself handles auth (Keycloak generic OAuth), so Caddy just
# proxies and propagates the right forwarded headers. WebSocket upgrade
# is required for Grafana's live tail feature.
#
# Prometheus + Alertmanager are deliberately NOT exposed through Caddy
# — they have no auth of their own and have been kept on the docker
# internal network. Operator access is via SSH tunnel
# (`ssh -L 9090:localhost:9090 ubuntu@<monitoring-host>`) when needed.

{
    email {$LEGO_EMAIL}
}

{$GRAFANA_DOMAIN} {
    encode gzip

    # `reverse_proxy` in Caddy v2 already forwards X-Forwarded-* + handles
    # WebSocket upgrades natively. No need to repeat them — keeps the
    # Caddyfile minimal.
    reverse_proxy grafana:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }
}
