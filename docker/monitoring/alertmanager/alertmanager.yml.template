# Alertmanager config. Single route → Discord/Slack webhook for now.
# The webhook URL itself comes from env (ALERT_WEBHOOK_URL) so the
# file itself is committable.
#
# Discord and Slack webhooks both accept the `webhook_configs` payload
# with `send_resolved: true`. The default JSON Alertmanager emits is
# Slack-flavoured by default — if Discord rejects, swap to its
# Alertmanager-compatible endpoint at `<your-webhook>/slack`.

global:
  resolve_timeout: 5m

route:
  receiver:        webhook
  group_by:        [alertname, instance]
  group_wait:      30s            # batch alerts firing within 30s into one notification
  group_interval:  5m             # subsequent updates for the same group at most every 5m
  repeat_interval: 4h             # re-page if still firing after 4h
  routes:
    # Critical alerts bypass the group_wait so they ping immediately.
    - matchers: [severity = "critical"]
      group_wait: 0s
      receiver:   webhook

receivers:
  - name: webhook
    webhook_configs:
      - url:            "${ALERT_WEBHOOK_URL}"
        send_resolved:  true
        max_alerts:     20

inhibit_rules:
  # Skip warning if a critical for the same alertname+instance is already firing.
  - source_matchers: [severity = "critical"]
    target_matchers: [severity = "warning"]
    equal:           [alertname, instance]
