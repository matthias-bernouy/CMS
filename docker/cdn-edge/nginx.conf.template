# cdn-edge — nginx skeleton (rendered at container start).
# Only ${MAIN_DOMAIN} and ${ORIGIN_HOST} are substituted by envsubst;
# every other `$variable` stays literal.
#
# Includes synced fragments (`/var/lib/cdn/nginx-generated/*`) for the
# per-bucket `cacheControl`, per-bucket `notFound`, and alias mappings
# pushed by the origin.

map $host $bucket_id {
    hostnames;
    default "";
    ~^(?<sub>[^.]+)\.${MAIN_DOMAIN}$ $sub;
    include /var/lib/cdn/nginx-generated/aliases.conf;
}

map $bucket_id $cache_control {
    default "";
    include /var/lib/cdn/nginx-generated/cacheControls.conf;
}

map $bucket_id $bucket_notfound {
    default "";
    include /var/lib/cdn/nginx-generated/notFoundPaths.conf;
}

# HTML responses always bypass caches — page content changes whenever an
# admin saves and we want next visitors to see it. Hashed assets keep
# the bucket's default Cache-Control (typically `immutable`).
map $uri $effective_cache_control {
    default     $cache_control;
    "~\.html$"  "no-store";
}

server {
    listen 80 default_server;
    server_name _;

    # ACME HTTP-01 challenges → proxy back to the origin. The origin
    # writes the challenge file to its own /var/lib/cdn/lego/webroot/
    # and lsyncd does NOT push that dir; instead Let's Encrypt fetches
    # `<alias>/.well-known/acme-challenge/<token>`, hits this edge
    # (because the alias DNS points here), and we proxy_pass it back to
    # the origin to serve the challenge content.
    location ^~ /.well-known/acme-challenge/ {
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_pass         http://${ORIGIN_HOST};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name *.${MAIN_DOMAIN};

    ssl_certificate     /var/lib/cdn/lego/certificates/${MAIN_DOMAIN}.crt;
    ssl_certificate_key /var/lib/cdn/lego/certificates/${MAIN_DOMAIN}.key;

    include /etc/nginx/conf.d/cdn/bucketServing.conf;
}

# Per-alias `server { … }` blocks (one per alias domain, generated by
# the origin and synced via lsyncd).
include /var/lib/cdn/nginx-generated/aliasesServers.conf;
