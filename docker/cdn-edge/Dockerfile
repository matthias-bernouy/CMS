# `bernouy/cdn-edge` — public-serving node of a CDN cluster.
#
# Headless on purpose: OpenResty (nginx + LuaJIT) only. NO sshd, NO lego,
# NO app, NO DB. The origin connects to the EDGE HOST's sshd (port 22,
# user `cdn-sync` pre-created by `docker/init-server.sh --role edge`
# with UID/GID 1099), rsyncs blobs/certs/fragments into `/var/lib/cdn`
# (bind-mounted into this container).
#
# OpenResty is required because every BucketProxy fragment generated by
# `@bernouy/cdn-buckets` carries `set_by_lua_block` directives that
# read secrets from a Lua table (`cms_secrets`) populated by an
# `init_by_lua_block` reading `/run/cdn-edge/secrets.json` (tmpfs) at
# config-load time. Vanilla nginx wouldn't parse those directives.
#
# Plaintext secrets path on this box: HTTPS body from /edge-api/secrets
# → tmpfs file (/run/cdn-edge/secrets.json) → Lua heap of nginx process.
# Never on persistent disk, never in the process env.
#
# NOTE: brotli static-precompressed serving is dropped vs the previous
# Debian-nginx image (the `brotli_*` modules aren't bundled by upstream
# OpenResty). Re-add via `lua-resty-brotli` or a custom OpenResty build
# if perf demands it; gzip-static is still on by default.
#
# Build (context = repo root):
#   docker buildx build -f docker/cdn-edge/Dockerfile -t bernouy/cdn-edge:0.3.0 .

FROM openresty/openresty:bookworm-buildpack-deps

# 1. Tooling on top of OpenResty: inotify (cert reload), curl + jq
#    (fetch-secrets pipeline), envsubst (nginx.conf.template render at
#    boot), logrotate, sudo for the unprivileged reload trick.
RUN apt-get update && apt-get install -y --no-install-recommends \
        inotify-tools logrotate \
        ca-certificates curl gettext-base jq sudo procps \
 && rm -rf /var/lib/apt/lists/*

# 2. cdn-sync user/group, UID/GID 1099 — MUST match the host's cdn-sync
#    created by `init-server.sh --role edge`. The www-data user/group
#    is created if missing (the openresty image doesn't ship it).
RUN groupadd  -g 1099 cdn-sync \
 && useradd   -u 1099 -g 1099 -M -s /usr/sbin/nologin cdn-sync \
 && (groupadd www-data 2>/dev/null || true) \
 && (useradd -M -s /usr/sbin/nologin -g www-data www-data 2>/dev/null || true) \
 && usermod   -a -G cdn-sync www-data

# 3. nginx config skeleton + per-alias serving include. OpenResty's
#    config root is /usr/local/openresty/nginx/conf — we mount our
#    files under conf/cdn/ and patch the main nginx.conf to include them.
ENV NGINX_PREFIX=/usr/local/openresty/nginx
COPY docker/cdn-edge/bucketServing.conf  ${NGINX_PREFIX}/conf/cdn/bucketServing.conf
COPY docker/cdn-edge/nginx.conf.template ${NGINX_PREFIX}/conf/cdn/nginx.conf.template
RUN printf 'events { worker_connections 1024; }\nhttp   { include cdn/nginx.conf; }\n' > ${NGINX_PREFIX}/conf/nginx.conf

# 4. logrotate config — hourly rotation of the JSON access log, gzip,
#    keep 168 files (7 days). Runs from the entrypoint's hourly loop.
COPY docker/cdn-edge/logrotate.conf /etc/logrotate.d/cdn-edge-access
RUN chmod 0644 /etc/logrotate.d/cdn-edge-access

# 5. Sudoers — the cert-reload watcher (running as cdn-sync) needs to
#    `nginx -s reload` AND `nginx -t` whenever certs / configs change.
#    `nginx -t` in unprivileged mode fails to open the master pidfile;
#    sudo restricted to these two argv combinations is the safe escape.
RUN echo "cdn-sync ALL=(root) NOPASSWD: /usr/local/openresty/nginx/sbin/nginx -s reload, /usr/local/openresty/nginx/sbin/nginx -t" > /etc/sudoers.d/cdn-sync \
 && chmod 0440 /etc/sudoers.d/cdn-sync

# 6. Shared OKMS bootstrap wrapper.
COPY docker/_shared/okms-fetch.sh /usr/local/bin/okms-fetch
RUN chmod +x /usr/local/bin/okms-fetch

# 7. Entrypoint + watchers + secrets pipeline. NOTE: `render-secrets.sh`
#    is gone — the lsynced fragment is included directly into nginx
#    (no envsubst step needed; secrets are read at runtime by Lua from
#    the tmpfs JSON manifest).
COPY docker/cdn-edge/entrypoint.sh          /usr/local/bin/cdn-edge-entrypoint.sh
COPY docker/cdn-edge/cert-reload-watcher.sh /usr/local/bin/cert-reload-watcher.sh
COPY docker/cdn-edge/fetch-secrets.sh       /usr/local/bin/fetch-secrets.sh
RUN chmod +x /usr/local/bin/cdn-edge-entrypoint.sh \
             /usr/local/bin/cert-reload-watcher.sh \
             /usr/local/bin/fetch-secrets.sh

# 8. Convenience symlink so existing scripts referencing /usr/sbin/nginx
#    still work without churn.
RUN ln -sf /usr/local/openresty/nginx/sbin/nginx /usr/sbin/nginx

VOLUME ["/var/lib/cdn"]
EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS -o /dev/null -w '%{http_code}' http://127.0.0.1/ | grep -E '^(200|301|302|404)$' || exit 1

ENTRYPOINT ["/usr/local/bin/okms-fetch", "/usr/local/bin/cdn-edge-entrypoint.sh"]
