# @bernouy/cdn — nginx skeleton (rendered at container start).
# Only ${MAIN_DOMAIN} is substituted by envsubst; every other `$variable`
# is an nginx variable and stays literal.

# ─── Maps ──────────────────────────────────────────────────────────────────────

map $host $bucket_id {
    hostnames;
    default "";
    ~^(?<sub>[^.]+)\.${MAIN_DOMAIN}$ $sub;
    include /etc/nginx/conf.d/cdn/generated/aliases.conf;
}

map $bucket_id $cache_control {
    default "";
    include /etc/nginx/conf.d/cdn/generated/cacheControls.conf;
}

# ─── Upstream — the user's bun app, on 127.0.0.1 ───────────────────────────────

upstream cdn_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

# ─── HTTP → HTTPS redirect (catch-all) ─────────────────────────────────────────

server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# ─── 1. Admin + upload + frontier B on ${MAIN_DOMAIN} ──────────────────────────

server {
    listen 443 ssl http2;
    server_name ${MAIN_DOMAIN};

    ssl_certificate     /etc/lego/certificates/${MAIN_DOMAIN}.crt;
    ssl_certificate_key /etc/lego/certificates/${MAIN_DOMAIN}.key;

    # Streaming upload — no Nginx-side buffering, the app enforces size.
    location = /upload {
        client_max_body_size    5g;
        proxy_request_buffering off;
        proxy_http_version      1.1;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_pass              http://cdn_app;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_pass         http://cdn_app;
    }
}

# ─── 2. Public bucket sub-domains *.${MAIN_DOMAIN} (try_files off disk) ────────

server {
    listen 443 ssl http2;
    server_name *.${MAIN_DOMAIN};

    ssl_certificate     /etc/lego/certificates/${MAIN_DOMAIN}.crt;
    ssl_certificate_key /etc/lego/certificates/${MAIN_DOMAIN}.key;

    include /etc/nginx/conf.d/cdn/bucketServing.conf;
}

# ─── 3. Custom alias domains — generated server blocks (one per alias) ─────────

include /etc/nginx/conf.d/cdn/generated/aliasesServers.conf;
