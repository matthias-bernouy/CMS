# Per-VPS environment for `exporters.compose.yml`. Place this file at
# `/etc/cms-monitoring/.env` on each production VPS, replacing the IP
# with that node's WireGuard address. The exporters bind ONLY to this
# address — keep public interfaces clear.

# cms:        10.10.0.2
# cdn-origin: 10.10.0.3
# cdn-edge:   10.10.0.4
WG_IP=10.10.0.X
