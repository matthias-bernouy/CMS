# Rendered from envsubst at boot — only ${MAIN_DOMAIN} is interpolated.
# nginx terminates TLS for auth.bernouy.com and proxies everything to
# Keycloak listening on 127.0.0.1:8080 (KC_HTTP_HOST/PORT in entrypoint).

upstream auth_app {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/auth/lego/webroot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${MAIN_DOMAIN};

    ssl_certificate     /var/lib/auth/lego/certificates/${MAIN_DOMAIN}.crt;
    ssl_certificate_key /var/lib/auth/lego/certificates/${MAIN_DOMAIN}.key;

    # Keycloak admin uploads (SAML metadata, themes) can be larger than 1m.
    client_max_body_size 25m;

    # Keycloak holds long-running admin requests (cache rebuilds, exports).
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;

    location / {
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  $server_port;
        proxy_pass         http://auth_app;
    }
}
