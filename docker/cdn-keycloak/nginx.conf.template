# cdn-keycloak — nginx skeleton (rendered at container start).
# Only ${MAIN_DOMAIN} is substituted by envsubst; every other `$variable`
# is an nginx variable and stays literal.

map $host $bucket_id {
    hostnames;
    default "";
    ~^(?<sub>[^.]+)\.${MAIN_DOMAIN}$ $sub;
    include /etc/nginx/conf.d/cdn/generated/aliases.conf;
}

map $bucket_id $cache_control {
    default "";
    include /etc/nginx/conf.d/cdn/generated/cacheControls.conf;
}

upstream cdn_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;

    # HTTP-01 challenges land here. Used by lego when issuing per-alias certs
    # (DNS-01 stays for the wildcard cert, handled by the entrypoint).
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/cdn/lego/webroot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${MAIN_DOMAIN};

    ssl_certificate     /var/lib/cdn/lego/certificates/${MAIN_DOMAIN}.crt;
    ssl_certificate_key /var/lib/cdn/lego/certificates/${MAIN_DOMAIN}.key;

    location = /upload {
        client_max_body_size    5g;
        proxy_request_buffering off;
        proxy_http_version      1.1;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_pass              http://cdn_app;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_pass         http://cdn_app;
    }
}

server {
    listen 443 ssl http2;
    server_name *.${MAIN_DOMAIN};

    ssl_certificate     /var/lib/cdn/lego/certificates/${MAIN_DOMAIN}.crt;
    ssl_certificate_key /var/lib/cdn/lego/certificates/${MAIN_DOMAIN}.key;

    include /etc/nginx/conf.d/cdn/bucketServing.conf;
}

include /etc/nginx/conf.d/cdn/generated/aliasesServers.conf;
