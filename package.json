{
    "name": "@bernouy/cms-workspace",
    "private": true,
    "license": "MIT",
    "packageManager": "bun@1.4.4",
    "engines": {
        "bun": "1.4.4"
    },
    "workspaces": [
        "packages/foundation/*",
        "packages/platform/*",
        "packages/features/*",
        "packages/features/email/*",
        "packages/surfaces/*",
        "packages/runtimes/*"
    ],
    "scripts": {
        "ulvia": "bun run infra/workspace.ts ulvia",
        "format": "biome check --write --unsafe --reporter=concise --max-diagnostics=none .",
        "check": "bun run infra/workspace.ts check",
        "test": "bun run infra/workspace.ts test",
        "verify": "bun run infra/workspace.ts verify",
        "build": "bun run build.ts",
        "publish": "bun run infra/distribution/publish.ts",
        "clean": "bun run quality/ci/clean.ts"
    },
    "devDependencies": {
        "@bernouy/binary-media": "workspace:*",
        "@bernouy/auth": "workspace:*",
        "@bernouy/content": "workspace:*",
        "@bernouy/ulvia-provider": "workspace:*",
        "@bernouy/ulvia-sdk": "workspace:*",
        "@bernouy/cms-edge": "workspace:*",
        "@bernouy/files": "workspace:*",
        "@bernouy/cms-gateway": "workspace:*",
        "@bernouy/repository": "workspace:*",
        "@bernouy/envelope-crypto": "workspace:*",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/logging": "workspace:*",
        "@bernouy/image-processing": "workspace:*",
        "@bernouy/rate-limiter": "workspace:*",
        "@bernouy/secret-store": "workspace:*",
        "@bernouy/ulvia-cli": "workspace:*",
        "@biomejs/biome": "2.6.4",
        "@types/bun": "1.4.4",
        "@typescript/typescript6": "6.0.2",
        "bun-types": "1.4.4",
        "image-size": "^2.0.4",
        "knip": "^6.44.1",
        "mongodb": "^7.8.0",
        "playwright": "^1.64.1",
        "sharp": "^0.35.5",
        "typescript": "^7.0.2",
        "@bernouy/resource-identity": "workspace:*",
        "@bernouy/ulvia-contracts": "workspace:*",
        "@bernouy/ulvia-providers": "workspace:*"
    }
}
