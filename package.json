{
    "name": "@bernouy/cms-core",
    "private": true,
    "workspaces": [
        "packages/foundation/*",
        "packages/features/*",
        "packages/surfaces/*",
        "packages/runtimes/*"
    ],
    "scripts": {
        "build": "bun run build.ts",
        "typecheck": "tsc --build",
        "clean": "tsc --build --clean",
        "test": "bun test"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "bun-types": "^1.3.6",
        "typescript": "^5.9.3",
        "mongodb": "^7.1.0",
        "image-size": "^2.0.2",
        "jose": "^6.2.1",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/rate-limiter": "workspace:*",
        "@bernouy/cms-auth": "workspace:*",
        "@bernouy/cms-bloc-compile": "workspace:*",
        "@bernouy/envelope-crypto": "workspace:*",
        "@bernouy/cms-secrets": "workspace:*",
        "@bernouy/cms-files": "workspace:*",
        "@bernouy/cms-permissions": "workspace:*",
        "@bernouy/cms-content": "workspace:*",
        "@bernouy/cms-delivery": "workspace:*",
        "@bernouy/cms-gateway": "workspace:*",
        "@bernouy/cms-analytics": "workspace:*",
        "@bernouy/cms-blocs": "workspace:*",
        "@bernouy/cms-control": "workspace:*",
        "@bernouy/cms-cli": "workspace:*"
    }
}
