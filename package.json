{
    "name": "@bernouy/cms-workspace",
    "private": true,
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": "1.4.2"
    },
    "workspaces": [
        "packages/foundation/*",
        "packages/features/*",
        "packages/surfaces/*",
        "packages/runtimes/*"
    ],
    "scripts": {
        "ulvia": "bun run packages/runtimes/ulvia-cli/src/index.ts",
        "build": "bun run build.ts",
        "check:all": "bun run quality/ci/check-all.ts",
        "check:architecture": "bun run quality/architecture/check.ts",
        "check:dead-code": "bun run quality/dead-code/check.ts",
        "check:directory-fanout": "bun run quality/ci/repository-shape/directory-fanout/check.ts",
        "check:file-size": "bun run quality/ci/repository-shape/file-size/check.ts",
        "check:repository-shape": "bun run quality/ci/repository-shape/check.ts",
        "check:style": "biome check --reporter=concise --max-diagnostics=none .",
        "format": "biome check --write --unsafe --reporter=concise --max-diagnostics=none .",
        "typecheck": "tsc --build",
        "clean": "tsc --build --clean",
        "test": "bun test",
        "test:control-smoke": "ULVIA_RUN_CONTROL_SMOKE=1 bun test packages/runtimes/ulvia-cli/tests/dev/control-smoke.browser.test.ts",
        "check:ui-contracts": "bun run quality/ui-contracts/check.ts"
    },
    "devDependencies": {
        "@bernouy/binary-media": "workspace:*",
        "@bernouy/blob-store": "workspace:*",
        "@bernouy/cms-auth": "workspace:*",
        "@bernouy/cms-content": "workspace:*",
        "@bernouy/cms-control": "workspace:*",
        "@bernouy/cms-core": "workspace:*",
        "@bernouy/cms-delivery": "workspace:*",
        "@bernouy/cms-files": "workspace:*",
        "@bernouy/cms-gateway": "workspace:*",
        "@bernouy/cms-repository": "workspace:*",
        "@bernouy/envelope-crypto": "workspace:*",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/image-processing": "workspace:*",
        "@bernouy/official-repository-server": "workspace:*",
        "@bernouy/rate-limiter": "workspace:*",
        "@bernouy/secret-store": "workspace:*",
        "@bernouy/ulvia-cli": "workspace:*",
        "@biomejs/biome": "2.5.14",
        "@types/bun": "1.4.2",
        "@typescript/typescript6": "6.0.2",
        "bun-types": "1.4.2",
        "image-size": "^2.0.4",
        "knip": "^6.40.0",
        "mongodb": "^7.6.0",
        "playwright": "^1.63.0",
        "sharp": "^0.35.4",
        "typescript": "^7.0.2"
    }
}
