{
    "format": "ulvia-resource-source/v1",
    "namespace": "ulvia/repository",
    "locale": "en",
    "states": [
        {
            "id": "kind",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 32,
                "enum": ["collection", "contract", "provider-manifest"]
            }
        },
        {
            "id": "query",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 500
            }
        },
        {
            "id": "account-mutation",
            "scope": "page",
            "schema": {
                "type": "object",
                "properties": {
                    "lastSuccess": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "requestId": {
                                "type": "string",
                                "format": "uuid",
                                "maxLength": 36
                            }
                        },
                        "required": ["requestId"]
                    }
                },
                "required": ["lastSuccess"]
            }
        },
        {
            "id": "catalogue-cursor",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 1024
            }
        },
        {
            "id": "search-cursor",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 8192
            }
        },
        {
            "id": "publisher",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 96
            }
        },
        {
            "id": "resource",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 128
            }
        },
        {
            "id": "version",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 128
            }
        },
        {
            "id": "channel",
            "scope": "param",
            "schema": {
                "type": "string",
                "maxLength": 6,
                "enum": ["stable", "beta", "all"]
            }
        }
    ]
}
