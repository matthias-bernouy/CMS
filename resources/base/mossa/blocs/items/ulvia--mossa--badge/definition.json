{
    "id": "ulvia--mossa--badge",
    "kind": "component",
    "name": "bloc.badge.label",
    "group": "bloc.category.components",
    "categories": ["bloc.category.components"],
    "description": "bloc.badge.description",
    "uses": [],
    "requires": [],
    "slots": {
        "label": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "inline"
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
