{
    "id": "ulvia--mossa--navigation",
    "kind": "component",
    "name": "bloc.navigation.label",
    "group": "bloc.category.site",
    "categories": ["bloc.category.site", "bloc.category.layout"],
    "description": "bloc.navigation.description",
    "uses": ["ulvia--mossa--action", "ulvia--mossa--image"],
    "requires": [],
    "slots": {
        "actions": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--action"
                }
            ],
            "max": 2
        },
        "brand": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "inline"
                },
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--image"
                }
            ],
            "min": 1,
            "max": 1
        },
        "links": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "inline"
                },
                {
                    "kind": "any-component"
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 10,
    "settings": [
        {
            "id": "surface",
            "label": "setting.surface.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "base",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "base",
                        "label": "setting.option.base"
                    },
                    {
                        "value": "subtle",
                        "label": "setting.option.subtle"
                    },
                    {
                        "value": "inverse",
                        "label": "setting.option.inverse"
                    }
                ]
            }
        },
        {
            "id": "sticky",
            "label": "setting.sticky.label",
            "group": "setting.group.behavior",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        }
    ]
}
