{
    "id": "ulvia--mossa--segmented-control",
    "kind": "component",
    "name": "bloc.segmented-control.label",
    "group": "bloc.category.forms",
    "categories": ["bloc.category.forms"],
    "description": "bloc.segmented-control.description",
    "uses": [
        "ulvia--mossa--option-list",
        "ulvia--mossa--radio",
        "ulvia--mossa--segment",
        "ulvia--mossa--segmented-caption"
    ],
    "requires": [],
    "slots": {
        "items": {
            "accepts": [
                {
                    "kind": "any-component"
                }
            ],
            "min": 2
        },
        "legend": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "inline"
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 190,
    "settings": [
        {
            "id": "size",
            "label": "setting.size.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        },
        {
            "id": "orientation",
            "label": "setting.orientation.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "horizontal",
            "maxLength": 10,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "horizontal",
                        "label": "setting.option.horizontal"
                    },
                    {
                        "value": "vertical",
                        "label": "setting.option.vertical"
                    }
                ]
            }
        },
        {
            "id": "wide",
            "label": "setting.wide.label",
            "group": "setting.group.layout",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        }
    ]
}
