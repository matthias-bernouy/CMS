{
    "id": "ulvia--mossa--field",
    "kind": "component",
    "name": "bloc.field.label",
    "group": "bloc.category.forms",
    "categories": ["bloc.category.forms"],
    "description": "bloc.field.description",
    "uses": ["ulvia--mossa--field-caption", "ulvia--mossa--field-help", "ulvia--mossa--input"],
    "requires": [],
    "slots": {
        "control": {
            "accepts": [
                {
                    "kind": "any-component"
                }
            ],
            "min": 1,
            "max": 1
        },
        "description": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "inline"
                }
            ],
            "max": 1
        },
        "error": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "inline"
                }
            ],
            "max": 1
        },
        "help": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--field-help"
                }
            ],
            "max": 1
        },
        "label": {
            "accepts": [
                {
                    "kind": "native-element",
                    "accepts": ["span"]
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 110,
    "settings": [
        {
            "id": "label-position",
            "label": "setting.label-position.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "top",
            "maxLength": 6,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "top",
                        "label": "setting.option.top"
                    },
                    {
                        "value": "inline",
                        "label": "setting.option.inline"
                    },
                    {
                        "value": "hidden",
                        "label": "setting.option.hidden"
                    }
                ]
            }
        },
        {
            "id": "required",
            "label": "setting.required-marker.label",
            "group": "setting.group.behavior",
            "help": "setting.required-marker.help",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        }
    ]
}
