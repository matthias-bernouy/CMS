{
    "id": "ulvia--mossa--tag-input",
    "kind": "component",
    "name": "bloc.tag-input.label",
    "group": "bloc.category.forms",
    "categories": ["bloc.category.forms"],
    "description": "bloc.tag-input.description",
    "uses": [],
    "requires": [],
    "slots": {
        "": {
            "accepts": [
                {
                    "kind": "native-element",
                    "accepts": ["input"],
                    "attributes": {
                        "type": {
                            "required": true,
                            "values": ["text"]
                        },
                        "aria-description": {
                            "required": false
                        }
                    },
                    "defaults": {
                        "type": "text",
                        "name": "tags",
                        "value": "research,design",
                        "autocomplete": "off"
                    }
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 75,
    "settings": [
        {
            "id": "size",
            "label": "setting.size.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        },
        {
            "id": "placeholder",
            "label": "setting.tag-placeholder.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "Type and press Enter",
            "maxLength": 80,
            "control": {
                "kind": "text"
            }
        },
        {
            "id": "hint",
            "label": "setting.tag-hint.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "Press Enter to add. Backspace removes the last tag.",
            "maxLength": 140,
            "control": {
                "kind": "text"
            }
        },
        {
            "id": "separator",
            "label": "setting.tag-separator.label",
            "group": "setting.group.behavior",
            "type": "string",
            "default": ",",
            "maxLength": 1,
            "control": {
                "kind": "text"
            }
        },
        {
            "id": "serialization",
            "label": "setting.tag-serialization.label",
            "group": "setting.group.behavior",
            "type": "string",
            "default": "separated",
            "maxLength": 9,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "separated",
                        "label": "setting.option.separated-values"
                    },
                    {
                        "value": "json",
                        "label": "setting.option.json-array"
                    }
                ]
            }
        },
        {
            "id": "max-tags",
            "label": "setting.max-tags.label",
            "group": "setting.group.behavior",
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "control": {
                "kind": "number",
                "step": 1
            }
        },
        {
            "id": "add-on-blur",
            "label": "setting.add-on-blur.label",
            "group": "setting.group.behavior",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        }
    ]
}
