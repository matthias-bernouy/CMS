{
    "id": "ulvia--mossa--input",
    "kind": "component",
    "name": "bloc.input.label",
    "group": "bloc.category.forms",
    "categories": ["bloc.category.forms"],
    "description": "bloc.input.description",
    "uses": [],
    "requires": [],
    "slots": {
        "": {
            "accepts": [
                {
                    "kind": "native-element",
                    "accepts": ["input"],
                    "attributes": {
                        "type": {
                            "required": true,
                            "values": [
                                "text",
                                "email",
                                "password",
                                "search",
                                "tel",
                                "url",
                                "number",
                                "date",
                                "time",
                                "datetime-local",
                                "month",
                                "week"
                            ]
                        }
                    },
                    "defaults": {
                        "type": "text",
                        "name": "field",
                        "autocomplete": "off"
                    }
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 10,
    "settings": [
        {
            "id": "size",
            "label": "setting.size.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        }
    ]
}
