{
    "id": "ulvia--mossa--search-input",
    "kind": "component",
    "name": "bloc.search-input.label",
    "group": "bloc.category.forms",
    "categories": ["bloc.category.forms"],
    "description": "bloc.search-input.description",
    "uses": ["ulvia--mossa--input"],
    "requires": [],
    "slots": {
        "control": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--input"
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 15,
    "settings": [
        {
            "id": "size",
            "label": "setting.size.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        },
        {
            "id": "clear-label",
            "label": "setting.clear-search-label.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "",
            "maxLength": 80,
            "control": {
                "kind": "text"
            }
        },
        {
            "id": "auto-submit",
            "label": "setting.auto-submit.label",
            "group": "setting.group.behavior",
            "help": "setting.auto-submit.help",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        },
        {
            "id": "submit-delay",
            "label": "setting.submit-delay.label",
            "group": "setting.group.behavior",
            "type": "integer",
            "default": 300,
            "minimum": 0,
            "maximum": 2000,
            "control": {
                "kind": "number",
                "step": 50
            },
            "visibleWhen": [
                {
                    "setting": "auto-submit",
                    "equals": true
                }
            ]
        }
    ]
}
