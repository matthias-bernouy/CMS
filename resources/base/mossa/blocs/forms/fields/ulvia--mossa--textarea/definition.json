{
    "id": "ulvia--mossa--textarea",
    "kind": "component",
    "name": "bloc.textarea.label",
    "group": "bloc.category.forms",
    "categories": ["bloc.category.forms"],
    "description": "bloc.textarea.description",
    "uses": [],
    "requires": [],
    "slots": {
        "": {
            "accepts": [
                {
                    "kind": "native-element",
                    "accepts": ["textarea"],
                    "defaults": {
                        "name": "message",
                        "rows": "5"
                    }
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 20,
    "settings": [
        {
            "id": "size",
            "label": "setting.size.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        },
        {
            "id": "resize",
            "label": "setting.resize.label",
            "group": "setting.group.behavior",
            "type": "string",
            "default": "vertical",
            "maxLength": 8,
            "control": {
                "kind": "select",
                "options": [
                    {
                        "value": "vertical",
                        "label": "setting.option.vertical"
                    },
                    {
                        "value": "both",
                        "label": "setting.option.both"
                    },
                    {
                        "value": "none",
                        "label": "setting.option.none"
                    }
                ]
            }
        },
        {
            "id": "show-count",
            "label": "setting.show-count.label",
            "group": "setting.group.behavior",
            "help": "setting.show-count.help",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        }
    ]
}
