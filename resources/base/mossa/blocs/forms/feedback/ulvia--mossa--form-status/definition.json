{
    "id": "ulvia--mossa--form-status",
    "kind": "component",
    "name": "bloc.form-status.label",
    "group": "bloc.category.forms",
    "categories": ["bloc.category.forms"],
    "description": "bloc.form-status.description",
    "uses": [],
    "requires": [],
    "slots": {
        "": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "phrasing"
                }
            ]
        }
    },
    "root": {
        "accepts": ["output"],
        "attributes": {
            "aria-live": {
                "required": true,
                "values": ["polite", "assertive"]
            }
        },
        "defaults": {
            "aria-live": "polite"
        }
    },
    "catalogueOrder": 170,
    "settings": [
        {
            "id": "tone",
            "label": "setting.tone.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "info",
            "maxLength": 7,
            "control": {
                "kind": "select",
                "options": [
                    {
                        "value": "info",
                        "label": "setting.option.info"
                    },
                    {
                        "value": "success",
                        "label": "setting.option.success"
                    },
                    {
                        "value": "warning",
                        "label": "setting.option.warning"
                    },
                    {
                        "value": "danger",
                        "label": "setting.option.danger"
                    }
                ]
            }
        }
    ]
}
