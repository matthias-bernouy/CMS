{
    "id": "ulvia--mossa--action",
    "kind": "component",
    "name": "bloc.action.label",
    "group": "bloc.category.actions",
    "categories": ["bloc.category.actions"],
    "description": "bloc.action.description",
    "uses": [],
    "requires": [],
    "slots": {
        "": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "phrasing"
                },
                {
                    "kind": "native-element",
                    "accepts": ["svg"]
                }
            ],
            "min": 1
        }
    },
    "root": {
        "accepts": ["button", "a"],
        "defaults": {
            "type": "button"
        }
    },
    "catalogueOrder": 10,
    "settings": [
        {
            "id": "variant",
            "label": "setting.variant.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "filled",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "filled",
                        "label": "setting.option.filled"
                    },
                    {
                        "value": "outline",
                        "label": "setting.option.outline"
                    },
                    {
                        "value": "ghost",
                        "label": "setting.option.ghost"
                    }
                ]
            }
        },
        {
            "id": "tone",
            "label": "setting.tone.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "primary",
            "maxLength": 9,
            "control": {
                "kind": "select",
                "options": [
                    {
                        "value": "primary",
                        "label": "setting.option.primary"
                    },
                    {
                        "value": "secondary",
                        "label": "setting.option.secondary"
                    },
                    {
                        "value": "neutral",
                        "label": "setting.option.neutral"
                    },
                    {
                        "value": "inverse",
                        "label": "setting.option.inverse"
                    },
                    {
                        "value": "info",
                        "label": "setting.option.info"
                    },
                    {
                        "value": "success",
                        "label": "setting.option.success"
                    },
                    {
                        "value": "warning",
                        "label": "setting.option.warning"
                    },
                    {
                        "value": "danger",
                        "label": "setting.option.danger"
                    }
                ]
            }
        },
        {
            "id": "size",
            "label": "setting.size.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        },
        {
            "id": "wide",
            "label": "setting.wide.label",
            "group": "setting.group.layout",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        },
        {
            "id": "icon-only",
            "label": "setting.icon-only.label",
            "group": "setting.group.layout",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        },
        {
            "id": "active",
            "label": "setting.active.label",
            "group": "setting.group.state",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        }
    ]
}
