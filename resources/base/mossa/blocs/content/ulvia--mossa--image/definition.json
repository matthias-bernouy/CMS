{
    "id": "ulvia--mossa--image",
    "kind": "component",
    "name": "bloc.image.label",
    "group": "bloc.category.media",
    "categories": ["bloc.category.media"],
    "description": "bloc.image.description",
    "uses": [],
    "requires": [
        {
            "contractId": "ulvia/cms.files",
            "capabilityId": "files.read",
            "versionRange": "^1.0.0"
        }
    ],
    "slots": {
        "": {
            "accepts": [
                {
                    "kind": "native-element",
                    "accepts": ["img"],
                    "attributes": {
                        "src": {
                            "required": false
                        }
                    },
                    "defaults": {
                        "alt": "",
                        "loading": "lazy",
                        "decoding": "async"
                    }
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div", "span"]
    },
    "catalogueOrder": 5,
    "settings": [
        {
            "id": "ratio",
            "label": "setting.ratio.label",
            "group": "setting.group.media",
            "type": "string",
            "default": "auto",
            "maxLength": 9,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "auto",
                        "label": "setting.option.auto"
                    },
                    {
                        "value": "square",
                        "label": "setting.option.square"
                    },
                    {
                        "value": "landscape",
                        "label": "setting.option.landscape"
                    },
                    {
                        "value": "portrait",
                        "label": "setting.option.portrait"
                    }
                ]
            }
        },
        {
            "id": "fit",
            "label": "setting.fit.label",
            "group": "setting.group.media",
            "type": "string",
            "default": "cover",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "cover",
                        "label": "setting.option.cover"
                    },
                    {
                        "value": "contain",
                        "label": "setting.option.contain"
                    }
                ]
            }
        }
    ]
}
