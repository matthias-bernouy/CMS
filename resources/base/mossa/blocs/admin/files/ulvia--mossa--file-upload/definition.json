{
    "id": "ulvia--mossa--file-upload",
    "kind": "component",
    "name": "bloc.file-upload.label",
    "group": "bloc.category.administration",
    "categories": ["bloc.category.administration"],
    "description": "bloc.file-upload.description",
    "uses": ["ulvia--mossa--file-upload-input"],
    "requires": [
        {
            "contractId": "ulvia/cms.files",
            "capabilityId": "upload.write",
            "versionRange": "^1.0.0"
        },
        {
            "contractId": "ulvia/cms.files",
            "capabilityId": "workspace.upload.complete",
            "versionRange": "^1.0.0"
        },
        {
            "contractId": "ulvia/cms.files",
            "capabilityId": "workspace.upload.create",
            "versionRange": "^1.0.0"
        }
    ],
    "slots": {
        "content": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                }
            ],
            "min": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogue": "hidden",
    "catalogueOrder": 20,
    "settings": [
        {
            "id": "file-id",
            "label": "setting.file-id.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "",
            "maxLength": 128,
            "control": {
                "kind": "text"
            }
        },
        {
            "id": "visibility",
            "label": "setting.visibility.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "private",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "private",
                        "label": "setting.option.private"
                    },
                    {
                        "value": "public",
                        "label": "setting.option.public"
                    }
                ]
            }
        }
    ]
}
