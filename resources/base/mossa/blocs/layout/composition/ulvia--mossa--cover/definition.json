{
    "id": "ulvia--mossa--cover",
    "kind": "component",
    "name": "bloc.cover.label",
    "group": "bloc.category.layout",
    "categories": ["bloc.category.layout"],
    "description": "bloc.cover.description",
    "uses": ["ulvia--mossa--heading"],
    "requires": [],
    "slots": {
        "content": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                }
            ]
        },
        "footer": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                }
            ]
        },
        "header": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 90,
    "settings": [
        {
            "id": "height",
            "label": "setting.height.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "half",
            "maxLength": 8,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "content",
                        "label": "setting.option.content"
                    },
                    {
                        "value": "half",
                        "label": "setting.option.half-screen"
                    },
                    {
                        "value": "viewport",
                        "label": "setting.option.full-screen"
                    }
                ]
            }
        },
        {
            "id": "content-align",
            "label": "setting.alignment.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "center",
            "maxLength": 6,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "start",
                        "label": "setting.option.start"
                    },
                    {
                        "value": "center",
                        "label": "setting.option.center"
                    },
                    {
                        "value": "end",
                        "label": "setting.option.end"
                    }
                ]
            }
        },
        {
            "id": "spacing",
            "label": "setting.spacing.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "lg",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        }
    ]
}
