                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    },
                    {
                        "value": "xl",
                        "label": "setting.option.extra-large"
                    }
                ]
            }
        },
        {
            "id": "narrow-layout",
            "label": "setting.narrow-layout.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "main-first",
            "maxLength": 16,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "main-first",
                        "label": "setting.option.main-first"
                    },
                    {
                        "value": "navigation-first",
                        "label": "setting.option.navigation-first"
                    }
