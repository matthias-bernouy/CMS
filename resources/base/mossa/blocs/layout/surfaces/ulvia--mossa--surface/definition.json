{
    "id": "ulvia--mossa--surface",
    "kind": "component",
    "name": "bloc.surface.label",
    "group": "bloc.category.layout",
    "categories": ["bloc.category.layout"],
    "description": "bloc.surface.description",
    "uses": ["ulvia--mossa--heading", "ulvia--mossa--prose"],
    "requires": [],
    "slots": {
        "content": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                },
                {
                    "kind": "native-element",
                    "accepts": ["div", "form"]
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 100,
    "settings": [
        {
            "id": "appearance",
            "label": "setting.appearance.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "plain",
            "maxLength": 8,
            "control": {
                "kind": "select",
                "options": [
                    {
                        "value": "plain",
                        "label": "setting.option.plain"
                    },
                    {
                        "value": "subtle",
                        "label": "setting.option.subtle"
                    },
                    {
                        "value": "outlined",
                        "label": "setting.option.outlined"
                    },
                    {
                        "value": "elevated",
                        "label": "setting.option.elevated"
                    },
                    {
                        "value": "inverse",
                        "label": "setting.option.inverse"
                    }
                ]
            }
        },
        {
            "id": "padding",
            "label": "setting.padding.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 4,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "none",
                        "label": "setting.option.none"
                    },
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    },
                    {
                        "value": "xl",
                        "label": "setting.option.extra-large"
                    }
                ]
            }
        },
        {
            "id": "radius",
            "label": "setting.radius.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "lg",
            "maxLength": 4,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "none",
                        "label": "setting.option.none"
                    },
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        }
    ]
}
