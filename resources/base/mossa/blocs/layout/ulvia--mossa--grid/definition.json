{
    "id": "ulvia--mossa--grid",
    "kind": "component",
    "name": "bloc.grid.label",
    "group": "bloc.category.layout",
    "categories": ["bloc.category.layout"],
    "description": "bloc.grid.description",
    "uses": [],
    "requires": [],
    "slots": {
        "items": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                },
                {
                    "kind": "native-element",
                    "accepts": ["div", "section", "article"]
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 40,
    "settings": [
        {
            "id": "columns",
            "label": "setting.columns.label",
            "group": "setting.group.layout",
            "type": "integer",
            "default": 3,
            "minimum": 1,
            "maximum": 6,
            "control": {
                "kind": "range",
                "step": 1,
                "suffix": "setting.columns.suffix"
            }
        },
        {
            "id": "gap",
            "label": "setting.gap.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "lg",
            "maxLength": 4,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "none",
                        "label": "setting.option.none"
                    },
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    },
                    {
                        "value": "xl",
                        "label": "setting.option.extra-large"
                    }
                ]
            }
        },
        {
            "id": "items-align",
            "label": "setting.alignment.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "stretch",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "stretch",
                        "label": "setting.option.stretch"
                    },
                    {
                        "value": "start",
                        "label": "setting.option.start"
                    },
                    {
                        "value": "center",
                        "label": "setting.option.center"
                    },
                    {
                        "value": "end",
                        "label": "setting.option.end"
                    }
                ]
            }
        }
    ]
}
