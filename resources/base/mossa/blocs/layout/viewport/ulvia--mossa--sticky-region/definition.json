{
    "id": "ulvia--mossa--sticky-region",
    "kind": "component",
    "name": "bloc.sticky-region.label",
    "group": "bloc.category.layout",
    "categories": ["bloc.category.layout"],
    "description": "bloc.sticky-region.description",
    "uses": [],
    "requires": [],
    "slots": {
        "content": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 150,
    "settings": [
        {
            "id": "position",
            "label": "setting.position.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "top",
            "maxLength": 6,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "top",
                        "label": "setting.option.top"
                    },
                    {
                        "value": "bottom",
                        "label": "setting.option.bottom"
                    }
                ]
            }
        },
        {
            "id": "offset",
            "label": "setting.offset.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 4,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "none",
                        "label": "setting.option.none"
                    },
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        }
    ]
}
