{
    "id": "ulvia--mossa--scroll-area",
    "kind": "component",
    "name": "bloc.scroll-area.label",
    "group": "bloc.category.layout",
    "categories": ["bloc.category.layout"],
    "description": "bloc.scroll-area.description",
    "uses": [],
    "requires": [],
    "slots": {
        "content": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 140,
    "settings": [
        {
            "id": "height",
            "label": "setting.height.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 8,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    },
                    {
                        "value": "viewport",
                        "label": "setting.option.viewport"
                    }
                ]
            }
        },
        {
            "id": "scrollbar",
            "label": "setting.scrollbar.label",
            "group": "setting.group.behaviour",
            "type": "string",
            "default": "auto",
            "maxLength": 6,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "auto",
                        "label": "setting.option.automatic"
                    },
                    {
                        "value": "thin",
                        "label": "setting.option.thin"
                    },
                    {
                        "value": "hidden",
                        "label": "setting.option.hidden"
                    }
                ]
            }
        }
    ]
}
