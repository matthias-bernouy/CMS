{
    "id": "ulvia--mossa--frame",
    "kind": "component",
    "name": "bloc.frame.label",
    "group": "bloc.category.layout",
    "categories": ["bloc.category.layout"],
    "description": "bloc.frame.description",
    "uses": [],
    "requires": [],
    "slots": {
        "content": {
            "accepts": [
                {
                    "kind": "any-component"
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 120,
    "settings": [
        {
            "id": "ratio",
            "label": "setting.ratio.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "landscape",
            "maxLength": 9,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "square",
                        "label": "setting.option.square"
                    },
                    {
                        "value": "portrait",
                        "label": "setting.option.portrait"
                    },
                    {
                        "value": "landscape",
                        "label": "setting.option.landscape"
                    },
                    {
                        "value": "wide",
                        "label": "setting.option.wide"
                    }
                ]
            }
        },
        {
            "id": "fit",
            "label": "setting.fit.label",
            "group": "setting.group.media",
            "type": "string",
            "default": "cover",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "cover",
                        "label": "setting.option.cover"
                    },
                    {
                        "value": "contain",
                        "label": "setting.option.contain"
                    }
                ]
            }
        },
        {
            "id": "radius",
            "label": "setting.radius.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "lg",
            "maxLength": 4,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "none",
                        "label": "setting.option.none"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        }
    ]
}
