{
    "id": "ulvia--mossa--stack",
    "kind": "component",
    "name": "bloc.stack.label",
    "group": "bloc.category.layout",
    "categories": ["bloc.category.layout"],
    "description": "bloc.stack.description",
    "uses": [],
    "requires": [],
    "slots": {
        "items": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "prose"
                },
                {
                    "kind": "native-element",
                    "accepts": ["div", "header", "section", "article", "fieldset", "form", "svg"]
                },
                {
                    "kind": "native-element",
                    "accepts": ["input"],
                    "attributes": {
                        "type": {
                            "required": true,
                            "values": ["hidden"]
                        }
                    }
                }
            ]
        }
    },
    "root": {
        "accepts": ["div", "form"]
    },
    "catalogueOrder": 30,
    "settings": [
        {
            "id": "gap",
            "label": "setting.gap.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "lg",
            "maxLength": 4,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "none",
                        "label": "setting.option.none"
                    },
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    },
                    {
                        "value": "xl",
                        "label": "setting.option.extra-large"
                    }
                ]
            }
        },
        {
            "id": "items-align",
            "label": "setting.alignment.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "stretch",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "stretch",
                        "label": "setting.option.stretch"
                    },
                    {
                        "value": "start",
                        "label": "setting.option.start"
                    },
                    {
                        "value": "center",
                        "label": "setting.option.center"
                    },
                    {
                        "value": "end",
                        "label": "setting.option.end"
                    }
                ]
            }
        },
        {
            "id": "width",
            "label": "setting.width.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "full",
            "maxLength": 4,
            "control": {
                "kind": "select",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.width-sm"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.width-md"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.width-lg"
                    },
                    {
                        "value": "xl",
                        "label": "setting.option.width-xl"
                    },
                    {
                        "value": "full",
                        "label": "setting.option.width-full"
                    }
                ]
            }
        },
        {
            "id": "break-long-words",
            "label": "setting.break-long-words.label",
            "group": "setting.group.typography",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        }
    ]
