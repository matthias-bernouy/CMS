{
    "id": "ulvia--mossa--route-tabs",
    "kind": "component",
    "name": "bloc.route-tabs.label",
    "group": "bloc.category.navigation",
    "categories": ["bloc.category.navigation"],
    "description": "bloc.route-tabs.description",
    "uses": ["ulvia--mossa--route-tab"],
    "requires": [],
    "slots": {
        "items": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--route-tab"
                }
            ],
            "min": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 10,
    "settings": [
        {
            "id": "appearance",
            "label": "setting.appearance.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "underline",
            "maxLength": 9,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "underline",
                        "label": "setting.option.underline"
                    },
                    {
                        "value": "pills",
                        "label": "setting.option.pills"
                    }
                ]
            }
        },
        {
            "id": "tabs-align",
            "label": "setting.alignment.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "start",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "start",
                        "label": "setting.option.start"
                    },
                    {
                        "value": "center",
                        "label": "setting.option.center"
                    },
                    {
                        "value": "stretch",
                        "label": "setting.option.stretch"
                    }
                ]
            }
        },
        {
            "id": "size",
            "label": "setting.size.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "md",
            "maxLength": 2,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "sm",
                        "label": "setting.option.small"
                    },
                    {
                        "value": "md",
                        "label": "setting.option.medium"
                    },
                    {
                        "value": "lg",
                        "label": "setting.option.large"
                    }
                ]
            }
        },
        {
            "id": "label",
            "label": "setting.navigation-label.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "Page navigation",
            "maxLength": 256,
            "control": {
                "kind": "text"
            }
        }
    ]
}
