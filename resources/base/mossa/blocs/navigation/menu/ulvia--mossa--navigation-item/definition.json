{
    "id": "ulvia--mossa--navigation-item",
    "kind": "component",
    "name": "bloc.navigation-item.label",
    "group": "bloc.category.navigation",
    "categories": ["bloc.category.navigation"],
    "description": "bloc.navigation-item.description",
    "uses": [],
    "requires": [],
    "slots": {
        "content": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "inline"
                },
                {
                    "kind": "native-element",
                    "accepts": ["svg"]
                }
            ]
        }
    },
    "root": {
        "accepts": ["a", "button"],
        "defaults": {
            "href": ""
        }
    },
    "catalogueOrder": 50,
    "settings": [
        {
            "id": "active",
            "label": "setting.active.label",
            "group": "setting.group.state",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        },
        {
            "id": "emphasis",
            "label": "setting.emphasis.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "default",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "default",
                        "label": "setting.option.default"
                    },
                    {
                        "value": "muted",
                        "label": "setting.option.muted"
                    }
                ]
            }
        }
    ]
}
