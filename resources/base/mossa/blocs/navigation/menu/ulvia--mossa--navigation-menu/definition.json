{
    "id": "ulvia--mossa--navigation-menu",
    "kind": "component",
    "name": "bloc.navigation-menu.label",
    "group": "bloc.category.navigation",
    "categories": ["bloc.category.navigation"],
    "description": "bloc.navigation-menu.description",
    "uses": ["ulvia--mossa--navigation-group", "ulvia--mossa--navigation-item", "ulvia--mossa--navigation-section"],
    "requires": [],
    "slots": {
        "footer": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--navigation-item"
                }
            ]
        },
        "header": {
            "accepts": [
                {
                    "kind": "any-component"
                },
                {
                    "kind": "native-content",
                    "profile": "inline"
                }
            ],
            "max": 1
        },
        "sections": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--navigation-section"
                }
            ],
            "min": 1
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 30,
    "settings": [
        {
            "id": "appearance",
            "label": "setting.appearance.label",
            "group": "setting.group.appearance",
            "type": "string",
            "default": "plain",
            "maxLength": 6,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "plain",
                        "label": "setting.option.plain"
                    },
                    {
                        "value": "subtle",
                        "label": "setting.option.subtle"
                    }
                ]
            }
        },
        {
            "id": "density",
            "label": "setting.density.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "default",
            "maxLength": 11,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "compact",
                        "label": "setting.option.compact"
                    },
                    {
                        "value": "default",
                        "label": "setting.option.default"
                    },
                    {
                        "value": "comfortable",
                        "label": "setting.option.comfortable"
                    }
                ]
            }
        },
        {
            "id": "label",
            "label": "setting.navigation-label.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "Navigation",
            "maxLength": 256,
            "control": {
                "kind": "text"
            }
        }
    ]
}
