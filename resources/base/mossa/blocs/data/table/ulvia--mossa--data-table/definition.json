{
    "id": "ulvia--mossa--data-table",
    "kind": "component",
    "name": "bloc.data-table.label",
    "group": "bloc.category.data",
    "categories": ["bloc.category.data"],
    "description": "bloc.data-table.description",
    "uses": [
        "ulvia--mossa--data-table-cell",
        "ulvia--mossa--data-table-column-header",
        "ulvia--mossa--data-table-row",
        "ulvia--mossa--data-table-row-header"
    ],
    "requires": [],
    "slots": {
        "caption": {
            "accepts": [
                {
                    "kind": "native-content",
                    "profile": "inline"
                }
            ],
            "min": 1,
            "max": 1
        },
        "columns": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--data-table-column-header"
                }
            ],
            "min": 1
        },
        "rows": {
            "accepts": [
                {
                    "kind": "component",
                    "tag": "ulvia--mossa--data-table-row"
                }
            ]
        }
    },
    "root": {
        "accepts": ["div"]
    },
    "catalogueOrder": 10,
    "settings": [
        {
            "id": "density",
            "label": "setting.density.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "default",
            "maxLength": 11,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "compact",
                        "label": "setting.option.compact"
                    },
                    {
                        "value": "default",
                        "label": "setting.option.default"
                    },
                    {
                        "value": "comfortable",
                        "label": "setting.option.comfortable"
                    }
                ]
            }
        },
        {
            "id": "caption-visibility",
            "label": "setting.caption-visibility.label",
            "group": "setting.group.content",
            "type": "string",
            "default": "visible",
            "maxLength": 7,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "visible",
                        "label": "setting.option.visible"
                    },
                    {
                        "value": "hidden",
                        "label": "setting.option.visually-hidden"
                    }
                ]
            }
        },
        {
            "id": "striped-rows",
            "label": "setting.striped-rows.label",
            "group": "setting.group.appearance",
            "type": "boolean",
            "default": false,
            "control": {
                "kind": "toggle"
            }
        },
        {
            "id": "responsive-layout",
            "label": "setting.responsive-layout.label",
            "group": "setting.group.layout",
            "type": "string",
            "default": "scroll",
            "maxLength": 6,
            "control": {
                "kind": "segmented",
                "options": [
                    {
                        "value": "scroll",
                        "label": "setting.option.table-scroll"
                    },
                    {
                        "value": "stack",
                        "label": "setting.option.table-stack"
                    }
                ]
            }
        }
    ]
}
