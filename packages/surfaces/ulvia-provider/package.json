{
    "name": "@bernouy/ulvia-provider",
    "version": "1.0.0",
    "description": "Provider-facing surface for the official Ulvia CMS contracts.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./src/exports/index.ts",
        "./capabilities": "./src/capabilities/index.ts",
        "./sdk/node": "./src/client/index.ts",
        "./build": "./src/exports/provider/index.ts"
    },
    "architecture": {
        "layer": "surfaces"
    },
    "dependencies": {
        "@bernouy/blob-store": "workspace:*",
        "@bernouy/cms-auth": "workspace:*",
        "@bernouy/cms-content": "workspace:*",
        "@bernouy/email": "workspace:*",
        "@bernouy/cms-files": "workspace:*",
        "@bernouy/cms-gateway": "workspace:*",
        "@bernouy/cms-repository": "workspace:*",
        "@bernouy/cms-secrets": "workspace:*",
        "@bernouy/email-smtp": "workspace:*",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/logging": "workspace:*",
        "@bernouy/cms-observability": "workspace:*",
        "@bernouy/cms-documentation": "workspace:*",
        "@bernouy/ulvia-contracts": "workspace:*",
        "@bernouy/ulvia-providers": "workspace:*",
        "@bernouy/ulvia-sdk": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    }
}
