    "configuration": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "credentialSlots": [
        {
            "id": "provider-token",
            "label": "Provider token",
            "required": true,
            "secretType": "token"
        }
    ],
    "requires": [
        {
            "contractId": "ulvia/cms.observability",
            "capabilityId": "logs.append",
            "versionRange": "^1.0.0",
            "optional": true
