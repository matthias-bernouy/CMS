{
    "name": "@bernouy/cms-control",
    "version": "0.1.0",
    "description": "Control kernel — authentication bootstrap, capability routes, collection-backed Pages, and the ControlCms composition class.",
    "license": "MIT",
    "type": "module",
    "main": "./index.ts",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "bun": "./index.ts",
            "default": "./index.ts"
        }
    },
    "files": [
        "index.ts",
        "src/",
        "types/",
        "dist/",
        ".claude/skills/",
        "tsconfig.json",
        "README.md",
        "CLAUDE.md"
    ],
    "scripts": {
        "build": "bun run src/tooling/build.ts",
        "typecheck": "bun x tsc --noEmit",
        "test": "bun test",
        "prepublishOnly": "bun run build"
    },
    "devDependencies": {
        "@types/bun": "1.4.2",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "typescript": "^7.0.2",
        "mongodb": "^7.2.0"
    },
    "dependencies": {
        "@bernouy/cms-repository": "workspace:*",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/cms-auth": "workspace:*",
        "linkedom": "^0.18.13",
        "@bernouy/cms-content": "workspace:*",
        "@bernouy/cms-gateway": "workspace:*"
    },
    "engines": {
        "bun": ">=1.3.0"
    }
}
