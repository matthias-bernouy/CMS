{
    "name": "@bernouy/cms-control",
    "version": "0.1.0",
    "description": "Admin layer of the CMS — REST API (file-routed under /api), server-rendered admin pages (under /admin), the visual editor (web components in /assets/control-components.js), and the `ControlCms` composition class. Consumes `@bernouy/cms-bloc-compile` for content / files / secrets stores and `@bernouy/cms-auth` for the auth chain.",
    "license": "UNLICENSED",
    "type": "module",
    "main": "./index.ts",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "bun": "./index.ts",
            "default": "./index.ts"
        },
        "./component": {
            "bun": "./src/exports/component.ts",
            "default": "./src/exports/component.ts"
        },
        "./editor": {
            "bun": "./src/exports/editor.ts",
            "default": "./src/exports/editor.ts"
        }
    },
    "files": [
        "index.ts",
        "src/",
        "types/",
        "dist/",
        ".claude/skills/",
        "tsconfig.json",
        "README.md",
        "CLAUDE.md"
    ],
    "scripts": {
        "build": "bun run src/tooling/build.ts",
        "typecheck": "bun x tsc --noEmit",
        "test": "bun test --preload ./tests/setup.ts",
        "prepublishOnly": "bun run build"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.14.5",
        "@types/bun": "1.4.2",
        "happy-dom": "^20.14.5",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "typescript": "^7.0.2",
        "mongodb": "^7.2.0"
    },
    "dependencies": {
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/cms-auth": "workspace:*",
        "@bernouy/cms-bloc-compile": "workspace:*",
        "@bernouy/cms-dashboards": "workspace:*",
        "@bernouy/cms-secrets": "workspace:*",
        "@bernouy/components": "workspace:*",
        "@bernouy/cms-analytics": "workspace:*",
        "linkedom": "^0.18.13",
        "@bernouy/cms-content": "workspace:*",
        "@bernouy/cms-gateway": "workspace:*",
        "@bernouy/cms-editor-system-v2": "workspace:*"
    },
    "engines": {
        "bun": ">=1.3.0"
    }
}
