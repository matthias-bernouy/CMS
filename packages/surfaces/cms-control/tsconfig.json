{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir":   "dist",
        "rootDir":  ".",
        "baseUrl":  ".",
        "paths": {
            "@bernouy/cms-control":           ["index.ts"],
            "@bernouy/cms-control/component": ["component.ts"],
            "@bernouy/cms-control/editor":    ["editor.ts"],
            "cms-control/*":                  ["src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json",
        "index.ts",
        "component.ts",
        "editor.ts",
        "build.ts",
        "types/**/*.ts",
        "tests/**/*.ts"
    ],
    "references": [
        { "path": "../../features/cms-permissions" },
        { "path": "../../foundation/http-runner" },
        { "path": "../../features/cms-auth" },
        { "path": "../../features/cms-bloc-compile" },
        { "path": "../../features/cms-content" },
        { "path": "../../features/cms-files" },
        { "path": "../../features/cms-secrets" },
        { "path": "../../features/cms-sources" },
        { "path": "../../features/cms-analytics" }
    ]
}
