{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir":   "dist",
        "rootDir":  ".",
        "paths": {
            "@bernouy/cms-control": ["./index.ts"],
            "cms-control/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json",
        "index.ts",
        "types/**/*.ts",
        "tests/**/*.ts"
    ],
    "references": [
        { "path": "../../foundation/blob-store" },
        { "path": "../../features/cms-repository" },
        { "path": "../../foundation/http-runner" },
        { "path": "../../features/cms-auth" },
        { "path": "../../features/cms-content" },
        { "path": "../../features/cms-gateway" }
    ]
}
