{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir":   "dist",
        "rootDir":  ".",
        "paths": {
            "@bernouy/cms-control":           ["./index.ts"],
            "@bernouy/cms-control/component": ["./src/exports/component.ts"],
            "cms-control/*":                  ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json",
        "index.ts",
        "types/**/*.ts",
        "tests/**/*.ts"
    ],
    "references": [
        { "path": "../../features/cms-repository" },
        { "path": "../../foundation/http-runner" },
        { "path": "../../features/cms-auth" },
        { "path": "../../features/cms-bloc-compile" },
        { "path": "../../features/cms-content" },
        { "path": "../../features/cms-gateway" },
        { "path": "../../foundation/secret-store" },
        { "path": "../../features/cms-dashboards" }
    ]
}
