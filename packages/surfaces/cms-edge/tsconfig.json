{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": ".",
        "paths": {
            "cms-edge/*": [
                "./src/*"
            ]
        },
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json",
        "types/**/*.ts"
    ],
    "references": [
        {
            "path": "../../features/cms-auth"
        },
        {
            "path": "../../features/cms-repository"
        },
        {
            "path": "../../foundation/http-runner"
        },
        {
            "path": "../../foundation/logging"
        },
        {
            "path": "../../platform/contracts"
        },
        {
            "path": "../../platform/gateway"
        }
    ]
}
