{
    "id": "catalogue-list",
    "description": "catalogue-list",
    "access": "public",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "enum": [
                    "collection",
                    "contract",
                    "provider-manifest"
                ]
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
            },
            "cursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
            }
        },
        "required": [
            "kind",
            "limit"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "releases": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32,
                            "enum": [
                                "collection",
                                "contract",
                                "provider-manifest"
                            ]
                        },
                        "publisherId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        },
                        "digest": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 71
                        }
                    },
                    "required": [
                        "kind",
                        "publisherId",
                        "id",
                        "version",
                        "digest"
                    ]
                }
            },
            "nextCursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
            }
        },
        "required": [
            "releases"
        ]
    },
    "errors": [
        {
            "code": "REJECTED",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/v1/catalogue",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [
                    200
                ],
                "contentTypes": [
                    "application/json"
                ],
                "errorStatuses": {
                    "REJECTED": 409,
                    "NOT_FOUND": 404
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp"
        }
    ]
}
