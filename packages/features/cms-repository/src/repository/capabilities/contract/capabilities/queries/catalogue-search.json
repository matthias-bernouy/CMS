{
    "id": "catalogue-search",
    "description": "Search public collection, Bloc, contract and Provider metadata before installation. Results are discovery hints, not compatibility or runtime readiness claims.",
    "access": "public",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": false
    },
    "input": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
            },
            "kinds": {
                "type": "array",
                "maxItems": 4,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "enum": [
                        "collection",
                        "bloc",
                        "contract",
                        "provider-manifest"
                    ]
                }
            },
            "publisherId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "contractId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
            },
            "cursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
            }
        },
        "required": [
            "query"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 71
            },
            "mode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 7,
                "enum": [
                    "hybrid",
                    "lexical"
                ]
            },
            "degraded": {
                "type": "boolean"
            },
            "results": {
                "type": "array",
                "maxItems": 50,
                "items": {
                    "type": "object",
                    "properties": {
                        "reference": {
                            "type": "object",
                            "properties": {
                                "kind": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 32,
                                    "enum": [
                                        "collection",
                                        "contract",
                                        "provider-manifest"
                                    ]
                                },
                                "publisherId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 96
                                },
                                "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "version": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "digest": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 71
                                }
                            },
                            "required": [
                                "kind",
                                "publisherId",
                                "id",
                                "version",
                                "digest"
                            ]
                        },
                        "blocId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        },
                        "name": {
                            "type": "string",
                            "maxLength": 512
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 1600
                        },
                        "categories": {
                            "type": "array",
                            "maxItems": 32,
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                            }
                        },
                        "contractIds": {
                            "type": "array",
                            "maxItems": 128,
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            }
                        }
                    },
                    "required": [
                        "reference",
                        "name",
                        "description",
                        "categories",
                        "contractIds"
                    ]
                }
            },
            "nextCursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
            }
        },
        "required": [
            "revision",
            "mode",
            "degraded",
            "results"
        ]
    },
    "errors": [
        {
            "code": "REJECTED",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "CATALOGUE_TOO_LARGE",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/v1/search",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [
                    200
                ],
                "contentTypes": [
                    "application/json"
                ],
                "errorStatuses": {
                    "REJECTED": 409,
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "RELEASE_MISMATCH": 409,
                    "REVISION_CONFLICT": 409,
                    "CATALOGUE_TOO_LARGE": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
