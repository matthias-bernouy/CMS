{
    "kind": "provider-manifest",
    "protocol": "ulvia-provider/v1",
    "schemaDialect": "ulvia-schema/v1",
    "providerId": "ulvia/ulvia.example",
    "name": "Ulvia Example Provider",
    "version": "1.0.0",
    "provenance": {
        "publisherId": "ulvia",
        "publishedAt": "2026-09-22T00:00:00Z"
    },
    "buildVersionRange": ">=1.0.0 <2.0.0",
    "endpoint": {
        "allowedOrigins": [
            "https://provider.example.com"
        ],
        "defaultOrigin": "https://provider.example.com"
    },
    "configuration": {
        "type": "object",
        "properties": {
            "region": {
                "type": "string",
                "enum": [
                    "eu"
                ],
                "maxLength": 16
            }
        },
        "required": [
            "region"
        ]
    },
    "credentialSlots": [
        {
            "id": "provider-token",
            "label": "Provider token",
            "required": true,
            "secretType": "token"
        }
    ],
    "implementations": [
        {
            "contractId": "ulvia/protocol.examples",
            "version": "1.0.0",
            "digest": "sha256:0f7adc66326ec67c2d3257be15992b07fde4e2d3e4abfee9372d9b82eeea7bce",
            "requires": [
                {
                    "contractId": "ulvia/communication.email",
                    "versionRange": "^1.0.0",
                    "capabilityId": "email.message.send",
                    "optional": false
                }
            ]
        }
    ],
    "dataPolicy": {
        "residency": [
            "eu"
        ],
        "retentionPolicyUrl": "https://provider.example.com/legal/retention"
    },
    "recovery": {
        "backupFormatVersion": "ulvia-provider-backup/v1",
        "compatibleBuildRange": "^1.0.0",
        "restore": true,
        "relocation": true
    },
    "requires": []
}
