                    }
                }
            ]
        },
        {
            "id": "atlas-page-default",
            "label": "bloc.page.label",
            "description": "bloc.page.label",
            "document": {
                "html": "<div cms-bloc=\"atlas-page\"><p slot=\"main\">Example content</p></div>"
            },
            "previews": [
                {
                    "id": "desktop",
                    "frame": {
                        "width": 640,
                        "height": 240
                    }
                }
            ]
        }
    ]
