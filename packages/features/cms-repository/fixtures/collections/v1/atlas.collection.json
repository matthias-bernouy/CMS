{
    "kind": "collection",
    "protocol": "ulvia-collection/v1",
    "schemaDialect": "ulvia-schema/v1",
    "collectionId": "atlas",
    "publisherId": "atlas.official",
    "version": "1.0.0",
    "name": "collection.name",
    "locale": "en-US",
    "translations": {
        "en-US": {
            "bloc.page.label": "Page",
            "bloc.panel.label": "Panel",
            "collection.name": "Atlas starter collection",
            "setting.option.default": "Default",
            "setting.option.muted": "Muted",
            "setting.tone.label": "Tone"
        }
    },
    "configuration": {
        "schema": {
            "type": "object",
            "properties": {},
            "required": []
        },
        "defaults": {}
    },
    "assets": [
        {
            "id": "preview",
            "mediaType": "image/svg+xml",
            "byteLength": 154,
            "digest": "sha256:199cbf7a31792013057e235364563ad358dc223517664811eedca40273fe8b46"
        }
    ],
    "blocs": [
        {
            "kind": "component",
            "root": {
                "accepts": [
                    "div"
                ]
            },
            "id": "atlas-panel",
            "label": "bloc.panel.label",
            "markup": "<section><slot name=\"body\"></slot></section>",
            "style": ":scope { display: block; } :scope([tone=\"muted\"]) { opacity: 0.8; }",
            "slots": {
                "body": {
                    "accepts": [
                        {
                            "kind": "native-content",
                            "profile": "prose"
                        }
                    ]
                }
            },
            "settings": [
                {
                    "id": "tone",
                    "label": "setting.tone.label",
                    "type": "string",
                    "control": {
                        "kind": "select",
                        "options": [
                            {
                                "value": "default",
                                "label": "setting.option.default"
                            },
                            {
                                "value": "muted",
                                "label": "setting.option.muted"
                            }
                        ]
                    },
                    "maxLength": 7,
                    "default": "default"
                }
            ],
            "description": "bloc.panel.label",
            "categories": [
                "bloc.panel.label"
            ],
            "examples": [
                "atlas-panel-default"
            ],
            "defaultExample": "atlas-panel-default"
        },
        {
            "kind": "composition",
            "root": {
                "accepts": [
                    "div"
                ]
            },
            "id": "atlas-page",
            "label": "bloc.page.label",
            "uses": [
                "atlas-panel"
            ],
            "markup": "<div cms-bloc=\"atlas-panel\" tone=\"default\"><slot name=\"main\" slot=\"body\"></slot></div>",
            "slots": {
                "main": {
                    "accepts": [
                        {
                            "kind": "native-content",
                            "profile": "prose"
                        }
                    ],
                    "max": 8
                }
            },
            "description": "bloc.page.label",
            "categories": [
                "bloc.page.label"
            ],
            "examples": [
                "atlas-page-default"
            ],
            "defaultExample": "atlas-page-default"
        }
    ],
    "examples": [
        {
            "id": "atlas-panel-default",
            "label": "bloc.panel.label",
            "description": "bloc.panel.label",
            "document": {
                "html": "<div cms-bloc=\"atlas-panel\"><p slot=\"body\">Example content</p></div>"
            },
            "previews": [
                {
