{
    "name": "@bernouy/cms-auth",
    "version": "0.1.0",
    "description": "CMS-owned authentication primitives (LocalAuth + OidcAuth + PAT + signed cookies) plus the membership / identity-provider / credential stores. Provider-agnostic — Keycloak/Google/Okta plug in as one OIDC backend among many. Consumed by every CMS surface that needs an admin-side auth chain.",
    "license": "MIT",
    "type": "module",
    "main": "./src/exports/index.ts",
    "exports": {
        ".": "./src/exports/index.ts",
        "./management": "./src/exports/management.ts",
        "./http": "./src/exports/http.ts",
        "./mongo": "./src/exports/mongo.ts",
        "./smtp": "./src/exports/smtp.ts",
        "./browser": "./src/exports/browser.ts"
    },
    "dependencies": {
        "@bernouy/envelope-crypto": "workspace:*",
        "jose": "^6.2.12",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/rate-limiter": "workspace:*",
        "@bernouy/secret-store": "workspace:*",
        "nodemailer": "^10.0.10"
    },
    "peerDependencies": {
        "mongodb": "^7.2.0",
        "typescript": "^7.0.2"
    }
}
