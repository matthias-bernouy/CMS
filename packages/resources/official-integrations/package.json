{
    "name": "@bernouy/cms-official-integrations",
    "version": "0.1.0",
    "description": "Local repository of official CmsCore integration resources.",
    "license": "UNLICENSED",
    "type": "module",
    "main": "./index.ts",
    "types": "./dist/index.d.ts",
    "scripts": {
        "test:postgres": "bun run tests/helpers/postgres/runPostgresContracts.ts"
    },
    "files": [
        "index.ts",
        "publication.ts",
        "dist/",
        "integrations"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "bun": "./index.ts",
            "default": "./index.ts"
        },
        "./publication": {
            "types": "./dist/publication.d.ts",
            "bun": "./publication.ts",
            "default": "./publication.ts"
        },
        "./integrations/ban/*": "./integrations/providers/ban/*",
        "./integrations/basic-blocs/*": "./integrations/foundation/basic-blocs/*",
        "./integrations/commerce/*": "./integrations/domains/commerce/*",
        "./integrations/commerce-mondial-relay-delivery/*": "./integrations/extensions/commerce-mondial-relay-delivery/*",
        "./integrations/commerce-mondial-relay-fulfillment/*": "./integrations/extensions/commerce-mondial-relay-fulfillment/*",
        "./integrations/commerce-negotiation/*": "./integrations/extensions/commerce-negotiation/*",
        "./integrations/commerce-stripe-payments/*": "./integrations/extensions/commerce-stripe-payments/*",
        "./integrations/emailer/*": "./integrations/providers/emailer/*",
        "./integrations/mondial-relay/*": "./integrations/providers/mondial-relay/*",
        "./integrations/newsletter/*": "./integrations/domains/newsletter/*",
        "./integrations/photo-albums/*": "./integrations/domains/photo-albums/*",
        "./integrations/sales-configurator/*": "./integrations/domains/sales-configurator/*",
        "./integrations/stripe-connect/*": "./integrations/providers/stripe-connect/*",
        "./integrations/user-account/*": "./integrations/domains/user-account/*"
    },
    "dependencies": {
        "@bernouy/cms-integration-packages": "workspace:*",
        "@bernouy/cms-integrations": "workspace:*",
        "semver": "^7.8.2"
    },
    "devDependencies": {
        "@types/semver": "^7.7.1"
    }
}
