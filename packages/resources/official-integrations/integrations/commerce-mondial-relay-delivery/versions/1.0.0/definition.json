{
    "schema": "cms.integration.definition.v1",
    "kind": "commerce-mondial-relay-delivery",
    "label": "Commerce Mondial Relay delivery",
    "version": "1.0.0",
    "category": "Delivery",
    "description": "Link authenticated Commerce orders to server-validated Mondial Relay pickup point selections.",
    "inputs": [],
    "dependencies": [
        { "name": "commerce", "kind": "commerce" },
        { "name": "delivery", "kind": "mondial-relay" },
        { "name": "accounts", "kind": "user-account" }
    ],
    "ui": {
        "mark": "CD",
        "markClass": "commerce-mondial-relay-delivery",
        "emit": "functions:updated",
        "checks": [
            "The authenticated buyer must own the Commerce order.",
            "Only awaiting-quote orders can receive a relay selection.",
            "Delivery revalidates the selected relay point with Mondial Relay.",
            "Delivery snapshots buyer and seller fulfillment data before any payment.",
            "One exact quote id is locked into immutable Commerce financial terms.",
            "Selecting a relay never creates a shipment or label."
        ],
        "resources": [["Functions", "Set and retrieve the relay point for an order"]],
        "sync": ["Validate dependencies", "Install delivery functions", "Refresh Functions"]
    },
    "artifacts": [
        {
            "type": "function",
            "function": {
                "id": "setRelayPointForOrder",
                "method": "POST",
                "access": { "mode": "auth" },
                "meta": {
                    "name": "Set relay point for order",
                    "description": "Verify order ownership and persist a server-validated Mondial Relay point."
                },
                "input": {
                    "body": {
                        "type": "object",
                        "properties": {
                            "orderId": { "type": "string" },
                            "relayLocation": { "type": "string" },
                            "country": { "type": "string" },
                            "postalCode": { "type": "string" },
                            "city": { "type": "string" }
                        },
                        "required": ["orderId", "relayLocation", "country", "postalCode"]
                    }
                },
                "output": [{ "status": "200", "body": { "type": "object" } }],
                "steps": [
                    {
                        "id": "context",
                        "call": {
                            "source": "{{dependencies.commerce.sourceId}}",
                            "endpoint": "getOrderDeliverySetupContext",
                            "params": { "orderId": "$input.body.orderId" }
                        }
                    },
                    {
                        "assert": {
                            "condition": { "equals": ["$steps.context.order.buyerCmsUserId", "$ctx.user.id"] },
                            "failure": { "status": 403, "error": "Order does not belong to the current buyer" }
                        }
                    },
                    {
                        "assert": {
                            "condition": { "equals": ["$steps.context.order.status", "awaiting_quote"] },
                            "failure": { "status": 409, "error": "Pickup point can only be changed before order finalization" }
                        }
                    },
                    {
                        "assert": {
                            "condition": { "all": [
                                { "equals": ["$steps.context.authorization.buyerCmsUserId", "$ctx.user.id"] },
                                { "equals": ["$steps.context.authorization.orderVersion", "$steps.context.order.version"] },
                                { "equals": ["$steps.context.authorization.status", "awaiting_quote"] }
                            ] },
                            "failure": { "status": 409, "error": "Order delivery authorization changed" }
                        }
                    },
                    {
                        "id": "seller",
                        "call": {
                            "source": "{{dependencies.accounts.sourceId}}",
                            "endpoint": "getAccountByUserId",
                            "params": { "userId": "$steps.context.authorization.sellerCmsUserId" }
                        }
                    },
                    {
                        "id": "selection",
                        "call": {
                            "source": "{{dependencies.delivery.sourceId}}",
                            "endpoint": "saveRelaySelection",
                            "body": {
                                "requestKey": { "$concat": ["commerce-order:", "$steps.context.order.publicId", ":version:", "$steps.context.order.version", ":relay:", "$input.body.relayLocation"] },
                                "externalOrderId": "$steps.context.order.publicId",
                                "orderVersion": "$steps.context.order.version",
                                "selectedForCmsUserId": "$ctx.user.id",
                                "relayLocation": "$input.body.relayLocation",
                                "country": "$input.body.country",
                                "postalCode": "$input.body.postalCode",
                                "city": "$input.body.city",
                                "currency": "$steps.context.authorization.currency",
                                "merchandiseSubtotalMinorAmount": "$steps.context.authorization.merchandiseSubtotalMinorAmount",
                                "recipientSnapshot": "$steps.context.authorization.shippingAddress",
                                "sellerFulfillmentSnapshot": "$steps.seller"
                            }
                        }
                    },
                    {
                        "id": "resolvedQuote",
                        "call": {
                            "source": "{{dependencies.delivery.sourceId}}",
                            "endpoint": "resolveDeliveryQuote",
                            "body": {
                                "quoteId": "$steps.selection.quoteId",
                                "externalOrderId": "$steps.context.order.publicId",
                                "selectedForCmsUserId": "$ctx.user.id",
                                "orderVersion": "$steps.context.order.version",
                                "merchandiseSubtotalMinorAmount": "$steps.context.authorization.merchandiseSubtotalMinorAmount",
                                "currency": "$steps.context.authorization.currency",
                                "purpose": "financial_lock"
                            }
                        }
                    },
                    {
                        "id": "financialTerms",
                        "call": {
                            "source": "{{dependencies.commerce.sourceId}}",
                            "endpoint": "lockOrderFinancialTerms",
                            "body": {
                                "orderPublicId": "$steps.context.order.publicId",
                                "deliveryQuoteId": "$steps.resolvedQuote.quoteId",
                                "shippingAmount": "$steps.resolvedQuote.shippingAmount",
                                "currency": "$steps.resolvedQuote.currency",
                                "expectedVersion": "$steps.context.order.version"
                            }
                        }
                    }
                ],
                "return": {
                    "status": 200,
                    "body": {
                        "selection": "$steps.selection",
                        "financialTerms": "$steps.financialTerms"
                    }
                }
            }
        },
        {
            "type": "function",
            "function": {
                "id": "getRelayPointForOrder",
                "method": "GET",
                "access": { "mode": "auth" },
                "meta": {
                    "name": "Get relay point for order",
                    "description": "Retrieve the validated relay point for an owned Commerce order."
                },
                "input": {
                    "params": {
                        "orderId": { "type": "string" }
                    }
                },
                "output": [{ "status": "200", "body": { "type": "object" } }],
                "steps": [
                    {
                        "id": "context",
                        "call": {
                            "source": "{{dependencies.commerce.sourceId}}",
                            "endpoint": "getOrderDeliverySelectionContext",
                            "params": { "orderId": "$input.params.orderId" }
                        }
                    },
                    {
                        "assert": {
                            "condition": { "equals": ["$steps.context.buyerCmsUserId", "$ctx.user.id"] },
                            "failure": { "status": 403, "error": "Order does not belong to the current buyer" }
                        }
                    },
                    {
                        "id": "selection",
                        "call": {
                            "source": "{{dependencies.delivery.sourceId}}",
                            "endpoint": "deliveryQuote",
                            "params": {
                                "quoteId": "$steps.context.deliveryQuoteId",
                                "externalOrderId": "$steps.context.publicId",
                                "selectedForCmsUserId": "$ctx.user.id"
                            }
                        }
                    }
                ],
                "return": { "status": 200, "body": {
                    "quoteId": "$steps.selection.quoteId",
                    "externalOrderId": "$steps.selection.externalOrderId",
                    "relayLocation": "$steps.selection.relayLocation",
                    "country": "$steps.selection.country",
                    "number": "$steps.selection.number",
                    "name": "$steps.selection.name",
                    "addressLine1": "$steps.selection.addressLine1",
                    "addressLine2": "$steps.selection.addressLine2",
                    "postalCode": "$steps.selection.postalCode",
                    "city": "$steps.selection.city",
                    "nature": "$steps.selection.nature",
                    "pointType": "$steps.selection.pointType",
                    "weightGrams": "$steps.selection.weightGrams",
                    "shippingAmount": "$steps.selection.shippingAmount",
                    "currency": "$steps.selection.currency",
                    "quotedAt": "$steps.selection.quotedAt",
                    "expiresAt": "$steps.selection.expiresAt"
                } }
            }
        }
    ]
}
