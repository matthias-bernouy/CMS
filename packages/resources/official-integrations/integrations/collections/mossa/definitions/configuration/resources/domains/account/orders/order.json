{
    "id": "mossa/blocs/order",
    "type": "bloc",
    "artifact": "mossa-order",
    "category": "account",
    "defaultActive": false,
    "endpoints": [
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:myOrder",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.id": "route.orderId"
                }
            }
        },
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:offer",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.id": "state.offer.id"
                }
            }
        },
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:publicOfferImage",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.id": "state.image.id"
                }
            }
        },
        {
            "source": "commerce-stripe-payments",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:system-functions:getPaymentForOrder",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.orderId": "route.orderId"
                }
            }
        },
        {
            "source": "commerce-mondial-relay-delivery",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:system-functions:getRelayPointForOrder",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.orderId": "route.orderId"
                }
            }
        },
        {
            "source": "commerce-mondial-relay-fulfillment",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:system-functions:getShipmentForOrder",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.orderId": "route.orderId"
                }
            }
        }
    ],
    "requires": {
        "resources": [
            "mossa/blocs/badge",
            "mossa/blocs/button",
            "mossa/blocs/commerce-offer-preview",
            "mossa/blocs/info-row",
            "mossa/blocs/order-controller",
            "mossa/blocs/responsive-grid",
            "mossa/blocs/section-header",
            "mossa/blocs/skeleton",
            "mossa/blocs/stack",
            "mossa/blocs/surface-card"
        ]
    }
}
