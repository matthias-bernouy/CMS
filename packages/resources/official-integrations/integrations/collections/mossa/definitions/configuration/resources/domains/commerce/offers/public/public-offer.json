{
    "id": "mossa/blocs/public-offer",
    "type": "bloc",
    "artifact": "mossa-public-offer",
    "category": "commerce",
    "defaultActive": false,
    "endpoints": [
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:offer",
            "contractVersion": "^1.0.0",
            "bindings": { "input": { "params.slug": "route.slug" } }
        },
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:product",
            "contractVersion": "^1.0.0",
            "bindings": { "input": { "params.id": "state.product.id" } }
        },
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:offerFilterSchema",
            "contractVersion": "^1.0.0",
            "bindings": { "input": { "params.category": "state.product.primaryCategory.fullSlug" } }
        },
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:publicOfferImage",
            "contractVersion": "^1.0.0",
            "bindings": { "input": { "params.id": "state.image.id" } }
        }
    ],
    "requires": {
        "resources": [
            "mossa/blocs/button",
            "mossa/blocs/condition",
            "mossa/blocs/meta",
            "mossa/blocs/offer-details",
            "mossa/blocs/public-offer-controller",
            "mossa/blocs/responsive-grid",
            "mossa/blocs/skeleton",
            "mossa/blocs/specification",
            "mossa/blocs/specifications",
            "mossa/blocs/stack",
            "mossa/blocs/surface-card",
            "mossa/blocs/toast",
            "mossa/blocs/trust-item"
        ]
    }
}
