{
    "id": "mossa/blocs/commerce-offer-price-form",
    "type": "bloc",
    "artifact": "mossa-commerce-offer-price-form",
    "category": "commerce",
    "endpoints": [
        {
            "source": "commerce",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:commerce:myOffer",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.id": "state.myOffer.id"
                }
            }
        },
        {
            "source": "user-account",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:user-account:getAccount",
            "contractVersion": "^1.0.0"
        },
        {
            "source": "user-account",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:user-account:updateAccount",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "body.phone": "state.updateAccount.phone",
                    "body.givenName": "state.updateAccount.givenName",
                    "body.surname": "state.updateAccount.surname",
                    "body.birthDate": "state.updateAccount.birthDate",
                    "body.addressLine1": "state.updateAccount.addressLine1",
                    "body.addressLine2": "state.updateAccount.addressLine2",
                    "body.addressLine3": "state.updateAccount.addressLine3",
                    "body.postalCode": "state.updateAccount.postalCode",
                    "body.city": "state.updateAccount.city",
                    "body.region": "state.updateAccount.region",
                    "body.countryCode": "state.updateAccount.countryCode",
                    "body.avatarUrl": "state.updateAccount.avatarUrl",
                    "body.avatarFileId": "state.updateAccount.avatarFileId",
                    "body.locale": "state.updateAccount.locale",
                    "body.timezone": "state.updateAccount.timezone"
                }
            }
        },
        {
            "source": "stripe-connect",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:stripe-connect:getConnectClientConfig",
            "contractVersion": "^1.0.0"
        },
        {
            "source": "commerce-stripe-payments",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:system-functions:getSellerSaleEnrollment",
            "contractVersion": "^1.0.0"
        },
        {
            "source": "commerce-stripe-payments",
            "sourceVersion": "^1.0.0",
            "endpoint": "urn:system-functions:submitSellerOfferPrice",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "body.offerId": "state.submitSellerOfferPrice.offerId",
                    "body.amount": "state.submitSellerOfferPrice.amount",
                    "body.expectedVersion": "state.submitSellerOfferPrice.expectedVersion",
                    "body.accountToken": "state.submitSellerOfferPrice.accountToken",
                    "body.sellerTermsAccepted": "state.submitSellerOfferPrice.sellerTermsAccepted",
                    "body.sellerTermsVersion": "state.submitSellerOfferPrice.sellerTermsVersion",
                    "body.sellerTermsHash": "state.submitSellerOfferPrice.sellerTermsHash"
                }
            }
        }
    ],
    "context": [
        "authenticated-user"
    ],
    "requires": {
        "resources": [
            "mossa/blocs/button",
            "mossa/blocs/commerce-offer-price-form-controller",
            "mossa/blocs/input",
            "mossa/blocs/responsive-grid",
            "mossa/blocs/skeleton",
            "mossa/blocs/stack",
            "mossa/blocs/surface-card",
            "mossa/blocs/toast"
        ]
    },
    "defaultActive": false
}
