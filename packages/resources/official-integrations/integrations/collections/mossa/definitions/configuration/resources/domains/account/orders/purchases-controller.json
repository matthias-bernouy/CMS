{
    "id": "mossa/blocs/purchases-controller",
    "type": "bloc",
    "artifact": "mossa-purchases-controller",
    "category": "account",
    "defaultActive": false,
    "endpoints": [
        {
            "source": "commerce",
            "sourceVersion": ">=1.0.0 <3.0.0",
            "endpoint": "urn:commerce:myOrders",
            "contractVersion": "^1.0.0",
            "bindings": {
                "input": {
                    "params.limit": "state.orders.limit",
                    "params.offset": "state.orders.offset"
                }
            }
        }
    ],
    "requires": {
        "resources": [
            "mossa/blocs/purchases"
        ]
    }
}
