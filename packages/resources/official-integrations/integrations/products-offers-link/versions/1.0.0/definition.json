{
    "schema": "cms.integration.definition.v1",
    "kind": "products-offers-link",
    "label": "Products offers link",
    "version": "1.0.0",
    "category": "Commerce",
    "description": "Registers a paginated relation from Products to Offers using the existing offers.productId reference and optional offers.variantId reference.",
    "icon": {
        "path": "assets/icon.svg"
    },
    "inputs": [],
    "dependencies": [
        {
            "name": "products",
            "kind": "products"
        },
        {
            "name": "offers",
            "kind": "offers"
        }
    ],
    "ui": {
        "mark": "PO",
        "markClass": "commerce-link",
        "emit": "relations:updated",
        "instructions": [
            [
                "Install Products and Offers",
                "This link reads the installed source ids from the Products and Offers integrations."
            ],
            [
                "Register product offers relation",
                "Create a paginated relation from products to offers through offers.productId, with optional variant-level targeting."
            ]
        ],
        "scopes": [
            "Product to offers relation",
            "Relation metadata and dashboard projection",
            "No connector deployment"
        ],
        "checks": [
            "Products and Offers must already be installed successfully.",
            "The Offers list endpoint must expose productId, variantId, limit and offset query parameters.",
            "The relation does not duplicate product or offer rows."
        ],
        "resources": [
            [
                "Relations",
                "Product offers relation"
            ],
            [
                "Dashboard",
                "Offers table on product detail"
            ],
            [
                "Dashboard",
                "Product and variant lookups on offer detail"
            ]
        ],
        "review": [
            "Keep offers.productId as the source of truth for the product relation.",
            "Use paginated dashboard projections instead of injecting full offer lists into product responses."
        ],
        "sync": [
            "Validate dependencies",
            "Attach product and variant lookups to offer detail dashboard",
            "Register product offers relation",
            "Attach offers table to product detail dashboard",
            "Refresh relations"
        ],
        "syncNote": "This integration stores relation metadata and a dashboard projection."
    },
    "artifacts": [
        {
            "type": "sourceOverlay",
            "overlay": {
                "id": "offers-product-lookup",
                "sourceId": "{{dependencies.offers.sourceId}}",
                "dashboardFields": [
                    {
                        "dashboardId": "{{dependencies.offers.sourceId}}-offers",
                        "viewId": "offerDetail",
                        "fieldId": "productId",
                        "field": {
                            "label": "Product",
                            "type": "combobox",
                            "lookup": {
                                "sourceId": "{{dependencies.products.sourceId}}",
                                "endpoint": "products",
                                "params": {
                                    "q": "$search",
                                    "limit": "20"
                                },
                                "itemsPath": "items",
                                "valuePath": "id",
                                "labelPath": "title",
                                "subtitlePath": "slug",
                                "selected": {
                                    "sourceId": "{{dependencies.products.sourceId}}",
                                    "endpoint": "product",
                                    "params": {
                                        "id": "$value"
                                    }
                                }
                            }
                        }
                    },
                    {
                        "dashboardId": "{{dependencies.offers.sourceId}}-offers",
                        "viewId": "offerDetail",
                        "fieldId": "variantId",
                        "field": {
                            "label": "Variant",
                            "type": "combobox",
                            "lookup": {
                                "sourceId": "{{dependencies.products.sourceId}}",
                                "endpoint": "variants",
                                "params": {
                                    "productId": "$field.productId",
                                    "q": "$search",
                                    "limit": "20"
                                },
                                "itemsPath": "items",
                                "valuePath": "id",
                                "labelPath": "title",
                                "subtitlePath": "optionsSummary",
                                "selected": {
                                    "sourceId": "{{dependencies.products.sourceId}}",
                                    "endpoint": "variant",
                                    "params": {
                                        "id": "$value"
                                    }
                                }
                            }
                        }
                    }
                ],
                "fields": []
            }
        },
        {
            "type": "relation",
            "relation": {
                "id": "product-offers",
                "label": "Offers",
                "from": {
                    "sourceId": "{{dependencies.products.sourceId}}",
                    "label": "Product",
                    "idPath": "id"
                },
                "to": {
                    "sourceId": "{{dependencies.offers.sourceId}}",
                    "label": "Offer",
                    "idPath": "id"
                },
                "cardinality": "many",
                "binding": {
                    "kind": "reference",
                    "endpoint": {
                        "sourceId": "{{dependencies.offers.sourceId}}",
                        "endpointId": "offers"
                    },
                    "params": {
                        "productId": "$from.id"
                    }
                },
                "page": {
                    "itemsPath": "items",
                    "totalPath": "total",
                    "limitParam": "limit",
                    "offsetParam": "offset",
                    "defaultLimit": 25,
                    "maxLimit": 100
                }
            }
        },
        {
            "type": "dashboardRelation",
            "projection": {
                "type": "dashboardRelation",
                "relationId": "product-offers",
                "dashboardId": "{{dependencies.products.sourceId}}-products",
                "viewId": "productDetail",
                "placement": "main",
                "sectionId": "productOffers",
                "title": "Offers",
                "widget": "table",
                "pageSize": 25,
                "rowKey": "id",
                "columns": [
                    {
                        "id": "title",
                        "label": "Offer",
                        "path": "title",
                        "primary": true
                    },
                    {
                        "id": "variantId",
                        "label": "Variant",
                        "path": "variantId"
                    },
                    {
                        "id": "sellerKind",
                        "label": "Seller",
                        "path": "sellerKind",
                        "format": "badge"
                    },
                    {
                        "id": "status",
                        "label": "Status",
                        "path": "status",
                        "format": "badge"
                    },
                    {
                        "id": "priceAmount",
                        "label": "Price",
                        "path": "priceAmount",
                        "format": "money"
                    },
                    {
                        "id": "currency",
                        "label": "Currency",
                        "path": "currency"
                    }
                ]
            }
        }
    ]
}
