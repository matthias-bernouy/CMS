{
    "schema": "cms.integration.definition.v1",
    "kind": "supabase-marketplace",
    "label": "Supabase Marketplace",
    "version": "1.0.0",
    "category": "Commerce",
    "description": "Connect CMS users to a Supabase-backed Stripe Connect marketplace API.",
    "inputs": [
        {
            "name": "id",
            "label": "Source id",
            "type": "text",
            "required": true,
            "defaultValue": "marketplace"
        },
        {
            "name": "functionsBaseUrl",
            "label": "Supabase Functions base URL",
            "type": "url",
            "required": true,
            "defaultValue": "https://PROJECT_REF.functions.supabase.co/functions/v1"
        },
        {
            "name": "apiKey",
            "label": "Private CMS marketplace API key",
            "type": "password",
            "required": true,
            "secret": true
        }
    ],
    "ui": {
        "mark": "M",
        "markClass": "marketplace",
        "emit": "source:updated",
        "instructions": [
            [
                "Deploy Supabase functions",
                "Deploy the marketplace Edge Function and set its production secrets."
            ],
            [
                "Run the database schema",
                "Apply connectors/supabase/schema.sql to the target Supabase database."
            ],
            [
                "Connect the CMS",
                "Enter the Functions base URL without a trailing slash and the private CMS API key."
            ]
        ],
        "scopes": [
            "CMS user id forwarding",
            "Stripe Connect onboarding",
            "Marketplace payment creation",
            "Order status reads"
        ],
        "checks": [
            "The CMS only stores the source configuration and private API key reference.",
            "Supabase publishable keys are not accepted by the marketplace Edge Function.",
            "Each CMS request forwards x-cms-user-id from the authenticated CMS subject."
        ],
        "resources": [
            [
                "Sources",
                "Marketplace source contract"
            ],
            [
                "Secrets",
                "Private CMS marketplace API key"
            ],
            [
                "Supabase",
                "Private marketplace schema and Edge Function"
            ]
        ],
        "review": [
            "Do not expose Stripe secret keys to the CMS or browser.",
            "Keep transfer release operations out of this public source contract.",
            "Use webhooks as the source of truth for Stripe account and payment state."
        ],
        "sync": [
            "Validate answers",
            "Store private API key",
            "Install marketplace source",
            "Refresh Sources"
        ],
        "syncNote": "This integration creates a stateless CMS source. Supabase owns all marketplace data."
    },
    "secrets": [
        {
            "input": "apiKey",
            "key": "MARKETPLACE_{{env answers.id}}_API_KEY"
        }
    ],
    "artifacts": [
        {
            "type": "source",
            "source": {
                "id": "{{answers.id}}",
                "meta": {
                    "name": "Marketplace",
                    "description": "Supabase-backed Stripe Connect marketplace endpoints.",
                    "icon": "credit-card"
                },
                "endpoints": [
                    {
                        "endpointId": "connectStatus",
                        "method": "GET",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-marketplace/connect-status",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-cms-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "connected": {
                                            "type": "boolean"
                                        },
                                        "onboardingStatus": {
                                            "type": "string"
                                        },
                                        "chargesEnabled": {
                                            "type": "boolean"
                                        },
                                        "payoutsEnabled": {
                                            "type": "boolean"
                                        },
                                        "disabledReason": {
                                            "type": "string"
                                        },
                                        "currentlyDue": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "pastDue": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "pendingVerification": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "required": [
                                        "connected",
                                        "onboardingStatus",
                                        "chargesEnabled",
                                        "payoutsEnabled",
                                        "currentlyDue",
                                        "pastDue",
                                        "pendingVerification"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "connectOnboarding",
                        "method": "POST",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-marketplace/connect-onboarding",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-cms-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "returnUrl": {
                                    "type": "string"
                                },
                                "refreshUrl": {
                                    "type": "string"
                                },
                                "collectionFields": {
                                    "type": "string"
                                },
                                "businessType": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "returnUrl",
                                "refreshUrl"
                            ]
                        },
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "url": {
                                            "type": "string"
                                        },
                                        "expiresAt": {
                                            "type": "number"
                                        }
                                    },
                                    "required": [
                                        "url"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "createPayment",
                        "method": "POST",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-marketplace/create-payment",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-cms-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "sellerUserId": {
                                    "type": "string"
                                },
                                "amountTotal": {
                                    "type": "number"
                                },
                                "platformFeeAmount": {
                                    "type": "number"
                                },
                                "currency": {
                                    "type": "string"
                                },
                                "clientReferenceId": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "sellerUserId",
                                "amountTotal",
                                "platformFeeAmount",
                                "currency"
                            ]
                        },
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "orderId": {
                                            "type": "number"
                                        },
                                        "paymentIntentId": {
                                            "type": "string"
                                        },
                                        "clientSecret": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "orderId",
                                        "paymentIntentId",
                                        "clientSecret"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "orderStatus",
                        "method": "GET",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-marketplace/order-status",
                        "params": [
                            {
                                "name": "orderId",
                                "in": "query",
                                "type": "number",
                                "required": true,
                                "description": "Marketplace order id returned by createPayment."
                            }
                        ],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-cms-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "orderId": {
                                            "type": "number"
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "paymentIntentId": {
                                            "type": "string"
                                        },
                                        "amountTotal": {
                                            "type": "number"
                                        },
                                        "platformFeeAmount": {
                                            "type": "number"
                                        },
                                        "sellerAmount": {
                                            "type": "number"
                                        },
                                        "currency": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "orderId",
                                        "status",
                                        "amountTotal",
                                        "platformFeeAmount",
                                        "sellerAmount",
                                        "currency"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "health",
                        "method": "GET",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-marketplace/health",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-cms-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "ok"
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
