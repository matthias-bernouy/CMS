{
    "schema": "cms.integration.definition.v1",
    "kind": "commerce-negotiation",
    "label": "Commerce negotiation",
    "version": "1.0.0",
    "category": "Commerce",
    "description": "Let authenticated marketplace buyers propose bounded prices to Commerce sellers.",
    "inputs": [
        {
            "name": "id",
            "label": "Source id",
            "type": "text",
            "required": true,
            "defaultValue": "commerce-negotiation"
        }
    ],
    "dependencies": [
        {
            "name": "basicBlocs",
            "kind": "basic-blocs"
        },
        {
            "name": "commerce",
            "kind": "commerce"
        }
    ],
    "ui": {
        "mark": "CN",
        "markClass": "commerce-negotiation",
        "emit": "source:updated",
        "instructions": [
            [
                "Install Basic Blocs",
                "Install the Basic Blocs integration used by the negotiation form and account list compositions."
            ],
            [
                "Install Commerce",
                "Commerce must already be installed successfully in the same Supabase project."
            ],
            [
                "Deploy connector resources",
                "Apply the private negotiation schema and deploy the cms-commerce-negotiation Edge Function."
            ],
            [
                "Review policy",
                "Configure the minimum and maximum percentages and the proposal lifetime."
            ]
        ],
        "scopes": [
            "Authenticated buyer price proposals",
            "Seller accept and reject decisions",
            "Bounded proposal policy snapshots",
            "Negotiation audit events",
            "Composable buyer form and authenticated proposal list",
            "Administrator proposal and policy dashboards"
        ],
        "checks": [
            "The negotiation schema stays private to anon and authenticated Supabase roles.",
            "Offer ownership, availability, currency, and reference price are loaded server-side from Commerce.",
            "Buyer and seller identities come from CMS-computed identity headers or trusted Commerce data.",
            "Proposal bounds are calculated and enforced transactionally in integer minor units.",
            "Only one pending proposal per buyer and offer and one accepted proposal per offer can exist."
        ],
        "resources": [
            ["Sources", "Negotiation source contract"],
            ["Blocs", "Buyer proposal form and received/sent proposal list"],
            ["Dashboards", "Proposals and negotiation settings"],
            ["Secrets", "Generated private negotiation API key"],
            ["Supabase", "Private negotiation schema and Edge Function"]
        ],
        "review": [
            "Version 1 assumes Commerce and Commerce negotiation use the same Supabase project.",
            "An accepted proposal is an immutable price agreement; creating a Commerce order at that price requires a dedicated Commerce order capability.",
            "Do not expose the generated API keys or service-role key to browser code."
        ],
        "sync": [
            "Validate Commerce dependency",
            "Generate private API key",
            "Deploy Supabase connector",
            "Install Negotiation source",
            "Install Negotiation form and list blocs",
            "Install Proposals dashboard",
            "Install Negotiation settings dashboard",
            "Refresh Sources"
        ],
        "syncNote": "Commerce owns listings and orders. Commerce negotiation owns bounded proposals, decisions, and audit history."
    },
    "generatedSecrets": [
        {
            "name": "cmsApiKey",
            "key": "COMMERCE_NEGOTIATION_{{env answers.id}}_API_KEY",
            "generator": "token",
            "bytes": 32,
            "prefix": "cms_cn_"
        }
    ],
    "connectors": [
        {
            "provider": "supabase",
            "root": "connectors/supabase",
            "dataApiSchemas": ["commerce_negotiation"],
            "schemas": [
                { "path": "schema.sql" }
            ],
            "functions": [
                {
                    "name": "cms-commerce-negotiation",
                    "directory": "functions/cms-commerce-negotiation",
                    "configPath": "supabase.config.toml",
                    "secrets": {
                        "CMS_NEGOTIATION_API_KEY": "{{generated.cmsApiKey}}"
                    }
                }
            ]
        }
    ],
    "artifacts": [
        {
            "type": "source",
            "source": {
                "id": "{{answers.id}}",
                "meta": {
                    "name": "Commerce negotiation",
                    "description": "Bounded buyer price proposals for Commerce marketplace offers.",
                    "icon": { "path": "assets/icon.svg" }
                },
                "endpoints": [
                    {
                        "endpointId": "health",
                        "method": "GET",
                        "access": "admin",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/health",
                        "params": [],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } }
                        ],
                        "output": [
                            { "status": "200", "body": { "type": "object", "properties": { "ok": { "type": "boolean" }, "enabled": { "type": "boolean" } }, "required": ["ok", "enabled"] } }
                        ]
                    },
                    {
                        "endpointId": "getProposalPolicy",
                        "method": "GET",
                        "access": "system",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/policy",
                        "params": [
                            { "name": "offerId", "in": "query", "type": "number", "required": true },
                            { "name": "offerSlug", "in": "query", "type": "string", "required": true },
                            { "name": "offerTitle", "in": "query", "type": "string", "required": true },
                            { "name": "sellerCmsUserId", "in": "query", "type": "string", "required": true },
                            { "name": "sellerDisplayName", "in": "query", "type": "string" },
                            { "name": "referenceAmount", "in": "query", "type": "number", "required": true },
                            { "name": "currency", "in": "query", "type": "string", "required": true },
                            { "name": "publicationStatus", "in": "query", "type": "string", "required": true },
                            { "name": "availability", "in": "query", "type": "string", "required": true }
                        ],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } },
                            { "name": "x-cms-user-id", "source": { "from": "computed", "ref": "userID" } }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "enabled": { "type": "boolean" },
                                        "canPropose": { "type": "boolean" },
                                        "ineligibilityReason": { "type": "string" },
                                        "offerId": { "type": "number" },
                                        "referenceAmount": { "type": "number" },
                                        "minimumAmount": { "type": "number" },
                                        "maximumAmount": { "type": "number" },
                                        "currency": { "type": "string" },
                                        "expiresAfterHours": { "type": "number" }
                                    },
                                    "required": ["enabled", "canPropose", "offerId", "referenceAmount", "minimumAmount", "maximumAmount", "currency"]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "createMyProposal",
                        "method": "POST",
                        "access": "system",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/proposals",
                        "params": [],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } },
                            { "name": "x-cms-user-id", "source": { "from": "computed", "ref": "userID" } }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "offerId": { "type": "number" },
                                "amount": { "type": "number" },
                                "message": { "type": "string" },
                                "offerSlug": { "type": "string" },
                                "offerTitle": { "type": "string" },
                                "sellerCmsUserId": { "type": "string" },
                                "sellerDisplayName": { "type": "string" },
                                "referenceAmount": { "type": "number" },
                                "currency": { "type": "string" },
                                "publicationStatus": { "type": "string" },
                                "availability": { "type": "string" }
                            },
                            "required": [
                                "offerId", "amount", "offerSlug", "offerTitle", "sellerCmsUserId",
                                "referenceAmount", "currency", "publicationStatus", "availability"
                            ]
                        },
                        "output": [
                            { "status": "201", "body": { "type": "object" } }
                        ]
                    },
                    {
                        "endpointId": "myProposals",
                        "method": "GET",
                        "access": "auth",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/proposals",
                        "params": [
                            { "name": "role", "in": "query", "type": "string" },
                            { "name": "status", "in": "query", "type": "string" },
                            { "name": "offerId", "in": "query", "type": "number" },
                            { "name": "limit", "in": "query", "type": "number" },
                            { "name": "offset", "in": "query", "type": "number" }
                        ],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } },
                            { "name": "x-cms-user-id", "source": { "from": "computed", "ref": "userID" } }
                        ],
                        "output": [
                            { "status": "200", "body": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "object" } }, "total": { "type": "number" } }, "required": ["items", "total"] } }
                        ]
                    },
                    {
                        "endpointId": "myProposal",
                        "method": "GET",
                        "access": "auth",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/proposal",
                        "params": [
                            { "name": "id", "in": "query", "type": "number" },
                            { "name": "publicId", "in": "query", "type": "string" }
                        ],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } },
                            { "name": "x-cms-user-id", "source": { "from": "computed", "ref": "userID" } }
                        ],
                        "output": [
                            { "status": "200", "body": { "type": "object" } }
                        ]
                    },
                    {
                        "endpointId": "respondToProposal",
                        "method": "POST",
                        "access": "auth",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/proposal/respond",
                        "params": [],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } },
                            { "name": "x-cms-user-id", "source": { "from": "computed", "ref": "userID" } }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "number" },
                                "action": { "type": "string" },
                                "expectedVersion": { "type": "number" },
                                "message": { "type": "string" }
                            },
                            "required": ["id", "action", "expectedVersion"]
                        },
                        "output": [
                            { "status": "200", "body": { "type": "object" } }
                        ]
                    },
                    {
                        "endpointId": "withdrawMyProposal",
                        "method": "POST",
                        "access": "auth",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/proposal/withdraw",
                        "params": [],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } },
                            { "name": "x-cms-user-id", "source": { "from": "computed", "ref": "userID" } }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "number" },
                                "expectedVersion": { "type": "number" }
                            },
                            "required": ["id", "expectedVersion"]
                        },
                        "output": [
                            { "status": "200", "body": { "type": "object" } }
                        ]
                    },
                    {
                        "endpointId": "manageProposals",
                        "method": "GET",
                        "access": "admin",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/admin/proposals",
                        "params": [
                            { "name": "q", "in": "query", "type": "string" },
                            { "name": "status", "in": "query", "type": "string" },
                            { "name": "limit", "in": "query", "type": "number" },
                            { "name": "offset", "in": "query", "type": "number" }
                        ],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } }
                        ],
                        "output": [
                            { "status": "200", "body": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "object" } }, "total": { "type": "number" } }, "required": ["items", "total"] } }
                        ]
                    },
                    {
                        "endpointId": "manageProposal",
                        "method": "GET",
                        "access": "admin",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/admin/proposal",
                        "params": [
                            { "name": "id", "in": "query", "type": "number", "required": true }
                        ],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } }
                        ],
                        "output": [
                            { "status": "200", "body": { "type": "object" } }
                        ]
                    },
                    {
                        "endpointId": "cancelProposal",
                        "method": "POST",
                        "access": "admin",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/admin/proposal/cancel",
                        "params": [],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "number" },
                                "expectedVersion": { "type": "number" },
                                "reason": { "type": "string" }
                            },
                            "required": ["id", "expectedVersion"]
                        },
                        "output": [
                            { "status": "200", "body": { "type": "object" } }
                        ]
                    },
                    {
                        "endpointId": "settings",
                        "method": "GET",
                        "access": "admin",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/admin/settings",
                        "params": [],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "minimumPercent": { "type": "number" },
                                        "maximumPercent": { "type": "number" },
                                        "proposalTtlHours": { "type": "number" },
                                        "enabled": { "type": "boolean" },
                                        "version": { "type": "number" }
                                    },
                                    "required": ["minimumPercent", "maximumPercent", "proposalTtlHours", "enabled", "version"]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "updateSettings",
                        "method": "POST",
                        "access": "admin",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/admin/settings",
                        "params": [],
                        "headers": [
                            { "name": "authorization", "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " } }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "expectedVersion": { "type": "number" },
                                "minimumPercent": { "type": "number" },
                                "maximumPercent": { "type": "number" },
                                "proposalTtlHours": { "type": "number" },
                                "enabled": { "type": "boolean" }
                            },
                            "required": ["expectedVersion"]
                        },
                        "output": [
                            { "status": "200", "body": { "type": "object" } }
                        ]
                    }
                ]
            }
        },
        {
            "type": "function",
            "function": {
                "id": "getProposalPolicy",
                "method": "GET",
                "access": { "mode": "auth" },
                "meta": {
                    "name": "Get proposal policy",
                    "description": "Resolve an authoritative Commerce offer and return its negotiation policy."
                },
                "input": {
                    "params": {
                        "offerId": { "type": "number" }
                    }
                },
                "output": [
                    { "status": "200", "body": { "type": "object" } }
                ],
                "steps": [
                    {
                        "id": "offer",
                        "call": {
                            "source": "{{dependencies.commerce.sourceId}}",
                            "endpoint": "getOfferNegotiationContext",
                            "params": { "offerId": "$input.params.offerId" }
                        }
                    },
                    {
                        "id": "policy",
                        "call": {
                            "source": "{{answers.id}}",
                            "endpoint": "getProposalPolicy",
                            "params": {
                                "offerId": "$steps.offer.offerId",
                                "offerSlug": "$steps.offer.offerSlug",
                                "offerTitle": "$steps.offer.offerTitle",
                                "sellerCmsUserId": "$steps.offer.sellerCmsUserId",
                                "sellerDisplayName": "$steps.offer.sellerDisplayName",
                                "referenceAmount": "$steps.offer.referenceAmount",
                                "currency": "$steps.offer.currency",
                                "publicationStatus": "$steps.offer.publicationStatus",
                                "availability": "$steps.offer.availability"
                            }
                        }
                    }
                ],
                "return": { "status": 200, "body": "$steps.policy" }
            }
        },
        {
            "type": "function",
            "function": {
                "id": "createMyProposal",
                "method": "POST",
                "access": { "mode": "auth" },
                "meta": {
                    "name": "Create my proposal",
                    "description": "Resolve an authoritative Commerce offer and create a bounded buyer proposal."
                },
                "input": {
                    "body": {
                        "type": "object",
                        "properties": {
                            "offerId": { "type": "number" },
                            "amount": { "type": "number" },
                            "message": { "type": "string" }
                        },
                        "required": ["offerId", "amount"]
                    }
                },
                "output": [
                    { "status": "201", "body": { "type": "object" } }
                ],
                "steps": [
                    {
                        "id": "offer",
                        "call": {
                            "source": "{{dependencies.commerce.sourceId}}",
                            "endpoint": "getOfferNegotiationContext",
                            "params": { "offerId": "$input.body.offerId" }
                        }
                    },
                    {
                        "id": "proposal",
                        "call": {
                            "source": "{{answers.id}}",
                            "endpoint": "createMyProposal",
                            "body": {
                                "offerId": "$steps.offer.offerId",
                                "amount": "$input.body.amount",
                                "message": "$input.body.message",
                                "offerSlug": "$steps.offer.offerSlug",
                                "offerTitle": "$steps.offer.offerTitle",
                                "sellerCmsUserId": "$steps.offer.sellerCmsUserId",
                                "sellerDisplayName": "$steps.offer.sellerDisplayName",
                                "referenceAmount": "$steps.offer.referenceAmount",
                                "currency": "$steps.offer.currency",
                                "publicationStatus": "$steps.offer.publicationStatus",
                                "availability": "$steps.offer.availability"
                            }
                        }
                    }
                ],
                "return": { "status": 201, "body": "$steps.proposal" }
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "commerce-negotiation-form",
                "name": "Negotiation form",
                "group": "Commerce",
                "description": "Customizable buyer proposal form composed from Basic Blocs.",
                "path": "blocs/commerce-negotiation-form"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "commerce-negotiation-list",
                "name": "Negotiation list",
                "group": "Commerce",
                "description": "Customizable received and sent proposal list composed from Basic Blocs.",
                "path": "blocs/commerce-negotiation-list"
            }
        },
        {
            "type": "dashboard",
            "dashboard": {
                "id": "{{answers.id}}-proposals",
                "source": "{{answers.id}}",
                "meta": {
                    "name": "Price proposals",
                    "icon": { "path": "assets/icon.svg" }
                },
                "views": [
                    {
                        "widget": "w-table",
                        "id": "proposalsTable",
                        "title": "Price proposals",
                        "source": {
                            "endpoint": "manageProposals",
                            "params": { "q": "$filter.q", "status": "$filter.status", "limit": "100" },
                            "itemsPath": "items",
                            "totalPath": "total"
                        },
                        "rowKey": "id",
                        "filters": [
                            { "id": "q", "label": "Search", "param": "q", "type": "text", "placeholder": "Offer or user" },
                            {
                                "id": "status",
                                "label": "Status",
                                "param": "status",
                                "type": "select",
                                "options": [
                                    { "value": "pending", "label": "Pending" },
                                    { "value": "accepted", "label": "Accepted" },
                                    { "value": "rejected", "label": "Rejected" },
                                    { "value": "withdrawn", "label": "Withdrawn" },
                                    { "value": "expired", "label": "Expired" },
                                    { "value": "canceled", "label": "Canceled" }
                                ]
                            }
                        ],
                        "columns": [
                            { "id": "offerTitle", "label": "Offer", "path": "offerTitle", "primary": true },
                            { "id": "status", "label": "Status", "path": "status", "format": "badge" },
                            { "id": "proposedAmount", "label": "Proposed", "path": "proposedAmount", "format": "money" },
                            { "id": "referenceAmount", "label": "Reference", "path": "referenceAmount", "format": "money" },
                            { "id": "currency", "label": "Currency", "path": "currency" },
                            { "id": "sellerDisplayName", "label": "Seller", "path": "sellerDisplayName" },
                            { "id": "createdAt", "label": "Created", "path": "createdAt", "format": "date" }
                        ],
                        "selection": { "opens": "proposalDetail" }
                    },
                    {
                        "widget": "w-detail",
                        "id": "proposalDetail",
                        "source": { "endpoint": "manageProposal", "params": { "id": "$selection.id" } },
                        "title": { "path": "offerTitle", "fallback": "Price proposal" },
                        "status": { "path": "status" },
                        "actions": [
                            {
                                "id": "cancelProposal",
                                "label": "Cancel proposal",
                                "tone": "danger",
                                "placement": "more",
                                "confirm": "Cancel this proposal?",
                                "visibleWhen": {
                                    "any": [
                                        { "value": "$field.status", "equals": "pending" },
                                        { "value": "$field.status", "equals": "accepted" }
                                    ]
                                },
                                "endpoint": {
                                    "endpoint": "cancelProposal",
                                    "body": {
                                        "id": "$resource.id",
                                        "expectedVersion": "$resource.version",
                                        "reason": "$field.cancellationReason"
                                    }
                                }
                            }
                        ],
                        "main": [
                            {
                                "id": "proposalAmounts",
                                "title": "Agreement",
                                "fields": [
                                    { "id": "referenceAmount", "label": "Reference amount", "path": "referenceAmount", "type": "readonly", "format": "money" },
                                    { "id": "minimumAmount", "label": "Minimum amount", "path": "minimumAmount", "type": "readonly", "format": "money" },
                                    { "id": "maximumAmount", "label": "Maximum amount", "path": "maximumAmount", "type": "readonly", "format": "money" },
                                    { "id": "proposedAmount", "label": "Proposed amount", "path": "proposedAmount", "type": "readonly", "format": "money" },
                                    { "id": "currency", "label": "Currency", "path": "currency", "type": "readonly" },
                                    { "id": "buyerMessage", "label": "Buyer message", "path": "buyerMessage", "type": "readonly" },
                                    { "id": "decisionMessage", "label": "Decision message", "path": "decisionMessage", "type": "readonly" },
                                    {
                                        "id": "cancellationReason",
                                        "label": "Cancellation reason",
                                        "path": "cancellationReason",
                                        "type": "textarea",
                                        "rows": 3,
                                        "visibleWhen": {
                                            "any": [
                                                { "value": "$field.status", "equals": "pending" },
                                                { "value": "$field.status", "equals": "accepted" }
                                            ]
                                        }
                                    }
                                ]
                            }
                        ],
                        "aside": [
                            {
                                "id": "proposalParties",
                                "title": "Parties",
                                "fields": [
                                    { "id": "sellerDisplayName", "label": "Seller", "path": "sellerDisplayName", "type": "readonly" },
                                    { "id": "sellerUserId", "label": "Seller user", "path": "sellerUserId", "type": "readonly" },
                                    { "id": "buyerUserId", "label": "Buyer user", "path": "buyerUserId", "type": "readonly" },
                                    { "id": "status", "label": "Status", "path": "status", "type": "readonly", "format": "badge" },
                                    { "id": "expiresAt", "label": "Expires", "path": "expiresAt", "type": "readonly", "format": "date" }
                                ]
                            }
                        ]
                    }
                ]
            }
        },
        {
            "type": "dashboard",
            "dashboard": {
                "id": "{{answers.id}}-settings",
                "source": "{{answers.id}}",
                "meta": {
                    "name": "Negotiation settings",
                    "icon": { "path": "assets/icon.svg" }
                },
                "views": [
                    {
                        "widget": "w-detail",
                        "id": "negotiationSettings",
                        "source": { "endpoint": "settings" },
                        "title": { "path": "id", "fallback": "Negotiation settings" },
                        "actions": [
                            {
                                "id": "saveSettings",
                                "label": "Save settings",
                                "tone": "primary",
                                "placement": "primary",
                                "endpoint": {
                                    "endpoint": "updateSettings",
                                    "body": {
                                        "expectedVersion": "$resource.version",
                                        "minimumPercent": "$field.minimumPercent",
                                        "maximumPercent": "$field.maximumPercent",
                                        "proposalTtlHours": "$field.proposalTtlHours",
                                        "enabled": "$field.enabled"
                                    }
                                },
                                "after": {
                                    "resource": "$result"
                                }
                            }
                        ],
                        "main": [
                            {
                                "id": "policy",
                                "title": "Price bounds",
                                "fields": [
                                    { "id": "minimumPercent", "label": "Minimum percent", "path": "minimumPercent", "type": "text", "required": true },
                                    { "id": "maximumPercent", "label": "Maximum percent", "path": "maximumPercent", "type": "text", "required": true },
                                    { "id": "proposalTtlHours", "label": "Lifetime in hours", "path": "proposalTtlHours", "type": "text", "required": true },
                                    { "id": "enabled", "label": "Enabled", "path": "enabled", "type": "checkbox" }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ]
