{
    "schema": "cms.integration.definition.v1",
    "kind": "supabase-newsletter",
    "label": "Supabase Newsletter",
    "version": "1.0.0",
    "category": "Marketing",
    "description": "Store newsletter subscription state in a small Supabase table.",
    "inputs": [
        {
            "name": "id",
            "label": "Source id",
            "type": "text",
            "required": true,
            "defaultValue": "newsletter"
        },
        {
            "name": "functionsBaseUrl",
            "label": "Supabase Functions base URL",
            "type": "url",
            "required": true,
            "defaultValue": "https://PROJECT_REF.functions.supabase.co/functions/v1"
        },
        {
            "name": "apiKey",
            "label": "Private CMS newsletter API key",
            "type": "password",
            "required": true,
            "secret": true
        }
    ],
    "ui": {
        "mark": "N",
        "markClass": "newsletter",
        "emit": "source:updated",
        "instructions": [
            [
                "Run the database schema",
                "Apply connectors/supabase/schema.sql to the target Supabase database."
            ],
            [
                "Deploy Supabase function",
                "Deploy the cms-newsletter Edge Function and set its production secrets."
            ],
            [
                "Connect the CMS",
                "Enter the Functions base URL without a trailing slash and the private CMS newsletter API key."
            ]
        ],
        "scopes": [
            "Newsletter subscription upsert",
            "Subscription status reads"
        ],
        "checks": [
            "The CMS only stores the source configuration and private API key reference.",
            "Supabase publishable keys are not accepted by the newsletter Edge Function."
        ],
        "resources": [
            [
                "Sources",
                "Newsletter source contract"
            ],
            [
                "Secrets",
                "Private CMS newsletter API key"
            ],
            [
                "Supabase",
                "Private newsletter schema and Edge Function"
            ]
        ],
        "review": [
            "Keep the newsletter table private to anon and authenticated roles.",
            "Use the Edge Function as the only public write/read path.",
            "Do not expose Supabase service-role or secret keys to the CMS or browser."
        ],
        "sync": [
            "Validate answers",
            "Store private API key",
            "Install newsletter source",
            "Refresh Sources"
        ],
        "syncNote": "This integration creates a stateless CMS source. Supabase owns newsletter subscription rows."
    },
    "secrets": [
        {
            "input": "apiKey",
            "key": "NEWSLETTER_{{env answers.id}}_API_KEY"
        }
    ],
    "artifacts": [
        {
            "type": "source",
            "source": {
                "id": "{{answers.id}}",
                "meta": {
                    "name": "Newsletter",
                    "description": "Supabase-backed newsletter subscription endpoints.",
                    "icon": "mail"
                },
                "endpoints": [
                    {
                        "endpointId": "setSubscription",
                        "method": "POST",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-newsletter/set-subscription",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string"
                                },
                                "subscribed": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "email",
                                "subscribed"
                            ]
                        },
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "email": {
                                            "type": "string"
                                        },
                                        "subscribed": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "email",
                                        "subscribed"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "subscriptionStatus",
                        "method": "GET",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-newsletter/subscription-status",
                        "params": [
                            {
                                "name": "email",
                                "in": "query",
                                "type": "string",
                                "required": true,
                                "description": "Newsletter email address."
                            }
                        ],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "email": {
                                            "type": "string"
                                        },
                                        "subscribed": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "email",
                                        "subscribed"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "health",
                        "method": "GET",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-newsletter/health",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "ok"
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
