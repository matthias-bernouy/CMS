{
    "type": "trigger",
    "trigger": {
        "id": "schedule-publish-mondial-relay-delivery-health",
        "label": "Publish Mondial Relay delivery health",
        "event": {
            "kind": "schedule",
            "intervalMs": 60000,
            "initialDelayMs": 55000,
            "timeoutMs": 120000
        },
        "mode": "async",
        "failureMode": "ignore",
        "function": {
            "id": "publishMondialRelayDeliveryHealth",
            "body": {
                "runKey": "$schedule.runKey",
                "limit": 24
            }
        }
    }
}
