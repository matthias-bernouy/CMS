{
    "endpointId": "runProviderReconciliation",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/reconciliation/run",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "runKey": {
                "type": "string"
            },
            "limit": {
                "type": "number"
            }
        },
        "required": [
            "runKey"
        ]
    },
    "output": {
        "$include": "run-provider-reconciliation/output/responses.json"
    }
}
