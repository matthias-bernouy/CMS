{
    "id": "reconcileMondialRelayShipmentOperations",
    "method": "POST",
    "access": {
        "mode": "system"
    },
    "meta": {
        "name": "Reconcile Mondial Relay shipment operations",
        "description": "Recover durable shipment creation and cancellation sagas without holding database locks across provider calls."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "runKey": {
                    "type": "string"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "runKey",
                "limit"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object"
            }
        }
    ],
    "steps": {
        "$include": "steps.json"
    },
    "return": {
        "status": 200,
        "body": {
            "creations": "$steps.creations",
            "cancellations": "$steps.cancellations"
        }
    }
}
