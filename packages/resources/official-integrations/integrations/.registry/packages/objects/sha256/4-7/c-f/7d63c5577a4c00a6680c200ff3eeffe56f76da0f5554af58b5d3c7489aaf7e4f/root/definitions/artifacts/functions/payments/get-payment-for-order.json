{
    "type": "function",
    "function": {
        "id": "getPaymentForOrder",
        "method": "GET",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Get payment for order",
            "description": "Verify order ownership and return the protected Stripe projection by immutable Commerce reference."
        },
        "input": {
            "params": {
                "orderId": {
                    "type": "number"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "orderId": {
                            "type": "number"
                        },
                        "orderPublicId": {
                            "type": "string"
                        },
                        "paymentExists": {
                            "type": "boolean"
                        },
                        "payment": {
                            "type": "object",
                            "properties": {
                                "paymentStatus": {
                                    "type": "string"
                                },
                                "settlementStatus": {
                                    "type": "string"
                                },
                                "disputeStatus": {
                                    "type": "string"
                                },
                                "reconciliationPending": {
                                    "type": "boolean"
                                },
                                "refundedAmount": {
                                    "type": "number"
                                },
                                "amountTotal": {
                                    "type": "number"
                                },
                                "currency": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "required": [
                        "orderId",
                        "orderPublicId",
                        "paymentExists"
                    ]
                }
            }
        ],
        "steps": [
            {
                "id": "order",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getPaymentOrderContext",
                    "params": {
                        "orderId": "$input.params.orderId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.order.buyerCmsUserId",
                            "$ctx.user.id"
                        ]
                    },
                    "failure": {
                        "status": 403,
                        "error": "Order does not belong to the current buyer"
                    }
                }
            },
            {
                "id": "paymentLookup",
                "call": {
                    "source": "{{dependencies.stripe.sourceId}}",
                    "endpoint": "getProtectedPaymentByClientReference",
                    "params": {
                        "clientReferenceId": "$steps.order.publicId"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "orderId": "$steps.order.id",
                "orderPublicId": "$steps.order.publicId",
                "paymentExists": "$steps.paymentLookup.exists",
                "payment": "$steps.paymentLookup.payment"
            }
        }
    }
}
