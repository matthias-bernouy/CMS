{
    "endpointId": "getProtectedPaymentByClientReference",
    "method": "GET",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/payments/reference",
    "params": [
        {
            "name": "clientReferenceId",
            "in": "query",
            "type": "string",
            "required": true
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "output": {
        "$include": "output/root.json"
    }
}
