{
  "type": "object",
  "properties": {
    "reference": { "type": "string" },
    "status": { "type": "string" },
    "title": { "type": "string", "nullable": true },
    "introduction": { "type": "string", "nullable": true },
    "publishedAt": { "type": "string" },
    "currency": { "type": "string" },
    "fixedTotalCents": { "type": "number" },
    "quoteItemCount": { "type": "number" },
    "salesContact": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "nullable": true }
      },
      "required": [
        "displayName"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$include": "item.json"
      }
    }
  },
  "required": [
    "reference",
    "status",
    "publishedAt",
    "currency",
    "fixedTotalCents",
    "quoteItemCount",
    "salesContact",
    "items"
  ]
