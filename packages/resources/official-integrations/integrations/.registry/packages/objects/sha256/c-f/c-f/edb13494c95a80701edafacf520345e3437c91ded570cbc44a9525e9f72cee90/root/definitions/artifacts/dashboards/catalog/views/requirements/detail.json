[
  {
    "widget": "w-detail",
    "id": "requirementDetail",
    "source": {
      "endpoint": "manageRequirements",
      "params": {
        "id": "$selection.id"
      },
      "itemPath": "item"
    },
    "title": { "path": "subjectName", "fallback": "New prerequisite" },
    "status": { "path": "requiredKind" },
    "actions": [
      {
        "id": "saveRequirement",
        "label": "Save prerequisite",
        "tone": "primary",
        "placement": "primary",
        "endpoint": {
          "endpoint": "upsertRequirement",
          "body": {
            "subjectItemId": "$field.subjectItemId",
            "requiredItemId": "$field.requiredItemId"
          }
        },
        "after": { "resource": "$result" }
      },
      {
        "id": "deleteRequirement",
        "label": "Delete prerequisite",
        "icon": "trash",
        "tone": "danger",
        "placement": "more",
        "confirm": "Delete this prerequisite?",
        "visibleWhen": { "value": "$resource.requiredItemId", "notEquals": null },
        "endpoint": {
          "endpoint": "deleteRequirement",
          "params": {
            "subjectItemId": "$resource.subjectItemId",
            "requiredItemId": "$resource.requiredItemId"
          }
        }
      }
    ],
    "main": [
      {
        "id": "requirementDefinition",
        "title": "All-of prerequisite",
        "description": "Choose the item to configure and the item it requires. The server rejects self-dependencies and cycles.",
        "fields": [
          {
            "id": "subjectItemId",
            "label": "Subject catalogue item",
            "path": "subjectItemId",
            "type": "combobox",
            "required": true,
            "lookup": {
              "endpoint": "manageCatalogItems",
              "params": { "q": "$search", "limit": "100" },
              "itemsPath": "items",
              "valuePath": "id",
              "labelPath": "name",
              "subtitlePath": "lookupSubtitle",
              "selected": "$resource.subject"
            }
          },
          {
            "id": "requiredItemId",
            "label": "Required catalogue item",
            "path": "requiredItemId",
            "type": "combobox",
            "required": true,
            "lookup": {
              "endpoint": "manageCatalogItems",
              "params": { "q": "$search", "limit": "100" },
              "itemsPath": "items",
              "valuePath": "id",
              "labelPath": "name",
              "subtitlePath": "lookupSubtitle",
              "selected": "$resource.required"
            }
          }
        ]
      }
    ]
  }
]
