[
    {
        "endpointId": "archiveAlbum",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-photo-albums/album/archive",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "number",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "number"
                }
            },
            "required": [
                "version"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "$include": "../../../schemas/album.json"
                }
            }
        ]
    },
    {
        "endpointId": "reorderAlbums",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-photo-albums/albums/reorder",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "albumIds": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            },
            "required": [
                "albumIds"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "albumIds": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        }
                    },
                    "required": [
                        "albumIds"
                    ]
                }
            }
        ]
    }
]
