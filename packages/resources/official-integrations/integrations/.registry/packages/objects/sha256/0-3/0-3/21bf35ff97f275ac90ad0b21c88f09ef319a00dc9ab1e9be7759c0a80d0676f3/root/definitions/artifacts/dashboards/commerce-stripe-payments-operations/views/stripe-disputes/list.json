[
    {
        "widget": "w-table",
        "id": "stripeDisputesTable",
        "title": "Card disputes",
        "source": {
            "sourceId": "{{dependencies.stripe.sourceId}}",
            "endpoint": "listStripeDisputes",
            "params": {
                "status": "$filter.status",
                "limit": "100"
            },
            "itemsPath": "disputes",
            "totalPath": "total"
        },
        "rowKey": "id",
        "filters": [
            {
                "id": "status",
                "label": "Status",
                "param": "status",
                "type": "text"
            }
        ],
        "columns": [
            {
                "id": "id",
                "label": "Stripe dispute",
                "path": "id",
                "primary": true
            },
            {
                "id": "clientReferenceId",
                "label": "Order",
                "path": "clientReferenceId"
            },
            {
                "id": "amount",
                "label": "Amount",
                "path": "amount",
                "format": "money"
            },
            {
                "id": "reason",
                "label": "Reason",
                "path": "reason",
                "format": "badge"
            },
            {
                "id": "status",
                "label": "Status",
                "path": "status",
                "format": "badge"
            },
            {
                "id": "fundsWithdrawn",
                "label": "Platform funds withdrawn",
                "path": "fundsWithdrawn",
                "format": "badge"
            },
            {
                "id": "evidenceDueBy",
                "label": "Evidence due",
                "path": "evidenceDueBy",
                "format": "date"
            }
        ],
        "selection": {
            "opens": "stripeDisputeDetail"
        }
    }
]
