[
    {
        "$include": "settings.json"
    },
    {
        "endpointId": "setting",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery-v2/settings",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "string",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "modeCollection": {
                            "type": "string",
                            "enum": [
                                "REL",
                                "CCC"
                            ]
                        },
                        "modeDelivery": {
                            "type": "string"
                        },
                        "customerReference": {
                            "type": "string"
                        },
                        "senderName": {
                            "type": "string"
                        },
                        "senderFirstName": {
                            "type": "string"
                        },
                        "senderLastName": {
                            "type": "string"
                        },
                        "senderAddressLine1": {
                            "type": "string"
                        },
                        "senderAddressLine2": {
                            "type": "string"
                        },
                        "senderAddressLine3": {
                            "type": "string"
                        },
                        "senderPostalCode": {
                            "type": "string"
                        },
                        "senderCity": {
                            "type": "string"
                        },
                        "senderCountry": {
                            "type": "string"
                        },
                        "senderPhone": {
                            "type": "string"
                        },
                        "senderMobile": {
                            "type": "string"
                        },
                        "senderEmail": {
                            "type": "string"
                        },
                        "defaultWeightGrams": {
                            "type": "number"
                        },
                        "defaultPackageCount": {
                            "type": "number"
                        },
                        "defaultLengthCm": {
                            "type": "number"
                        },
                        "defaultWidthCm": {
                            "type": "number"
                        },
                        "defaultHeightCm": {
                            "type": "number"
                        },
                        "defaultContent": {
                            "type": "string"
                        },
                        "defaultShippingAmount": {
                            "type": "number"
                        },
                        "declaredCurrency": {
                            "type": "string"
                        },
                        "connectCulture": {
                            "type": "string"
                        },
                        "connectVersionApi": {
                            "type": "string"
                        },
                        "connectOutputFormat": {
                            "type": "string"
                        },
                        "connectOutputType": {
                            "type": "string"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    }
]
