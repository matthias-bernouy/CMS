[
    {
        "id": "order",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "getPaymentOrderContext",
            "params": {
                "orderId": "$input.body.orderId"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.order.buyerCmsUserId",
                    "$ctx.user.id"
                ]
            },
            "failure": {
                "status": 403,
                "error": "Order does not belong to the current buyer"
            }
        }
    },
    {
        "id": "paymentLookup",
        "call": {
            "source": "{{dependencies.stripe.sourceId}}",
            "endpoint": "getProtectedPaymentByClientReference",
            "params": {
                "clientReferenceId": "$steps.order.publicId"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.paymentLookup.exists",
                    true
                ]
            },
            "failure": {
                "status": 404,
                "error": "Payment does not exist for this order"
            }
        }
    },
    {
        "id": "commercePayment",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "recordOrderPayment",
            "body": {
                "orderPublicId": "$steps.order.publicId",
                "providerEventId": {
                    "$concat": [
                        "payment-sync:",
                        "$steps.paymentLookup.payment.paymentId",
                        ":",
                        "$steps.paymentLookup.payment.updatedAt"
                    ]
                },
                "providerPaymentId": "$steps.paymentLookup.payment.paymentId",
                "status": "$steps.paymentLookup.payment.commercePaymentStatus",
                "amount": "$steps.paymentLookup.payment.amountTotal",
                "currency": "$steps.paymentLookup.payment.currency",
                "financialTermsHash": "$steps.paymentLookup.payment.financialTermsHash",
                "occurredAt": "$steps.paymentLookup.payment.updatedAt",
                "providerChargeId": "$steps.paymentLookup.payment.stripeChargeId",
                "providerPaymentIntentId": "$steps.paymentLookup.payment.stripePaymentIntentId",
                "providerSnapshot": "$steps.paymentLookup.payment"
            }
        }
    }
]
