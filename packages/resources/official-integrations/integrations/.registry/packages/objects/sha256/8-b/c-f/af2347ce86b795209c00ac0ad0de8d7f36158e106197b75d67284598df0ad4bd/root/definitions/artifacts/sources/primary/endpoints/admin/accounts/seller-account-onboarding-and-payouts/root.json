[
    {
        "$include": "configure-seller-payout-schedule/root.json"
    },
    {
        "endpointId": "createConnectOnboardingLinkForUser",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/accounts/account/onboarding",
        "params": [
            {
                "name": "userId",
                "in": "query",
                "type": "string",
                "semantic": {
                    "kind": "user-id",
                    "authority": "cms"
                },
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "displayName": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "returnUrl": {
                    "type": "string"
                },
                "refreshUrl": {
                    "type": "string"
                }
            },
            "required": [
                "returnUrl",
                "refreshUrl"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ]
    },
    {
        "endpointId": "createConnectOnboardingSessionForUser",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/accounts/account/onboarding/session",
        "params": [
            {
                "name": "userId",
                "in": "query",
                "type": "string",
                "semantic": {
                    "kind": "user-id",
                    "authority": "cms"
                },
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "displayName": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ]
    }
]
