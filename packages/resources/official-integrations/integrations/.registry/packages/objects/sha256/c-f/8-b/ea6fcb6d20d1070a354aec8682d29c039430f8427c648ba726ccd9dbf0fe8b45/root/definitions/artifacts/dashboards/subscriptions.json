{
    "type": "dashboard",
    "dashboard": {
        "id": "{{answers.id}}-subscriptions",
        "meta": {
            "name": "Newsletter",
            "icon": "mail"
        },
        "source": "{{answers.id}}",
        "views": [
            {
                "widget": "w-table",
                "id": "subscriptionsTable",
                "title": "Subscriptions",
                "source": {
                    "endpoint": "listSubscriptions",
                    "params": {
                        "q": "$filter.q",
                        "subscribed": "$filter.subscribed",
                        "limit": "100"
                    },
                    "itemsPath": "subscriptions",
                    "totalPath": "total"
                },
                "rowKey": "email",
                "filters": [
                    {
                        "id": "q",
                        "param": "q",
                        "type": "text",
                        "label": "Search",
                        "placeholder": "Search emails"
                    },
                    {
                        "id": "subscribed",
                        "param": "subscribed",
                        "type": "select",
                        "label": "Status",
                        "options": [
                            {
                                "value": "true",
                                "label": "Subscribed"
                            },
                            {
                                "value": "false",
                                "label": "Unsubscribed"
                            }
                        ]
                    }
                ],
                "columns": [
                    {
                        "id": "email",
                        "label": "Email",
                        "path": "email",
                        "primary": true
                    },
                    {
                        "id": "subscribed",
                        "label": "Subscribed",
                        "path": "subscribed",
                        "format": "badge"
                    },
                    {
                        "id": "createdAt",
                        "label": "Created",
                        "path": "createdAt",
                        "format": "date"
                    },
                    {
                        "id": "updatedAt",
                        "label": "Updated",
                        "path": "updatedAt",
                        "format": "date"
                    }
                ],
                "actions": [
                    {
                        "id": "exportSubscriptions",
                        "label": "Export CSV",
                        "icon": "download",
                        "tone": "secondary",
                        "placement": "primary",
                        "endpoint": {
                            "endpoint": "exportSubscriptions",
                            "params": {
                                "q": "$filter.q",
                                "subscribed": "$filter.subscribed"
                            }
                        },
                        "download": {
                            "filename": "newsletter-subscriptions.csv"
                        }
                    }
                ]
            }
        ]
    }
}
