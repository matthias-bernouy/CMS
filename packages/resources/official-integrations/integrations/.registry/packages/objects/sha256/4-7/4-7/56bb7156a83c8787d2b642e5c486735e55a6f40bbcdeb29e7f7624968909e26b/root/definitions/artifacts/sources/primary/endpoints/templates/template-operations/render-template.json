{
    "endpointId": "renderTemplate",
    "method": "POST",
    "access": "admin",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-emailer/template/render",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "key": {
                "type": "string"
            },
            "data": {
                "type": "object"
            },
            "sampleDataJson": {
                "type": "string"
            }
        },
        "required": [
            "key"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "htmlBody": {
                        "type": "string"
                    },
                    "textBody": {
                        "type": "string"
                    }
                }
            }
        }
    ]
}
