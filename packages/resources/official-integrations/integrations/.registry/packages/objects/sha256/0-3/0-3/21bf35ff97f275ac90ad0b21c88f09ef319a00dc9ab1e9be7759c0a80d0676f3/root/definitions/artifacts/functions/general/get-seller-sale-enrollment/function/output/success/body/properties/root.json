{
    "connect": {
        "$include": "connect.json"
    },
    "seller": {
        "type": "object",
        "properties": {
            "exists": {
                "type": "boolean"
            },
            "id": {
                "type": "number"
            },
            "cmsUserId": {
                "type": "string",
                "semantic": {
                    "kind": "user-id",
                    "authority": "cms"
                }
            },
            "verificationStatus": {
                "type": "string"
            },
            "version": {
                "type": "number"
            }
        },
        "required": [
