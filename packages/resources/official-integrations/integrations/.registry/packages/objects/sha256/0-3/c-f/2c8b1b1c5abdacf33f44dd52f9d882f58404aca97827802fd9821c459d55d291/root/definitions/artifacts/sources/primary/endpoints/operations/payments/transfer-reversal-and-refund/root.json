[
    {
        "endpointId": "requestTransferReversal",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/operations/reversal",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "paymentId": {
                    "type": "number"
                },
                "reversalRequestId": {
                    "type": "string"
                },
                "amount": {
                    "type": "number"
                },
                "reason": {
                    "type": "string"
                }
            },
            "required": [
                "paymentId",
                "reversalRequestId",
                "amount"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "recoveryId": {
                            "type": "number"
                        },
                        "paymentId": {
                            "type": "number"
                        },
                        "recoveryRequestId": {
                            "type": "string"
                        },
                        "exposureType": {
                            "type": "string"
                        },
                        "requestedAmount": {
                            "type": "number"
                        },
                        "allocatedAmount": {
                            "type": "number"
                        },
                        "confirmedAmount": {
                            "type": "number"
                        },
                        "allocationShortfallAmount": {
                            "type": "number"
                        },
                        "currency": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string"
                        },
                        "reversals": {
                            "type": "array",
                            "items": {
                                "type": "object"
                            }
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "recoveryId",
                        "paymentId",
                        "recoveryRequestId",
                        "requestedAmount",
                        "allocatedAmount",
                        "confirmedAmount",
                        "allocationShortfallAmount",
                        "currency",
                        "status",
                        "reversals"
                    ]
                }
            },
            {
                "status": "400",
                "body": {
                    "type": "object"
                }
            },
            {
                "status": "404",
                "body": {
                    "type": "object"
                }
            },
            {
                "status": "409",
                "body": {
                    "type": "object"
                }
            }
        ]
    },
    {
        "$include": "request-protected-refund.json"
    }
]
