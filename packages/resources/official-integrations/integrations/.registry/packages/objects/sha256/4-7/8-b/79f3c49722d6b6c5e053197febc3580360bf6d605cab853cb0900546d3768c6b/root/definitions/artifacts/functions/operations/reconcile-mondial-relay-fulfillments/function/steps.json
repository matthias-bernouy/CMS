[
    {
        "id": "deliveryBatch",
        "call": {
            "source": "{{dependencies.delivery.sourceId}}",
            "endpoint": "reconcileShipments",
            "body": {
                "runKey": "$input.body.runKey",
                "limit": 8
            }
        }
    },
    {
        "id": "commerceEvents",
        "forEach": {
            "items": "$steps.deliveryBatch.events",
            "max": 8,
            "continueOnError": true,
            "steps": [
                {
                    "id": "record",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "recordOrderFulfillment",
                        "body": {
                            "orderPublicId": "$item.orderPublicId",
                            "providerEventId": "$item.providerEventId",
                            "normalizedStatus": "$item.normalizedStatus",
                            "occurredAt": "$item.occurredAt",
                            "providerReference": "$item.providerReference",
                            "recipientHandoffAt": "$item.recipientHandoffAt",
                            "carrierAcceptedAt": "$item.carrierAcceptedAt"
                        }
                    }
                },
                {
                    "id": "acknowledge",
                    "call": {
                        "source": "{{dependencies.delivery.sourceId}}",
                        "endpoint": "acknowledgeShipmentEvent",
                        "body": {
                            "eventId": "$item.eventId",
                            "claimToken": "$item.claimToken"
                        }
                    }
                }
            ],
            "yield": "$steps.record",
            "onError": [
                {
                    "id": "failOrderProjection",
                    "call": {
                        "source": "{{dependencies.delivery.sourceId}}",
                        "endpoint": "failShipmentEventProjection",
                        "body": {
                            "eventId": "$item.eventId",
                            "claimToken": "$item.claimToken",
                            "error": "Commerce order fulfillment projection failed"
                        }
                    }
                }
            ],
            "errorYield": {
                "eventId": "$item.eventId",
                "providerEventId": "$item.providerEventId",
                "projectionFailed": true,
                "failure": "$steps.failOrderProjection"
            }
        }
    },
    {
        "id": "commerceClaimReturnEvents",
        "forEach": {
            "items": "$steps.deliveryBatch.claimReturnEvents",
            "max": 8,
            "continueOnError": true,
            "steps": [
                {
                    "id": "recordClaimReturn",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "recordClaimReturnDelivery",
                        "body": {
                            "claimId": "$item.claimId",
                            "providerEventId": "$item.providerEventId",
                            "providerReference": "$item.providerReference",
                            "normalizedStatus": "$item.normalizedStatus",
                            "occurredAt": "$item.occurredAt",
                            "providerEvidence": "$item.providerEvidence"
                        }
                    }
                },
                {
                    "id": "acknowledgeClaimReturn",
                    "call": {
                        "source": "{{dependencies.delivery.sourceId}}",
                        "endpoint": "acknowledgeShipmentEvent",
                        "body": {
                            "eventId": "$item.eventId",
                            "claimToken": "$item.claimToken"
                        }
                    }
                }
            ],
            "yield": "$steps.recordClaimReturn",
            "onError": [
                {
                    "id": "failClaimReturnProjection",
                    "call": {
                        "source": "{{dependencies.delivery.sourceId}}",
                        "endpoint": "failShipmentEventProjection",
                        "body": {
                            "eventId": "$item.eventId",
                            "claimToken": "$item.claimToken",
                            "error": "Commerce claim return projection failed"
                        }
                    }
                }
            ],
            "errorYield": {
                "eventId": "$item.eventId",
                "providerEventId": "$item.providerEventId",
                "projectionFailed": true,
                "failure": "$steps.failClaimReturnProjection"
            }
        }
    }
]
