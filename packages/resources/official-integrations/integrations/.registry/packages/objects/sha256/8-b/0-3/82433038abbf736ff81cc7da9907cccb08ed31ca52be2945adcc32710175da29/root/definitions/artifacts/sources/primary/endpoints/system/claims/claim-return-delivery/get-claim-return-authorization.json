{
    "endpointId": "getClaimReturnAuthorization",
    "method": "GET",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/claim/return-authorization",
    "params": [
        {
            "name": "claimId",
            "in": "query",
            "type": "number",
            "required": true
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "allowed": {
                        "type": "boolean"
                    },
                    "reason": {
                        "type": "string"
                    },
                    "claimId": {
                        "type": "number"
                    },
                    "claimPublicId": {
                        "type": "string"
                    },
                    "claimStatus": {
                        "type": "string"
                    },
                    "claimVersion": {
                        "type": "number"
                    },
                    "returnShipByAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "returnDeliveryStatus": {
                        "type": "string",
                        "nullable": true
                    },
                    "orderId": {
                        "type": "number"
                    },
                    "orderPublicId": {
                        "type": "string"
                    },
                    "orderNumber": {
                        "type": "string"
                    },
                    "buyerCmsUserId": {
                        "type": "string",
                        "semantic": {
                            "kind": "user-id",
                            "authority": "cms"
                        }
                    },
                    "sellerId": {
                        "type": "number"
                    },
                    "sellerCmsUserId": {
                        "type": "string",
                        "semantic": {
                            "kind": "user-id",
                            "authority": "cms"
                        }
                    },
                    "deliveryQuoteId": {
                        "type": "string"
                    },
                    "merchandiseSubtotalMinorAmount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    }
                },
                "required": [
                    "allowed",
                    "reason",
                    "claimId",
                    "claimStatus",
                    "claimVersion",
                    "orderId",
                    "orderPublicId",
                    "buyerCmsUserId",
                    "sellerId",
                    "sellerCmsUserId"
                ]
            }
        }
    ]
}
