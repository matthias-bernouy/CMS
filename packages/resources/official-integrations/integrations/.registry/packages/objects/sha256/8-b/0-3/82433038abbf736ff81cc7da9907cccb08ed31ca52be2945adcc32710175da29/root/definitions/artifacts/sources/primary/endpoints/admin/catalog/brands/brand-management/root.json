[
    {
        "$include": "manage-brands.json"
    },
    {
        "endpointId": "manageBrand",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/brand",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number",
                            "nullable": true
                        },
                        "slug": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "description": {
                            "type": "string",
                            "nullable": true
                        },
                        "status": {
                            "type": "string"
                        },
                        "metadata": {
                            "type": "object"
                        },
                        "version": {
                            "type": "number"
                        }
                    }
                }
            }
        ]
    },
    {
        "$include": "upsert-brand.json"
    },
    {
        "endpointId": "deleteBrand",
        "method": "DELETE",
        "effects": {
            "invalidatesSchema": true
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/brand",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "number",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "deleted": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "id",
                        "deleted"
                    ]
                }
            }
        ]
    }
]
