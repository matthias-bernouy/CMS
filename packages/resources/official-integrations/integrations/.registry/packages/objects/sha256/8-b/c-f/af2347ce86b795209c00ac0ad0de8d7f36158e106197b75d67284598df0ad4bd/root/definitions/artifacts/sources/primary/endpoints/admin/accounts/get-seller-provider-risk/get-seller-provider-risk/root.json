{
    "endpointId": "getSellerProviderRisk",
    "method": "GET",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/accounts/account/risk",
    "params": [
        {
            "name": "userId",
            "in": "query",
            "type": "string",
            "semantic": {
                "kind": "user-id",
                "authority": "cms"
            },
            "required": true
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "output": {
        "$include": "output.json"
    }
}
