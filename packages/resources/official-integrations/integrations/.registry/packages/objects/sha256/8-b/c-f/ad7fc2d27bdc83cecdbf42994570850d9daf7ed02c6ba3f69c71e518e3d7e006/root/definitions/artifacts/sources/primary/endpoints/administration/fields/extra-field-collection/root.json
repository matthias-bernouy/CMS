[
    {
        "endpointId": "listExtraFields",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-user-account/personal-information/extra-fields",
        "meta": {
            "name": "List personal information fields",
            "description": "List configured extra personal information fields."
        },
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "label": {
                                        "type": "string"
                                    },
                                    "type": {
                                        "type": "string"
                                    },
                                    "required": {
                                        "type": "boolean"
                                    },
                                    "multiple": {
                                        "type": "boolean"
                                    },
                                    "showInDashboardTable": {
                                        "type": "boolean"
                                    },
                                    "options": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "value": {
                                                    "type": "string"
                                                },
                                                "label": {
                                                    "type": "string"
                                                },
                                                "position": {
                                                    "type": "number"
                                                }
                                            },
                                            "required": [
                                                "value",
                                                "label"
                                            ]
                                        }
                                    }
                                },
                                "required": [
                                    "id",
                                    "label",
                                    "type"
                                ]
                            }
                        }
                    },
                    "required": [
                        "fields"
                    ]
                }
            }
        ]
    },
    {
        "$include": "create-extra-field.json"
    }
]
