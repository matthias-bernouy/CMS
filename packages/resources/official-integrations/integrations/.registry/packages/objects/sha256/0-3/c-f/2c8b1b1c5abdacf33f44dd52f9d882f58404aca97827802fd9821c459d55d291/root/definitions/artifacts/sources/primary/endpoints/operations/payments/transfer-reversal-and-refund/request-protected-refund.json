{
    "endpointId": "requestProtectedRefund",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/operations/protected-refund",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "paymentId": {
                "type": "number"
            },
            "refundRequestId": {
                "type": "string"
            },
            "commerceRefundRequestId": {
                "type": "number"
            },
            "amount": {
                "type": "number"
            },
            "authorizedSellerAmount": {
                "type": "number"
            },
            "sellerEntitlementReductionAmount": {
                "type": "number"
            },
            "reason": {
                "type": "string"
            }
        },
        "required": [
            "paymentId",
            "refundRequestId",
            "amount",
            "authorizedSellerAmount",
            "sellerEntitlementReductionAmount"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "payment": {
                        "type": "object"
                    },
                    "reversal": {
                        "type": "object",
                        "nullable": true
                    },
                    "refund": {
                        "type": "object"
                    },
                    "operations": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "providerEventId": {
                                    "type": "string"
                                },
                                "providerOperationId": {
                                    "type": "number"
                                },
                                "operationType": {
                                    "type": "string"
                                },
                                "providerOperationObjectId": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                },
                                "amount": {
                                    "type": "number"
                                },
                                "currency": {
                                    "type": "string"
                                },
                                "occurredAt": {
                                    "type": "string"
                                },
                                "refundRequestId": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "commerceRefundRequestId": {
                                    "type": "number",
                                    "nullable": true
                                },
                                "providerSnapshot": {
                                    "type": "object"
                                }
                            },
                            "required": [
                                "providerEventId",
                                "providerOperationId",
                                "operationType",
                                "status",
                                "amount",
                                "currency",
                                "occurredAt"
                            ]
                        }
                    }
                },
                "required": [
                    "payment",
                    "refund",
                    "operations"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "404",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object"
            }
        }
    ]
}
