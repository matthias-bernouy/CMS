[
  {
    "id": "grantClientsManage",
    "label": "Grant client management",
    "tone": "secondary",
    "placement": "more",
    "visibleWhen": { "value": "$resource.id", "notEquals": null },
    "endpoint": {
      "endpoint": "setPartnerCapability",
      "params": { "partnerId": "$resource.id" },
      "body": { "capability": "clients.manage", "enabled": "true" }
    },
    "after": { "resource": "$result" }
  },
  {
    "id": "revokeClientsManage",
    "label": "Revoke client management",
    "tone": "danger",
    "placement": "more",
    "visibleWhen": { "value": "$resource.id", "notEquals": null },
    "endpoint": {
      "endpoint": "setPartnerCapability",
      "params": { "partnerId": "$resource.id" },
      "body": { "capability": "clients.manage", "enabled": "false" }
    },
    "after": { "resource": "$result" }
  }
]
