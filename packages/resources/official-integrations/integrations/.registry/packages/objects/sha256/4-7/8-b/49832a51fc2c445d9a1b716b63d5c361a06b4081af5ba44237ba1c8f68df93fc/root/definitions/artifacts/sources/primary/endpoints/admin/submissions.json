[
    {
        "endpointId": "manageSubmissions",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/submissions",
        "params": [
            { "name": "key", "in": "query", "type": "string" },
            { "name": "status", "in": "query", "type": "string" },
            { "name": "limit", "in": "query", "type": "number" },
            { "name": "offset", "in": "query", "type": "number" }
        ],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/submission-list.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "manageSubmission",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/submission",
        "params": [{ "name": "id", "in": "query", "type": "number", "required": true }],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/builder/submission-detail.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "updateSubmission",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/submission/status",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": {
            "type": "object",
            "properties": { "id": { "type": "number" }, "status": { "type": "string" } },
            "required": ["id", "status"]
        },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/builder/submission-detail.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    }
]
