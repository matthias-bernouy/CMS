[
    {
        "assert": {
            "condition": {
                "in": [
                    "$input.body.status",
                    [
                        "approved",
                        "provider_operation_reserved",
                        "processing"
                    ]
                ]
            },
            "failure": {
                "status": 409,
                "error": "Refund is not fully authorized"
            }
        }
    },
    {
        "id": "providerRefund",
        "call": {
            "source": "{{dependencies.stripe.sourceId}}",
            "endpoint": "requestProtectedRefund",
            "body": {
                "paymentId": "$input.body.providerPaymentId",
                "refundRequestId": "$input.body.refundRequestId",
                "commerceRefundRequestId": "$input.body.commerceRefundRequestId",
                "amount": "$input.body.amount",
                "authorizedSellerAmount": "$input.body.authorizedSellerAmount",
                "sellerEntitlementReductionAmount": "$input.body.sellerEntitlementReductionAmount",
                "reason": "Commerce authorized refund"
            }
        }
    },
    {
        "id": "commerceOperations",
        "forEach": {
            "items": "$steps.providerRefund.operations",
            "max": 24,
            "steps": [
                {
                    "id": "commerceOperation",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "recordOrderSettlement",
                        "body": {
                            "orderPublicId": "$input.body.orderPublicId",
                            "providerEventId": {
                                "$concat": [
                                    "provider-operation:",
                                    "$item.providerOperationId",
                                    ":",
                                    "$item.status",
                                    ":",
                                    "$item.occurredAt"
                                ]
                            },
                            "operationType": "$item.operationType",
                            "providerOperationId": "$item.providerOperationId",
                            "status": "$item.status",
                            "amount": "$item.amount",
                            "currency": "$item.currency",
                            "occurredAt": "$item.occurredAt",
                            "refundRequestId": "$input.body.refundRequestId",
                            "commerceRefundRequestId": "$input.body.commerceRefundRequestId",
                            "providerSnapshot": "$item.providerSnapshot"
                        }
                    }
                }
            ],
            "yield": "$steps.commerceOperation"
        }
    }
]
