{
    "widget": "w-detail",
    "id": "proposalDetail",
    "source": {
        "endpoint": "manageProposal",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "offerTitle",
        "fallback": "Price proposal"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "cancelProposal",
            "label": "Cancel proposal",
            "tone": "danger",
            "placement": "more",
            "confirm": "Cancel this proposal?",
            "visibleWhen": {
                "any": [
                    {
                        "value": "$field.status",
                        "equals": "pending"
                    },
                    {
                        "value": "$field.status",
                        "equals": "accepted"
                    }
                ]
            },
            "endpoint": {
                "endpoint": "cancelProposal",
                "body": {
                    "id": "$resource.id",
                    "expectedVersion": "$resource.version",
                    "reason": "$field.cancellationReason"
                }
            },
            "after": {
                "resource": "$result"
            }
        }
    ],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "proposalParties",
            "title": "Parties",
            "fields": [
                {
                    "id": "sellerDisplayName",
                    "label": "Seller",
                    "path": "sellerDisplayName",
                    "type": "readonly"
                },
                {
                    "id": "sellerUserId",
                    "label": "Seller user",
                    "path": "sellerUserId",
                    "type": "readonly"
                },
                {
                    "id": "buyerUserId",
                    "label": "Buyer user",
                    "path": "buyerUserId",
                    "type": "readonly"
                },
                {
                    "id": "status",
                    "label": "Status",
                    "path": "status",
                    "type": "readonly",
                    "format": "badge"
                },
                {
                    "id": "expiresAt",
                    "label": "Expires",
                    "path": "expiresAt",
                    "type": "readonly",
                    "format": "date"
                }
            ]
        }
    ]
}
