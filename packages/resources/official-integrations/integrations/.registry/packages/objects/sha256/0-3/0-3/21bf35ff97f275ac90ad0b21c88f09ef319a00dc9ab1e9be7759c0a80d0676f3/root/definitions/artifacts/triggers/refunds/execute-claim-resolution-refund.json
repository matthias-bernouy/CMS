{
    "type": "trigger",
    "trigger": {
        "id": "execute-claim-resolution-refund",
        "label": "Execute claim resolution refund",
        "event": {
            "kind": "endpoint",
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "resolveOrderClaim",
            "phase": "response"
        },
        "mode": "async",
        "failureMode": "ignore",
        "condition": {
            "all": [
                {
                    "equals": [
                        "$response.status",
                        200
                    ]
                },
                {
                    "equals": [
                        "$response.body.refundAuthorization.status",
                        "approved"
                    ]
                }
            ]
        },
        "function": {
            "id": "executeAuthorizedRefund",
            "body": "$response.body.refundAuthorization"
        }
    }
}
