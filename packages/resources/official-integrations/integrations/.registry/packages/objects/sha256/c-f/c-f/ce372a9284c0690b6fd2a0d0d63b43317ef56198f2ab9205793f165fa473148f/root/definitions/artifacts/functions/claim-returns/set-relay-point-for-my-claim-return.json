{
    "type": "function",
    "function": {
        "id": "setRelayPointForMyClaimReturn",
        "method": "POST",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Set relay point for my claim return",
            "description": "Let only the claim seller select the server-validated relay that will receive the return."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "claimId": {
                        "type": "number"
                    },
                    "relayLocation": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    }
                },
                "required": [
                    "claimId",
                    "relayLocation",
                    "country",
                    "postalCode"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "authorization",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getClaimReturnAuthorization",
                    "params": {
                        "claimId": "$input.body.claimId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.authorization.sellerCmsUserId",
                            "$ctx.user.id"
                        ]
                    },
                    "failure": {
                        "status": 403,
                        "error": "Only the claim seller can select the return relay"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.authorization.allowed",
                            true
                        ]
                    },
                    "failure": {
                        "status": 409,
                        "error": "Commerce has not authorized this claim return"
                    }
                }
            },
            {
                "id": "selection",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "saveClaimReturnRelaySelection",
                    "body": {
                        "externalOrderId": {
                            "$concat": [
                                "claim-return:",
                                "$steps.authorization.claimId"
                            ]
                        },
                        "relayLocation": "$input.body.relayLocation",
                        "country": "$input.body.country",
                        "postalCode": "$input.body.postalCode",
                        "city": "$input.body.city"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "selection": "$steps.selection"
            }
        }
    }
}
