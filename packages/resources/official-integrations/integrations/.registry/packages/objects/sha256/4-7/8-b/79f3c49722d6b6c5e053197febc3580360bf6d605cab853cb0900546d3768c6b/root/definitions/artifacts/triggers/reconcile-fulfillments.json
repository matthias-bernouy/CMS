{
    "type": "trigger",
    "trigger": {
        "id": "schedule-reconcile-mondial-relay-fulfillments",
        "label": "Reconcile Mondial Relay fulfillments",
        "critical": true,
        "event": {
            "kind": "schedule",
            "intervalMs": 300000,
            "initialDelayMs": 50000,
            "timeoutMs": 120000
        },
        "mode": "async",
        "failureMode": "ignore",
        "function": {
            "id": "reconcileMondialRelayFulfillments",
            "body": {
                "runKey": "$schedule.runKey",
                "limit": 8
            }
        }
    }
}
