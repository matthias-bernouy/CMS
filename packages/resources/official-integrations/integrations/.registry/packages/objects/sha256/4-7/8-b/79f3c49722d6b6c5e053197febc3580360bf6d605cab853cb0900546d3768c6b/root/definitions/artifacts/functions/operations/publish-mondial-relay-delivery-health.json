{
    "type": "function",
    "function": {
        "id": "publishMondialRelayDeliveryHealth",
        "method": "POST",
        "access": {
            "mode": "system"
        },
        "meta": {
            "name": "Publish Mondial Relay Delivery health",
            "description": "Publish a global worker heartbeat and isolated order shipment watermarks without freezing unrelated settlements."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "runKey": {
                        "type": "string"
                    },
                    "limit": {
                        "type": "number"
                    }
                },
                "required": [
                    "runKey",
                    "limit"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "projectionHealth",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "deliveryProjectionHealth"
                }
            },
            {
                "id": "globalHealth",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "recordDeliveryReconciliationHealth",
                    "body": {
                        "runKey": "$input.body.runKey",
                        "checkedAt": "$steps.projectionHealth.checkedAt",
                        "pendingProjectionCount": "$steps.projectionHealth.pendingProjectionCount",
                        "manualReviewCount": "$steps.projectionHealth.manualReviewCount",
                        "trackingErrorCount": "$steps.projectionHealth.trackingErrorCount"
                    }
                }
            },
            {
                "id": "orders",
                "forEach": {
                    "items": "$steps.projectionHealth.orders",
                    "max": 24,
                    "steps": [
                        {
                            "id": "orderHealth",
                            "call": {
                                "source": "{{dependencies.commerce.sourceId}}",
                                "endpoint": "recordDeliveryOrderReconciliationHealth",
                                "body": {
                                    "runKey": "$input.body.runKey",
                                    "checkedAt": "$steps.projectionHealth.checkedAt",
                                    "orderPublicId": "$item.externalOrderId",
                                    "shipmentId": "$item.shipmentId",
                                    "providerReference": "$item.providerReference",
                                    "shipmentStatus": "$item.shipmentStatus",
                                    "pendingProjectionCount": "$item.pendingProjectionCount",
                                    "manualReviewCount": "$item.manualReviewCount",
                                    "trackingErrorCount": "$item.trackingErrorCount",
                                    "trackingCheckedAt": "$item.trackingCheckedAt"
                                }
                            }
                        }
                    ],
                    "yield": "$steps.orderHealth"
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "global": "$steps.globalHealth",
                "orders": "$steps.orders"
            }
        }
    }
}
