{
  "type": "dashboard-view",
  "view": {
        "id": "ban-addresses",
        "meta": {
            "name": "Address search",
            "icon": "map-pin"
        },
        "source": "ban",
        "views": [
            {
                "widget": "w-table",
                "id": "addressesTable",
                "source": {
                    "endpoint": "search",
                    "params": {
                        "q": "$filter.q"
                    },
                    "itemsPath": "features"
                },
                "rowKey": "properties.label",
                "filters": [
                    {
                        "id": "q",
                        "param": "q",
                        "type": "text",
                        "label": "Search",
                        "placeholder": "Search addresses"
                    }
                ],
                "columns": [
                    {
                        "id": "address",
                        "path": "properties.label",
                        "label": "Address",
                        "primary": true
                    },
                    {
                        "id": "city",
                        "path": "properties.city",
                        "label": "City"
                    },
                    {
                        "id": "postcode",
                        "path": "properties.postcode",
                        "label": "Postcode"
                    },
                    {
                        "id": "score",
                        "path": "properties.score",
                        "label": "Score"
                    }
                ]
            }
        ]
    }
}
