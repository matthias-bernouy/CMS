{
    "endpointId": "shipment",
    "method": "GET",
    "access": "admin",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery/shipment",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "string"
        },
        {
            "name": "expeditionNumber",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": {
        "$include": "output/root.json"
    }
}
