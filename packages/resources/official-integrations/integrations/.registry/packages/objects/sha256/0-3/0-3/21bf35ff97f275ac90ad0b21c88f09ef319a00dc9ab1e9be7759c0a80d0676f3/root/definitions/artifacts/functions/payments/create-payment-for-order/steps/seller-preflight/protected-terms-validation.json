[
    {
        "id": "terms",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "prepareProtectedPayment",
            "body": {
                "orderId": "$input.body.orderId",
                "paymentProvider": "stripe",
                "acceptedLegalDocumentVersionIds": "$input.body.acceptedLegalDocumentVersionIds"
            },
            "onError": {
                "propagate": [
                    {
                        "sourceStatus": 409,
                        "status": 409
                    },
                    {
                        "sourceStatus": 422,
                        "status": 422
                    }
                ]
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.terms.protectionRequired",
                    true
                ]
            },
            "failure": {
                "status": 409,
                "error": "Protected settlement is required for this order"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.terms.currency",
                    "EUR"
                ]
            },
            "failure": {
                "status": 409,
                "error": "Protected C2C payments currently support EUR only"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "gt": [
                    "$steps.terms.buyerTotalAmount",
                    0
                ]
            },
            "failure": {
                "status": 409,
                "error": "Order total must be positive"
            }
        }
    }
]
