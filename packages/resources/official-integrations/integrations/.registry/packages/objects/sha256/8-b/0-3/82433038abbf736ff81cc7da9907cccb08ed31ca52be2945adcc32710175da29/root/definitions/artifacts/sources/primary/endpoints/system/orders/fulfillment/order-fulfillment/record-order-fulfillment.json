{
    "endpointId": "recordOrderFulfillment",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/fulfillment",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "orderPublicId": {
                "type": "string"
            },
            "providerEventId": {
                "type": "string"
            },
            "normalizedStatus": {
                "type": "string"
            },
            "occurredAt": {
                "type": "string"
            },
            "providerReference": {
                "type": "string"
            },
            "recipientHandoffAt": {
                "type": "string"
            },
            "carrierAcceptedAt": {
                "type": "string"
            },
            "sellerHandoffDeclaredAt": {
                "type": "string"
            }
        },
        "required": [
            "orderPublicId",
            "providerEventId",
            "normalizedStatus",
            "occurredAt"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "orderId": {
                        "type": "number"
                    },
                    "orderPublicId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "providerReference": {
                        "type": "string",
                        "nullable": true
                    },
                    "carrierAcceptedAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "sellerHandoffDeclaredAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "recipientHandoffAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "recipientHandoffFirstObservedAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "claimWindowStartedAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "claimByAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "releaseEligibleAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "blockingReason": {
                        "type": "string",
                        "nullable": true
                    },
                    "version": {
                        "type": "number"
                    }
                }
            }
        }
    ]
}
