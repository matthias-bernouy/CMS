{
    "endpointId": "submitStripeDisputeEvidence",
    "method": "POST",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/disputes/evidence/submit",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "disputeId": {
                "type": "string"
            },
            "submissionOperationId": {
                "type": "string"
            },
            "evidenceOperationId": {
                "type": "string"
            },
            "confirmation": {
                "type": "string"
            }
        },
        "required": [
            "disputeId",
            "submissionOperationId",
            "evidenceOperationId",
            "confirmation"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "disputeId": {
                        "type": "string"
                    },
                    "evidenceStatus": {
                        "type": "string"
                    },
                    "operationId": {
                        "type": "number"
                    },
                    "approvalStatus": {
                        "type": "string"
                    },
                    "dualApprovalRequired": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "disputeId",
                    "evidenceStatus",
                    "operationId"
                ]
            }
        },
        {
            "status": "202",
            "body": {
                "type": "object",
                "properties": {
                    "disputeId": {
                        "type": "string"
                    },
                    "evidenceStatus": {
                        "type": "string"
                    },
                    "approvalStatus": {
                        "type": "string"
                    },
                    "dualApprovalRequired": {
                        "type": "boolean"
                    },
                    "firstApprovedBy": {
                        "type": "string"
                    }
                },
                "required": [
                    "disputeId",
                    "evidenceStatus",
                    "approvalStatus",
                    "dualApprovalRequired",
                    "firstApprovedBy"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "403",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "404",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object"
            }
        }
    ]
}
