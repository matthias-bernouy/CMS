    },
    "after": { "resource": "$result" }
  },
  {
    "id": "revokeProposalsPublish",
    "label": "Revoke proposal publication",
    "tone": "danger",
    "placement": "more",
    "visibleWhen": { "value": "$resource.id", "notEquals": null },
    "endpoint": {
      "endpoint": "setPartnerCapability",
      "params": { "partnerId": "$resource.id" },
      "body": { "capability": "proposals.publish", "enabled": "false" }
    },
    "after": { "resource": "$result" }
  },
  {
