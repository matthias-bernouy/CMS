[
  {
    "id": "grantProposalsManage",
    "label": "Grant proposal management",
    "tone": "secondary",
    "placement": "more",
    "visibleWhen": { "value": "$resource.id", "notEquals": null },
    "endpoint": {
      "endpoint": "setPartnerCapability",
      "params": { "partnerId": "$resource.id" },
      "body": { "capability": "proposals.manage", "enabled": "true" }
    },
    "after": { "resource": "$result" }
  },
  {
    "id": "revokeProposalsManage",
    "label": "Revoke proposal management",
    "tone": "danger",
    "placement": "more",
    "visibleWhen": { "value": "$resource.id", "notEquals": null },
    "endpoint": {
      "endpoint": "setPartnerCapability",
      "params": { "partnerId": "$resource.id" },
      "body": { "capability": "proposals.manage", "enabled": "false" }
    },
    "after": { "resource": "$result" }
  },
  {
