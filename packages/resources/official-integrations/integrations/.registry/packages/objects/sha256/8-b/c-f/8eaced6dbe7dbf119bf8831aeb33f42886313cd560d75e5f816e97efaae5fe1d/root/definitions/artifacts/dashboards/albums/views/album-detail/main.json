[
    {
        "id": "albumDetails",
        "title": "Album details",
        "fields": [
            {
                "id": "title",
                "label": "Title",
                "path": "title",
                "type": "text",
                "required": true
            },
            {
                "id": "slug",
                "label": "Slug",
                "path": "slug",
                "type": "text",
                "required": true
            },
            {
                "id": "description",
                "label": "Description",
                "path": "description",
                "type": "textarea",
                "rows": 5
            }
        ]
    },
    {
        "id": "albumPhotos",
        "title": "Photos",
        "description": "The first photo is the album cover. Drag photos to change their order.",
        "fields": [
            {
                "id": "photos",
                "label": "Album photos",
                "path": "photos",
                "type": "media",
                "multiple": true,
                "visibleWhen": {
                    "value": "$field.id",
                    "notEquals": ""
                },
                "item": {
                    "idPath": "id",
                    "urlPath": "url",
                    "altPath": "alt"
                },
                "actions": {
                    "upload": {
                        "endpoint": "uploadPhoto",
                        "params": {
                            "albumId": "$resource.id"
                        }
                    },
                    "replace": {
                        "endpoint": "replacePhoto",
                        "params": {
                            "albumId": "$resource.id",
                            "photoId": "$media.previousItem.id"
                        }
                    },
                    "remove": {
                        "endpoint": "removePhoto",
                        "params": {
                            "albumId": "$resource.id",
                            "photoId": "$media.item.id"
                        }
                    },
                    "reorder": {
                        "endpoint": "reorderPhotos",
                        "params": {
                            "albumId": "$resource.id"
                        },
                        "body": {
                            "photoIds": "$media.valueIds"
                        }
                    }
                }
            }
        ]
    }
]
