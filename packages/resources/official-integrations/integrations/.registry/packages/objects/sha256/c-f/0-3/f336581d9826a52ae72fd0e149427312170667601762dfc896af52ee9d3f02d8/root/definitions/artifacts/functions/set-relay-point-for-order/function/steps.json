[
    {
        "id": "context",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "getOrderDeliverySetupContext",
            "params": {
                "orderId": "$input.body.orderId"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.context.order.buyerCmsUserId",
                    "$ctx.user.id"
                ]
            },
            "failure": {
                "status": 403,
                "error": "Order does not belong to the current buyer"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.context.order.status",
                    "awaiting_quote"
                ]
            },
            "failure": {
                "status": 409,
                "error": "Pickup point can only be changed before order finalization"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "all": [
                    {
                        "equals": [
                            "$steps.context.authorization.buyerCmsUserId",
                            "$ctx.user.id"
                        ]
                    },
                    {
                        "equals": [
                            "$steps.context.authorization.orderVersion",
                            "$steps.context.order.version"
                        ]
                    },
                    {
                        "equals": [
                            "$steps.context.authorization.status",
                            "awaiting_quote"
                        ]
                    }
                ]
            },
            "failure": {
                "status": 409,
                "error": "Order delivery authorization changed"
            }
        }
    },
    {
        "id": "seller",
        "call": {
            "source": "{{dependencies.accounts.sourceId}}",
            "endpoint": "getAccountByUserId",
            "params": {
                "userId": "$steps.context.authorization.sellerCmsUserId"
            }
        }
    },
    {
        "id": "selection",
        "call": {
            "source": "{{dependencies.delivery.sourceId}}",
            "endpoint": "saveRelaySelection",
            "body": {
                "requestKey": {
                    "$concat": [
                        "commerce-order:",
                        "$steps.context.order.publicId",
                        ":version:",
                        "$steps.context.order.version",
                        ":relay:",
                        "$input.body.relayLocation"
                    ]
                },
                "externalOrderId": "$steps.context.order.publicId",
                "orderVersion": "$steps.context.order.version",
                "selectedForCmsUserId": "$ctx.user.id",
                "relayLocation": "$input.body.relayLocation",
                "country": "$input.body.country",
                "postalCode": "$input.body.postalCode",
                "city": "$input.body.city",
                "currency": "$steps.context.authorization.currency",
                "merchandiseSubtotalMinorAmount": "$steps.context.authorization.merchandiseSubtotalMinorAmount",
                "recipientSnapshot": "$steps.context.authorization.shippingAddress",
                "sellerFulfillmentSnapshot": "$steps.seller"
            }
        }
    },
    {
        "id": "resolvedQuote",
        "call": {
            "source": "{{dependencies.delivery.sourceId}}",
            "endpoint": "resolveDeliveryQuote",
            "body": {
                "quoteId": "$steps.selection.quoteId",
                "externalOrderId": "$steps.context.order.publicId",
                "selectedForCmsUserId": "$ctx.user.id",
                "orderVersion": "$steps.context.order.version",
                "merchandiseSubtotalMinorAmount": "$steps.context.authorization.merchandiseSubtotalMinorAmount",
                "currency": "$steps.context.authorization.currency",
                "purpose": "financial_lock"
            }
        }
    },
    {
        "id": "financialTerms",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "lockOrderFinancialTerms",
            "body": {
                "orderPublicId": "$steps.context.order.publicId",
                "deliveryQuoteId": "$steps.resolvedQuote.quoteId",
                "shippingAmount": "$steps.resolvedQuote.shippingAmount",
                "currency": "$steps.resolvedQuote.currency",
                "expectedVersion": "$steps.context.order.version"
            }
        }
    }
]
