[
    {
        "id": "cancellations",
        "forEach": {
            "items": "$steps.cancellationClaims.items",
            "max": 5,
            "continueOnError": true,
            "steps": [
                {
                    "id": "deliveryCancellation",
                    "call": {
                        "source": "{{dependencies.delivery.sourceId}}",
                        "endpoint": "cancelShipmentReservation",
                        "body": {
                            "externalOrderId": "$item.orderPublicId",
                            "trackingUntil": "$item.trackingUntil"
                        }
                    }
                },
                {
                    "id": "completeCancellation",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "completeOrderShipmentCancellation",
                        "body": {
                            "operationId": "$item.operationId",
                            "claimToken": "$item.claimToken",
                            "providerStatus": "$steps.deliveryCancellation.status",
                            "providerReference": "$steps.deliveryCancellation.expeditionNumber",
                            "providerSnapshot": "$steps.deliveryCancellation"
                        }
                    }
                }
            ],
            "yield": "$steps.completeCancellation",
            "onError": [
                {
                    "id": "failCancellation",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "failOrderShipmentCancellation",
                        "body": {
                            "operationId": "$item.operationId",
                            "claimToken": "$item.claimToken",
                            "error": "Mondial Relay shipment cancellation reconciliation failed"
                        }
                    }
                }
            ],
            "errorYield": {
                "operationId": "$item.operationId",
                "failed": true,
                "failure": "$steps.failCancellation"
            }
        }
    }
]
