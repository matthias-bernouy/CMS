[
    {
        "provider": "stripe-webhooks",
        "configuration": {
            "secretKey": "{{connectorSecrets.stripeSecretKey}}",
            "owner": "{{answers.id}}",
            "v1ApiVersion": "2026-02-25.clover",
            "v2ApiVersion": "2026-06-24.dahlia",
            "destinations": [
                {
                    "protocol": "v1",
                    "name": "stripeWebhookSecret",
                    "url": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/webhooks/stripe",
                    "connect": false,
                    "enabledEvents": [
                        "payment_intent.amount_capturable_updated",
                        "payment_intent.canceled",
                        "payment_intent.payment_failed",
                        "payment_intent.processing",
                        "payment_intent.succeeded",
                        "charge.failed",
                        "charge.refunded",
                        "charge.succeeded",
                        "refund.created",
                        "refund.failed",
                        "refund.updated",
                        "charge.dispute.closed",
                        "charge.dispute.created",
                        "charge.dispute.funds_reinstated",
                        "charge.dispute.funds_withdrawn",
                        "charge.dispute.updated",
                        "transfer.created",
                        "transfer.reversed",
                        "transfer.updated",
                        "payout.created",
                        "payout.updated",
                        "payout.paid",
                        "payout.failed"
                    ]
                },
                {
                    "protocol": "v1",
                    "name": "stripeConnectWebhookSecret",
                    "url": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/webhooks/stripe-connect",
                    "connect": true,
                    "enabledEvents": [
                        "account.updated",
                        "payout.canceled",
                        "payout.created",
                        "payout.failed",
                        "payout.paid",
                        "payout.updated"
                    ]
                },
                {
                    "protocol": "v2",
                    "name": "stripeConnectV2WebhookSecret",
                    "url": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/webhooks/stripe-connect-v2",
                    "eventsFrom": [
                        "self"
                    ],
                    "enabledEvents": [
                        "v2.core.account.closed",
                        "v2.core.account.updated",
                        "v2.core.account[configuration.recipient].capability_status_updated",
                        "v2.core.account[configuration.recipient].updated",
                        "v2.core.account[defaults].updated",
                        "v2.core.account[future_requirements].updated",
                        "v2.core.account[identity].updated",
                        "v2.core.account[requirements].updated"
                    ]
                }
            ]
        },
        "outputs": [
            {
                "name": "stripeWebhookSecret",
                "key": "STRIPE_CONNECT_{{env answers.id}}_WEBHOOK_SECRET"
            },
            {
                "name": "stripeConnectWebhookSecret",
                "key": "STRIPE_CONNECT_{{env answers.id}}_CONNECT_WEBHOOK_SECRET"
            },
            {
                "name": "stripeConnectV2WebhookSecret",
                "key": "STRIPE_CONNECT_{{env answers.id}}_CONNECT_V2_WEBHOOK_SECRET"
            }
        ]
    }
]
