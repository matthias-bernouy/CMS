[
    {
        "widget": "w-table",
        "id": "claimEvidenceTable",
        "title": "Private evidence for the selected claim",
        "source": {
            "endpoint": "claimEvidenceItems",
            "params": {
                "claimId": "$selection.claimDetail.id",
                "limit": "100",
                "offset": "0"
            },
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "id",
        "columns": [
            {
                "id": "id",
                "label": "Evidence",
                "path": "id",
                "primary": true
            },
            {
                "id": "claimId",
                "label": "Claim",
                "path": "claimId"
            },
            {
                "id": "submittedByKind",
                "label": "Submitted by",
                "path": "submittedByKind",
                "format": "badge"
            },
            {
                "id": "originalFilename",
                "label": "File",
                "path": "originalFilename"
            },
            {
                "id": "mimeType",
                "label": "Type",
                "path": "mimeType"
            },
            {
                "id": "fileSize",
                "label": "Bytes",
                "path": "fileSize"
            },
            {
                "id": "createdAt",
                "label": "Uploaded",
                "path": "createdAt",
                "format": "date"
            }
        ],
        "selection": {
            "opens": "claimEvidenceDetail"
        }
    },
    {
        "widget": "w-detail",
        "id": "claimEvidenceDetail",
        "source": {
            "endpoint": "claimEvidenceItem",
            "params": {
                "id": "$selection.id"
            }
        },
        "title": {
            "path": "originalFilename",
            "fallback": "Claim evidence"
        },
        "actions": [
            {
                "id": "downloadClaimEvidence",
                "label": "Download private evidence",
                "icon": "download",
                "placement": "primary",
                "endpoint": {
                    "endpoint": "claimEvidenceFile",
                    "params": {
                        "evidenceId": "$resource.id"
                    }
                },
                "download": {}
            }
        ],
        "main": [
            {
                "id": "claimEvidenceMetadata",
                "title": "Evidence metadata",
                "fields": [
                    {
                        "id": "claimId",
                        "label": "Claim",
                        "path": "claimId",
                        "type": "readonly"
                    },
                    {
                        "id": "submittedByKind",
                        "label": "Submitted by",
                        "path": "submittedByKind",
                        "type": "readonly",
                        "format": "badge"
                    },
                    {
                        "id": "mimeType",
                        "label": "MIME type",
                        "path": "mimeType",
                        "type": "readonly"
                    },
                    {
                        "id": "fileSize",
                        "label": "File size",
                        "path": "fileSize",
                        "type": "readonly"
                    },
                    {
                        "id": "sha256",
                        "label": "SHA-256",
                        "path": "sha256",
                        "type": "readonly"
                    },
                    {
                        "id": "description",
                        "label": "Description",
                        "path": "description",
                        "type": "readonly"
                    },
                    {
                        "id": "createdAt",
                        "label": "Uploaded",
                        "path": "createdAt",
                        "type": "readonly",
                        "format": "date"
                    }
                ]
            }
        ]
    }
]
