{
    "endpointId": "uploadMyOfferImage",
    "access": "auth",
    "method": "POST",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/offer/image",
    "params": [
        {
            "name": "offerId",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "offerMediaId": {
                        "type": "number"
                    },
                    "mediaId": {
                        "type": "number"
                    },
                    "sortOrder": {
                        "type": "number"
                    },
                    "isMain": {
                        "type": "boolean"
                    }
                }
            }
        }
    ]
}
