[
    {
        "endpointId": "manageForms",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/forms",
        "params": [
            { "name": "q", "in": "query", "type": "string" },
            { "name": "status", "in": "query", "type": "string" },
            { "name": "limit", "in": "query", "type": "number" },
            { "name": "offset", "in": "query", "type": "number" }
        ],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/form-list.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "manageForm",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form",
        "params": [{ "name": "key", "in": "query", "type": "string", "required": true }],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/form.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "saveFormDraft",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/draft",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": {
            "type": "object",
            "properties": {
                "key": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string", "nullable": true },
                "accessMode": { "type": "string" },
                "definition": { "type": "object", "nullable": true }
            },
            "required": ["key", "title", "accessMode"]
        },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/form.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "publishForm",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/publish",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": { "type": "object", "properties": { "key": { "type": "string" } }, "required": ["key"] },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/form.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "archiveForm",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/archive",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": { "type": "object", "properties": { "key": { "type": "string" } }, "required": ["key"] },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/form.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    }
]
