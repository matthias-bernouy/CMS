{
    "id": "typography",
    "label": "Typography",
    "description": "Font families, sizes and reading rhythm shared by official interfaces.",
    "tokens": [
        {
            "id": "font-body",
            "label": "Body font",
            "description": "Paragraphs, controls and regular interface text.",
            "type": "font-family",
            "defaults": { "light": "Inter, system-ui, sans-serif" }
        },
        {
            "id": "font-heading",
            "label": "Heading font",
            "description": "Titles and prominent headings.",
            "type": "font-family",
            "defaults": { "light": "Georgia, serif" }
        },
        {
            "id": "font-mono",
            "label": "Monospace font",
            "description": "Code, identifiers and tabular technical values.",
            "type": "font-family",
            "defaults": { "light": "ui-monospace, SFMono-Regular, Consolas, monospace" }
        },
        {
            "id": "font-size-small",
            "label": "Small text size",
            "description": "Captions and supporting interface text.",
            "type": "length",
            "defaults": { "light": ".875rem" }
        },
        {
            "id": "font-size-body",
            "label": "Body text size",
            "description": "Default reading and interface text size.",
            "type": "length",
            "defaults": { "light": "1rem" }
        },
        {
            "id": "font-size-display",
            "label": "Display text size",
            "description": "Large marketing and page headings.",
            "type": "length",
            "defaults": { "light": "clamp(2.75rem, 7vw, 5.5rem)" }
        },
        {
            "id": "line-height-body",
            "label": "Body line height",
            "description": "Default line height for readable copy.",
            "type": "number",
            "defaults": { "light": "1.6" }
        }
    ]
}
