{
    "schema": "cms.integration.definition.v1",
    "kind": "basic-blocs",
    "label": "Basic Blocs",
    "version": "1.0.0",
    "category": "Blocks",
    "description": "Install neutral official UI blocs used by other integrations.",
    "icon": {
        "path": "assets/icon.svg"
    },
    "inputs": [],
    "ui": {
        "mark": "B",
        "markClass": "content",
        "emit": "bloc:updated",
        "instructions": [
            [
                "Install official blocks",
                "CmsCore imports the neutral UI blocs used as shared building blocks by official integrations."
            ],
            [
                "Keep site styling",
                "The blocs inherit typography and expose CSS custom properties and parts for site-level themes."
            ]
        ],
        "scopes": [
            "Bloc source write",
            "Editor catalog update"
        ],
        "checks": [
            "No source, secret, connector, or dashboard is installed.",
            "Existing blocs require force when re-importing.",
            "The imported source remains editable in the site bloc folder."
        ],
        "resources": [
            [
                "Blocs",
                "Neutral layout and form blocs"
            ]
        ],
        "review": [
            "Use these blocs as neutral defaults for official integration UI.",
            "Override visual treatment through the site theme before creating specialized copies."
        ],
        "sync": [
            "Validate bloc sources",
            "Install basic-button",
            "Install basic-card",
            "Install basic-skeleton",
            "Install intrinsic layout blocs",
            "Install basic-redirect",
            "Install native form editor",
            "Install form controls including file uploads",
            "Install toast notifications",
            "Refresh Blocs"
        ],
        "syncNote": "This integration installs only bloc artifacts."
    },
    "artifacts": [
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-button",
                "name": "Basic button",
                "group": "Basic",
                "description": "Neutral button bloc with inherited typography and CSS custom properties.",
                "path": "blocs/basic-button"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-card",
                "name": "Card",
                "group": "Basic",
                "description": "Generic card for grouping media, headings, content, and actions.",
                "path": "blocs/basic-card"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-skeleton",
                "name": "Skeleton",
                "group": "Feedback",
                "description": "Neutral animated placeholder for content that is still loading.",
                "path": "blocs/basic-skeleton"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-grid",
                "name": "Grid",
                "group": "Layout",
                "description": "Intrinsic responsive grid driven by minimum and maximum item widths.",
                "path": "blocs/basic-grid"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-stack",
                "name": "Stack",
                "group": "Layout",
                "description": "Vertical layout with token-based spacing.",
                "path": "blocs/basic-stack"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-toast",
                "name": "Toast",
                "group": "Feedback",
                "description": "Neutral, customizable transient notification.",
                "path": "blocs/basic-toast"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "img",
                "name": "Image",
                "group": "Media",
                "description": "Native responsive image with accessibility and loading settings.",
                "path": "blocs/basic-image"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-pagination",
                "name": "Pagination",
                "group": "Navigation",
                "description": "Accessible previous and next pagination with page and offset events.",
                "path": "blocs/basic-pagination"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-redirect",
                "name": "Redirect",
                "group": "Basic",
                "description": "Redirects a published page to another internal page.",
                "path": "blocs/basic-redirect"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "form",
                "name": "Form",
                "group": "Form",
                "description": "Native form submitted through the CMS binding runtime.",
                "path": "blocs/basic-form"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-input",
                "name": "Input",
                "group": "Form",
                "description": "Form-associated input with an encapsulated label, hint, and validation message.",
                "path": "blocs/basic-input"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-file-input",
                "name": "File input",
                "group": "Form",
                "description": "Form-associated file picker with an encapsulated label, hint, and validation message.",
                "path": "blocs/basic-file-input"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-textarea",
                "name": "Textarea",
                "group": "Form",
                "description": "Form-associated multiline input with an encapsulated label.",
                "path": "blocs/basic-textarea"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-option",
                "name": "Select option",
                "group": "Form",
                "description": "Option used by a Basic select.",
                "path": "blocs/basic-option"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-select",
                "name": "Select",
                "group": "Form",
                "description": "Form-associated select with adaptive native and custom presentations.",
                "path": "blocs/basic-select"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-checkbox",
                "name": "Checkbox",
                "group": "Form",
                "description": "Form-associated checkbox whose label is rendered inside its shadow root.",
                "path": "blocs/basic-checkbox"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-chip",
                "name": "Choice chip",
                "group": "Form",
                "description": "Selectable choice used inside a Basic chip group.",
                "path": "blocs/basic-chip"
            }
        },
        {
            "type": "bloc",
            "bloc": {
                "tag": "basic-chip-group",
                "name": "Choice chip group",
                "group": "Form",
                "description": "Form-associated single or multiple choice chip group.",
                "path": "blocs/basic-chip-group"
            }
        }
    ]
}
