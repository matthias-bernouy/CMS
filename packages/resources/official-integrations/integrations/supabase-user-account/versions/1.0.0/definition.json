{
    "schema": "cms.integration.definition.v1",
    "kind": "supabase-user-account",
    "label": "Supabase User Account",
    "version": "1.0.0",
    "category": "Users",
    "description": "Store minimal CMS user account fields in a private Supabase table.",
    "inputs": [
        {
            "name": "id",
            "label": "Source id",
            "type": "text",
            "required": true,
            "defaultValue": "user-account"
        },
        {
            "name": "functionsBaseUrl",
            "label": "Supabase Functions base URL",
            "type": "url",
            "required": true,
            "defaultValue": "https://PROJECT_REF.functions.supabase.co/functions/v1"
        },
        {
            "name": "apiKey",
            "label": "Private CMS or Supabase secret API key",
            "type": "password",
            "required": true,
            "secret": true
        }
    ],
    "ui": {
        "mark": "U",
        "markClass": "user-account",
        "emit": "source:updated",
        "instructions": [
            [
                "Run the database schema",
                "Apply connectors/supabase/schema.sql to the target Supabase database."
            ],
            [
                "Deploy Supabase function",
                "Deploy the cms-user-account Edge Function and set its production secrets."
            ],
            [
                "Connect the CMS",
                "Enter the Functions base URL without a trailing slash and the private CMS user account API key."
            ]
        ],
        "scopes": [
            "CMS x-user-id forwarding",
            "Current user account reads",
            "Minimal user account updates",
            "User account row deletion"
        ],
        "checks": [
            "The CMS only stores the source configuration and private API key reference.",
            "Each account request forwards x-user-id from the authenticated CMS subject.",
            "Supabase publishable keys are not accepted by the user account Edge Function."
        ],
        "resources": [
            [
                "Sources",
                "User account source contract"
            ],
            [
                "Secrets",
                "Private CMS user account API key"
            ],
            [
                "Supabase",
                "Private user_account schema and Edge Function"
            ]
        ],
        "review": [
            "Keep the user_account schema private to anon and authenticated roles.",
            "Use x-user-id only when it has been computed by the CMS, never from browser input.",
            "Do not expose Supabase service-role or secret keys to browser code."
        ],
        "sync": [
            "Validate answers",
            "Store private API key",
            "Install user account source",
            "Refresh Sources"
        ],
        "syncNote": "This integration creates a stateless CMS source. Supabase owns minimal account rows."
    },
    "secrets": [
        {
            "input": "apiKey",
            "key": "USER_ACCOUNT_{{env answers.id}}_API_KEY"
        }
    ],
    "artifacts": [
        {
            "type": "source",
            "source": {
                "id": "{{answers.id}}",
                "meta": {
                    "name": "User Account",
                    "description": "Supabase-backed current user account endpoints.",
                    "icon": "user"
                },
                "endpoints": [
                    {
                        "endpointId": "getAccount",
                        "method": "GET",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-user-account/account",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "exists": {
                                            "type": "boolean"
                                        },
                                        "userId": {
                                            "type": "string"
                                        },
                                        "email": {
                                            "type": "string"
                                        },
                                        "phone": {
                                            "type": "string"
                                        },
                                        "displayName": {
                                            "type": "string"
                                        },
                                        "avatarUrl": {
                                            "type": "string"
                                        },
                                        "locale": {
                                            "type": "string"
                                        },
                                        "timezone": {
                                            "type": "string"
                                        },
                                        "createdAt": {
                                            "type": "string"
                                        },
                                        "updatedAt": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "exists",
                                        "userId"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "updateAccount",
                        "method": "POST",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-user-account/account",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string"
                                },
                                "phone": {
                                    "type": "string"
                                },
                                "displayName": {
                                    "type": "string"
                                },
                                "avatarUrl": {
                                    "type": "string"
                                },
                                "locale": {
                                    "type": "string"
                                },
                                "timezone": {
                                    "type": "string"
                                }
                            }
                        },
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "exists": {
                                            "type": "boolean"
                                        },
                                        "userId": {
                                            "type": "string"
                                        },
                                        "email": {
                                            "type": "string"
                                        },
                                        "phone": {
                                            "type": "string"
                                        },
                                        "displayName": {
                                            "type": "string"
                                        },
                                        "avatarUrl": {
                                            "type": "string"
                                        },
                                        "locale": {
                                            "type": "string"
                                        },
                                        "timezone": {
                                            "type": "string"
                                        },
                                        "createdAt": {
                                            "type": "string"
                                        },
                                        "updatedAt": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "exists",
                                        "userId"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "deleteAccount",
                        "method": "POST",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-user-account/delete-account",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            },
                            {
                                "name": "x-user-id",
                                "source": {
                                    "from": "computed",
                                    "ref": "userID"
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "deleted": {
                                            "type": "boolean"
                                        },
                                        "userId": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "deleted",
                                        "userId"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "health",
                        "method": "GET",
                        "targetUrl": "{{answers.functionsBaseUrl}}/cms-user-account/health",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.apiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "ok"
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
