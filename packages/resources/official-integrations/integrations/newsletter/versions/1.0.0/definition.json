{
    "schema": "cms.integration.definition.v1",
    "kind": "newsletter",
    "label": "Newsletter",
    "version": "1.0.0",
    "category": "Marketing",
    "description": "Store newsletter subscription state with the configured connector.",
    "inputs": [
        {
            "name": "id",
            "label": "Source id",
            "type": "text",
            "required": true,
            "defaultValue": "newsletter"
        }
    ],
    "ui": {
        "mark": "N",
        "markClass": "newsletter",
        "emit": "source:updated",
        "instructions": [
            [
                "Deploy connector resources",
                "Apply the bundled Supabase schema and Edge Function to the configured project."
            ],
            [
                "Generate CMS API key",
                "Create a dedicated bearer token and install it in both the CMS secret store and the Supabase function secrets."
            ],
            [
                "Connect the CMS",
                "Install the newsletter source and subscriptions dashboard with the deployed function URL."
            ]
        ],
        "scopes": [
            "Newsletter subscription creation",
            "Newsletter subscription reads",
            "Newsletter subscription updates",
            "Newsletter subscription deletion",
            "Backoffice subscriptions dashboard"
        ],
        "checks": [
            "The CMS only stores the source configuration and private API key reference.",
            "Newsletter requests do not require a CMS user identity.",
            "The connector schema stays private to anon and authenticated Supabase roles.",
            "The connector deployer owns Supabase project credentials; the CMS source only stores its generated API key reference."
        ],
        "resources": [
            [
                "Sources",
                "Newsletter source contract"
            ],
            [
                "Dashboards",
                "Newsletter subscriptions dashboard"
            ],
            [
                "Secrets",
                "Private CMS newsletter API key"
            ],
            [
                "Supabase",
                "Private newsletter schema and Edge Function"
            ]
        ],
        "review": [
            "Keep the newsletter schema private to anon and authenticated roles.",
            "Do not expose Supabase service-role or secret keys to browser code.",
            "Use the CMS source proxy for all backoffice access."
        ],
        "sync": [
            "Validate answers",
            "Generate private API key",
            "Deploy Supabase connector",
            "Install newsletter source",
            "Install subscriptions dashboard",
            "Refresh Sources"
        ],
        "syncNote": "This integration creates a stateless CMS source. Supabase owns newsletter subscription rows."
    },
    "generatedSecrets": [
        {
            "name": "cmsApiKey",
            "key": "NEWSLETTER_{{env answers.id}}_API_KEY",
            "generator": "token",
            "bytes": 32,
            "prefix": "cms_nl_"
        }
    ],
    "connectors": [
        {
            "provider": "supabase",
            "root": "connectors/supabase",
            "dataApiSchemas": [
                "newsletter"
            ],
            "schemas": [
                "schema.sql"
            ],
            "functions": [
                {
                    "name": "cms-newsletter",
                    "directory": "functions/cms-newsletter",
                    "configPath": "supabase.config.toml",
                    "secrets": {
                        "CMS_NEWSLETTER_API_KEY": "{{generated.cmsApiKey}}"
                    }
                }
            ]
        }
    ],
    "artifacts": [
        {
            "type": "bloc",
            "bloc": {
                "tag": "newsletter-subscription",
                "name": "Newsletter subscription",
                "group": "Newsletter",
                "description": "Public newsletter subscription form backed by the Newsletter source.",
                "path": "blocs/newsletter-subscription"
            }
        },
        {
            "type": "source",
            "source": {
                "id": "{{answers.id}}",
                "meta": {
                    "name": "Newsletter",
                    "description": "Supabase-backed newsletter subscription endpoints.",
                    "icon": "mail"
                },
                "endpoints": [
                    {
                        "endpointId": "setSubscription",
                        "method": "POST",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscription",
                        "meta": {
                            "name": "Set subscription",
                            "description": "Create or update one newsletter subscription."
                        },
                        "params": [
                            {
                                "name": "email",
                                "in": "query",
                                "type": "string",
                                "description": "Normalized subscription email. Optional when the email is provided in the body."
                            }
                        ],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.cmsApiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "body": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string"
                                },
                                "subscribed": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "subscribed"
                            ]
                        },
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "exists": {
                                            "type": "boolean"
                                        },
                                        "email": {
                                            "type": "string"
                                        },
                                        "subscribed": {
                                            "type": "boolean"
                                        },
                                        "createdAt": {
                                            "type": "string"
                                        },
                                        "updatedAt": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "exists",
                                        "email",
                                        "subscribed"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "listSubscriptions",
                        "method": "GET",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscriptions",
                        "meta": {
                            "name": "List subscriptions",
                            "description": "List newsletter subscriptions for the backoffice dashboard."
                        },
                        "params": [
                            {
                                "name": "q",
                                "in": "query",
                                "type": "string",
                                "description": "Email search."
                            },
                            {
                                "name": "subscribed",
                                "in": "query",
                                "type": "string",
                                "description": "Filter by subscription status. Use true or false."
                            },
                            {
                                "name": "limit",
                                "in": "query",
                                "type": "number",
                                "description": "Maximum number of subscriptions to return."
                            }
                        ],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.cmsApiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "subscriptions": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "email": {
                                                        "type": "string"
                                                    },
                                                    "subscribed": {
                                                        "type": "boolean"
                                                    },
                                                    "createdAt": {
                                                        "type": "string"
                                                    },
                                                    "updatedAt": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "email",
                                                    "subscribed"
                                                ]
                                            }
                                        },
                                        "total": {
                                            "type": "number"
                                        }
                                    },
                                    "required": [
                                        "subscriptions",
                                        "total"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "exportSubscriptions",
                        "method": "GET",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscriptions/export",
                        "responseKind": "file",
                        "mediaType": "text/csv",
                        "meta": {
                            "name": "Export subscriptions",
                            "description": "Export newsletter subscriptions as a CSV file."
                        },
                        "params": [
                            {
                                "name": "q",
                                "in": "query",
                                "type": "string",
                                "description": "Email search."
                            },
                            {
                                "name": "subscribed",
                                "in": "query",
                                "type": "string",
                                "description": "Filter by subscription status. Use true or false."
                            }
                        ],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.cmsApiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "getSubscription",
                        "method": "GET",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscription",
                        "meta": {
                            "name": "Get subscription",
                            "description": "Read one newsletter subscription by email."
                        },
                        "params": [
                            {
                                "name": "email",
                                "in": "query",
                                "required": true,
                                "type": "string",
                                "description": "Subscription email."
                            }
                        ],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.cmsApiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "exists": {
                                            "type": "boolean"
                                        },
                                        "email": {
                                            "type": "string"
                                        },
                                        "subscribed": {
                                            "type": "boolean"
                                        },
                                        "createdAt": {
                                            "type": "string"
                                        },
                                        "updatedAt": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "exists",
                                        "email"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "deleteSubscription",
                        "method": "DELETE",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscription",
                        "meta": {
                            "name": "Delete subscription",
                            "description": "Delete one newsletter subscription by email."
                        },
                        "params": [
                            {
                                "name": "email",
                                "in": "query",
                                "required": true,
                                "type": "string",
                                "description": "Subscription email."
                            }
                        ],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.cmsApiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "deleted": {
                                            "type": "boolean"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "deleted",
                                        "email"
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "endpointId": "health",
                        "method": "GET",
                        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/health",
                        "params": [],
                        "headers": [
                            {
                                "name": "authorization",
                                "source": {
                                    "from": "secret",
                                    "ref": "{{secrets.cmsApiKey}}",
                                    "prefix": "Bearer "
                                }
                            }
                        ],
                        "output": [
                            {
                                "status": "200",
                                "body": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "ok"
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "type": "dashboard",
            "dashboard": {
                "id": "{{answers.id}}-subscriptions",
                "meta": {
                    "name": "Newsletter",
                    "icon": "mail"
                },
                "source": "{{answers.id}}",
                "views": [
                    {
                        "widget": "w-table",
                        "id": "subscriptionsTable",
                        "title": "Subscriptions",
                        "source": {
                            "endpoint": "listSubscriptions",
                            "params": {
                                "q": "$filter.q",
                                "subscribed": "$filter.subscribed",
                                "limit": "100"
                            },
                            "itemsPath": "subscriptions",
                            "totalPath": "total"
                        },
                        "rowKey": "email",
                        "filters": [
                            {
                                "id": "q",
                                "param": "q",
                                "type": "text",
                                "label": "Search",
                                "placeholder": "Search emails"
                            },
                            {
                                "id": "subscribed",
                                "param": "subscribed",
                                "type": "select",
                                "label": "Status",
                                "options": [
                                    {
                                        "value": "true",
                                        "label": "Subscribed"
                                    },
                                    {
                                        "value": "false",
                                        "label": "Unsubscribed"
                                    }
                                ]
                            }
                        ],
                        "columns": [
                            {
                                "id": "email",
                                "label": "Email",
                                "path": "email",
                                "primary": true
                            },
                            {
                                "id": "subscribed",
                                "label": "Subscribed",
                                "path": "subscribed",
                                "format": "badge"
                            },
                            {
                                "id": "createdAt",
                                "label": "Created",
                                "path": "createdAt",
                                "format": "date"
                            },
                            {
                                "id": "updatedAt",
                                "label": "Updated",
                                "path": "updatedAt",
                                "format": "date"
                            }
                        ],
                        "selection": {
                            "opens": "subscriptionDetail"
                        },
                        "actions": [
                            {
                                "id": "createSubscription",
                                "label": "Add subscription",
                                "tone": "primary",
                                "placement": "primary",
                                "selection": {
                                    "opens": "subscriptionDetail"
                                }
                            }
                        ]
                    },
                    {
                        "widget": "w-detail",
                        "id": "subscriptionDetail",
                        "source": {
                            "endpoint": "getSubscription",
                            "params": {
                                "email": "$selection.email"
                            }
                        },
                        "title": {
                            "path": "email",
                            "fallback": "Subscription"
                        },
                        "status": {
                            "path": "subscribed"
                        },
                        "actions": [
                            {
                                "id": "saveSubscription",
                                "label": "Save subscription",
                                "tone": "primary",
                                "placement": "primary",
                                "endpoint": {
                                    "endpoint": "setSubscription",
                                    "params": {
                                        "email": "$field.email"
                                    },
                                    "body": {
                                        "email": "$field.email",
                                        "subscribed": "$field.subscribed"
                                    }
                                }
                            },
                            {
                                "id": "deleteSubscription",
                                "label": "Delete subscription",
                                "tone": "danger",
                                "placement": "more",
                                "confirm": "Delete this newsletter subscription?",
                                "endpoint": {
                                    "endpoint": "deleteSubscription",
                                    "params": {
                                        "email": "$resource.email"
                                    }
                                }
                            }
                        ],
                        "main": [
                            {
                                "id": "subscriptionFields",
                                "title": "Subscription",
                                "fields": [
                                    {
                                        "id": "email",
                                        "label": "Email",
                                        "path": "email",
                                        "required": true,
                                        "type": "text"
                                    },
                                    {
                                        "id": "subscribed",
                                        "label": "Status",
                                        "path": "subscribed",
                                        "required": true,
                                        "type": "select",
                                        "options": [
                                            {
                                                "value": "true",
                                                "label": "Subscribed"
                                            },
                                            {
                                                "value": "false",
                                                "label": "Unsubscribed"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ],
                        "aside": [
                            {
                                "id": "subscriptionMetadata",
                                "title": "Metadata",
                                "fields": [
                                    {
                                        "id": "createdAt",
                                        "label": "Created",
                                        "path": "createdAt",
                                        "type": "readonly",
                                        "format": "date"
                                    },
                                    {
                                        "id": "updatedAt",
                                        "label": "Updated",
                                        "path": "updatedAt",
                                        "type": "readonly",
                                        "format": "date"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
