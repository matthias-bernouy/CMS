{
    "type": "trigger",
    "trigger": {
        "id": "consent-stage-target",
        "label": "Validate and stage target consent",
        "critical": true,
        "event": {
            "kind": "endpoint",
            "source": "system-auth",
            "endpoint": "signup",
            "phase": "request"
        },
        "mode": "sync",
        "failureMode": "block",
        "function": {
            "id": "stageConsentAcceptance",
            "body": {
                "contextKey": "signup",
                "subjectClaim": "$request.body.email",
                "attemptId": "$request.body.consentAttemptId",
                "acceptedVersionIds": "$request.body.acceptedConsentVersionIds"
            }
        }
    }
}
