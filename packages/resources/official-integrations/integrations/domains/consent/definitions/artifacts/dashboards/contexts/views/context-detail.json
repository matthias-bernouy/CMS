[
    {
        "widget": "w-detail",
        "id": "consentContext",
        "source": {
            "endpoint": "getConsentContext",
            "params": {
                "context": "$selection.id"
            }
        },
        "title": {
            "path": "contextKey",
            "fallback": "Consent policy"
        },
        "status": {
            "path": "status"
        },
        "actions": [
            {
                "id": "publishContext",
                "label": "Publish configuration",
                "tone": "primary",
                "placement": "primary",
                "confirm": "Publish a new immutable policy revision? Disabling preserves all existing evidence.",
                "after": {
                    "resource": "$result"
                },
                "management": {
                    "installationId": "consent",
                    "action": "save-settings",
                    "body": {
                        "contextKey": "$resource.contextKey",
                        "enabled": "$field.enabled",
                        "expectedRevision": "$resource.revision",
                        "documents": "$field.documents"
                    }
                }
            }
        ],
        "main": [
            {
                "id": "policy",
                "title": "Runtime policy",
                "description": "Publishing verifies each current page snapshot before atomically activating its immutable version.",
                "fields": [
                    {
                        "id": "contextKey",
                        "label": "Stable context key",
                        "path": "contextKey",
                        "type": "readonly"
                    },
                    {
                        "id": "enabled",
                        "label": "Require consent",
                        "path": "enabled",
                        "type": "checkbox"
                    },
                    {
                        "id": "documents",
                        "label": "Documents",
                        "path": "documents",
                        "type": "reorderable-list",
                        "layout": "cards",
                        "itemKey": "key",
                        "positionPath": "position",
                        "addLabel": "Add document",
                        "maxItems": 8,
                        "fields": [
                            {
                                "id": "enabled",
                                "label": "Required",
                                "path": "enabled",
                                "type": "checkbox"
                            },
                            {
                                "id": "key",
                                "label": "Stable key",
                                "path": "key",
                                "required": true
                            },
                            {
                                "id": "label",
                                "label": "Public label",
                                "path": "label",
                                "required": true
                            },
                            {
                                "id": "consentText",
                                "label": "Consent sentence",
                                "path": "consentText",
                                "required": true
                            },
                            {
                                "id": "page",
                                "label": "Published page",
                                "path": "page",
                                "type": "page-link",
                                "publishedOnly": true,
                                "allowExternal": false,
                                "allowMedia": false,
                                "required": true
                            }
                        ],
                        "visibleWhen": {
                            "value": "$field.enabled",
                            "equals": true
                        }
                    }
                ]
            }
        ],
        "aside": [
            {
                "id": "publication",
                "title": "Publication",
                "fields": [
                    {
                        "id": "status",
                        "label": "Status",
                        "path": "status",
                        "type": "readonly",
                        "format": "badge"
                    },
                    {
                        "id": "revision",
                        "label": "Revision",
                        "path": "revision",
                        "type": "readonly"
                    },
                    {
                        "id": "approvedSnapshotOrigin",
                        "label": "CMS Delivery origin",
                        "path": "approvedSnapshotOrigin",
                        "type": "readonly",
                        "format": "url"
                    },
                    {
                        "id": "updatedAt",
                        "label": "Updated",
                        "path": "updatedAt",
                        "type": "readonly",
                        "format": "date"
                    }
                ]
            }
        ]
    }
]
