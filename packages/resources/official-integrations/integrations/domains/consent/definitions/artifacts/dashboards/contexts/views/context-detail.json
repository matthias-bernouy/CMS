[
    {
        "widget": "w-detail",
        "id": "consentContext",
        "source": {
            "endpoint": "getConsentContext",
            "params": {
                "context": "$selection.id"
            }
        },
        "title": {
            "path": "contextKey",
            "fallback": "Consent policy"
        },
        "status": {
            "path": "status"
        },
        "main": [
            {
                "id": "policy",
                "title": "Runtime policy",
                "description": "Publishing verifies each current page snapshot before atomically activating its immutable version.",
                "fields": [
                    {
                        "id": "newContextKey",
                        "label": "Stable context key",
                        "path": "contextKey",
                        "name": "contextKey",
                        "type": "text",
                        "required": true,
                        "visibleWhen": {
                            "value": "$resource.revision",
                            "equals": "new"
                        }
                    },
                    {
                        "id": "contextKey",
                        "label": "Stable context key",
                        "path": "contextKey",
                        "type": "readonly",
                        "visibleWhen": {
                            "value": "$resource.revision",
                            "notEquals": "new"
                        }
                    },
                    {
                        "id": "enabled",
                        "label": "Require consent",
                        "path": "enabled",
                        "type": "checkbox"
                    },
                    {
                        "id": "documents",
                        "label": "Documents",
                        "path": "documents",
                        "type": "reorderable-list",
                        "layout": "cards",
                        "itemKey": "key",
                        "positionPath": "position",
                        "addLabel": "Add document",
                        "maxItems": 8,
                        "fields": [
                            {
                                "id": "enabled",
                                "label": "Required",
                                "path": "enabled",
                                "type": "checkbox"
                            },
                            {
                                "id": "key",
                                "label": "Stable key",
                                "path": "key",
                                "required": true
                            },
                            {
                                "id": "label",
                                "label": "Public label",
                                "path": "label",
                                "required": true
                            },
                            {
                                "id": "consentText",
                                "label": "Consent sentence",
                                "path": "consentText",
                                "required": true
                            },
                            {
                                "id": "page",
                                "label": "Published page",
                                "path": "page",
                                "type": "page-link",
                                "publishedOnly": true,
                                "allowExternal": false,
                                "allowMedia": false,
                                "required": true
                            }
                        ],
                        "visibleWhen": {
                            "value": "$field.enabled",
                            "equals": true
                        }
                    }
                ]
            }
        ],
        "aside": [
            {
                "id": "publication",
                "title": "Publication",
                "fields": [
                    {
                        "id": "status",
                        "label": "Status",
                        "path": "status",
                        "type": "readonly",
                        "format": "badge"
                    },
                    {
                        "id": "revision",
                        "label": "Revision",
                        "path": "revision",
                        "type": "readonly"
                    },
                    {
                        "id": "approvedSnapshotOrigin",
                        "label": "CMS Delivery origin",
                        "path": "approvedSnapshotOrigin",
                        "type": "readonly",
                        "format": "url"
                    },
                    {
                        "id": "updatedAt",
                        "label": "Updated",
                        "path": "updatedAt",
                        "type": "readonly",
                        "format": "date"
                    }
                ]
            }
        ],
        "create": {},
        "save": {
            "valuesPath": "values",
            "idPath": "values.contextKey",
            "label": "Publish configuration",
            "confirm": "Publish a new immutable policy revision? Disabling preserves all existing evidence.",
            "hiddenFields": [
                {
                    "name": "contextKey",
                    "type": "string",
                    "value": "$resource.contextKey",
                    "empty": "omit"
                },
                {
                    "name": "expectedRevision",
                    "type": "string",
                    "value": "$resource.revision"
                }
            ],
            "endpoint": "publishConsentPolicy"
        }
    }
]
