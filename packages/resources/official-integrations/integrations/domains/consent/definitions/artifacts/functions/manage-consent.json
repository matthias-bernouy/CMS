{
    "type": "function",
    "contractVersion": "1.0.0",
    "function": {
        "id": "manageConsent",
        "method": "POST",
        "access": {
            "mode": "system"
        },
        "meta": {
            "name": "Manage Consent settings and health"
        },
        "input": {
            "body": {
                "type": "object",
                "additionalProperties": true
            }
        },
        "steps": [
            {
                "id": "management",
                "call": {
                    "source": "consent",
                    "endpoint": "manageIntegration",
                    "body": "$input.body",
                    "onError": {
                        "propagate": [
                            400,
                            409,
                            422,
                            503
                        ]
                    }
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            {
                "status": "400",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "409",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "422",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "503",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.management"
        }
    }
}
