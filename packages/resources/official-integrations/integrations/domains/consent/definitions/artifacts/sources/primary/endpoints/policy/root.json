[
    {
        "endpointId": "publishConsentPolicy",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-consent/context-policy",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "body": {
            "type": "object",
            "additionalProperties": true
        },
        "output": {
            "$include": "output.json"
        },
        "integrationContext": true
    }
]
