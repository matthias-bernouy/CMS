[
    {
        "endpointId": "publishConsentContext",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-consent/admin/context/publish",
        "meta": {
            "name": "Publish consent context",
            "description": "Verify page snapshots and atomically publish a new consent policy revision."
        },
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": { "from": "secret", "ref": "{{secrets.cmsApiKey}}", "prefix": "Bearer " }
            },
            { "name": "x-cms-user-id", "source": { "from": "computed", "ref": "userID" } }
        ],
        "body": {
            "type": "object",
            "properties": {
                "contextKey": { "type": "string" },
                "enabled": { "type": "boolean" },
                "expectedRevision": { "type": "string" },
                "documents": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "key": { "type": "string" },
                            "enabled": { "type": "boolean" },
                            "label": { "type": "string" },
                            "consentText": { "type": "string" },
                            "publishedSnapshotUrl": { "type": "string" }
                        },
                        "required": ["key", "enabled", "label", "consentText", "publishedSnapshotUrl"]
                    }
                }
            },
            "required": ["contextKey", "enabled", "expectedRevision", "documents"]
        },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/context.json" } },
            { "status": "default", "body": { "$include": "../../shared/error.json" } }
        ]
    }
]
