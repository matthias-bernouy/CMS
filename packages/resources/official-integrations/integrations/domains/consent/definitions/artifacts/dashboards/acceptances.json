{
    "type": "dashboard-view",
    "view": {
        "id": "consent-acceptances",
        "meta": {
            "name": "Consent evidence",
            "icon": "check-square"
        },
        "source": "consent",
        "views": [
            {
                "widget": "w-table",
                "id": "consentAcceptances",
                "title": "Consent acceptances",
                "source": {
                    "endpoint": "listAcceptances",
                    "params": {
                        "context": "$filter.context",
                        "cmsUserId": "$filter.cmsUserId",
                        "limit": "100"
                    },
                    "itemsPath": "items",
                    "totalPath": "total"
                },
                "rowKey": "id",
                "pageSize": 100,
                "filters": [
                    {
                        "id": "context",
                        "param": "context",
                        "type": "text",
                        "label": "Context",
                        "placeholder": "signup"
                    },
                    {
                        "id": "cmsUserId",
                        "param": "cmsUserId",
                        "type": "text",
                        "label": "CMS subject",
                        "placeholder": "local:…"
                    }
                ],
                "columns": [
                    {
                        "id": "cmsUserId",
                        "label": "CMS subject",
                        "path": "cmsUserId",
                        "primary": true
                    },
                    {
                        "id": "contextKey",
                        "label": "Context",
                        "path": "contextKey",
                        "format": "badge"
                    },
                    {
                        "id": "acceptedAt",
                        "label": "Accepted",
                        "path": "acceptedAt",
                        "format": "date"
                    },
                    {
                        "id": "committedAt",
                        "label": "Associated",
                        "path": "committedAt",
                        "format": "date"
                    },
                    {
                        "id": "documentSummary",
                        "label": "Documents",
                        "path": "documentSummary"
                    }
                ]
            }
        ]
    }
}
