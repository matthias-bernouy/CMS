{
    "type": "trigger",
    "trigger": {
        "id": "consent-commit-target",
        "label": "Commit target consent for the verified subject",
        "critical": true,
        "event": {
            "kind": "endpoint",
            "source": "system-auth",
            "endpoint": "signup",
            "phase": "response"
        },
        "mode": "sync",
        "failureMode": "block",
        "condition": {
            "all": [
                { "equals": ["$response.status", 200] },
                { "exists": "$response.body.cmsUserId" }
            ]
        },
        "function": {
            "id": "commitConsentAcceptance",
            "body": {
                "contextKey": "{{answers.contextKey}}",
                "subjectClaim": "$request.body.email",
                "attemptId": "$request.body.consentAttemptId",
                "acceptedVersionIds": "$request.body.acceptedConsentVersionIds",
                "cmsUserId": "$response.body.cmsUserId"
            }
        }
    }
}
