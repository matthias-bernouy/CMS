{
    "schema": "cms.integration.definition.v2",
    "kind": "consent",
    "label": "Consent",
    "version": "1.0.0",
    "category": "Identity & Legal",
    "description": "Collect immutable, versioned consent evidence without coupling business policy to CMS Auth.",
    "icon": {
        "path": "assets/icon.svg"
    },
    "ui": {
        "$include": "configuration/ui.json"
    },
    "generatedSecrets": {
        "$include": "configuration/generated-secrets.json"
    },
    "connectors": {
        "$include": "configuration/connectors.json"
    },
    "afterInstallation": {
        "$include": "configuration/after-installation.json"
    },
    "artifacts": {
        "$files": [
            "artifacts/sources/primary/definition.json",
            "artifacts/functions/stage-consent-acceptance.json",
            "artifacts/functions/commit-consent-acceptance.json",
            "artifacts/triggers/stage-target-consent.json",
            "artifacts/triggers/commit-target-consent.json",
            "artifacts/dashboards/acceptances.json",
            "artifacts/dashboards/contexts/root.json",
            "artifacts/functions/manage-consent.json"
        ]
    },
    "type": "source",
    "management": {
        "schemaVersion": 1,
        "health": {
            "functionId": "manageConsent"
        },
        "settings": {
            "readFunctionId": "manageConsent",
            "saveFunctionId": "manageConsent",
            "fields": {
                "$include": "artifacts/dashboards/contexts/fields.json"
            },
            "dashboardId": "consent-contexts"
        }
    }
}
