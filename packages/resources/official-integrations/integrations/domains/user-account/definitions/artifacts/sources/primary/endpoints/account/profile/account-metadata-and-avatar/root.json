[
    {
        "$include": "update-account-metadata.json"
    },
    {
        "$include": "upload-account-avatar.json"
    },
    {
        "endpointId": "getAccountAvatar",
        "method": "GET",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-user-account/personal-information/avatar",
        "responseKind": "file",
        "mediaType": "image/*",
        "meta": {
            "name": "Get current user avatar",
            "description": "Read the current CMS user avatar file."
        },
        "params": [
            {
                "name": "fileId",
                "in": "query",
                "required": true,
                "type": "string",
                "description": "Avatar file id returned by uploadAccountAvatar."
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200"
            },
            {
                "status": "206"
            }
        ]
    }
]
