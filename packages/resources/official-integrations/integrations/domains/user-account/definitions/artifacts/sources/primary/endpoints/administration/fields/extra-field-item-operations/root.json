[
    {
        "$include": "get-extra-field.json"
    },
    {
        "endpointId": "reorderExtraFields",
        "method": "POST",
        "access": "admin",
        "effects": {
            "invalidatesSchema": true
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-user-account/personal-information/extra-fields/reorder",
        "meta": {
            "name": "Reorder personal information fields",
            "description": "Save the display order of configured personal information fields."
        },
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "ids"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "ids": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "required": [
                        "ids"
                    ]
                }
            }
        ]
    },
    {
        "endpointId": "deleteExtraField",
        "method": "DELETE",
        "access": "admin",
        "effects": {
            "invalidatesSchema": true
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-user-account/personal-information/extra-fields/field",
        "meta": {
            "name": "Delete personal information field",
            "description": "Delete a configured extra personal information field definition while keeping existing account metadata values."
        },
        "params": [
            {
                "name": "id",
                "in": "query",
                "required": true,
                "type": "string",
                "description": "Configured extra field id."
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "deleted": {
                            "type": "boolean"
                        },
                        "id": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "deleted",
                        "id"
                    ]
                }
            }
        ]
    }
]
