{
    "widget": "w-detail",
    "id": "accountDetail",
    "source": {
        "endpoint": "getAccountByUserId",
        "params": {
            "userId": "$selection.id"
        }
    },
    "title": {
        "path": "givenName",
        "fallback": "User"
    },
    "actions": [
        {
            "id": "saveAccount",
            "label": "Save user",
            "tone": "primary",
            "placement": "primary",
            "endpoint": {
                "endpoint": "createUserPersonalInformation",
                "params": {
                    "userId": "$resource.userId"
                },
                "body": {
                    "givenName": "$field.givenName",
                    "surname": "$field.surname",
                    "birthDate": "$field.birthDate",
                    "phone": "$field.phone",
                    "addressLine1": "$field.addressLine1",
                    "addressLine2": "$field.addressLine2",
                    "addressLine3": "$field.addressLine3",
                    "postalCode": "$field.postalCode",
                    "city": "$field.city",
                    "region": "$field.region",
                    "countryCode": "$field.countryCode",
                    "avatarUrl": "$resource.avatarUrl",
                    "avatarFileId": "$resource.avatarFileId",
                    "locale": "$field.locale",
                    "timezone": "$field.timezone"
                }
            },
            "after": {
                "resource": "$result"
            }
        },
        {
            "id": "deleteAccount",
            "label": "Delete user",
            "tone": "danger",
            "placement": "more",
            "confirm": "Delete this user's personal information?",
            "endpoint": {
                "endpoint": "deleteUserPersonalInformation",
                "params": {
                    "userId": "$resource.userId"
                }
            }
        }
    ],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "avatar",
            "title": "Avatar",
            "fields": [
                {
                    "id": "avatarPreview",
                    "label": "Avatar",
                    "path": "avatarUrl",
                    "type": "readonly",
                    "format": "image"
                }
            ]
        },
        {
            "id": "accountMetadata",
            "title": "Metadata",
            "fields": [
                {
                    "id": "createdAt",
                    "label": "Created",
                    "path": "createdAt",
                    "type": "readonly",
                    "format": "date"
                },
                {
                    "id": "updatedAt",
                    "label": "Updated",
                    "path": "updatedAt",
                    "type": "readonly",
                    "format": "date"
                }
            ]
        }
    ]
}
