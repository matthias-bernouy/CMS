{
    "type": "function",
    "contractVersion": "1.0.0",
    "function": {
        "id": "checkUserAccountHealth",
        "method": "POST",
        "access": {
            "mode": "system"
        },
        "meta": {
            "name": "user-account health"
        },
        "input": {
            "body": {
                "type": "object"
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "health",
                "call": {
                    "source": "user-account",
                    "endpoint": "health"
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.health"
        }
    }
}
