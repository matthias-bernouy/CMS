{
    "endpointId": "uploadUserPersonalInformationAvatar",
    "method": "POST",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-user-account/personal-information/record/avatar",
    "meta": {
        "name": "Upload user avatar",
        "description": "Upload and attach an avatar image to a target CMS user. The request must be multipart/form-data with a file field."
    },
    "params": [
        {
            "name": "userId",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Target CMS user id."
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "exists": {
                        "type": "boolean"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string",
                        "nullable": true
                    },
                    "givenName": {
                        "type": "string",
                        "nullable": true
                    },
                    "surname": {
                        "type": "string",
                        "nullable": true
                    },
                    "birthDate": {
                        "type": "string",
                        "nullable": true
                    },
                    "addressLine1": {
                        "type": "string",
                        "nullable": true
                    },
                    "addressLine2": {
                        "type": "string",
                        "nullable": true
                    },
                    "addressLine3": {
                        "type": "string",
                        "nullable": true
                    },
                    "postalCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "city": {
                        "type": "string",
                        "nullable": true
                    },
                    "region": {
                        "type": "string",
                        "nullable": true
                    },
                    "countryCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "avatarUrl": {
                        "type": "string",
                        "nullable": true
                    },
                    "avatarFileId": {
                        "type": "string",
                        "nullable": true
                    },
                    "locale": {
                        "type": "string",
                        "nullable": true
                    },
                    "timezone": {
                        "type": "string",
                        "nullable": true
                    },
                    "metadata": {
                        "type": "object",
                        "properties": {}
                    },
                    "createdAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "exists",
                    "userId",
                    "avatarFileId"
                ]
            }
        }
    ]
}
