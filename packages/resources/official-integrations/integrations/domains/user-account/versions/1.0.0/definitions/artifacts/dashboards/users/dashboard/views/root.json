[
    {
        "widget": "w-table",
        "id": "accountsTable",
        "title": "Users",
        "source": {
            "endpoint": "listAccounts",
            "params": {
                "q": "$filter.q",
                "limit": "100"
            },
            "itemsPath": "accounts",
            "totalPath": "total"
        },
        "rowKey": "userId",
        "filters": [
            {
                "id": "q",
                "param": "q",
                "type": "text",
                "label": "Search",
                "placeholder": "Search users"
            }
        ],
        "columns": [
            {
                "id": "givenName",
                "label": "Given name",
                "path": "givenName",
                "primary": true
            },
            {
                "id": "surname",
                "label": "Surname",
                "path": "surname"
            },
            {
                "id": "phone",
                "label": "Phone",
                "path": "phone"
            },
            {
                "id": "locale",
                "label": "Locale",
                "path": "locale"
            },
            {
                "id": "timezone",
                "label": "Timezone",
                "path": "timezone"
            },
            {
                "id": "updatedAt",
                "label": "Updated",
                "path": "updatedAt",
                "format": "date"
            }
        ],
        "selection": {
            "opens": "accountDetail"
        }
    },
    {
        "$include": "account-detail/root.json"
    }
]
