{
    "schema": "cms.integration.definition.v1",
    "kind": "user-account",
    "label": "User Personal Information",
    "version": "1.0.0",
    "category": "Users",
    "description": "Store personal information for CMS users with the configured connector.",
    "icon": {
        "path": "assets/icon.svg"
    },
    "inputs": {
        "$include": "configuration/inputs.json"
    },
    "dependencies": {
        "$include": "configuration/dependencies.json"
    },
    "ui": {
        "$include": "configuration/ui.json"
    },
    "generatedSecrets": {
        "$include": "configuration/generated-secrets.json"
    },
    "connectors": {
        "$include": "configuration/connectors.json"
    },
    "artifacts": {
        "$files": [
            "artifacts/blocs/user-account-avatar.json",
            "artifacts/blocs/user-account-form.json",
            "artifacts/sources/primary/definition.json",
            "artifacts/source-overlays/extra-fields.json",
            "artifacts/source-overlays/flat-metadata-fields.json",
            "artifacts/dashboards/users/root.json",
            "artifacts/dashboards/fields/root.json"
        ]
    },
    "resources": []
