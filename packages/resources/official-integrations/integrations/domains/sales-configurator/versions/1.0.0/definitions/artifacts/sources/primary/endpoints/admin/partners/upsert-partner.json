[
  {
    "endpointId": "upsertPartner",
    "method": "POST",
    "access": "admin",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-sales-configurator/admin/partner",
    "meta": {
      "name": "Save sales partner",
      "description": "Create or update a sales-partner business entitlement."
    },
    "params": [
      { "name": "id", "in": "query", "type": "number" }
    ],
    "headers": {
      "$include": "../../../shared/admin-headers.json"
    },
    "body": {
      "type": "object",
      "properties": {
        "cmsUserId": {
          "type": "string",
          "semantic": {
            "kind": "user-id",
            "authority": "cms"
          }
        },
        "status": { "type": "string" },
        "displayName": { "type": "string" },
        "contactEmail": { "type": "string", "nullable": true }
      },
      "required": ["cmsUserId", "status", "displayName"]
    },
    "output": [
      {
        "status": "200",
        "body": {
          "$include": "../../../shapes/partners/partner.json"
        }
      },
      {
        "status": "default",
        "body": {
          "$include": "../../../shared/error.json"
        }
      }
    ]
  }
]
