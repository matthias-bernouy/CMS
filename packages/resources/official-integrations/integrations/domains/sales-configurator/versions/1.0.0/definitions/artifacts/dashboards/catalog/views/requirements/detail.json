[
  {
    "widget": "w-detail",
    "id": "requirementDetail",
    "source": {
      "endpoint": "manageRequirements",
      "params": {
        "subjectItemId": "$selection.subjectItemId",
        "requiredItemId": "$selection.requiredItemId"
      },
      "itemPath": "item"
    },
    "title": { "path": "subjectName", "fallback": "New prerequisite" },
    "status": { "path": "requiredKind" },
    "actions": [
      {
        "id": "saveRequirement",
        "label": "Save prerequisite",
        "tone": "primary",
        "placement": "primary",
        "endpoint": {
          "endpoint": "upsertRequirement",
          "body": {
            "subjectItemId": "$field.subjectItemId",
            "requiredItemId": "$field.requiredItemId"
          }
        },
        "after": { "resource": "$result" }
      },
      {
        "id": "deleteRequirement",
        "label": "Delete prerequisite",
        "icon": "trash",
        "tone": "danger",
        "placement": "more",
        "confirm": "Delete this prerequisite?",
        "visibleWhen": { "value": "$resource.requiredItemId", "notEquals": null },
        "endpoint": {
          "endpoint": "deleteRequirement",
          "params": {
            "subjectItemId": "$resource.subjectItemId",
            "requiredItemId": "$resource.requiredItemId"
          }
        }
      }
    ],
    "main": [
      {
        "id": "requirementDefinition",
        "title": "All-of prerequisite",
        "description": "Use catalogue item ids. The server rejects self-dependencies and cycles.",
        "fields": [
          {
            "id": "subjectItemId",
            "label": "Subject catalogue item id",
            "path": "subjectItemId",
            "type": "number",
            "required": true,
            "min": 1
          },
          {
            "id": "requiredItemId",
            "label": "Required catalogue item id",
            "path": "requiredItemId",
            "type": "number",
            "required": true,
            "min": 1
          },
          { "id": "subjectKind", "label": "Subject type", "path": "subjectKind", "type": "readonly" },
          { "id": "requiredKind", "label": "Required type", "path": "requiredKind", "type": "readonly" }
        ]
      }
    ]
  }
]
