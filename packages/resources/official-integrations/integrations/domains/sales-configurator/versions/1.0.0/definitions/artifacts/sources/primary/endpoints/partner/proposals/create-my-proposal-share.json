[
  {
    "endpointId": "createMyProposalShare",
    "method": "POST",
    "access": "auth",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-sales-configurator/partner/proposal/share",
    "meta": {
      "name": "Create proposal share",
      "description": "Create a revocable share for the current published proposal version."
    },
    "params": [],
    "headers": {
      "$include": "../../../shared/actor-headers.json"
    },
    "body": {
      "type": "object",
      "properties": {
        "proposalId": { "type": "number" },
        "expiresAt": { "type": "string", "nullable": true }
      },
      "required": ["proposalId"]
    },
    "output": [
      {
        "status": "200",
        "body": {
          "type": "object",
          "properties": {
            "share": {
              "$include": "../../../shapes/proposals/share.json"
            },
            "token": { "type": "string" },
            "proposal": {
              "$include": "../../../shapes/proposals/partner-detail.json"
            }
          },
          "required": ["share", "token", "proposal"]
        }
      },
      {
        "status": "default",
        "body": {
          "$include": "../../../shared/error.json"
        }
      }
    ]
  }
]
