[
  {
    "id": "createPartner",
    "label": "Save sales partner",
    "tone": "primary",
    "placement": "primary",
    "visibleWhen": { "value": "$resource.id", "equals": null },
    "endpoint": {
      "endpoint": "upsertPartner",
      "params": { "id": "$resource.id" },
      "body": {
        "cmsUserId": "$field.cmsUserId",
        "status": "$field.status",
        "displayName": "$field.displayName",
        "contactEmail": "$field.contactEmail"
      }
    },
    "after": { "resource": "$result" }
  },
  {
    "id": "savePartner",
    "label": "Save sales partner",
    "tone": "primary",
    "placement": "primary",
    "visibleWhen": { "value": "$resource.id", "notEquals": null },
    "endpoint": {
      "endpoint": "upsertPartner",
      "params": { "id": "$resource.id" },
      "body": {
        "cmsUserId": "$resource.cmsUserId",
        "status": "$field.status",
        "displayName": "$field.displayName",
        "contactEmail": "$field.contactEmail"
      }
    },
    "after": { "resource": "$result" }
  }
]
