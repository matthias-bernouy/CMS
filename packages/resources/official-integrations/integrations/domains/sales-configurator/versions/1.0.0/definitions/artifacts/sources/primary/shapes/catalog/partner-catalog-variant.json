{
  "type": "object",
  "properties": {
    "id": { "type": "number" },
    "code": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string", "nullable": true },
    "providerName": { "type": "string", "nullable": true },
    "pricingMode": { "type": "string" },
    "unitAmountCents": { "type": "number", "nullable": true },
    "currency": { "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "$include": "partner-catalog-feature.json"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$include": "requirement.json"
      }
    }
  },
  "required": [
    "id",
    "code",
    "name",
    "pricingMode",
    "currency",
    "features",
    "requirements"
  ]
}
