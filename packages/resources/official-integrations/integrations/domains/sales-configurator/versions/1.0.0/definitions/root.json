{
  "schema": "cms.integration.definition.v1",
  "kind": "sales-configurator",
  "label": "Sales Configurator",
  "version": "1.0.0",
  "category": "Sales",
  "description": "Configure a commercial catalogue and publish immutable, partner-owned sales proposals.",
  "icon": {
    "path": "assets/icon.svg"
  },
  "inputs": {
    "$include": "configuration/inputs.json"
  },
  "dependencies": {
    "$include": "configuration/dependencies.json"
  },
  "ui": {
    "$include": "configuration/ui.json"
  },
  "generatedSecrets": {
    "$include": "configuration/generated-secrets.json"
  },
  "connectors": {
    "$include": "configuration/connectors.json"
  },
  "artifacts": {
    "$files": [
      "artifacts/blocs/sales-client-directory.json",
      "artifacts/blocs/sales-catalog-browser.json",
      "artifacts/blocs/sales-proposal-list.json",
      "artifacts/blocs/sales-proposal-starter.json",
      "artifacts/blocs/sales-proposal-builder.json",
      "artifacts/blocs/sales-proposal-view.json",
      "artifacts/sources/primary/definition.json",
      "artifacts/dashboards/catalog/definition.json",
      "artifacts/dashboards/proposals/definition.json",
      "artifacts/dashboards/partners/definition.json"
    ]
  }
}
