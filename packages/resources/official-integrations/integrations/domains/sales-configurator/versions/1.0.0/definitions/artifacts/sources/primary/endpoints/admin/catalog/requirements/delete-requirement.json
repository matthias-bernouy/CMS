[
  {
    "endpointId": "deleteRequirement",
    "method": "DELETE",
    "access": "admin",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-sales-configurator/admin/requirement",
    "meta": {
      "name": "Delete prerequisite",
      "description": "Remove one all-of prerequisite edge."
    },
    "params": [
      { "name": "subjectItemId", "in": "query", "type": "number", "required": true },
      { "name": "requiredItemId", "in": "query", "type": "number", "required": true }
    ],
    "headers": {
      "$include": "../../../../shared/admin-headers.json"
    },
    "output": [
      {
        "status": "200",
        "body": {
          "type": "object",
          "properties": {
            "deleted": { "type": "boolean" },
            "subjectItemId": { "type": "number" },
            "requiredItemId": { "type": "number" }
          },
          "required": ["deleted", "subjectItemId", "requiredItemId"]
        }
      },
      {
        "status": "default",
        "body": {
          "$include": "../../../../shared/error.json"
        }
      }
    ]
  }
]
