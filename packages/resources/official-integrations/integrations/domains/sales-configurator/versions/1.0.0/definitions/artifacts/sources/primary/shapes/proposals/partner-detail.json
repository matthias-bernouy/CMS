{
  "type": "object",
  "properties": {
    "id": { "type": "number" },
    "reference": { "type": "string" },
    "status": { "type": "string" },
    "title": { "type": "string", "nullable": true },
    "introduction": { "type": "string", "nullable": true },
    "privateNotes": { "type": "string", "nullable": true },
    "client": {
      "$include": "../clients/client.json"
    },
    "draftVersion": {
      "$include": "version.json"
    },
    "publishedVersion": {
      "$include": "version.json"
    },
    "missingRequirements": {
      "type": "array",
      "items": {
        "$include": "../../shared/proposal-draft/missing-requirement.json"
      }
    },
    "shares": {
      "type": "array",
      "items": {
        "$include": "share.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$include": "event.json"
      }
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "required": [
    "id",
    "reference",
    "status",
    "client",
    "missingRequirements",
    "shares",
    "events"
  ]
}
