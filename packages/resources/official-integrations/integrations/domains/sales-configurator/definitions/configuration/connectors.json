[
  {
    "provider": "supabase",
    "root": "connectors/supabase",
    "dataApiSchemas": [
      "sales_configurator"
    ],
    "compatibility": {
      "schema": {
        "$include": "compatibility/schema.json"
      }
    },
    "schemas": [
      {
        "manifest": "sql/schema.manifest.json"
      }
    ],
    "functions": [
      {
        "name": "cms-sales-configurator",
        "directory": "functions/cms-sales-configurator",
        "configPath": "supabase.config.toml",
        "secrets": {
          "CMS_SALES_CONFIGURATOR_API_KEY": "{{generated.cmsApiKey}}"
        }
      }
    ]
  }
]
