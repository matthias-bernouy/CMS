[
  {
    "endpointId": "publishMyProposal",
    "method": "POST",
    "access": "auth",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-sales-configurator/partner/proposal/publish",
    "meta": {
      "name": "Publish my proposal",
      "description": "Publish the current valid draft and supersede the previous published version."
    },
    "params": [],
    "headers": {
      "$include": "../../../shared/actor-headers.json"
    },
    "body": {
      "type": "object",
      "properties": {
        "proposalId": { "type": "number" },
        "expectedVersionId": { "type": "number" },
        "expectedRevision": { "type": "number" }
      },
      "required": ["proposalId", "expectedVersionId", "expectedRevision"]
    },
    "output": [
      {
        "status": "200",
        "body": {
          "type": "object",
          "properties": {
            "proposal": {
              "$include": "../../../shapes/proposals/partner/detail.json"
            }
          },
          "required": ["proposal"]
        }
      },
      {
        "status": "default",
        "body": {
          "$include": "../../../shared/error.json"
        }
      }
    ]
  }
]
