[
  {
    "endpointId": "deleteVariantFeature",
    "method": "DELETE",
    "access": "admin",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-sales-configurator/admin/variant-feature",
    "meta": {
      "name": "Delete variant feature",
      "description": "Remove one contextual feature association."
    },
    "params": [
      { "name": "variantItemId", "in": "query", "type": "number", "required": true },
      { "name": "featureItemId", "in": "query", "type": "number", "required": true }
    ],
    "headers": {
      "$include": "../../../../shared/admin-headers.json"
    },
    "output": [
      {
        "status": "200",
        "body": {
          "type": "object",
          "properties": {
            "deleted": { "type": "boolean" },
            "variantItemId": { "type": "number" },
            "featureItemId": { "type": "number" }
          },
          "required": ["deleted", "variantItemId", "featureItemId"]
        }
      },
      {
        "status": "default",
        "body": {
          "$include": "../../../../shared/error.json"
        }
      }
    ]
  }
]
