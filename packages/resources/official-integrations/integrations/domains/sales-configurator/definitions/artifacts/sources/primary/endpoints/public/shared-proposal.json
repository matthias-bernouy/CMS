[
  {
    "endpointId": "getSharedProposal",
    "method": "GET",
    "access": "public",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-sales-configurator/shared-proposal",
    "meta": {
      "name": "Get shared proposal",
      "description": "Read one immutable client projection and atomically record its view."
    },
    "params": [
      { "name": "token", "in": "query", "type": "string", "required": true }
    ],
    "headers": {
      "$include": "../../shared/service-header.json"
    },
    "output": [
      {
        "status": "200",
        "body": {
          "type": "object",
          "properties": {
            "proposal": {
              "$include": "../../shapes/proposals/shared/detail.json"
            }
          },
          "required": ["proposal"]
        }
      },
      {
        "status": "default",
        "body": {
          "$include": "../../shared/error.json"
        }
      }
    ]
  }
]
