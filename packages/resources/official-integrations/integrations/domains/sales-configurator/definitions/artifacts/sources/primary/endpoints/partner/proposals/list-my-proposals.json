[
  {
    "endpointId": "listMyProposals",
    "method": "GET",
    "access": "auth",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-sales-configurator/partner/proposals",
    "meta": {
      "name": "List my proposals",
      "description": "List proposals owned by the authenticated active sales partner."
    },
    "params": [
      { "name": "q", "in": "query", "type": "string" },
      { "name": "status", "in": "query", "type": "string" },
      { "name": "cursor", "in": "query", "type": "string" },
      { "name": "limit", "in": "query", "type": "number" }
    ],
    "headers": {
      "$include": "../../../shared/actor-headers.json"
    },
    "output": [
      {
        "status": "200",
        "body": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$include": "../../../shapes/proposals/summary.json"
              }
            },
            "nextCursor": { "type": "string", "nullable": true }
          },
          "required": ["items"]
        }
      },
      {
        "status": "default",
        "body": {
          "$include": "../../../shared/error.json"
        }
      }
    ]
  }
]
