{
    "schema": "cms.integration.definition.v2",
    "kind": "forms",
    "label": "Forms",
    "version": "3.1.0",
    "category": "Content",
    "description": "Build versioned multi-step forms, publish them through CMS Sources, and review their submissions.",
    "icon": {
        "path": "assets/icon.svg"
    },
    "inputs": {
        "$include": "configuration/inputs.json"
    },
    "ui": {
        "$include": "configuration/ui.json"
    },
    "generatedSecrets": {
        "$include": "configuration/generated-secrets.json"
    },
    "connectors": {
        "$include": "configuration/connectors.json"
    },
    "afterInstallation": {
        "$include": "configuration/after-installation.json"
    },
    "artifacts": {
        "$files": [
            "artifacts/sources/primary/definition.json",
            "artifacts/dashboards/forms/root.json",
            "artifacts/dashboards/submissions/root.json"
        ]
    },
    "type": "source"
}
