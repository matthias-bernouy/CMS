[
    {
        "widget": "w-detail",
        "id": "newFormDetail",
        "source": { "endpoint": "manageForm", "params": { "key": "$selection.id" } },
        "title": { "path": "title", "fallback": "Create a form" },
        "actions": [
            {
                "id": "createForm",
                "label": "Create form",
                "tone": "primary",
                "placement": "primary",
                "endpoint": {
                    "endpoint": "saveFormDraft",
                    "body": {
                        "key": "$field.key",
                        "title": "$field.title",
                        "description": "$field.description",
                        "accessMode": "$field.accessMode",
                        "definition": "$resource.draftDefinition"
                    }
                },
                "after": { "opens": "formDetail", "row": "$result.key", "resource": "$result" }
            }
        ],
        "main": [
            {
                "id": "identity",
                "title": "Form details",
                "description": "Create the form first, then organize its sections and questions.",
                "fields": [
                    { "id": "title", "label": "Title", "path": "title", "type": "text", "required": true },
                    { "id": "key", "label": "Stable key", "path": "key", "type": "text", "required": true },
                    { "id": "description", "label": "Description", "path": "description", "type": "textarea", "rows": 3 },
                    {
                        "id": "accessMode",
                        "label": "Visitor access",
                        "path": "accessMode",
                        "type": "select",
                        "required": true,
                        "options": [
                            { "value": "public", "label": "Public" },
                            { "value": "authenticated", "label": "Signed-in visitors" }
                        ]
                    }
                ]
            }
        ]
    }
]
