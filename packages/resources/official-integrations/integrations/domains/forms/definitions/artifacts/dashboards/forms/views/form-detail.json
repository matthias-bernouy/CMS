[
    {
        "widget": "w-detail",
        "id": "formDetail",
        "source": { "endpoint": "manageForm", "params": { "key": "$selection.id" } },
        "title": { "path": "title", "fallback": "New form" },
        "status": { "path": "status" },
        "actions": [
            {
                "id": "saveDraft",
                "label": "Save form",
                "tone": "primary",
                "placement": "primary",
                "endpoint": {
                    "endpoint": "saveFormDraft",
                    "body": {
                        "key": "$field.key",
                        "title": "$field.title",
                        "description": "$field.description",
                        "accessMode": "$field.accessMode",
                        "definition": "$resource.draftDefinition"
                    }
                },
                "after": { "opens": "formDetail", "row": "$result.key", "resource": "$result" }
            },
            {
                "id": "publishForm",
                "label": "Publish new version",
                "tone": "primary",
                "placement": "more",
                "confirm": "Publish the current draft as a new immutable version?",
                "visibleWhen": { "value": "$field.key", "notEquals": "" },
                "endpoint": { "endpoint": "publishForm", "body": { "key": "$field.key" } },
                "after": { "resource": "$result" }
            },
            {
                "id": "archiveForm",
                "label": "Archive form",
                "tone": "danger",
                "placement": "more",
                "confirm": "Archive this form? Published rendering and new submissions will stop.",
                "visibleWhen": { "value": "$field.key", "notEquals": "" },
                "endpoint": { "endpoint": "archiveForm", "body": { "key": "$field.key" } },
                "after": { "resource": "$result" }
            }
        ],
        "main": [
            {
                "id": "identity",
                "title": "Form settings",
                "description": "Save the form, then build its sections and questions below.",
                "fields": [
                    { "id": "title", "label": "Title", "path": "title", "type": "text", "required": true },
                    { "id": "key", "label": "Stable key", "path": "key", "type": "readonly" },
                    { "id": "description", "label": "Description", "path": "description", "type": "textarea", "rows": 3 },
                    {
                        "id": "accessMode",
                        "label": "Visitor access",
                        "path": "accessMode",
                        "type": "select",
                        "required": true,
                        "options": [
                            { "value": "public", "label": "Public" },
                            { "value": "authenticated", "label": "Signed-in visitors" }
                        ]
                    }
                ]
            },
            {
                "widget": "w-navigation-list",
                "id": "sectionNavigation",
                "title": "Sections",
                "description": "Open a section to manage its questions. Drag sections to change the visitor journey.",
                "source": {
                    "endpoint": "manageSections",
                    "params": { "context": "$selection.formDetail.id" },
                    "itemsPath": "items"
                },
                "rowKey": "id",
                "item": {
                    "title": { "path": "title" },
                    "subtitle": { "path": "subtitle" },
                    "badge": { "path": "badge" }
                },
                "selection": { "opens": "sectionDetail" },
                "reorderable": { "action": "reorderSections" },
                "actions": [
                    {
                        "id": "createSection",
                        "label": "Add section",
                        "tone": "primary",
                        "placement": "primary",
                        "endpoint": {
                            "endpoint": "createSection",
                            "body": { "context": "$selection.formDetail.id" }
                        },
                        "after": { "opens": "sectionDetail", "row": "$result.ref", "resource": "$result" }
                    },
                    {
                        "id": "reorderSections",
                        "label": "Reorder sections",
                        "endpoint": {
                            "endpoint": "reorderSections",
                            "body": {
                                "context": "$selection.formDetail.id",
                                "refs": "$value"
                            }
                        }
                    }
                ]
            }
        ],
        "aside": [
            {
                "id": "publication",
                "title": "Publication",
                "fields": [
                    { "id": "status", "label": "Status", "path": "status", "type": "readonly", "format": "badge" },
                    { "id": "version", "label": "Published version", "path": "version", "type": "readonly" },
                    { "id": "publishedAt", "label": "Published", "path": "publishedAt", "type": "readonly", "format": "date" }
                ]
            }
        ]
    }
]
