[
    {
        "endpointId": "manageSections",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/sections",
        "params": [{ "name": "context", "in": "query", "type": "string", "required": true }],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/builder/section-list.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "createSection",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/sections/create",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": {
            "type": "object",
            "properties": { "context": { "type": "string" } },
            "required": ["context"]
        },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/builder/section.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "reorderSections",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/sections/reorder",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": {
            "type": "object",
            "properties": {
                "context": { "type": "string" },
                "refs": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["context", "refs"]
        },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/builder/section-list.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "manageSection",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/section",
        "params": [{ "name": "ref", "in": "query", "type": "string", "required": true }],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/builder/section.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "saveSection",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/section",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": {
            "type": "object",
            "properties": {
                "ref": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string", "nullable": true }
            },
            "required": ["ref", "title"]
        },
        "output": [
            { "status": "200", "body": { "$include": "../../schemas/builder/section.json" } },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    },
    {
        "endpointId": "deleteSection",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/admin/form/section/delete",
        "params": [],
        "headers": { "$include": "../../shared/admin-headers.json" },
        "body": {
            "type": "object",
            "properties": { "ref": { "type": "string" } },
            "required": ["ref"]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": { "ok": { "type": "boolean" }, "formKey": { "type": "string" } },
                    "required": ["ok", "formKey"]
                }
            },
            { "status": "default", "body": { "$include": "../../schemas/error.json" } }
        ]
    }
]
