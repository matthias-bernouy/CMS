{
    "id": "choices",
    "title": "Choices",
    "description": "Each answer stores its stable key. Labels and images can evolve without changing submitted values.",
    "fields": [
        {
            "id": "options",
            "label": "Options",
            "path": "options",
            "type": "reorderable-list",
            "itemKey": "key",
            "positionPath": "position",
            "addLabel": "Add option",
            "maxItems": 50,
            "visibleWhen": {
                "any": [
                    { "value": "$field.type", "equals": "select" },
                    {
                        "all": [
                            { "value": "$field.type", "equals": "choice" },
                            { "value": "$field.presentation", "notEquals": "image-grid" }
                        ]
                    }
                ]
            },
            "fields": [
                { "id": "key", "label": "Stable key", "path": "key", "required": true },
                { "id": "label", "label": "Label", "path": "label", "required": true }
            ]
        },
        {
            "id": "imageOptions",
            "label": "Image choices",
            "path": "options",
            "type": "reorderable-list",
            "layout": "cards",
            "itemKey": "key",
            "positionPath": "position",
            "addLabel": "Add image choice",
            "maxItems": 50,
            "visibleWhen": {
                "all": [
                    { "value": "$field.type", "equals": "choice" },
                    { "value": "$field.presentation", "equals": "image-grid" }
                ]
            },
            "fields": [
                {
                    "id": "image",
                    "label": "Image",
                    "path": "image",
                    "type": "media",
                    "required": true,
                    "item": { "idPath": "mediaId", "urlPath": "url", "altPath": "alt" },
                    "actions": {
                        "upload": { "endpoint": "uploadChoiceImage", "params": { "ref": "$resource.ref" } },
                        "replace": { "endpoint": "uploadChoiceImage", "params": { "ref": "$resource.ref" } }
                    }
                },
                { "id": "label", "label": "Label", "path": "label", "required": true },
                { "id": "key", "label": "Stable key", "path": "key", "required": true, "secondary": true },
                { "id": "imageAlt", "label": "Image alt text", "path": "image.alt", "secondary": true }
            ]
        },
        {
            "id": "multiple",
            "label": "Allow multiple choices",
            "path": "multiple",
            "type": "checkbox",
            "visibleWhen": { "value": "$field.type", "equals": "choice" }
        }
    ]
}
