{
    "type": "object",
    "properties": {
        "id": { "type": "number" },
        "receiptId": { "type": "string" },
        "formKey": { "type": "string" },
        "formVersion": { "type": "number" },
        "status": { "type": "string" },
        "submittedBy": { "type": "string", "nullable": true },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "answers": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "key": { "type": "string" },
                    "section": { "type": "string" },
                    "question": { "type": "string" },
                    "answer": { "type": "string" }
                },
                "required": ["key", "question", "answer"]
            }
        }
    },
    "required": ["id", "receiptId", "formKey", "formVersion", "status", "answers"]
}
