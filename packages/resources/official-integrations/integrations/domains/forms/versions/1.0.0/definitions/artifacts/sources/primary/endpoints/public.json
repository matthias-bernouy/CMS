[
    {
        "endpointId": "formPublic",
        "method": "GET",
        "access": "public",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/public/form",
        "meta": {
            "name": "Published public form",
            "description": "Resolve the current or an exact immutable version of a public form."
        },
        "params": [
            {
                "name": "key",
                "in": "query",
                "type": "string",
                "required": true
            },
            {
                "name": "version",
                "in": "query",
                "type": "number"
            }
        ],
        "headers": {
            "$include": "../shared/service-headers.json"
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "$include": "../schemas/form.json"
                }
            },
            {
                "status": "default",
                "body": {
                    "$include": "../schemas/error.json"
                }
            }
        ]
    },
    {
        "endpointId": "submitPublic",
        "method": "POST",
        "access": "public",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/public/submission",
        "meta": {
            "name": "Submit public form",
            "description": "Validate and idempotently store answers for a public form version."
        },
        "params": [
            {
                "name": "key",
                "in": "query",
                "type": "string",
                "required": true
            }
        ],
        "headers": {
            "$include": "../shared/service-headers.json"
        },
        "body": {
            "$include": "../schemas/submission-input.json"
        },
        "output": [
            {
                "status": "202",
                "body": {
                    "$include": "../schemas/result.json"
                }
            },
            {
                "status": "default",
                "body": {
                    "$include": "../schemas/error.json"
                }
            }
        ]
    },
    {
        "endpointId": "formImagePublic",
        "method": "GET",
        "access": "public",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/public/form/image",
        "params": [
            { "name": "key", "in": "query", "type": "string", "required": true },
            { "name": "version", "in": "query", "type": "number", "required": true },
            { "name": "id", "in": "query", "type": "string", "required": true }
        ],
        "headers": { "$include": "../shared/service-headers.json" },
        "responseKind": "file",
        "mediaType": "image/*",
        "output": [{ "status": "200" }]
    }
]
