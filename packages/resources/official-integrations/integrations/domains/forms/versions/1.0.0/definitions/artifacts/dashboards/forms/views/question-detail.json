[
    {
        "widget": "w-detail",
        "id": "questionDetail",
        "source": { "endpoint": "manageQuestion", "params": { "ref": "$selection.id" } },
        "title": { "path": "label", "fallback": "Question" },
        "status": { "path": "type" },
        "actions": [
            {
                "id": "saveQuestion",
                "label": "Save question",
                "tone": "primary",
                "placement": "primary",
                "endpoint": {
                    "endpoint": "saveQuestion",
                    "body": {
                        "ref": "$resource.ref",
                        "key": "$field.key",
                        "label": "$field.label",
                        "type": "$field.type",
                        "required": "$field.required",
                        "hint": "$field.hint",
                        "placeholder": "$field.placeholder",
                        "presentation": "$field.presentation",
                        "multiple": "$field.multiple",
                        "options": "$field.options",
                        "imageOptions": "$field.imageOptions"
                    }
                },
                "after": { "opens": "questionDetail", "row": "$result.ref", "resource": "$result" }
            },
            {
                "id": "backToSection",
                "label": "Section",
                "placement": "secondary",
                "endpoint": { "endpoint": "manageSection", "params": { "ref": "$resource.sectionRef" } },
                "after": { "opens": "sectionDetail", "row": "$result.ref" }
            },
            {
                "id": "deleteQuestion",
                "label": "Delete question",
                "tone": "danger",
                "placement": "more",
                "confirm": "Delete this question? Existing published versions and responses remain unchanged.",
                "endpoint": { "endpoint": "deleteQuestion", "body": { "ref": "$resource.ref" } },
                "after": { "opens": "sectionDetail", "row": "$result.sectionRef" }
            }
        ],
        "main": [
            {
                "id": "questionContent",
                "title": "Question",
                "fields": [
                    { "id": "label", "label": "Label", "path": "label", "type": "text", "required": true },
                    {
                        "id": "key",
                        "label": "Stable key",
                        "path": "key",
                        "type": "text",
                        "required": true,
                        "placeholder": "customerIntent"
                    },
                    {
                        "id": "type",
                        "label": "Answer type",
                        "path": "type",
                        "type": "select",
                        "required": true,
                        "options": [
                            { "value": "text", "label": "Short text" },
                            { "value": "textarea", "label": "Long text" },
                            { "value": "email", "label": "Email" },
                            { "value": "tel", "label": "Phone" },
                            { "value": "number", "label": "Number" },
                            { "value": "date", "label": "Date" },
                            { "value": "select", "label": "Dropdown" },
                            { "value": "choice", "label": "Choice chips" },
                            { "value": "checkbox", "label": "Confirmation checkbox" }
                        ]
                    },
                    { "id": "required", "label": "Required answer", "path": "required", "type": "checkbox" },
                    { "id": "hint", "label": "Help text", "path": "hint", "type": "text" },
                    { "id": "placeholder", "label": "Placeholder", "path": "placeholder", "type": "text" },
                    {
                        "id": "presentation",
                        "label": "Choice layout",
                        "path": "presentation",
                        "type": "select",
                        "options": [
                            { "value": "chips", "label": "Choice chips" },
                            { "value": "image-grid", "label": "Image grid" }
                        ],
                        "visibleWhen": { "value": "$field.type", "equals": "choice" }
                    }
                ]
            },
            {
                "id": "choices",
                "title": "Choices",
                "description": "Each answer stores its stable key. Labels and images can evolve without changing submitted values.",
                "fields": [
                    {
                        "id": "options",
                        "label": "Options",
                        "path": "options",
                        "type": "reorderable-list",
                        "itemKey": "key",
                        "positionPath": "position",
                        "addLabel": "Add option",
                        "maxItems": 50,
                        "visibleWhen": {
                            "any": [
                                { "value": "$field.type", "equals": "select" },
                                {
                                    "all": [
                                        { "value": "$field.type", "equals": "choice" },
                                        { "value": "$field.presentation", "notEquals": "image-grid" }
                                    ]
                                }
                            ]
                        },
                        "fields": [
                            { "id": "key", "label": "Stable key", "path": "key", "required": true },
                            { "id": "label", "label": "Label", "path": "label", "required": true }
                        ]
                    },
                    {
                        "id": "imageOptions",
                        "label": "Image choices",
                        "path": "options",
                        "type": "reorderable-list",
                        "layout": "cards",
                        "itemKey": "key",
                        "positionPath": "position",
                        "addLabel": "Add image choice",
                        "maxItems": 50,
                        "visibleWhen": {
                            "all": [
                                { "value": "$field.type", "equals": "choice" },
                                { "value": "$field.presentation", "equals": "image-grid" }
                            ]
                        },
                        "fields": [
                            {
                                "id": "image",
                                "label": "Image",
                                "path": "image",
                                "type": "media",
                                "required": true,
                                "item": { "idPath": "mediaId", "urlPath": "url", "altPath": "alt" },
                                "actions": {
                                    "upload": {
                                        "endpoint": "uploadChoiceImage",
                                        "params": { "ref": "$resource.ref" }
                                    },
                                    "replace": {
                                        "endpoint": "uploadChoiceImage",
                                        "params": { "ref": "$resource.ref" }
                                    }
                                }
                            },
                            { "id": "label", "label": "Label", "path": "label", "required": true },
                            {
                                "id": "key",
                                "label": "Stable key",
                                "path": "key",
                                "required": true,
                                "secondary": true
                            },
                            {
                                "id": "imageAlt",
                                "label": "Image alt text",
                                "path": "image.alt",
                                "secondary": true
                            }
                        ]
                    },
                    {
                        "id": "multiple",
                        "label": "Allow multiple choices",
                        "path": "multiple",
                        "type": "checkbox",
                        "visibleWhen": { "value": "$field.type", "equals": "choice" }
                    }
                ]
            }
        ],
        "aside": [
            {
                "id": "questionMetadata",
                "title": "Location",
                "fields": [
                    { "id": "sectionTitle", "label": "Section", "path": "sectionTitle", "type": "readonly" },
                    { "id": "formKey", "label": "Form", "path": "formKey", "type": "readonly" }
                ]
            }
        ]
    }
]
