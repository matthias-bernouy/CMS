[
    {
        "endpointId": "formAuthenticated",
        "method": "GET",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/authenticated/form",
        "meta": {
            "name": "Published authenticated form",
            "description": "Resolve a form that requires the trusted CMS user identity."
        },
        "params": [
            {
                "name": "key",
                "in": "query",
                "type": "string",
                "required": true
            },
            {
                "name": "version",
                "in": "query",
                "type": "number"
            }
        ],
        "headers": {
            "$include": "../shared/actor-headers.json"
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "$include": "../schemas/form.json"
                }
            },
            {
                "status": "default",
                "body": {
                    "$include": "../schemas/error.json"
                }
            }
        ]
    },
    {
        "endpointId": "submitAuthenticated",
        "method": "POST",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-forms/authenticated/submission",
        "meta": {
            "name": "Submit authenticated form",
            "description": "Store answers with the trusted CMS user identity."
        },
        "params": [
            {
                "name": "key",
                "in": "query",
                "type": "string",
                "required": true
            }
        ],
        "headers": {
            "$include": "../shared/actor-headers.json"
        },
        "body": {
            "$include": "../schemas/submission-input.json"
        },
        "output": [
            {
                "status": "202",
                "body": {
                    "$include": "../schemas/result.json"
                }
            },
            {
                "status": "default",
                "body": {
                    "$include": "../schemas/error.json"
                }
            }
        ]
    }
]
