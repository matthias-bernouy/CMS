[
    {
        "name": "authorization",
        "source": {
            "from": "secret",
            "ref": "{{secrets.cmsApiKey}}",
            "prefix": "Bearer "
        }
    },
    {
        "name": "x-cms-user-id",
        "source": {
            "from": "computed",
            "ref": "userID"
        }
    },
    {
        "name": "x-cms-user-role",
        "source": {
            "from": "computed",
            "ref": "userRole"
        }
    }
]
