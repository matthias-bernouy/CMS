[
    {
        "endpointId": "openMyOrderClaim",
        "method": "POST",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/order/claim",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "orderId": {
                    "type": "number"
                },
                "reason": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "requestedAmount": {
                    "type": "number"
                }
            },
            "required": [
                "orderId",
                "reason",
                "description"
            ]
        },
        "output": [
            {
                "status": "201",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "publicId": {
                            "type": "string"
                        },
                        "orderId": {
                            "type": "number"
                        },
                        "reason": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string"
                        },
                        "sellerResponseByAt": {
                            "type": "string"
                        },
                        "version": {
                            "type": "number"
                        },
                        "createdAt": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    }
]
