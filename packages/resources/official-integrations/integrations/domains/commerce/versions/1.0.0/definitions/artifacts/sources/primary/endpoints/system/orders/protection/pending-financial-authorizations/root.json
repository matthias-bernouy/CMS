[
    {
        "$include": "pending-order-refund-authorizations.json"
    },
    {
        "endpointId": "pendingPaymentCancellationAuthorizations",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/payment-cancellations/pending",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "runKey": {
                    "type": "string"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "runKey"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "runKey": {
                            "type": "string"
                        },
                        "authorizations": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "status": {
                                        "type": "string"
                                    },
                                    "paymentCancellationRequestId": {
                                        "type": "number"
                                    },
                                    "cancellationRequestId": {
                                        "type": "string"
                                    },
                                    "orderId": {
                                        "type": "number"
                                    },
                                    "orderPublicId": {
                                        "type": "string"
                                    },
                                    "clientReferenceId": {
                                        "type": "string"
                                    },
                                    "providerPaymentId": {
                                        "type": "number",
                                        "nullable": true
                                    },
                                    "providerPaymentIntentId": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "targetOrderStatus": {
                                        "type": "string"
                                    },
                                    "reason": {
                                        "type": "string"
                                    },
                                    "amount": {
                                        "type": "number"
                                    },
                                    "currency": {
                                        "type": "string"
                                    },
                                    "financialTermsHash": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "status",
                                    "paymentCancellationRequestId",
                                    "cancellationRequestId",
                                    "orderId",
                                    "orderPublicId",
                                    "clientReferenceId",
                                    "targetOrderStatus",
                                    "reason",
                                    "amount",
                                    "currency",
                                    "financialTermsHash"
                                ]
                            }
                        }
                    },
                    "required": [
                        "runKey",
                        "authorizations"
                    ]
                }
            }
        ]
    }
]
