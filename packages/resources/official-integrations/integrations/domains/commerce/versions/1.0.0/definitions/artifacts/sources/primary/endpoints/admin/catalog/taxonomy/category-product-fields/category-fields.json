{
    "endpointId": "categoryFields",
    "method": "GET",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/category-fields",
    "params": [
        {
            "name": "categoryId",
            "in": "query",
            "type": "number",
            "required": true
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "categoryId": {
                                    "type": "number"
                                },
                                "fieldKey": {
                                    "type": "string"
                                },
                                "required": {
                                    "type": "boolean"
                                },
                                "filterable": {
                                    "type": "boolean"
                                },
                                "position": {
                                    "type": "number"
                                },
                                "definition": {
                                    "type": "object",
                                    "properties": {
                                        "label": {
                                            "type": "string"
                                        },
                                        "fieldType": {
                                            "type": "string"
                                        },
                                        "options": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "unit": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "publicReadable": {
                                            "type": "boolean"
                                        },
                                        "enabled": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "total": {
                        "type": "number"
                    }
                }
            }
        }
    ]
}
