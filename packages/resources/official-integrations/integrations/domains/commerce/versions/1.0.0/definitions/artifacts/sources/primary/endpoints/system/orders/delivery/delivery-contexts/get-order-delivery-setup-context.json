{
    "endpointId": "getOrderDeliverySetupContext",
    "method": "GET",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/delivery-setup-context",
    "params": [
        {
            "name": "orderId",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "order": {
                        "type": "object",
                        "properties": {
                            "publicId": {
                                "type": "string"
                            },
                            "buyerCmsUserId": {
                                "type": "string",
                                "semantic": {
                                    "kind": "user-id",
                                    "authority": "cms"
                                }
                            },
                            "status": {
                                "type": "string"
                            },
                            "version": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "publicId",
                            "buyerCmsUserId",
                            "status",
                            "version"
                        ]
                    },
                    "authorization": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "buyerCmsUserId": {
                                "type": "string",
                                "semantic": {
                                    "kind": "user-id",
                                    "authority": "cms"
                                }
                            },
                            "status": {
                                "type": "string"
                            },
                            "orderVersion": {
                                "type": "number"
                            },
                            "sellerCmsUserId": {
                                "type": "string",
                                "semantic": {
                                    "kind": "user-id",
                                    "authority": "cms"
                                }
                            },
                            "currency": {
                                "type": "string"
                            },
                            "merchandiseSubtotalMinorAmount": {
                                "type": "number"
                            },
                            "shippingAddress": {
                                "type": "object"
                            }
                        },
                        "required": [
                            "buyerCmsUserId",
                            "status",
                            "orderVersion",
                            "sellerCmsUserId",
                            "currency",
                            "merchandiseSubtotalMinorAmount",
                            "shippingAddress"
                        ]
                    }
                },
                "required": [
                    "order",
                    "authorization"
                ]
            }
        }
    ]
}
