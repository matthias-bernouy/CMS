{
    "endpointId": "upsertCustomField",
    "method": "POST",
    "effects": {
        "invalidatesSchema": true
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/custom-field",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "entityType": {
                "type": "string"
            },
            "key": {
                "type": "string"
            },
            "label": {
                "type": "string"
            },
            "fieldType": {
                "type": "string"
            },
            "options": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "unit": {
                "type": "string"
            },
            "required": {
                "type": "boolean"
            },
            "selfEditable": {
                "type": "boolean"
            },
            "adminEditable": {
                "type": "boolean"
            },
            "publicReadable": {
                "type": "boolean"
            },
            "showInDashboardTable": {
                "type": "boolean"
            },
            "position": {
                "type": "number"
            },
            "enabled": {
                "type": "boolean"
            }
        },
        "required": [
            "entityType",
            "key",
            "label",
            "fieldType"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "entityType": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "fieldType": {
                        "type": "string"
                    },
                    "options": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "unit": {
                        "type": "string",
                        "nullable": true
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "selfEditable": {
                        "type": "boolean"
                    },
                    "adminEditable": {
                        "type": "boolean"
                    },
                    "publicReadable": {
                        "type": "boolean"
                    },
                    "showInDashboardTable": {
                        "type": "boolean"
                    },
                    "position": {
                        "type": "number"
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "updatedAt": {
                        "type": "string"
                    }
                }
            }
        }
    ]
}
