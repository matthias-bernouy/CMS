{
    "endpointId": "upsertProduct",
    "method": "POST",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/product",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "expectedVersion": {
                "type": "number"
            },
            "slug": {
                "type": "string"
            },
            "title": {
                "type": "string"
            },
            "description": {
                "type": "string"
            },
            "brandId": {
                "type": "string"
            },
            "primaryCategoryId": {
                "type": "string"
            },
            "variantAxes": {
                "type": "array",
                "items": {
                    "type": "object"
                }
            },
            "status": {
                "type": "string"
            },
            "visibility": {
                "type": "string"
            },
            "metadata": {
                "type": "object"
            }
        }
    },
    "output": {
        "$include": "upsert-product/output/responses.json"
    }
}
