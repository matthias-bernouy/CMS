{
    "widget": "w-detail",
    "id": "workflowStateDetail",
    "source": {
        "endpoint": "workflowState",
        "params": {
            "code": "$selection.id"
        }
    },
    "title": {
        "path": "label",
        "fallback": "New workflow state"
    },
    "status": {
        "path": "phase"
    },
    "actions": [
        {
            "id": "saveWorkflowState",
            "label": "Save state",
            "tone": "primary",
            "placement": "primary",
            "endpoint": {
                "endpoint": "upsertWorkflowState",
                "body": {
                    "code": "$field.code",
                    "label": "$field.label",
                    "phase": "$field.phase",
                    "position": "$field.position",
                    "enabled": "$field.enabled",
                    "terminal": "$field.terminal"
                }
            },
            "after": {
                "resource": "$result"
            }
        }
    ],
    "main": [
        {
            "id": "workflowStateFields",
            "title": "State",
            "fields": [
                {
                    "id": "code",
                    "label": "Code",
                    "path": "code",
                    "type": "text",
                    "required": true
                },
                {
                    "id": "label",
                    "label": "Label",
                    "path": "label",
                    "type": "text",
                    "required": true
                },
                {
                    "id": "phase",
                    "label": "Phase",
                    "path": "phase",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "draft",
                            "label": "Draft"
                        },
                        {
                            "value": "seller_input",
                            "label": "Seller input"
                        },
                        {
                            "value": "admin_review",
                            "label": "Administrator review"
                        },
                        {
                            "value": "ready",
                            "label": "Ready"
                        },
                        {
                            "value": "terminal",
                            "label": "Terminal"
                        }
                    ]
                },
                {
                    "id": "position",
                    "label": "Position",
                    "path": "position",
                    "type": "text"
                },
                {
                    "id": "enabled",
                    "label": "Enabled",
                    "path": "enabled",
                    "type": "select",
                    "options": [
                        {
                            "value": "true",
                            "label": "Yes"
                        },
                        {
                            "value": "false",
                            "label": "No"
                        }
                    ]
                },
                {
                    "id": "terminal",
                    "label": "Terminal",
                    "path": "terminal",
                    "type": "select",
                    "options": [
                        {
                            "value": "true",
                            "label": "Yes"
                        },
                        {
                            "value": "false",
                            "label": "No"
                        }
                    ]
                }
            ]
        }
    ]
}
