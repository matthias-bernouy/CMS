[
    {
        "$include": "workflow-states.json"
    },
    {
        "endpointId": "workflowState",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/workflow-state",
        "params": [
            {
                "name": "code",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "code": {
                            "type": "string"
                        },
                        "label": {
                            "type": "string"
                        },
                        "phase": {
                            "type": "string"
                        },
                        "position": {
                            "type": "number"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "terminal": {
                            "type": "boolean"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    },
    {
        "$include": "upsert-workflow-state.json"
    },
    {
        "endpointId": "workflowTransitions",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/workflow-transitions",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "fromState": {
                                        "type": "string"
                                    },
                                    "action": {
                                        "type": "string"
                                    },
                                    "actorKind": {
                                        "type": "string"
                                    },
                                    "toState": {
                                        "type": "string"
                                    },
                                    "createdAt": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "total": {
                            "type": "number"
                        }
                    }
                }
            }
        ]
    }
]
