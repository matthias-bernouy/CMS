{
    "endpointId": "createC2cPolicyRevision",
    "method": "POST",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/c2c-policies",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "body": {
        "$include": "body/root.json"
    },
    "output": [
        {
            "status": "201",
            "body": {
                "type": "object",
                "properties": {
                    "feePolicyId": {
                        "type": "number"
                    },
                    "protectionPolicyId": {
                        "type": "number"
                    },
                    "sellerRiskPolicyId": {
                        "type": "number"
                    },
                    "policyVersion": {
                        "type": "number"
                    },
                    "settingsVersion": {
                        "type": "number"
                    }
                }
            }
        }
    ]
}
