[
    {
        "endpointId": "settings",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/settings",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "mode": {
                            "type": "string"
                        },
                        "defaultCurrency": {
                            "type": "string"
                        },
                        "requireVerifiedSeller": {
                            "type": "boolean"
                        },
                        "offerModeration": {
                            "type": "string"
                        },
                        "pricePolicy": {
                            "type": "string"
                        },
                        "autoApprovePriceInRange": {
                            "type": "boolean"
                        },
                        "requireFinalPriceApproval": {
                            "type": "boolean"
                        },
                        "sellerCanPublish": {
                            "type": "boolean"
                        },
                        "activeC2cFeePolicyId": {
                            "type": "number"
                        },
                        "activeC2cProtectionPolicyId": {
                            "type": "number"
                        },
                        "activeC2cSellerRiskPolicyId": {
                            "type": "number"
                        },
                        "version": {
                            "type": "number"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    },
    {
        "$include": "update-settings.json"
    }
]
