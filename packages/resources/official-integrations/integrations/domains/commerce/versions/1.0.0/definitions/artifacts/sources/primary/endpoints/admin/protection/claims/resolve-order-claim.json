[
    {
        "endpointId": "resolveOrderClaim",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/claim/resolve",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            },
            {
                "name": "x-cms-user-role",
                "source": {
                    "from": "computed",
                    "ref": "userRole"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "claimId": {
                    "type": "number"
                },
                "outcome": {
                    "type": "string"
                },
                "sellerTransferAmount": {
                    "type": "number"
                },
                "buyerRefundAmount": {
                    "type": "number",
                    "description": "Legacy aggregate buyer refund in minor units. Submit this field alone, or submit both allocated refund fields."
                },
                "merchandiseRefundAmount": {
                    "type": "number",
                    "description": "Minor-unit amount allocated to refunded merchandise."
                },
                "shippingRefundAmount": {
                    "type": "number",
                    "description": "Minor-unit amount allocated to refunded shipping."
                },
                "protectionFeeRefundAmount": {
                    "type": "number"
                },
                "decisionReason": {
                    "type": "string"
                },
                "expectedVersion": {
                    "type": "number"
                }
            },
            "required": [
                "claimId",
                "outcome",
                "sellerTransferAmount",
                "protectionFeeRefundAmount",
                "decisionReason",
                "expectedVersion"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "publicId": {
                            "type": "string"
                        },
                        "orderId": {
                            "type": "number"
                        },
                        "status": {
                            "type": "string"
                        },
                        "resolutionOutcome": {
                            "type": "string"
                        },
                        "resolutionBuyerRefundAmount": {
                            "type": "number"
                        },
                        "resolutionSellerTransferAmount": {
                            "type": "number"
                        },
                        "decisionReason": {
                            "type": "string"
                        },
                        "version": {
                            "type": "number"
                        },
                        "refundAuthorization": {
                            "type": "object",
                            "nullable": true
                        },
                        "paymentCancellationAuthorization": {
                            "type": "object",
                            "nullable": true
                        }
                    }
                }
            }
        ]
    }
]
