{
    "endpointId": "c2cPolicies",
    "method": "GET",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/c2c-policies",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "output": {
        "$include": "c2c-policies/output/responses.json"
    }
}
