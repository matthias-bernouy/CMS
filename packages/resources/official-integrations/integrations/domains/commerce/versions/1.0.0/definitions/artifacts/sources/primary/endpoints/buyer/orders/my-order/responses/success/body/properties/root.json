            "type": "object",
            "properties": {
                "key": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                },
                "unit": {
                    "type": "string"
                }
            },
            "required": [
                "key",
                "label",
                "type",
                "value"
            ]
        }
    },
    "idempotencyKey": {
        "type": "string"
    },
