                "type": "number"
            },
            "shippingAmount": {
                "type": "number"
            },
            "buyerProtectionFeeAmount": {
                "type": "number"
            },
            "buyerTotalAmount": {
                "type": "number"
            },
            "currency": {
                "type": "string"
            }
        },
        "nullable": true
    }
