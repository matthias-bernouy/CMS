        "type": "object",
        "properties": {
            "id": {
                "type": "number",
                "semantic": "user-id"
            },
            "kind": {
                "type": "string"
            },
            "slug": {
                "type": "string"
            },
            "displayName": {
                "type": "string"
            }
        }
