{
    "endpointId": "getProtectedCheckoutSellerContext",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/protected-checkout/seller-context",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "agreementId": {
                "type": "string"
            },
            "items": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "offerId": {
                            "type": "string"
                        },
                        "quantity": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "offerId",
                        "quantity"
                    ]
                }
            }
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "sellerCmsUserId": {
                        "type": "string",
                        "semantic": {
                            "kind": "user-id",
                            "authority": "cms"
                        }
                    },
                    "buyerCmsUserId": {
                        "type": "string",
                        "semantic": {
                            "kind": "user-id",
                            "authority": "cms"
                        }
                    }
                },
                "required": [
                    "sellerCmsUserId",
                    "buyerCmsUserId"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "403",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "404",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "422",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        }
    ]
}
