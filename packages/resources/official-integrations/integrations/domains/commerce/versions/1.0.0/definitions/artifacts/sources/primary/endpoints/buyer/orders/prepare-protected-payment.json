[
    {
        "endpointId": "prepareProtectedPayment",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/order/payment/prepare",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "orderId": {
                    "type": "number"
                },
                "acceptedLegalDocumentVersionIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "paymentProvider": {
                    "type": "string"
                }
            },
            "required": [
                "orderId"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "orderId": {
                            "type": "number"
                        },
                        "orderPublicId": {
                            "type": "string"
                        },
                        "orderNumber": {
                            "type": "string"
                        },
                        "buyerCmsUserId": {
                            "type": "string",
                            "semantic": {
                                "kind": "user-id",
                                "authority": "cms"
                            }
                        },
                        "sellerId": {
                            "type": "string",
                            "semantic": {
                                "kind": "user-id",
                                "authority": "cms"
                            }
                        },
                        "currency": {
                            "type": "string"
                        },
                        "buyerTotalAmount": {
                            "type": "number"
                        },
                        "sellerProceedsAmount": {
                            "type": "number"
                        },
                        "sellerTransferReleaseAmount": {
                            "type": "number"
                        },
                        "sellerReserveLiabilityAmount": {
                            "type": "number"
                        },
                        "platformRetainedAmount": {
                            "type": "number"
                        },
                        "sellerRequiredMinimumBalanceAmount": {
                            "type": "number"
                        },
                        "platformRequiredMinimumBalanceAmount": {
                            "type": "number"
                        },
                        "payoutDelayDays": {
                            "type": "number"
                        },
                        "platformLiabilityRevision": {
                            "type": "number"
                        },
                        "platformPayoutDecreaseAuthorizationId": {
                            "type": "string",
                            "nullable": true
                        },
                        "platformPayoutChangeDirection": {
                            "type": "string"
                        },
                        "sellerReserveLiabilityDays": {
                            "type": "number"
                        },
                        "dualApprovalThresholdAmount": {
                            "type": "number"
                        },
                        "financialTermsHash": {
                            "type": "string"
                        },
                        "financialRevision": {
                            "type": "number"
                        },
                        "paymentAttemptId": {
                            "type": "number"
                        },
                        "buyerLegalAcceptances": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "key": {
                                        "type": "string"
                                    },
                                    "versionId": {
                                        "type": "string"
                                    },
                                    "contentHash": {
                                        "type": "string"
                                    },
                                    "acceptedAt": {
                                        "type": "string"
                                    },
                                    "correlationId": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "key",
                                    "versionId",
                                    "contentHash",
                                    "acceptedAt",
                                    "correlationId"
                                ]
                            }
                        },
                        "payByAt": {
                            "type": "string"
                        },
                        "protectionRequired": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "orderId",
                        "orderPublicId",
                        "sellerId",
                        "currency",
                        "buyerTotalAmount",
                        "sellerProceedsAmount",
                        "sellerTransferReleaseAmount",
                        "sellerReserveLiabilityAmount",
                        "sellerRequiredMinimumBalanceAmount",
                        "platformRequiredMinimumBalanceAmount",
                        "platformLiabilityRevision",
                        "platformPayoutChangeDirection",
                        "payoutDelayDays",
                        "sellerReserveLiabilityDays",
                        "dualApprovalThresholdAmount",
                        "financialTermsHash",
                        "financialRevision",
                        "paymentAttemptId",
                        "buyerLegalAcceptances",
                        "protectionRequired"
                    ]
                }
            },
            {
                "status": "409",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "422",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            }
        ]
    }
]
