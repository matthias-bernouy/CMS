{
    "endpointId": "checkoutMyCart",
    "method": "POST",
    "access": "auth",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/cart/checkout",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "idempotencyKey": {
                "type": "string"
            },
            "expectedVersion": {
                "type": "number"
            },
            "shippingAddress": {
                "type": "object"
            },
            "billingAddress": {
                "type": "object"
            },
            "metadata": {
                "type": "object"
            }
        },
        "required": [
            "idempotencyKey",
            "expectedVersion"
        ]
    },
    "output": {
        "$include": "output/root.json"
    }
}
