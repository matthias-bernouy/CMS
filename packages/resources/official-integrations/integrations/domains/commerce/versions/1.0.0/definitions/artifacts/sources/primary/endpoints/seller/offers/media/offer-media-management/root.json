[
    {
        "endpointId": "myOfferImage",
        "access": "auth",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/offer/image",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "string",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "responseKind": "file",
        "mediaType": "image/*",
        "output": [
            {
                "status": "200"
            },
            {
                "status": "206"
            }
        ]
    },
    {
        "$include": "upload-my-offer-image.json"
    },
    {
        "$include": "replace-my-offer-image.json"
    },
    {
        "endpointId": "removeMyOfferImage",
        "access": "auth",
        "method": "DELETE",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/offer/image",
        "params": [
            {
                "name": "offerId",
                "in": "query",
                "type": "string"
            },
            {
                "name": "mediaId",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "ok": {
                            "type": "boolean"
                        },
                        "mediaId": {
                            "type": "number"
                        }
                    }
                }
            }
        ]
    },
    {
        "$include": "reorder-my-offer-images.json"
    }
]
