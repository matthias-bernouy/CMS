[
    {
        "endpointId": "requestOrderRefund",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/order/refund",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            },
            {
                "name": "x-cms-user-role",
                "source": {
                    "from": "computed",
                    "ref": "userRole"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "orderId": {
                    "type": "number"
                },
                "reason": {
                    "type": "string"
                },
                "merchandiseRefundAmount": {
                    "type": "number",
                    "description": "Minor-unit amount allocated to refunded merchandise."
                },
                "shippingRefundAmount": {
                    "type": "number",
                    "description": "Minor-unit amount allocated to refunded shipping."
                },
                "protectionFeeRefundAmount": {
                    "type": "number"
                }
            },
            "required": [
                "orderId",
                "reason",
                "merchandiseRefundAmount",
                "shippingRefundAmount",
                "protectionFeeRefundAmount"
            ]
        },
        "output": [
            {
                "status": "201",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "orderId": {
                            "type": "number"
                        },
                        "businessKey": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string"
                        },
                        "requestedAmount": {
                            "type": "number"
                        },
                        "merchandiseRefundAmount": {
                            "type": "number"
                        },
                        "shippingRefundAmount": {
                            "type": "number"
                        },
                        "protectionFeeRefundAmount": {
                            "type": "number"
                        },
                        "allocationVersion": {
                            "type": "number"
                        },
                        "requiresFinanceApproval": {
                            "type": "boolean"
                        },
                        "version": {
                            "type": "number"
                        },
                        "refundAuthorization": {
                            "type": "object",
                            "nullable": true
                        }
                    }
                }
            }
        ]
    }
]
