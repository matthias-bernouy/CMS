[
    {
        "endpointId": "claimPendingShipmentCancellations",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/shipment-cancellations/claim",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "runKey": {
                    "type": "string"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "runKey",
                "limit"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "operationId": {
                                        "type": "number"
                                    },
                                    "claimToken": {
                                        "type": "string"
                                    },
                                    "businessKey": {
                                        "type": "string"
                                    },
                                    "status": {
                                        "type": "string"
                                    },
                                    "orderId": {
                                        "type": "number"
                                    },
                                    "orderPublicId": {
                                        "type": "string"
                                    },
                                    "providerReference": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "trackingUntil": {
                                        "type": "string"
                                    },
                                    "cancellationRequestId": {
                                        "type": "number"
                                    }
                                },
                                "required": [
                                    "operationId",
                                    "claimToken",
                                    "orderPublicId",
                                    "trackingUntil",
                                    "cancellationRequestId"
                                ]
                            }
                        }
                    },
                    "required": [
                        "items"
                    ]
                }
            }
        ]
    },
    {
        "$include": "complete-order-shipment-cancellation.json"
    },
    {
        "$include": "fail-order-shipment-cancellation.json"
    }
]
