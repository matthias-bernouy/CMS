[
    {
        "endpointId": "refreshPlatformPayoutLiability",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/platform-payout-liability/refresh",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "reason": {
                    "type": "string"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "liabilityRevision": {
                            "type": "number"
                        },
                        "requiredMinimumAmount": {
                            "type": "number"
                        },
                        "lastProviderAppliedRevision": {
                            "type": "number"
                        },
                        "lastProviderAppliedAmount": {
                            "type": "number"
                        },
                        "changeDirection": {
                            "type": "string"
                        },
                        "decreaseAuthorizationId": {
                            "type": "string",
                            "nullable": true
                        },
                        "decreaseAuthorizedAt": {
                            "type": "string",
                            "nullable": true
                        },
                        "calculatedAt": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    },
    {
        "endpointId": "recordPlatformPayoutLiabilityApplied",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/platform-payout-liability/applied",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "liabilityRevision": {
                    "type": "number"
                },
                "appliedMinimumAmount": {
                    "type": "number"
                },
                "decreaseAuthorizationId": {
                    "type": "string"
                }
            },
            "required": [
                "liabilityRevision",
                "appliedMinimumAmount"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "accepted": {
                            "type": "boolean"
                        },
                        "needsReapply": {
                            "type": "boolean"
                        },
                        "liabilityRevision": {
                            "type": "number"
                        },
                        "requiredMinimumAmount": {
                            "type": "number"
                        },
                        "lastProviderAppliedAmount": {
                            "type": "number"
                        }
                    }
                }
            }
        ]
    },
    {
        "$include": "pending-platform-payout-liability-authorizations.json"
    }
]
