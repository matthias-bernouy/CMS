{
    "id": "offerDetails",
    "title": "Details",
    "fields": [
        {
            "id": "slug",
            "label": "Slug",
            "path": "slug",
            "type": "text",
            "required": true
        },
        {
            "id": "title",
            "label": "Title",
            "path": "title",
            "type": "text",
            "required": true
        },
        {
            "id": "description",
            "label": "Description",
            "path": "description",
            "type": "textarea",
            "rows": 5
        },
        {
            "id": "sellerId",
            "label": "Seller",
            "path": "sellerId",
            "type": "combobox",
            "required": true,
            "lookup": {
                "endpoint": "sellers",
                "params": {
                    "q": "$search",
                    "limit": "20"
                },
                "itemsPath": "items",
                "valuePath": "id",
                "labelPath": "displayName",
                "subtitlePath": "verificationStatus",
                "selected": "$resource.seller"
            }
        },
        {
            "id": "productId",
            "label": "Product",
            "path": "productId",
            "type": "combobox",
            "required": true,
            "lookup": {
                "endpoint": "manageProducts",
                "params": {
                    "q": "$search",
                    "limit": "20"
                },
                "itemsPath": "items",
                "valuePath": "id",
                "labelPath": "title",
                "subtitlePath": "slug",
                "selected": "$resource.product"
            }
        },
        {
            "id": "variantId",
            "label": "Variant",
            "path": "variantId",
            "type": "combobox",
            "lookup": {
                "endpoint": "productVariants",
                "params": {
                    "productId": "$field.productId",
                    "q": "$search",
                    "limit": "20"
                },
                "itemsPath": "items",
                "valuePath": "id",
                "labelPath": "title",
                "subtitlePath": "sku",
                "selected": "$resource.variant"
            }
        },
        {
            "id": "conditionCode",
            "label": "Condition",
            "path": "conditionCode",
            "type": "combobox",
            "required": true,
            "lookup": {
                "endpoint": "offerConditions",
                "itemsPath": "items",
                "valuePath": "code",
                "labelPath": "label",
                "subtitlePath": "description"
            }
        }
    ]
}
