{
    "id": "product-by-slug",
    "label": "Product",
    "resolve": {
        "endpointId": "product",
        "identity": {
            "key": "slug",
            "inputParam": "slug",
            "outputPath": "slug"
        }
    },
    "discover": {
        "endpointId": "products",
        "itemsPath": "items",
        "identityPath": "slug",
        "lastModifiedPath": "updatedAt",
        "pagination": {
            "type": "offset",
            "limitParam": "limit",
            "offsetParam": "offset",
            "pageSize": 100,
            "totalPath": "total"
        }
    },
    "variables": {
        "id": {
            "path": "id",
            "type": "number"
        },
        "slug": {
            "path": "slug",
            "type": "text"
        },
        "title": {
            "path": "title",
            "type": "text"
        },
        "description": {
            "path": "description",
            "type": "text"
        },
        "updatedAt": {
            "path": "updatedAt",
            "type": "date"
        }
    },
    "defaults": {
        "titleTemplate": "${content.title}",
        "descriptionTemplate": "${content.description}"
    }
}
