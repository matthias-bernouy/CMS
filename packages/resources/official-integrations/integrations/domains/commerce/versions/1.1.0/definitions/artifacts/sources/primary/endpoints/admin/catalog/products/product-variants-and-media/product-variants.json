{
    "endpointId": "productVariants",
    "method": "GET",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/product/variants",
    "params": [
        {
            "name": "productId",
            "in": "query",
            "type": "string",
            "required": true
        },
        {
            "name": "q",
            "in": "query",
            "type": "string"
        },
        {
            "name": "status",
            "in": "query",
            "type": "string"
        },
        {
            "name": "limit",
            "in": "query",
            "type": "number"
        },
        {
            "name": "offset",
            "in": "query",
            "type": "number"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number"
                                },
                                "productId": {
                                    "type": "number"
                                },
                                "sku": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                },
                                "position": {
                                    "type": "number"
                                },
                                "combinationKey": {
                                    "type": "string"
                                },
                                "generatedFromAxes": {
                                    "type": "boolean"
                                },
                                "version": {
                                    "type": "number"
                                },
                                "createdAt": {
                                    "type": "string"
                                },
                                "updatedAt": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "total": {
                        "type": "number"
                    },
                    "limit": {
                        "type": "number"
                    },
                    "offset": {
                        "type": "number"
                    }
                }
            }
        }
    ]
}
