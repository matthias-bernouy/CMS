{
    "endpointId": "reserveOrderShipmentCreation",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/shipment-creation/reserve",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "orderPublicId": {
                "type": "string"
            },
            "workerId": {
                "type": "string"
            }
        },
        "required": [
            "orderPublicId"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "operationId": {
                        "type": "number"
                    },
                    "claimToken": {
                        "type": "string"
                    },
                    "businessKey": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "orderId": {
                        "type": "number"
                    },
                    "orderPublicId": {
                        "type": "string"
                    },
                    "sellerId": {
                        "type": "string",
                        "semantic": {
                            "kind": "user-id",
                            "authority": "cms"
                        }
                    },
                    "buyerCmsUserId": {
                        "type": "string",
                        "semantic": {
                            "kind": "user-id",
                            "authority": "cms"
                        }
                    },
                    "deliveryQuoteId": {
                        "type": "string"
                    },
                    "merchandiseSubtotalMinorAmount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "financialTermsHash": {
                        "type": "string"
                    },
                    "fulfillmentStatus": {
                        "type": "string"
                    }
                },
                "required": [
                    "operationId",
                    "claimToken",
                    "orderPublicId",
                    "sellerId",
                    "buyerCmsUserId",
                    "deliveryQuoteId",
                    "merchandiseSubtotalMinorAmount",
                    "currency",
                    "financialTermsHash"
                ]
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        }
    ]
}
