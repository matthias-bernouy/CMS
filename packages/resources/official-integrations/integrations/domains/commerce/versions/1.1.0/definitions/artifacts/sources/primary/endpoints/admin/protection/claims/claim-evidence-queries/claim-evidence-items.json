{
    "endpointId": "claimEvidenceItems",
    "method": "GET",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/claim/evidence-items",
    "params": [
        {
            "name": "claimId",
            "in": "query",
            "type": "number",
            "required": true
        },
        {
            "name": "limit",
            "in": "query",
            "type": "number"
        },
        {
            "name": "offset",
            "in": "query",
            "type": "number"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number"
                                },
                                "claimId": {
                                    "type": "number"
                                },
                                "submittedByKind": {
                                    "type": "string"
                                },
                                "mimeType": {
                                    "type": "string"
                                },
                                "fileSize": {
                                    "type": "number"
                                },
                                "originalFilename": {
                                    "type": "string"
                                },
                                "sha256": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "createdAt": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "total": {
                        "type": "number"
                    },
                    "limit": {
                        "type": "number"
                    },
                    "offset": {
                        "type": "number"
                    }
                },
                "required": [
                    "items",
                    "total",
                    "limit",
                    "offset"
                ]
            }
        }
    ]
}
