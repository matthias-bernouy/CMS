[
    {
        "endpointId": "processDueOrderDeadlines",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/deadlines/due",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "runKey": {
                    "type": "string"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "runKey",
                "limit"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "runKey": {
                            "type": "string"
                        },
                        "processed": {
                            "type": "number"
                        },
                        "events": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "kind": {
                                        "type": "string"
                                    },
                                    "orderId": {
                                        "type": "number"
                                    },
                                    "orderPublicId": {
                                        "type": "string"
                                    },
                                    "claimId": {
                                        "type": "number"
                                    },
                                    "cancellationRequestId": {
                                        "type": "number"
                                    },
                                    "outcome": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "kind",
                                    "orderId",
                                    "outcome"
                                ]
                            }
                        }
                    },
                    "required": [
                        "runKey",
                        "processed",
                        "events"
                    ]
                }
            }
        ]
    }
]
