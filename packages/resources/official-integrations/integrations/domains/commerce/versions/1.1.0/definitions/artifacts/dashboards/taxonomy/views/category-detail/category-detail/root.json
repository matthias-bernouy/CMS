{
    "widget": "w-detail",
    "id": "categoryDetail",
    "source": {
        "endpoint": "manageCategory",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "label",
        "fallback": "New category"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "saveCategory",
            "label": "Save category",
            "tone": "primary",
            "placement": "primary",
            "endpoint": {
                "endpoint": "upsertCategory",
                "params": {
                    "id": "$resource.id"
                },
                "body": {
                    "expectedVersion": "$resource.version",
                    "parentId": "$field.parentId",
                    "slug": "$field.slug",
                    "label": "$field.label",
                    "description": "$field.description",
                    "categoryFields": "$field.categoryFields",
                    "status": "$field.status"
                }
            }
        },
        {
            "id": "deleteCategory",
            "label": "Delete category",
            "icon": "trash",
            "tone": "danger",
            "placement": "more",
            "confirm": "Delete this category?",
            "visibleWhen": {
                "value": "$field.id",
                "notEquals": ""
            },
            "endpoint": {
                "endpoint": "deleteCategory",
                "params": {
                    "id": "$resource.id"
                }
            }
        }
    ],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "categoryState",
            "title": "State",
            "fields": [
                {
                    "id": "status",
                    "label": "Status",
                    "path": "status",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "active",
                            "label": "Active"
                        },
                        {
                            "value": "archived",
                            "label": "Archived"
                        }
                    ]
                },
                {
                    "id": "id",
                    "label": "Identifier",
                    "path": "id",
                    "type": "readonly"
                }
            ]
        }
    ]
}
