[
    {
        "endpointId": "recordDeliveryReconciliationHealth",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/delivery/reconciliation-health",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "runKey": {
                    "type": "string"
                },
                "checkedAt": {
                    "type": "string"
                },
                "pendingProjectionCount": {
                    "type": "number"
                },
                "manualReviewCount": {
                    "type": "number"
                },
                "trackingErrorCount": {
                    "type": "number"
                }
            },
            "required": [
                "runKey",
                "checkedAt",
                "pendingProjectionCount",
                "manualReviewCount",
                "trackingErrorCount"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "runKey": {
                            "type": "string"
                        },
                        "checkedAt": {
                            "type": "string"
                        },
                        "pendingProjectionCount": {
                            "type": "number"
                        },
                        "manualReviewCount": {
                            "type": "number"
                        },
                        "trackingErrorCount": {
                            "type": "number"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "runKey",
                        "checkedAt",
                        "pendingProjectionCount",
                        "manualReviewCount",
                        "trackingErrorCount"
                    ]
                }
            }
        ]
    },
    {
        "$include": "record-delivery-order-reconciliation-health.json"
    }
]
