[
    {
        "id": "platformEconomics",
        "title": "Platform costs and margin",
        "fields": [
            {
                "id": "costEstimatesConfigured",
                "label": "Cost estimates configured",
                "path": "activePolicy.fee.costEstimatesConfigured",
                "type": "checkbox"
            },
            {
                "id": "estimatedStripeCostAmount",
                "label": "Estimated Stripe cost",
                "path": "activePolicy.fee.estimatedStripeCostAmount",
                "type": "number",
                "required": true,
                "min": 0,
                "step": 1
            },
            {
                "id": "estimatedCarrierCostAmount",
                "label": "Estimated carrier cost",
                "path": "activePolicy.fee.estimatedCarrierCostAmount",
                "type": "number",
                "required": true,
                "min": 0,
                "step": 1
            },
            {
                "id": "platformRiskReserveContributionAmount",
                "label": "Risk reserve contribution",
                "path": "activePolicy.fee.platformRiskReserveContributionAmount",
                "type": "number",
                "required": true,
                "min": 0,
                "step": 1
            },
            {
                "id": "configuredMinimumMarginAmount",
                "label": "Minimum platform margin",
                "path": "activePolicy.fee.configuredMinimumMarginAmount",
                "type": "number",
                "required": true,
                "min": 0,
                "step": 1
            },
            {
                "id": "subsidyOverride",
                "label": "Audited subsidy override",
                "path": "activePolicy.fee.subsidyOverride",
                "type": "checkbox"
            },
            {
                "id": "subsidyReason",
                "label": "Subsidy reason",
                "path": "activePolicy.subsidy.reason",
                "type": "textarea",
                "rows": 3,
                "visibleWhen": {
                    "value": "$field.subsidyOverride",
                    "equals": true
                }
            },
            {
                "id": "subsidyMaximumDeficitAmount",
                "label": "Maximum subsidized deficit",
                "path": "activePolicy.subsidy.maximumDeficitAmount",
                "type": "number",
                "min": 0,
                "step": 1,
                "visibleWhen": {
                    "value": "$field.subsidyOverride",
                    "equals": true
                }
            }
        ]
    }
]
