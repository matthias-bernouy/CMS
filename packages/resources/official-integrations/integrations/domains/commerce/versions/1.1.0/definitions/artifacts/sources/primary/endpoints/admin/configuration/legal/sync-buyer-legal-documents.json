[
    {
        "endpointId": "syncBuyerLegalDocuments",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/buyer-legal-documents/sync",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "configuration": {
                    "type": "string"
                }
            },
            "required": [
                "configuration"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "documents": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "key": {
                                        "type": "string"
                                    },
                                    "versionId": {
                                        "type": "string"
                                    },
                                    "contentHash": {
                                        "type": "string"
                                    },
                                    "versionDate": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "key",
                                    "versionId",
                                    "contentHash",
                                    "versionDate"
                                ]
                            }
                        }
                    },
                    "required": [
                        "enabled",
                        "documents"
                    ]
                }
            }
        ]
    }
]
