{
    "endpointId": "submitMyOfferPrice",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/offer/price",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "string",
            "required": true
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "amount": {
                "type": "number"
            },
            "expectedVersion": {
                "type": "number"
            }
        },
        "required": [
            "amount",
            "expectedVersion"
        ]
    },
    "output": {
        "$include": "output.json"
    }
}
