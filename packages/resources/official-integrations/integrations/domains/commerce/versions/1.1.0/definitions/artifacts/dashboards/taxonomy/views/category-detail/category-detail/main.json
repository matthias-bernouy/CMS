[
    {
        "id": "categoryDetails",
        "title": "Category",
        "fields": [
            {
                "id": "slug",
                "label": "Slug",
                "path": "slug",
                "type": "text",
                "required": true
            },
            {
                "id": "label",
                "label": "Label",
                "path": "label",
                "type": "text",
                "required": true
            },
            {
                "id": "description",
                "label": "Description",
                "path": "description",
                "type": "textarea",
                "rows": 4
            },
            {
                "id": "parentId",
                "label": "Parent category",
                "path": "parentId",
                "type": "combobox",
                "lookup": {
                    "endpoint": "manageCategories",
                    "params": {
                        "q": "$search",
                        "limit": "20"
                    },
                    "itemsPath": "items",
                    "valuePath": "id",
                    "labelPath": "label",
                    "subtitlePath": "fullSlug",
                    "selected": "$resource.parent"
                }
            },
            {
                "id": "categoryFields",
                "label": "Product metadata",
                "path": "categoryFields",
                "type": "reorderable-list",
                "itemKey": "fieldKey",
                "positionPath": "position",
                "addLabel": "Add product metadata",
                "maxItems": 100,
                "fields": [
                    {
                        "id": "fieldKey",
                        "label": "Product metadata",
                        "path": "fieldKey",
                        "type": "combobox",
                        "required": true,
                        "lookup": {
                            "endpoint": "entityCustomFields",
                            "params": {
                                "entityType": "product"
                            },
                            "itemsPath": "items",
                            "valuePath": "key",
                            "labelPath": "label",
                            "subtitlePath": "fieldType"
                        }
                    },
                    {
                        "id": "required",
                        "label": "Required",
                        "path": "required",
                        "type": "checkbox"
                    },
                    {
                        "id": "filterable",
                        "label": "Filterable",
                        "path": "filterable",
                        "type": "checkbox"
                    }
                ]
            }
        ]
    }
]
