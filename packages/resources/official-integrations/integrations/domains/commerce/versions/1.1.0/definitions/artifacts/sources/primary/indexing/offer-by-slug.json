{
    "id": "offer-by-slug",
    "resolve": {
        "endpointId": "offer",
        "identity": {
            "key": "slug",
            "inputParam": "slug",
            "outputPath": "slug"
        }
    },
    "discover": {
        "endpointId": "offers",
        "itemsPath": "items",
        "identityPath": "slug",
        "lastModifiedPath": "updatedAt",
        "pagination": {
            "type": "offset",
            "limitParam": "limit",
            "offsetParam": "offset",
            "pageSize": 100,
            "totalPath": "total"
        }
    },
    "variables": {
        "id": {
            "path": "id",
            "type": "number"
        },
        "slug": {
            "path": "slug",
            "type": "text"
        },
        "title": {
            "path": "title",
            "type": "text"
        },
        "description": {
            "path": "description",
            "type": "text"
        },
        "price": {
            "path": "acceptedPriceAmount",
            "type": "number"
        },
        "currency": {
            "path": "currency",
            "type": "text"
        },
        "availability": {
            "path": "availability",
            "type": "text"
        },
        "productTitle": {
            "path": "product.title",
            "type": "text"
        },
        "updatedAt": {
            "path": "updatedAt",
            "type": "date"
        }
    },
    "defaults": {
        "titleTemplate": "{{ title }}",
        "descriptionTemplate": "{{ description }}"
    }
}
