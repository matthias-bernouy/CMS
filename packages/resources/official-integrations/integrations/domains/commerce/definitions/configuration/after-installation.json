[
    {
        "id": "install-notification-templates",
        "requires": [
            "emailer"
        ],
        "steps": [
            {
                "id": "templates",
                "call": {
                    "source": "commerce",
                    "endpoint": "listDefaultNotificationTemplates"
                }
            },
            {
                "id": "installation",
                "call": {
                    "source": "emailer",
                    "endpoint": "installTemplates",
                    "body": {
                        "templates": "$steps.templates.items"
                    }
                }
            }
        ]
    }
]
