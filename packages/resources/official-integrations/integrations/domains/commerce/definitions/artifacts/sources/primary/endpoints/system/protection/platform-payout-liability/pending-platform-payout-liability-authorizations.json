                            "properties": {
                                "liabilityRevision": {
                                    "type": "number"
                                },
                                "requiredMinimumAmount": {
                                    "type": "number"
                                },
                                "decreaseAuthorizationId": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "changeDirection": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "liabilityRevision",
                                "requiredMinimumAmount",
                                "decreaseAuthorizationId",
                                "changeDirection"
                            ]
