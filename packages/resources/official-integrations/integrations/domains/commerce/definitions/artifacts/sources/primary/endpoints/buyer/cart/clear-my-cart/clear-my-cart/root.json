{
    "endpointId": "clearMyCart",
    "method": "POST",
    "access": "auth",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-v1-1/me/cart/clear",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "expectedVersion": {
                "type": "number"
            }
        },
        "required": [
            "expectedVersion"
        ]
    },
    "output": {
        "$include": "output/root.json"
    }
}
