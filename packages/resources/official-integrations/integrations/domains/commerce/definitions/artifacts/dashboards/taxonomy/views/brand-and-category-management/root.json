[
    {
        "widget": "w-navigation-list",
        "id": "brandsTable",
        "title": "Brands",
        "source": {
            "endpoint": "manageBrands",
            "params": {
                "limit": "100"
            },
            "itemsPath": "items"
        },
        "rowKey": "id",
        "item": {
            "title": {
                "path": "name"
            },
            "subtitle": {
                "path": "slug"
            },
            "badge": {
                "path": "status"
            }
        },
        "reorderable": {
            "action": "reorderBrands"
        },
        "actions": [
            {
                "id": "createBrand",
                "label": "Create brand",
                "tone": "primary",
                "placement": "primary",
                "selection": {
                    "opens": "brandDetail"
                }
            },
            {
                "id": "reorderBrands",
                "label": "Reorder brands",
                "endpoint": {
                    "endpoint": "reorderBrands",
                    "body": {
                        "ids": "$value"
                    }
                }
            }
        ],
        "selection": {
            "opens": "brandDetail"
        }
    },
    {
        "widget": "w-navigation-list",
        "id": "categoriesTable",
        "title": "Categories",
        "source": {
            "endpoint": "manageCategories",
            "params": {
                "limit": "200"
            },
            "itemsPath": "items"
        },
        "rowKey": "id",
        "item": {
            "title": {
                "path": "label"
            },
            "subtitle": {
                "path": "fullSlug"
            },
            "badge": {
                "path": "status"
            }
        },
        "reorderable": {
            "action": "reorderCategories"
        },
        "actions": [
            {
                "id": "createCategory",
                "label": "Create category",
                "tone": "primary",
                "placement": "primary",
                "selection": {
                    "opens": "categoryDetail"
                }
            },
            {
                "id": "reorderCategories",
                "label": "Reorder categories",
                "endpoint": {
                    "endpoint": "reorderCategories",
                    "body": {
                        "ids": "$value"
                    }
                }
            }
        ],
        "selection": {
            "opens": "categoryDetail"
        }
    },
    {
        "$include": "brand-detail.json"
    }
]
