{
    "endpointId": "listDefaultNotificationTemplates",
    "method": "GET",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-v1-1/notifications/templates",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "$include": "outputs/templates/root.json"
            }
        }
    ]
}
