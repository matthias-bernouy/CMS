{
    "endpointId": "manageProduct",
    "method": "GET",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/product",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": {
        "$include": "manage-product/output/responses.json"
    }
}
