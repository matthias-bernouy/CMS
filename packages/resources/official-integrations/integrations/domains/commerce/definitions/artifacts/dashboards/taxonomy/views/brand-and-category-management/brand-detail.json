{
    "widget": "w-detail",
    "id": "brandDetail",
    "source": {
        "endpoint": "manageBrand",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "name",
        "fallback": "New brand"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "saveBrand",
            "label": "Save brand",
            "tone": "primary",
            "placement": "primary",
            "endpoint": {
                "endpoint": "upsertBrand",
                "params": {
                    "id": "$resource.id"
                },
                "body": {
                    "expectedVersion": "$resource.version",
                    "slug": "$field.slug",
                    "name": "$field.name",
                    "description": "$field.description",
                    "status": "$field.status"
                }
            },
            "after": {
                "resource": "$result"
            }
        },
        {
            "id": "deleteBrand",
            "label": "Delete brand",
            "icon": "trash",
            "tone": "danger",
            "placement": "more",
            "confirm": "Delete this brand?",
            "visibleWhen": {
                "value": "$field.id",
                "notEquals": ""
            },
            "endpoint": {
                "endpoint": "deleteBrand",
                "params": {
                    "id": "$resource.id"
                }
            }
        }
    ],
    "main": [
        {
            "id": "brandDetails",
            "title": "Brand",
            "fields": [
                {
                    "id": "slug",
                    "label": "Slug",
                    "path": "slug",
                    "type": "text",
                    "required": true
                },
                {
                    "id": "name",
                    "label": "Name",
                    "path": "name",
                    "type": "text",
                    "required": true
                },
                {
                    "id": "description",
                    "label": "Description",
                    "path": "description",
                    "type": "textarea",
                    "rows": 4
                }
            ]
        }
    ],
    "aside": [
        {
            "id": "brandState",
            "title": "State",
            "fields": [
                {
                    "id": "status",
                    "label": "Status",
                    "path": "status",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "active",
                            "label": "Active"
                        },
                        {
                            "value": "archived",
                            "label": "Archived"
                        }
                    ]
                },
                {
                    "id": "id",
                    "label": "Identifier",
                    "path": "id",
                    "type": "readonly"
                }
            ]
        }
    ]
}
