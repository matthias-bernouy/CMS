[
    {
        "$include": "custom-field.json"
    },
    {
        "$include": "upsert-custom-field.json"
    },
    {
        "endpointId": "deleteCustomField",
        "method": "DELETE",
        "effects": {
            "invalidatesSchema": true
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-v1-1/admin/custom-field",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "entityType": {
                            "type": "string"
                        },
                        "key": {
                            "type": "string"
                        },
                        "deleted": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "entityType",
                        "key",
                        "deleted"
                    ]
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "entityType": {
                    "type": "string"
                },
                "key": {
                    "type": "string"
                }
            },
            "required": [
                "entityType",
                "key"
            ]
        }
    }
]
