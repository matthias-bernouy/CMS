[
    {
        "$include": "product-variants.json"
    },
    {
        "endpointId": "productVariant",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-v1-1/admin/product/variant",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "string",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "productId": {
                            "type": "number"
                        },
                        "sku": {
                            "type": "string",
                            "nullable": true
                        },
                        "title": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string"
                        },
                        "position": {
                            "type": "number"
                        },
                        "combinationKey": {
                            "type": "string"
                        },
                        "generatedFromAxes": {
                            "type": "boolean"
                        },
                        "version": {
                            "type": "number"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    },
    {
        "endpointId": "productImage",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-v1-1/admin/product/image",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "string"
            },
            {
                "name": "sessionId",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            },
            {
                "name": "x-cms-user-role",
                "source": {
                    "from": "computed",
                    "ref": "userRole"
                }
            }
        ],
        "responseKind": "file",
        "mediaType": "image/*",
        "output": [
            {
                "status": "200"
            },
            {
                "status": "206"
            }
        ]
    },
    {
        "$include": "upload-product-image.json"
    }
]
