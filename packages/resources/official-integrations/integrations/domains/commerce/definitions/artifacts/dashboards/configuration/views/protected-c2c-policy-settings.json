{
    "widget": "w-detail",
    "id": "protectedC2cPolicySettings",
    "source": {
        "endpoint": "c2cPolicies"
    },
    "title": {
        "path": "activePolicy.name",
        "fallback": "Protected C2C policy"
    },
    "status": {
        "path": "activePolicy.status"
    },
    "actions": [
        {
            "id": "publishProtectedC2cPolicyRevision",
            "label": "Publish new protected C2C policy revision",
            "tone": "danger",
            "placement": "primary",
            "confirm": "Publish and activate this new protected C2C financial policy revision? The current revision will remain immutable for existing orders.",
            "endpoint": {
                "endpoint": "createC2cPolicyRevision",
                "body": {
                    "expectedSettingsVersion": "$resource.settings.version",
                    "name": "$field.policyName",
                    "shippingBeneficiary": "$field.shippingBeneficiary",
                    "buyerFeeBasis": "$field.buyerFeeBasis",
                    "buyerFeeRateBps": "$field.buyerFeeRateBps",
                    "buyerFeeFixedAmount": "$field.buyerFeeFixedAmount",
                    "buyerFeeMinimumAmount": "$field.buyerFeeMinimumAmount",
                    "buyerFeeMaximumAmount": "$field.buyerFeeMaximumAmount",
                    "buyerFeeRefundPolicy": "$field.buyerFeeRefundPolicy",
                    "sellerFeeBasis": "$field.sellerFeeBasis",
                    "sellerFeeRateBps": "$field.sellerFeeRateBps",
                    "sellerFeeFixedAmount": "$field.sellerFeeFixedAmount",
                    "sellerFeeMinimumAmount": "$field.sellerFeeMinimumAmount",
                    "sellerFeeMaximumAmount": "$field.sellerFeeMaximumAmount",
                    "sellerFeeRefundPolicy": "$field.sellerFeeRefundPolicy",
                    "costEstimatesConfigured": "$field.costEstimatesConfigured",
                    "estimatedStripeCostAmount": "$field.estimatedStripeCostAmount",
                    "estimatedCarrierCostAmount": "$field.estimatedCarrierCostAmount",
                    "platformRiskReserveContributionAmount": "$field.platformRiskReserveContributionAmount",
                    "configuredMinimumMarginAmount": "$field.configuredMinimumMarginAmount",
                    "subsidyOverride": "$field.subsidyOverride",
                    "subsidyReason": "$field.subsidyReason",
                    "subsidyMaximumDeficitAmount": "$field.subsidyMaximumDeficitAmount",
                    "paymentWindowMinutes": "$field.paymentWindowMinutes",
                    "sellerHandoffHours": "$field.sellerHandoffHours",
                    "scanGraceHours": "$field.scanGraceHours",
                    "claimWindowHours": "$field.claimWindowHours",
                    "sellerResponseHours": "$field.sellerResponseHours",
                    "returnShipHours": "$field.returnShipHours",
                    "financeReviewThresholdAmount": "$field.financeReviewThresholdAmount",
                    "dualApprovalThresholdAmount": "$field.dualApprovalThresholdAmount",
                    "sellerReserveRateBps": "$field.sellerReserveRateBps",
                    "payoutDelayDays": "$field.payoutDelayDays",
                    "sellerReserveLiabilityDays": "$field.sellerReserveLiabilityDays",
                    "orderTransferLimitAmount": "$field.orderTransferLimitAmount",
                    "velocityLimitAmount": "$field.velocityLimitAmount",
                    "highValueReviewAmount": "$field.highValueReviewAmount",
                    "claimRatioReviewBps": "$field.claimRatioReviewBps",
                    "chargebackRatioReviewBps": "$field.chargebackRatioReviewBps"
                }
            }
        }
    ],
    "main": {
        "$include": "protected-c2c-policy-settings/sections.json"
    }
}
