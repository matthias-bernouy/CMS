{
    "widget": "w-detail",
    "id": "orderDetail",
    "source": {
        "endpoint": "order",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "orderNumber",
        "fallback": "Order"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "reopenShippingWindow",
            "label": "Reopen shipping window",
            "tone": "secondary",
            "placement": "more",
            "form": {
                "endpoint": "reopenOrderShippingWindow",
                "hiddenFields": [
                    {
                        "name": "orderPublicId",
                        "value": "$resource.publicId",
                        "type": "string"
                    }
                ],
                "fields": [
                    {
                        "id": "reason",
                        "name": "reason",
                        "label": "Reopening reason",
                        "path": "fulfillmentReviewReason",
                        "type": "textarea",
                        "rows": 3,
                        "required": true
                    }
                ],
                "confirm": "Reopen the seller shipping window for this order?"
            },
            "visibleWhen": {
                "value": "$resource.fulfillment.blockingReason",
                "equals": "scan_grace_elapsed_without_carrier_acceptance"
            }
        }
    ],
    "main": [
        {
            "id": "orderSummary",
            "title": "Summary",
            "fields": [
                {
                    "id": "publicId",
                    "label": "Public id",
                    "path": "publicId",
                    "type": "readonly"
                },
                {
                    "id": "buyerCmsUserId",
                    "label": "Buyer",
                    "path": "buyerCmsUserId",
                    "type": "readonly"
                },
                {
                    "id": "sellerId",
                    "label": "Seller",
                    "path": "sellerId",
                    "type": "readonly"
                },
                {
                    "id": "subtotalAmount",
                    "label": "Subtotal",
                    "path": "subtotalAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "totalAmount",
                    "label": "Total",
                    "path": "totalAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "currency",
                    "label": "Currency",
                    "path": "currency",
                    "type": "readonly"
                },
                {
                    "id": "statusMessage",
                    "label": "Status note",
                    "path": "statusMessage",
                    "type": "textarea",
                    "rows": 3
                }
            ]
        },
        {
            "id": "fulfillmentReview",
            "title": "Fulfillment review",
            "fields": [
                {
                    "id": "fulfillmentStatus",
                    "label": "Fulfillment status",
                    "path": "fulfillment.status",
                    "type": "readonly",
                    "format": "badge"
                },
                {
                    "id": "fulfillmentBlockingReason",
                    "label": "Blocking reason",
                    "path": "fulfillment.blockingReason",
                    "type": "readonly"
                },
                {
                    "id": "settlementStatus",
                    "label": "Settlement status",
                    "path": "settlement.status",
                    "type": "readonly",
                    "format": "badge"
                },
                {
                    "id": "settlementReviewReason",
                    "label": "Settlement review reason",
                    "path": "settlement.manualReviewReason",
                    "type": "readonly"
                }
            ]
        },
        {
            "id": "orderLines",
            "title": "Lines",
            "fields": [
                {
                    "id": "lines",
                    "label": "Order lines",
                    "path": "lines",
                    "type": "table",
                    "columns": [
                        {
                            "id": "title",
                            "label": "Item",
                            "path": "title",
                            "primary": true
                        },
                        {
                            "id": "quantity",
                            "label": "Quantity",
                            "path": "quantity"
                        },
                        {
                            "id": "unitAmount",
                            "label": "Unit price",
                            "path": "unitAmount",
                            "format": "money"
                        },
                        {
                            "id": "totalAmount",
                            "label": "Total",
                            "path": "totalAmount",
                            "format": "money"
                        }
                    ]
                }
            ]
        }
    ]
}
