{
    "endpointId": "reviewMarketplaceServiceWithdrawalRequest",
    "method": "POST",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/service-withdrawal-request/review",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "requestPublicId": { "type": "string" },
            "nextStatus": { "type": "string" },
            "resolution": { "type": "string" },
            "note": { "type": "string" },
            "expectedVersion": { "type": "number" }
        },
        "required": [
            "requestPublicId",
            "nextStatus",
            "note",
            "expectedVersion"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "$include": "../../../shared/marketplace-service-withdrawal-request.json"
            }
        }
    ]
}
