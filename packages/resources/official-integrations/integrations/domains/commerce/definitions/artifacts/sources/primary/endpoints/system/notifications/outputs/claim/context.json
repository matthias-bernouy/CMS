{
    "type": "object",
    "properties": {
        "contractVersion": {
            "type": "number"
        },
        "event": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string"
                },
                "occurredAt": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "occurredAt"
            ]
        },
        "recipient": {
            "type": "object",
            "properties": {
                "userId": {
                    "type": "string",
                    "semantic": {
                        "kind": "user-id",
                        "authority": "cms"
                    }
                },
                "role": {
                    "type": "string"
                }
            },
            "required": [
                "userId",
                "role"
            ]
        },
        "order": {
            "$include": "context/order.json"
        },
        "agreement": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "version": {
                    "type": "number"
                },
                "status": {
                    "type": "string"
                },
                "unitAmountMinor": {
                    "type": "number"
                },
                "quantity": {
                    "type": "number"
                },
                "subtotalAmountMinor": {
                    "type": "number"
                },
                "subtotalAmountFormatted": {
                    "type": "string"
                },
                "currency": {
                    "type": "string"
                },
                "expiresAt": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "version",
                "status",
                "unitAmountMinor",
                "quantity",
                "subtotalAmountMinor",
                "subtotalAmountFormatted",
                "currency",
                "expiresAt"
            ]
        },
        "offer": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "number"
                },
                "slug": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "slug",
                "title"
            ]
        },
        "fulfillment": {
            "type": "object",
            "nullable": true,
            "properties": {
                "status": {
                    "type": "string"
                },
                "sellerHandoffDeadline": {
                    "type": "string"
                },
                "sellerHandoffDeclaredAt": {
                    "type": "string",
                    "nullable": true
                },
                "carrierAcceptedAt": {
                    "type": "string",
                    "nullable": true
                }
            },
            "required": [
                "status",
                "sellerHandoffDeadline",
                "sellerHandoffDeclaredAt",
                "carrierAcceptedAt"
            ]
        },
        "claim": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "sellerResponseByAt": {
                    "type": "string"
                },
                "returnShipByAt": {
                    "type": "string",
                    "nullable": true
                },
                "returnDeliveryStatus": {
                    "type": "string",
                    "nullable": true
                }
            },
            "required": [
                "id",
                "status",
                "reason",
                "sellerResponseByAt",
                "returnShipByAt",
                "returnDeliveryStatus"
            ]
        },
        "delivery": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                }
            },
            "required": [
                "status",
                "label"
            ]
        },
        "action": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string"
                }
            },
            "required": [
                "path"
            ]
        },
        "source": {
            "type": "object",
            "properties": {
                "sourceEventId": {
                    "type": "number"
                },
                "sourceAggregateType": {
                    "type": "string"
                },
                "sourceAggregateId": {
                    "type": "string"
                },
                "sourceEventType": {
                    "type": "string"
                },
                "data": {
                    "type": "object"
                },
                "financialException": {
                    "type": "object"
                }
            }
        }
    },
    "required": [
        "contractVersion",
        "event",
        "recipient",
        "delivery",
        "action",
        "source"
    ]
}
