[
    {
        "endpointId": "authorizePlatformPayoutLiabilityDecrease",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/platform-payout-liability/authorize-decrease",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            },
            {
                "name": "x-cms-user-role",
                "source": {
                    "from": "computed",
                    "ref": "userRole"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "expectedLiabilityRevision": {
                    "type": "number"
                },
                "reason": {
                    "type": "string"
                }
            },
            "required": [
                "expectedLiabilityRevision",
                "reason"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "liabilityRevision": {
                            "type": "number"
                        },
                        "requiredMinimumAmount": {
                            "type": "number"
                        },
                        "lastProviderAppliedRevision": {
                            "type": "number"
                        },
                        "lastProviderAppliedAmount": {
                            "type": "number"
                        },
                        "changeDirection": {
                            "type": "string"
                        },
                        "decreaseAuthorizationId": {
                            "type": "string"
                        },
                        "decreaseAuthorizedAt": {
                            "type": "string"
                        },
                        "calculatedAt": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    }
]
