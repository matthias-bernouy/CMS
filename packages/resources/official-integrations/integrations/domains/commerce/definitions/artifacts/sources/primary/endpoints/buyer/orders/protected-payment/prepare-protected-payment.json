[
    {
        "endpointId": "prepareProtectedPayment",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/order/payment/prepare",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "orderId": {
                    "type": "number"
                },
                "acceptedLegalDocumentVersionIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "paymentProvider": {
                    "type": "string"
                }
            },
            "required": [
                "orderId"
            ]
        },
        "output": {
            "$include": "prepare-protected-payment/output.json"
        }
    }
]
