{
    "endpointId": "stageProductImage",
    "method": "POST",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-v1-1/admin/product/image/stage",
    "params": [
        {
            "name": "sessionId",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        },
        {
            "name": "x-cms-functions-base-url",
            "source": {
                "from": "static",
                "value": "{{connectors.supabase.functionsBaseUrl}}"
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "sessionId": {
                        "type": "string"
                    },
                    "media": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number"
                            },
                            "storageBucket": {
                                "type": "string"
                            },
                            "storagePath": {
                                "type": "string"
                            },
                            "mimeType": {
                                "type": "string"
                            },
                            "fileSize": {
                                "type": "number"
                            },
                            "width": {
                                "type": "number"
                            },
                            "height": {
                                "type": "number"
                            },
                            "originalFilename": {
                                "type": "string"
                            },
                            "alt": {
                                "type": "string",
                                "nullable": true
                            },
                            "createdAt": {
                                "type": "string"
                            },
                            "updatedAt": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "previewUrl": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    ]
}
