[
    {
        "endpointId": "category",
        "method": "GET",
        "access": "public",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/category",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "string"
            },
            {
                "name": "fullSlug",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "parentId": {
                            "type": "number",
                            "nullable": true
                        },
                        "slug": {
                            "type": "string"
                        },
                        "fullSlug": {
                            "type": "string"
                        },
                        "label": {
                            "type": "string"
                        },
                        "description": {
                            "type": "string",
                            "nullable": true
                        },
                        "status": {
                            "type": "string"
                        },
                        "position": {
                            "type": "number"
                        },
                        "metadata": {
                            "type": "object"
                        },
                        "version": {
                            "type": "number"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        },
                        "parent": {
                            "type": "object",
                            "nullable": true
                        }
                    }
                }
            }
        ]
    }
]
