{
    "endpointId": "reviewSeller",
    "method": "POST",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/seller/review",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "string",
            "required": true
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "status": {
                "type": "string"
            },
            "reason": {
                "type": "string"
            },
            "expectedVersion": {
                "type": "number"
            }
        },
        "required": [
            "status",
            "expectedVersion"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "kind": {
                        "type": "string"
                    },
                    "cmsUserId": {
                        "type": "string",
                        "nullable": true
                    },
                    "slug": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "verificationStatus": {
                        "type": "string"
                    },
                    "verifiedAt": {
                        "type": "string",
                        "nullable": true
                    },
                    "verifiedBy": {
                        "type": "string",
                        "nullable": true
                    },
                    "metadata": {
                        "type": "object"
                    },
                    "version": {
                        "type": "number"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "updatedAt": {
                        "type": "string"
                    }
                }
            }
        }
    ]
}
