[
    {
        "endpointId": "getOrderShippingActionsSellerContext",
        "method": "GET",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/shipping/actions/seller-context",
        "params": [
            {
                "name": "orderId",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "number" },
                        "publicId": { "type": "string" },
                        "orderNumber": { "type": "string" },
                        "sellerCmsUserId": {
                            "type": "string",
                            "semantic": {
                                "kind": "user-id",
                                "authority": "cms"
                            }
                        },
                        "orderStatus": { "type": "string" },
                        "fulfillmentStatus": { "type": "string" },
                        "settlementStatus": { "type": "string" },
                        "blockingReason": { "type": "string", "nullable": true },
                        "reviewReason": { "type": "string", "nullable": true },
                        "canCreateShipment": { "type": "boolean" },
                        "canDownloadLabel": { "type": "boolean" },
                        "canDeclareHandoff": { "type": "boolean" },
                        "requiresReview": { "type": "boolean" }
                    },
                    "required": [
                        "id",
                        "publicId",
                        "orderNumber",
                        "sellerCmsUserId",
                        "orderStatus",
                        "fulfillmentStatus",
                        "settlementStatus",
                        "canCreateShipment",
                        "canDownloadLabel",
                        "canDeclareHandoff",
                        "requiresReview"
                    ]
                }
            }
        ]
    }
]
