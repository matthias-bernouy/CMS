[
    {
        "widget": "w-table",
        "id": "offersTable",
        "title": "Offers",
        "source": {
            "endpoint": "manageOffers",
            "params": {
                "q": "$filter.q",
                "publicationStatus": "$filter.publicationStatus",
                "workflowState": "$filter.workflowState",
                "conditionCode": "$filter.conditionCode",
                "limit": "100"
            },
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "id",
        "filters": [
            {
                "id": "q",
                "label": "Search",
                "param": "q",
                "type": "text",
                "placeholder": "Search offers"
            },
            {
                "id": "publicationStatus",
                "label": "Publication",
                "param": "publicationStatus",
                "type": "select",
                "options": [
                    {
                        "value": "draft",
                        "label": "Draft"
                    },
                    {
                        "value": "active",
                        "label": "Active"
                    },
                    {
                        "value": "paused",
                        "label": "Paused"
                    },
                    {
                        "value": "archived",
                        "label": "Archived"
                    }
                ]
            },
            {
                "id": "workflowState",
                "label": "Workflow state",
                "param": "workflowState",
                "type": "text"
            },
            {
                "id": "conditionCode",
                "label": "Condition",
                "param": "conditionCode",
                "type": "text"
            }
        ],
        "columns": [
            {
                "id": "title",
                "label": "Offer",
                "path": "title",
                "primary": true
            },
            {
                "id": "publicationStatus",
                "label": "Publication",
                "path": "publicationStatus",
                "format": "badge"
            },
            {
                "id": "workflowState",
                "label": "Workflow",
                "path": "workflowState",
                "format": "badge"
            },
            {
                "id": "conditionCode",
                "label": "Condition",
                "path": "conditionCode",
                "format": "badge"
            },
            {
                "id": "acceptedPriceAmount",
                "label": "Price",
                "path": "acceptedPriceAmount",
                "format": "money"
            },
            {
                "id": "currency",
                "label": "Currency",
                "path": "currency"
            }
        ],
        "actions": [
            {
                "id": "createOffer",
                "label": "Create offer",
                "tone": "primary",
                "placement": "primary",
                "selection": {
                    "opens": "offerDetail"
                }
            }
        ],
        "selection": {
            "opens": "offerDetail"
        }
    }
]
