{
    "endpointId": "claimNotifications",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/notifications/system/claim",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "runKey": {
                "type": "string"
            },
            "limit": {
                "type": "number"
            },
            "consumerMode": {
                "type": "string"
            }
        },
        "required": [
            "runKey"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "$include": "../outputs/claim/root.json"
            }
        }
    ]
}
