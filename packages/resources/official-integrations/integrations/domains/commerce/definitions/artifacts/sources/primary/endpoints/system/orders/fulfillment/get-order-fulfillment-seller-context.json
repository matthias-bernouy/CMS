[
    {
        "endpointId": "getOrderFulfillmentSellerContext",
        "method": "GET",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/fulfillment/seller-context",
        "params": [
            {
                "name": "orderId",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "publicId": {
                            "type": "string"
                        },
                        "orderNumber": {
                            "type": "string"
                        }
                    }
                }
            }
        ]
    }
]
