{
    "endpointId": "upsertBrand",
    "method": "POST",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/brand",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "expectedVersion": {
                "type": "number"
            },
            "slug": {
                "type": "string"
            },
            "name": {
                "type": "string"
            },
            "description": {
                "type": "string"
            },
            "status": {
                "type": "string"
            },
            "metadata": {
                "type": "object"
            }
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "object"
                    },
                    "version": {
                        "type": "number"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "updatedAt": {
                        "type": "string"
                    }
                }
            }
        }
    ]
}
