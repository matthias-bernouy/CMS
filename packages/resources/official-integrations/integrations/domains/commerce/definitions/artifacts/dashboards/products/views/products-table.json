[
    {
        "widget": "w-table",
        "id": "productsTable",
        "title": "Products",
        "source": {
            "endpoint": "manageProducts",
            "params": {
                "q": "$filter.q",
                "status": "$filter.status",
                "visibility": "$filter.visibility",
                "limit": "100"
            },
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "id",
        "filters": [
            {
                "id": "q",
                "label": "Search",
                "param": "q",
                "type": "text",
                "placeholder": "Search products"
            },
            {
                "id": "status",
                "label": "Status",
                "param": "status",
                "type": "select",
                "options": [
                    {
                        "value": "draft",
                        "label": "Draft"
                    },
                    {
                        "value": "active",
                        "label": "Active"
                    },
                    {
                        "value": "archived",
                        "label": "Archived"
                    }
                ]
            },
            {
                "id": "visibility",
                "label": "Visibility",
                "param": "visibility",
                "type": "select",
                "options": [
                    {
                        "value": "public",
                        "label": "Public"
                    },
                    {
                        "value": "hidden",
                        "label": "Hidden"
                    }
                ]
            }
        ],
        "columns": [
            {
                "id": "title",
                "label": "Product",
                "path": "title",
                "primary": true
            },
            {
                "id": "slug",
                "label": "Slug",
                "path": "slug"
            },
            {
                "id": "status",
                "label": "Status",
                "path": "status",
                "format": "badge"
            },
            {
                "id": "visibility",
                "label": "Visibility",
                "path": "visibility",
                "format": "badge"
            },
            {
                "id": "updatedAt",
                "label": "Updated",
                "path": "updatedAt",
                "format": "date"
            }
        ],
        "actions": [
            {
                "id": "createProduct",
                "label": "Create product",
                "tone": "primary",
                "placement": "primary",
                "selection": {
                    "opens": "productDetail"
                }
            }
        ],
        "selection": {
            "opens": "productDetail"
        }
    }
]
