[
    {
        "id": "protectedC2cRevision",
        "title": "Active immutable revision",
        "description": "Amounts are minor currency units and rates are integer basis points. Publishing creates and activates a new revision; existing orders keep their financial snapshot.",
        "fields": [
            {
                "id": "policyName",
                "label": "Policy name",
                "path": "activePolicy.name",
                "type": "text",
                "required": true
            },
            {
                "id": "policyKey",
                "label": "Policy key",
                "path": "activePolicy.policyKey",
                "type": "readonly"
            },
            {
                "id": "policyVersion",
                "label": "Policy version",
                "path": "activePolicy.version",
                "type": "readonly"
            },
            {
                "id": "policyStatus",
                "label": "Status",
                "path": "activePolicy.status",
                "type": "readonly",
                "format": "badge"
            },
            {
                "id": "policyCurrency",
                "label": "Currency",
                "path": "activePolicy.currency",
                "type": "readonly"
            },
            {
                "id": "settingsVersion",
                "label": "Settings version",
                "path": "settings.version",
                "type": "readonly"
            },
            {
                "id": "shippingBeneficiary",
                "label": "Shipping revenue beneficiary",
                "path": "activePolicy.fee.shippingBeneficiary",
                "type": "select",
                "required": true,
                "options": [
                    {
                        "value": "platform",
                        "label": "Platform"
                    },
                    {
                        "value": "seller",
                        "label": "Seller"
                    }
                ]
            }
        ]
    },
    {
        "$include": "buyer-protection-fee.json"
    },
    {
        "id": "sellerCommission",
        "title": "Seller commission",
        "fields": [
            {
                "id": "sellerFeeBasis",
                "label": "Calculation basis",
                "path": "activePolicy.sellerCommission.basis",
                "type": "select",
                "required": true,
                "options": [
                    {
                        "value": "merchandise",
                        "label": "Merchandise"
                    },
                    {
                        "value": "merchandise_and_shipping",
                        "label": "Merchandise and shipping"
                    }
                ]
            },
            {
                "id": "sellerFeeRateBps",
                "label": "Rate (basis points)",
                "path": "activePolicy.sellerCommission.rateBps",
                "type": "number",
                "required": true,
                "min": 0,
                "max": 10000,
                "step": 1
            },
            {
                "id": "sellerFeeFixedAmount",
                "label": "Fixed amount",
                "path": "activePolicy.sellerCommission.fixedAmount",
                "type": "number",
                "required": true,
                "min": 0,
                "step": 1
            },
            {
                "id": "sellerFeeMinimumAmount",
                "label": "Minimum amount",
                "path": "activePolicy.sellerCommission.minimumAmount",
                "type": "number",
                "min": 0,
                "step": 1
            },
            {
                "id": "sellerFeeMaximumAmount",
                "label": "Maximum amount",
                "path": "activePolicy.sellerCommission.maximumAmount",
                "type": "number",
                "min": 0,
                "step": 1
            },
            {
                "id": "sellerFeeRefundPolicy",
                "label": "Refund policy",
                "path": "activePolicy.sellerCommission.refundPolicy",
                "type": "select",
                "required": true,
                "options": [
                    {
                        "value": "never",
                        "label": "Never"
                    }
                ]
            }
        ]
    }
]
