[
    {
        "widget": "w-table",
        "id": "sellersTable",
        "title": "Sellers",
        "source": {
            "endpoint": "sellers",
            "params": {
                "q": "$filter.q",
                "verificationStatus": "$filter.verificationStatus",
                "kind": "$filter.kind",
                "limit": "100"
            },
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "id",
        "filters": [
            {
                "id": "q",
                "label": "Search",
                "param": "q",
                "type": "text",
                "placeholder": "Search sellers"
            },
            {
                "id": "verificationStatus",
                "label": "Verification",
                "param": "verificationStatus",
                "type": "select",
                "options": [
                    {
                        "value": "pending",
                        "label": "Pending"
                    },
                    {
                        "value": "verified",
                        "label": "Verified"
                    },
                    {
                        "value": "rejected",
                        "label": "Rejected"
                    },
                    {
                        "value": "suspended",
                        "label": "Suspended"
                    }
                ]
            },
            {
                "id": "kind",
                "label": "Kind",
                "param": "kind",
                "type": "select",
                "options": [
                    {
                        "value": "merchant",
                        "label": "Merchant"
                    },
                    {
                        "value": "user",
                        "label": "User"
                    },
                    {
                        "value": "external",
                        "label": "External"
                    }
                ]
            }
        ],
        "columns": [
            {
                "id": "displayName",
                "label": "Seller",
                "path": "displayName",
                "primary": true
            },
            {
                "id": "slug",
                "label": "Slug",
                "path": "slug"
            },
            {
                "id": "kind",
                "label": "Kind",
                "path": "kind",
                "format": "badge"
            },
            {
                "id": "verificationStatus",
                "label": "Verification",
                "path": "verificationStatus",
                "format": "badge"
            }
        ],
        "selection": {
            "opens": "sellerDetail"
        }
    },
    {
        "$include": "seller-detail.json"
    }
]
