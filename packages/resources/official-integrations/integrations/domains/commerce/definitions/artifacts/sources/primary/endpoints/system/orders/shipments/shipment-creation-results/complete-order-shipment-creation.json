{
    "endpointId": "completeOrderShipmentCreation",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/system/order/shipment-creation/complete",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "operationId": {
                "type": "number"
            },
            "claimToken": {
                "type": "string"
            },
            "providerReference": {
                "type": "string"
            },
            "providerShipmentId": {
                "type": "string"
            },
            "providerSnapshot": {
                "type": "object"
            }
        },
        "required": [
            "operationId",
            "claimToken",
            "providerReference"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "orderId": {
                        "type": "number"
                    },
                    "businessKey": {
                        "type": "string"
                    },
                    "deliveryQuoteId": {
                        "type": "string"
                    },
                    "financialTermsHash": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "attempts": {
                        "type": "number"
                    },
                    "providerReference": {
                        "type": "string",
                        "nullable": true
                    },
                    "providerShipmentId": {
                        "type": "string",
                        "nullable": true
                    },
                    "lastError": {
                        "type": "string",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "updatedAt": {
                        "type": "string"
                    },
                    "idempotentReplay": {
                        "type": "boolean"
                    },
                    "fulfillment": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "string"
                            },
                            "providerReference": {
                                "type": "string",
                                "nullable": true
                            },
                            "version": {
                                "type": "number"
                            },
                            "updatedAt": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "id",
                    "orderId",
                    "businessKey",
                    "status",
                    "attempts"
                ]
            }
        }
    ]
}
