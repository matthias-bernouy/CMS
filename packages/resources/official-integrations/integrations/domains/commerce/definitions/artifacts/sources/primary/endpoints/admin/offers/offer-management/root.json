[
    {
        "$include": "upsert-offer.json"
    },
    {
        "$include": "review-offer.json"
    },
    {
        "endpointId": "offerImage",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/admin/offer/image",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "string",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "responseKind": "file",
        "mediaType": "image/*",
        "output": [
            {
                "status": "200"
            },
            {
                "status": "206"
            }
        ]
    }
]
