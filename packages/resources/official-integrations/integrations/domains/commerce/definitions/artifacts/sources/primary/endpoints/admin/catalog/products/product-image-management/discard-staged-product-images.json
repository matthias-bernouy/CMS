{
    "method": "POST",
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "endpointId": "discardStagedProductImages",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-v1-1/admin/product/images/discard",
    "body": {
        "type": "object",
        "properties": {
            "mediaIds": {
                "type": "array",
                "items": {
                    "type": "number"
                }
            },
            "sessionId": {
                "type": "string"
            }
        },
        "required": [
            "sessionId",
            "mediaIds"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    }
                }
            }
        }
    ],
    "params": []
}
