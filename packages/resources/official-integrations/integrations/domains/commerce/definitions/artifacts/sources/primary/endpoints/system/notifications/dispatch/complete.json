{
    "endpointId": "completeNotification",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/notifications/system/complete",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "deliveryId": {
                "type": "string"
            },
            "runKey": {
                "type": "string"
            },
            "messageId": {
                "type": "string"
            }
        },
        "required": [
            "deliveryId",
            "runKey"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "$include": "../outputs/delivery-result.json"
            }
        }
    ]
}
