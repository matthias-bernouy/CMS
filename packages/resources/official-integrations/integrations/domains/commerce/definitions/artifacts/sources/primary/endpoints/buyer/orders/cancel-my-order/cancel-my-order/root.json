{
    "endpointId": "cancelMyOrder",
    "method": "POST",
    "access": "auth",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce/me/order/cancel",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "orderId": {
                "type": "number"
            },
            "reason": {
                "type": "string"
            }
        },
        "required": [
            "orderId",
            "reason"
        ]
    },
    "output": {
        "$include": "output/root.json"
    }
}
