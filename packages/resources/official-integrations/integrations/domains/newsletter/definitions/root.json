{
    "schema": "cms.integration.definition.v2",
    "kind": "newsletter",
    "label": "Newsletter",
    "version": "1.0.0",
    "category": "Marketing",
    "description": "Store newsletter subscription state with the configured connector.",
    "icon": {
        "path": "assets/icon.svg"
    },
    "inputs": {
        "$include": "configuration/inputs.json"
    },
    "ui": {
        "$include": "configuration/ui.json"
    },
    "generatedSecrets": {
        "$include": "configuration/generated-secrets.json"
    },
    "connectors": {
        "$include": "configuration/connectors.json"
    },
    "artifacts": {
        "$files": [
            "artifacts/sources/primary/definition.json",
            "artifacts/dashboards/subscriptions.json",
            "artifacts/functions/source-health.json"
        ]
    },
    "type": "source",
    "management": {
        "schemaVersion": 1,
        "health": {
            "functionId": "checkNewsletterHealth"
        }
    }
}
