{
    "endpointId": "listSubscriptions",
    "method": "GET",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscriptions",
    "meta": {
        "name": "List subscriptions",
        "description": "List newsletter subscriptions for the backoffice dashboard."
    },
    "params": [
        {
            "name": "q",
            "in": "query",
            "type": "string",
            "description": "Email search."
        },
        {
            "name": "subscribed",
            "in": "query",
            "type": "string",
            "description": "Filter by subscription status. Use true or false."
        },
        {
            "name": "limit",
            "in": "query",
            "type": "number",
            "description": "Maximum number of subscriptions to return."
        },
        {
            "name": "offset",
            "in": "query",
            "type": "number",
            "description": "Number of subscriptions to skip."
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "subscriptions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string"
                                },
                                "subscribed": {
                                    "type": "boolean"
                                },
                                "createdAt": {
                                    "type": "string"
                                },
                                "updatedAt": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "email",
                                "subscribed"
                            ]
                        }
                    },
                    "total": {
                        "type": "number"
                    }
                },
                "required": [
                    "subscriptions",
                    "total"
                ]
            }
        }
    ]
}
