[
    {
        "$include": "set-subscription.json"
    },
    {
        "$include": "list-subscriptions.json"
    },
    {
        "endpointId": "exportSubscriptions",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscriptions/export",
        "responseKind": "file",
        "mediaType": "text/csv",
        "meta": {
            "name": "Export subscriptions",
            "description": "Export newsletter subscriptions as a CSV file."
        },
        "params": [
            {
                "name": "q",
                "in": "query",
                "type": "string",
                "description": "Email search."
            },
            {
                "name": "subscribed",
                "in": "query",
                "type": "string",
                "description": "Filter by subscription status. Use true or false."
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200"
            },
            {
                "status": "206"
            }
        ]
    },
    {
        "endpointId": "getSubscription",
        "method": "GET",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-newsletter/subscription",
        "meta": {
            "name": "Get subscription",
            "description": "Read one newsletter subscription by email."
        },
        "params": [
            {
                "name": "email",
                "in": "query",
                "required": true,
                "type": "string",
                "description": "Subscription email."
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "exists": {
                            "type": "boolean"
                        },
                        "email": {
                            "type": "string"
                        },
                        "subscribed": {
                            "type": "boolean"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "exists",
                        "email"
                    ]
                }
            }
        ]
    }
]
