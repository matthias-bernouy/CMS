[
    {
        "widget": "w-table",
        "id": "albumsTable",
        "title": "Photo albums",
        "source": {
            "endpoint": "manageAlbums",
            "params": {
                "q": "$filter.q",
                "status": "$filter.status",
                "limit": "50"
            },
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "id",
        "filters": [
            {
                "id": "q",
                "label": "Search",
                "param": "q",
                "type": "text",
                "placeholder": "Search albums"
            },
            {
                "id": "status",
                "label": "Status",
                "param": "status",
                "type": "select",
                "options": [
                    {
                        "value": "draft",
                        "label": "Draft"
                    },
                    {
                        "value": "published",
                        "label": "Published"
                    },
                    {
                        "value": "archived",
                        "label": "Archived"
                    }
                ]
            }
        ],
        "columns": [
            {
                "id": "title",
                "label": "Album",
                "path": "title",
                "primary": true
            },
            {
                "id": "category",
                "label": "Category",
                "path": "category.name"
            },
            {
                "id": "status",
                "label": "Status",
                "path": "status",
                "format": "badge"
            },
            {
                "id": "photoCount",
                "label": "Photos",
                "path": "photoCount"
            },
            {
                "id": "updatedAt",
                "label": "Updated",
                "path": "updatedAt",
                "format": "date"
            }
        ],
        "actions": [
            {
                "id": "createAlbum",
                "label": "Create album",
                "tone": "primary",
                "placement": "primary",
                "selection": {
                    "opens": "albumDetail"
                }
            }
        ],
        "selection": {
            "opens": "albumDetail"
        }
    }
]
