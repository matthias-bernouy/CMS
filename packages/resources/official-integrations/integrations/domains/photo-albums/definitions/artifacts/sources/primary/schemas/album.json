{
    "type": "object",
    "nullable": true,
    "properties": {
        "id": {
            "type": "number",
            "nullable": true
        },
        "slug": {
            "type": "string"
        },
        "title": {
            "type": "string"
        },
        "description": {
            "type": "string",
            "nullable": true
        },
        "categoryId": {
            "type": "number",
            "nullable": true
        },
        "category": {
            "$include": "category.json"
        },
        "status": {
            "type": "string"
        },
        "publishedAt": {
            "type": "string",
            "nullable": true
        },
        "position": {
            "type": "number"
        },
        "photoCount": {
            "type": "number"
        },
        "coverPhoto": {
            "$include": "photo.json"
        },
        "photos": {
            "type": "array",
            "items": {
                "$include": "photo.json"
            }
        },
        "display": {
            "type": "object",
            "properties": {
                "allowDownloads": {
                    "type": "boolean"
                },
                "showCaptions": {
                    "type": "boolean"
                },
                "showTakenAt": {
                    "type": "boolean"
                }
            }
        },
        "version": {
            "type": "number"
        },
        "createdAt": {
            "type": "string"
        },
        "updatedAt": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "slug",
        "title"
    ]
}
