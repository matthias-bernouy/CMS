[
    {
        "endpointId": "upsertAlbum",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-photo-albums/album",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "number",
                    "nullable": true
                },
                "version": {
                    "type": "number"
                },
                "slug": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "nullable": true
                },
                "categoryId": {
                    "type": "number",
                    "nullable": true
                },
                "status": {
                    "type": "string"
                },
                "position": {
                    "type": "number"
                }
            },
            "required": [
                "slug",
                "title"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "$include": "../../../schemas/album.json"
                }
            }
        ]
    }
]
