[
    {
        "endpointId": "photo",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-photo-albums/photo",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "number",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "responseKind": "file",
        "mediaType": "image/*",
        "output": [
            {
                "status": "200"
            },
            {
                "status": "206"
            }
        ]
    }
]
