{
    "type": "dashboard",
    "dashboard": {
        "id": "{{answers.id}}-settings",
        "source": "{{answers.id}}",
        "meta": {
            "name": "Photo album settings",
            "icon": "settings"
        },
        "views": [
            {
                "widget": "w-detail",
                "id": "photoAlbumSettings",
                "source": {
                    "endpoint": "settings"
                },
                "title": {
                    "path": "galleryTitle",
                    "fallback": "Photo album settings"
                },
                "actions": [
                    {
                        "id": "saveSettings",
                        "label": "Save settings",
                        "tone": "primary",
                        "placement": "primary",
                        "endpoint": {
                            "endpoint": "updateSettings",
                            "body": {
                                "galleryTitle": "$field.galleryTitle",
                                "defaultPageSize": "$field.defaultPageSize",
                                "maxPhotosPerAlbum": "$field.maxPhotosPerAlbum",
                                "allowDownloads": "$field.allowDownloads",
                                "showCaptions": "$field.showCaptions",
                                "showTakenAt": "$field.showTakenAt",
                                "version": "$resource.version"
                            }
                        },
                        "after": {
                            "resource": "$result"
                        }
                    }
                ],
                "main": [
                    {
                        "id": "galleryPresentation",
                        "title": "Gallery presentation",
                        "fields": [
                            {
                                "id": "galleryTitle",
                                "label": "Gallery title",
                                "path": "galleryTitle",
                                "type": "text",
                                "required": true
                            },
                            {
                                "id": "defaultPageSize",
                                "label": "Albums per page",
                                "path": "defaultPageSize",
                                "type": "number",
                                "required": true,
                                "min": 1,
                                "max": 100,
                                "step": 1
                            },
                            {
                                "id": "allowDownloads",
                                "label": "Allow original photo downloads",
                                "path": "allowDownloads",
                                "type": "checkbox"
                            },
                            {
                                "id": "showCaptions",
                                "label": "Show photo captions",
                                "path": "showCaptions",
                                "type": "checkbox"
                            },
                            {
                                "id": "showTakenAt",
                                "label": "Show capture dates",
                                "path": "showTakenAt",
                                "type": "checkbox"
                            }
                        ]
                    }
                ],
                "aside": [
                    {
                        "id": "uploadLimits",
                        "title": "Upload limits",
                        "description": "Accepted originals remain private and are never removed automatically.",
                        "fields": [
                            {
                                "id": "maxPhotosPerAlbum",
                                "label": "Maximum photos per album",
                                "path": "maxPhotosPerAlbum",
                                "type": "number",
                                "required": true,
                                "min": 1,
                                "max": 500,
                                "step": 1
                            },
                            {
                                "id": "updatedAt",
                                "label": "Last updated",
                                "path": "updatedAt",
                                "type": "readonly",
                                "format": "date"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
