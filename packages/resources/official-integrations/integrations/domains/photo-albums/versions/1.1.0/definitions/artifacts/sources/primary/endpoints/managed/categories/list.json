[
    {
        "endpointId": "manageCategories",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-photo-albums/categories",
        "params": [
            {
                "name": "q",
                "in": "query",
                "type": "string"
            },
            {
                "name": "limit",
                "in": "query",
                "type": "number"
            },
            {
                "name": "offset",
                "in": "query",
                "type": "number"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "$include": "../../../schemas/categories.json"
                }
            }
        ]
    }
]
