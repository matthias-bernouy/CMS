{
    "widget": "w-detail",
    "id": "albumDetail",
    "source": {
        "endpoint": "manageAlbum",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "title",
        "fallback": "New photo album"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "saveAlbum",
            "label": "Save album",
            "tone": "primary",
            "placement": "primary",
            "endpoint": {
                "endpoint": "upsertAlbum",
                "body": {
                    "id": "$resource.id",
                    "version": "$resource.version",
                    "slug": "$field.slug",
                    "title": "$field.title",
                    "description": "$field.description",
                    "categoryId": "$field.categoryId",
                    "status": "$field.status",
                    "position": "$field.position"
                }
            },
            "after": {
                "resource": "$result"
            }
        },
        {
            "id": "archiveAlbum",
            "label": "Archive album",
            "icon": "archive",
            "tone": "danger",
            "placement": "more",
            "confirm": "Archive this album? Its photos will no longer be public.",
            "visibleWhen": {
                "all": [
                    {
                        "value": "$field.id",
                        "notEquals": ""
                    },
                    {
                        "value": "$field.status",
                        "notEquals": "archived"
                    }
                ]
            },
            "endpoint": {
                "endpoint": "archiveAlbum",
                "params": {
                    "id": "$resource.id"
                },
                "body": {
                    "version": "$resource.version"
                }
            },
            "after": {
                "resource": "$result"
            }
        }
    ],
    "main": {
        "$include": "album-detail/main.json"
    },
    "aside": {
        "$include": "album-detail/aside.json"
    }
}
