{
    "id": "createClaimReturnShipmentForMyPurchase",
    "method": "POST",
    "access": {
        "mode": "auth"
    },
    "meta": {
        "name": "Create claim return shipment for my purchase",
        "description": "Create one idempotent buyer-to-seller claim return from trusted Commerce and account snapshots."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "claimId": {
                    "type": "number"
                }
            },
            "required": [
                "claimId"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object"
            }
        }
    ],
    "steps": {
        "$include": "steps/root.json"
    },
    "return": {
        "status": 200,
        "body": {
            "claimId": "$steps.authorization.claimId",
            "shipment": {
                "id": "$steps.shipment.id",
                "expeditionNumber": "$steps.shipment.expeditionNumber",
                "trackingUrl": "$steps.shipment.trackingUrl",
                "status": "$steps.shipment.status",
                "createdAt": "$steps.shipment.createdAt",
                "idempotentReplay": "$steps.shipment.idempotentReplay"
            }
        }
    }
}
