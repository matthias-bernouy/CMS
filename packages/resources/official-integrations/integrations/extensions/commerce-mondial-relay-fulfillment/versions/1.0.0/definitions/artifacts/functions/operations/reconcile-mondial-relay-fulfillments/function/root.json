{
    "id": "reconcileMondialRelayFulfillments",
    "method": "POST",
    "access": {
        "mode": "system"
    },
    "meta": {
        "name": "Reconcile Mondial Relay fulfillments",
        "description": "Synchronize a bounded provider batch and project normalized events into Commerce."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "runKey": {
                    "type": "string"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "runKey",
                "limit"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object"
            }
        }
    ],
    "steps": {
        "$include": "steps.json"
    },
    "return": {
        "status": 200,
        "body": {
            "processed": "$steps.deliveryBatch.processed",
            "shipments": "$steps.deliveryBatch.shipments",
            "events": "$steps.commerceEvents",
            "claimReturnEvents": "$steps.commerceClaimReturnEvents"
        }
    }
}
