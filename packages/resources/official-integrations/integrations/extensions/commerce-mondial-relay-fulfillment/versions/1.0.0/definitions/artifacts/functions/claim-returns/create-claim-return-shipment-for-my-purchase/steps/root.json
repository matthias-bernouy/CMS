[
    {
        "id": "authorization",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "getClaimReturnAuthorization",
            "params": {
                "claimId": "$input.body.claimId"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.authorization.buyerCmsUserId",
                    "$ctx.user.id"
                ]
            },
            "failure": {
                "status": 403,
                "error": "Only the claim buyer can create the return shipment"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "equals": [
                    "$steps.authorization.allowed",
                    true
                ]
            },
            "failure": {
                "status": 409,
                "error": "Commerce has not authorized this claim return"
            }
        }
    },
    {
        "id": "quote",
        "call": {
            "source": "{{dependencies.delivery.sourceId}}",
            "endpoint": "resolveDeliveryQuote",
            "body": {
                "quoteId": "$steps.authorization.deliveryQuoteId",
                "externalOrderId": "$steps.authorization.orderPublicId",
                "selectedForCmsUserId": "$steps.authorization.buyerCmsUserId",
                "merchandiseSubtotalMinorAmount": "$steps.authorization.merchandiseSubtotalMinorAmount",
                "currency": "$steps.authorization.currency",
                "purpose": "claim_return"
            }
        }
    },
    {
        "id": "selection",
        "call": {
            "source": "{{dependencies.delivery.sourceId}}",
            "endpoint": "relaySelection",
            "params": {
                "externalOrderId": {
                    "$concat": [
                        "claim-return:",
                        "$steps.authorization.claimId"
                    ]
                }
            }
        }
    },
    {
        "id": "authorizationRecheck",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "getClaimReturnAuthorization",
            "params": {
                "claimId": "$steps.authorization.claimId"
            }
        }
    },
    {
        "assert": {
            "condition": {
                "all": [
                    {
                        "equals": [
                            "$steps.authorizationRecheck.allowed",
                            true
                        ]
                    },
                    {
                        "equals": [
                            "$steps.authorizationRecheck.claimVersion",
                            "$steps.authorization.claimVersion"
                        ]
                    },
                    {
                        "equals": [
                            "$steps.authorizationRecheck.buyerCmsUserId",
                            "$steps.authorization.buyerCmsUserId"
                        ]
                    },
                    {
                        "equals": [
                            "$steps.authorizationRecheck.sellerCmsUserId",
                            "$steps.authorization.sellerCmsUserId"
                        ]
                    },
                    {
                        "equals": [
                            "$steps.authorizationRecheck.orderPublicId",
                            "$steps.authorization.orderPublicId"
                        ]
                    }
                ]
            },
            "failure": {
                "status": 409,
                "error": "Claim return authorization changed before shipment creation"
            }
        }
    },
    {
        "$include": "shipment.json"
    }
]
