[
    {
        "id": "creationClaims",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "claimPendingShipmentCreations",
            "body": {
                "runKey": "$input.body.runKey",
                "limit": "$input.body.limit"
            }
        }
    },
    {
        "id": "creations",
        "forEach": {
            "items": "$steps.creationClaims.items",
            "max": 5,
            "continueOnError": true,
            "steps": [
                {
                    "id": "quote",
                    "call": {
                        "source": "{{dependencies.delivery.sourceId}}",
                        "endpoint": "resolveDeliveryQuote",
                        "body": {
                            "quoteId": "$item.deliveryQuoteId",
                            "externalOrderId": "$item.orderPublicId",
                            "selectedForCmsUserId": "$item.buyerCmsUserId",
                            "merchandiseSubtotalMinorAmount": "$item.merchandiseSubtotalMinorAmount",
                            "currency": "$item.currency",
                            "purpose": "fulfillment"
                        }
                    }
                },
                {
                    "id": "shipment",
                    "call": {
                        "source": "{{dependencies.delivery.sourceId}}",
                        "endpoint": "createShipment",
                        "body": {
                            "externalOrderId": "$item.orderPublicId",
                            "sellerCmsUserId": "$item.sellerId",
                            "deliveryQuoteId": "$steps.quote.quoteId",
                            "quoteExternalOrderId": "$steps.quote.externalOrderId",
                            "quotePurpose": "fulfillment",
                            "selectedForCmsUserId": "$item.buyerCmsUserId",
                            "senderName": "$steps.quote.sellerFulfillmentSnapshot.name",
                            "senderFirstName": "$steps.quote.sellerFulfillmentSnapshot.firstName",
                            "senderLastName": "$steps.quote.sellerFulfillmentSnapshot.lastName",
                            "senderEmail": "$steps.quote.sellerFulfillmentSnapshot.email",
                            "senderPhone": "$steps.quote.sellerFulfillmentSnapshot.phone",
                            "senderAddressLine1": "$steps.quote.sellerFulfillmentSnapshot.addressLine1",
                            "senderAddressLine2": "$steps.quote.sellerFulfillmentSnapshot.addressLine2",
                            "senderAddressLine3": "$steps.quote.sellerFulfillmentSnapshot.addressLine3",
                            "senderPostalCode": "$steps.quote.sellerFulfillmentSnapshot.postalCode",
                            "senderCity": "$steps.quote.sellerFulfillmentSnapshot.city",
                            "senderCountry": "$steps.quote.sellerFulfillmentSnapshot.country",
                            "recipientName": "$steps.quote.recipientSnapshot.name",
                            "recipientFirstName": "$steps.quote.recipientSnapshot.firstName",
                            "recipientLastName": "$steps.quote.recipientSnapshot.lastName",
                            "recipientEmail": "$steps.quote.recipientSnapshot.email",
                            "recipientPhone": "$steps.quote.recipientSnapshot.phone",
                            "recipientAddressLine1": "$steps.quote.recipientSnapshot.addressLine1",
                            "recipientAddressLine2": "$steps.quote.recipientSnapshot.addressLine2",
                            "recipientAddressLine3": "$steps.quote.recipientSnapshot.addressLine3",
                            "recipientPostalCode": "$steps.quote.recipientSnapshot.postalCode",
                            "recipientCity": "$steps.quote.recipientSnapshot.city",
                            "recipientCountry": "$steps.quote.recipientSnapshot.country",
                            "deliveryRelayLocation": "$steps.quote.relayLocation",
                            "weightGrams": "$steps.quote.weightGrams",
                            "packageCount": 1,
                            "declaredValueMinorAmount": "$item.merchandiseSubtotalMinorAmount",
                            "declaredCurrency": "EUR",
                            "metadata": {
                                "commerceOrderId": "$item.orderPublicId",
                                "financialTermsHash": "$item.financialTermsHash",
                                "deliveryQuoteId": "$item.deliveryQuoteId",
                                "declaredValueMinorAmount": "$item.merchandiseSubtotalMinorAmount",
                                "declaredCurrency": "EUR"
                            }
                        }
                    }
                },
                {
                    "id": "complete",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "completeOrderShipmentCreation",
                        "body": {
                            "operationId": "$item.operationId",
                            "claimToken": "$item.claimToken",
                            "providerReference": "$steps.shipment.expeditionNumber",
                            "providerShipmentId": "$steps.shipment.id",
                            "providerSnapshot": {
                                "status": "$steps.shipment.status",
                                "createdAt": "$steps.shipment.createdAt"
                            }
                        }
                    }
                }
            ],
            "yield": "$steps.complete",
            "onError": [
                {
                    "id": "failCreation",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "failOrderShipmentCreation",
                        "body": {
                            "operationId": "$item.operationId",
                            "claimToken": "$item.claimToken",
                            "error": "Mondial Relay shipment creation reconciliation failed"
                        }
                    }
                }
            ],
            "errorYield": {
                "operationId": "$item.operationId",
                "failed": true,
                "failure": "$steps.failCreation"
            }
        }
    },
    {
        "id": "cancellationClaims",
        "call": {
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "claimPendingShipmentCancellations",
            "body": {
                "runKey": "$input.body.runKey",
                "limit": "$input.body.limit"
            }
        }
    }
]
