{
    "type": "function",
    "function": {
        "id": "requestShipmentLabelForMySale",
        "method": "POST",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Request shipment label for my sale",
            "description": "Issue a short-lived seller-bound label capability without exposing the provider URL."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "orderId": {
                        "type": "string"
                    }
                },
                "required": [
                    "orderId"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "shippingActions",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getOrderShippingActionsSellerContext",
                    "params": {
                        "orderId": "$input.body.orderId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "all": [
                            {
                                "equals": [
                                    "$steps.shippingActions.canDownloadLabel",
                                    true
                                ]
                            },
                            {
                                "equals": [
                                    "$steps.shippingActions.sellerCmsUserId",
                                    "$ctx.user.id"
                                ]
                            }
                        ]
                    },
                    "failure": {
                        "status": 409,
                        "error": "Commerce has not authorized label access"
                    }
                }
            },
            {
                "id": "capability",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "issueLabelAccess",
                    "body": {
                        "externalOrderId": "$steps.shippingActions.publicId",
                        "sellerCmsUserId": "$ctx.user.id"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "labelUrl": {
                    "$concat": [
                        "/.cms/sources/{{dependencies.delivery.sourceId}}/label?token=",
                        "$steps.capability.token"
                    ]
                },
                "expiresAt": "$steps.capability.expiresAt"
            }
        }
    },
    "contractVersion": "1.1.0"
}
