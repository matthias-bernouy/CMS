{
    "type": "function",
    "function": {
        "id": "getRelayPointForMyClaimReturn",
        "method": "GET",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Get relay point for my claim return",
            "description": "Return the selected return relay to either claim participant."
        },
        "input": {
            "params": {
                "claimId": {
                    "type": "number"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "authorization",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getClaimReturnAuthorization",
                    "params": {
                        "claimId": "$input.params.claimId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "in": [
                            "$ctx.user.id",
                            [
                                "$steps.authorization.buyerCmsUserId",
                                "$steps.authorization.sellerCmsUserId"
                            ]
                        ]
                    },
                    "failure": {
                        "status": 403,
                        "error": "Marketplace claim return does not belong to the current user"
                    }
                }
            },
            {
                "id": "selection",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "relaySelection",
                    "params": {
                        "externalOrderId": {
                            "$concat": [
                                "claim-return:",
                                "$steps.authorization.claimId"
                            ]
                        }
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.selection"
        }
    }
}
