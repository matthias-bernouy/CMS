{
    "type": "function",
    "function": {
        "id": "requestClaimReturnLabelForMyPurchase",
        "method": "POST",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Request claim return label for my purchase",
            "description": "Issue a short-lived buyer-bound return-label capability without exposing the provider URL."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "claimId": {
                        "type": "number"
                    }
                },
                "required": [
                    "claimId"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "authorization",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getClaimReturnAuthorization",
                    "params": {
                        "claimId": "$input.body.claimId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.authorization.buyerCmsUserId",
                            "$ctx.user.id"
                        ]
                    },
                    "failure": {
                        "status": 403,
                        "error": "Only the claim buyer can request the return label"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.authorization.allowed",
                            true
                        ]
                    },
                    "failure": {
                        "status": 409,
                        "error": "Commerce has not authorized this claim return"
                    }
                }
            },
            {
                "id": "capability",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "issueLabelAccess",
                    "body": {
                        "externalOrderId": {
                            "$concat": [
                                "claim-return:",
                                "$steps.authorization.claimId"
                            ]
                        },
                        "sellerCmsUserId": "$ctx.user.id"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "labelUrl": {
                    "$concat": [
                        "/.cms/sources/{{dependencies.delivery.sourceId}}/label?token=",
                        "$steps.capability.token"
                    ]
                },
                "expiresAt": "$steps.capability.expiresAt"
            }
        }
    }
}
