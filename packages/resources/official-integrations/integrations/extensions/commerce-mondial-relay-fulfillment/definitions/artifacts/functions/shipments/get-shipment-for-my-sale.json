{
    "type": "function",
    "function": {
        "id": "getShipmentForMySale",
        "method": "GET",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Get shipment for my sale",
            "description": "Return a sanitized shipment projection after Commerce resolves seller ownership."
        },
        "input": {
            "params": {
                "orderId": {
                    "type": "string"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "sale",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getOrderFulfillmentSellerContext",
                    "params": {
                        "orderId": "$input.params.orderId"
                    }
                }
            },
            {
                "id": "shipments",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "shipmentForExternalOrder",
                    "params": {
                        "externalOrderId": "$steps.sale.publicId"
                    }
                }
            },
            {
                "id": "details",
                "forEach": {
                    "items": "$steps.shipments.items",
                    "max": 1,
                    "steps": [
                        {
                            "assert": {
                                "condition": {
                                    "exists": "$item.id"
                                }
                            }
                        }
                    ],
                    "yield": {
                        "id": "$item.id",
                        "expeditionNumber": "$item.expeditionNumber",
                        "status": "$item.status",
                        "trackingUrl": "$item.trackingUrl",
                        "deliveryRelayLocation": "$item.deliveryRelayLocation",
                        "latestEventLabel": "$item.latestEventLabel",
                        "latestEventAt": "$item.latestEventAt",
                        "carrierAcceptedAt": "$item.carrierAcceptedAt",
                        "sellerHandoffDeclaredAt": "$item.sellerHandoffDeclaredAt",
                        "recipientHandoffAt": "$item.recipientHandoffAt",
                        "createdAt": "$item.createdAt",
                        "events": "$item.events"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "orderId": "$steps.sale.id",
                "orderPublicId": "$steps.sale.publicId",
                "orderNumber": "$steps.sale.orderNumber",
                "shipments": "$steps.details"
            }
        }
    },
    "contractVersion": "1.0.0"
}
