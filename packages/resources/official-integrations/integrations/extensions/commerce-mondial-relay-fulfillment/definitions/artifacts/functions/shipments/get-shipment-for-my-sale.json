{
    "type": "function",
    "function": {
        "id": "getShipmentForMySale",
        "method": "GET",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Get shipment for my sale",
            "description": "Return a sanitized shipment projection with seller actions authorized by Commerce."
        },
        "input": {
            "params": {
                "orderId": {
                    "type": "string"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "shippingActions",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getOrderShippingActionsSellerContext",
                    "params": {
                        "orderId": "$input.params.orderId"
                    }
                }
            },
            {
                "id": "shipments",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "shipmentForExternalOrder",
                    "params": {
                        "externalOrderId": "$steps.shippingActions.publicId"
                    }
                }
            },
            {
                "id": "details",
                "forEach": {
                    "items": "$steps.shipments.items",
                    "max": 1,
                    "steps": [
                        {
                            "assert": {
                                "condition": {
                                    "exists": "$item.id"
                                }
                            }
                        }
                    ],
                    "yield": {
                        "id": "$item.id",
                        "expeditionNumber": "$item.expeditionNumber",
                        "status": "$item.status",
                        "trackingUrl": "$item.trackingUrl",
                        "deliveryRelayLocation": "$item.deliveryRelayLocation",
                        "latestEventLabel": "$item.latestEventLabel",
                        "latestEventAt": "$item.latestEventAt",
                        "carrierAcceptedAt": "$item.carrierAcceptedAt",
                        "sellerHandoffDeclaredAt": "$item.sellerHandoffDeclaredAt",
                        "recipientHandoffAt": "$item.recipientHandoffAt",
                        "createdAt": "$item.createdAt",
                        "events": "$item.events"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "orderId": "$steps.shippingActions.id",
                "orderPublicId": "$steps.shippingActions.publicId",
                "orderNumber": "$steps.shippingActions.orderNumber",
                "actions": {
                    "canCreateShipment": "$steps.shippingActions.canCreateShipment",
                    "canDownloadLabel": "$steps.shippingActions.canDownloadLabel",
                    "canDeclareHandoff": "$steps.shippingActions.canDeclareHandoff",
                    "requiresReview": "$steps.shippingActions.requiresReview",
                    "reviewReason": "$steps.shippingActions.reviewReason",
                    "fulfillmentStatus": "$steps.shippingActions.fulfillmentStatus",
                    "settlementStatus": "$steps.shippingActions.settlementStatus"
                },
                "shipments": "$steps.details"
            }
        }
    },
    "contractVersion": "1.1.0"
}
