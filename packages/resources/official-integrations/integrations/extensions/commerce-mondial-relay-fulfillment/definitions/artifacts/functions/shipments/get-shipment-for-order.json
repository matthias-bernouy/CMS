{
    "type": "function",
    "function": {
        "id": "getShipmentForOrder",
        "method": "GET",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Get shipment for order",
            "description": "Return an allowlisted tracking projection after Commerce verifies buyer ownership."
        },
        "input": {
            "params": {
                "orderId": {
                    "type": "string"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "order",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getOrderFulfillmentBuyerContext",
                    "params": {
                        "orderId": "$input.params.orderId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.order.buyerCmsUserId",
                            "$ctx.user.id"
                        ]
                    },
                    "failure": {
                        "status": 403,
                        "error": "Order does not belong to the current buyer"
                    }
                }
            },
            {
                "id": "shipments",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "shipmentForExternalOrder",
                    "params": {
                        "externalOrderId": "$steps.order.publicId"
                    }
                }
            },
            {
                "id": "tracking",
                "forEach": {
                    "items": "$steps.shipments.items",
                    "max": 1,
                    "steps": [
                        {
                            "assert": {
                                "condition": {
                                    "exists": "$item.id"
                                }
                            }
                        }
                    ],
                    "yield": {
                        "id": "$item.id",
                        "expeditionNumber": "$item.expeditionNumber",
                        "status": "$item.status",
                        "trackingUrl": "$item.trackingUrl",
                        "deliveryRelayLocation": "$item.deliveryRelayLocation",
                        "latestEventLabel": "$item.latestEventLabel",
                        "latestEventAt": "$item.latestEventAt",
                        "carrierAcceptedAt": "$item.carrierAcceptedAt",
                        "recipientHandoffAt": "$item.recipientHandoffAt",
                        "createdAt": "$item.createdAt",
                        "events": "$item.events"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "orderId": "$steps.order.id",
                "orderPublicId": "$steps.order.publicId",
                "shipments": "$steps.tracking"
            }
        }
    }
}
