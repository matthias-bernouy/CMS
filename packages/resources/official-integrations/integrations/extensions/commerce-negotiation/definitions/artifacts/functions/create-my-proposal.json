{
    "type": "function",
    "function": {
        "id": "createMyProposal",
        "method": "POST",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Create my proposal",
            "description": "Resolve an authoritative Commerce offer and create a bounded buyer proposal."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "offerId": {
                        "type": "number"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "offerId",
                    "amount"
                ]
            }
        },
        "output": [
            {
                "status": "201",
                "body": {
                    "type": "object"
                }
            },
            {
                "status": "400",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "403",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "404",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "409",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            }
        ],
        "steps": [
            {
                "id": "offer",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getOfferNegotiationContext",
                    "params": {
                        "offerId": "$input.body.offerId"
                    },
                    "onError": {
                        "propagate": [
                            {
                                "sourceStatus": 400,
                                "status": 400
                            },
                            {
                                "sourceStatus": 404,
                                "status": 404
                            }
                        ]
                    }
                }
            },
            {
                "id": "proposal",
                "call": {
                    "source": "commerce-negotiation",
                    "endpoint": "createMyProposal",
                    "body": {
                        "offerId": "$steps.offer.offerId",
                        "amount": "$input.body.amount",
                        "message": "$input.body.message",
                        "offerSlug": "$steps.offer.offerSlug",
                        "offerTitle": "$steps.offer.offerTitle",
                        "offerMainImageMediaId": "$steps.offer.offerMainImageMediaId",
                        "sellerCmsUserId": "$steps.offer.sellerCmsUserId",
                        "sellerDisplayName": "$steps.offer.sellerDisplayName",
                        "referenceAmount": "$steps.offer.referenceAmount",
                        "currency": "$steps.offer.currency",
                        "wholeUnitPrices": "$steps.offer.wholeUnitPrices",
                        "publicationStatus": "$steps.offer.publicationStatus",
                        "availability": "$steps.offer.availability"
                    },
                    "onError": {
                        "propagate": [
                            {
                                "sourceStatus": 400,
                                "status": 400
                            },
                            {
                                "sourceStatus": 403,
                                "status": 403
                            },
                            {
                                "sourceStatus": 404,
                                "status": 404
                            },
                            {
                                "sourceStatus": 409,
                                "status": 409
                            }
                        ]
                    }
                }
            }
        ],
        "return": {
            "status": 201,
            "body": "$steps.proposal"
        }
    },
    "contractVersion": "1.0.0"
}
