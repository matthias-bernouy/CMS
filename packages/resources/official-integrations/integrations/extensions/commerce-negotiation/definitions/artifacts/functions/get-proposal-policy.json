{
    "type": "function",
    "function": {
        "id": "getProposalPolicy",
        "method": "GET",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Get proposal policy",
            "description": "Resolve an authoritative Commerce offer and return its negotiation policy."
        },
        "input": {
            "params": {
                "offerId": {
                    "type": "number"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            },
            {
                "status": "400",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "403",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "404",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "409",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            }
        ],
        "steps": [
            {
                "id": "offer",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getOfferNegotiationContext",
                    "params": {
                        "offerId": "$input.params.offerId"
                    },
                    "onError": {
                        "propagate": [
                            {
                                "sourceStatus": 400,
                                "status": 400
                            },
                            {
                                "sourceStatus": 404,
                                "status": 404
                            }
                        ]
                    }
                }
            },
            {
                "id": "policy",
                "call": {
                    "source": "{{answers.id}}",
                    "endpoint": "getProposalPolicy",
                    "params": {
                        "offerId": "$steps.offer.offerId",
                        "offerSlug": "$steps.offer.offerSlug",
                        "offerTitle": "$steps.offer.offerTitle",
                        "sellerCmsUserId": "$steps.offer.sellerCmsUserId",
                        "sellerDisplayName": "$steps.offer.sellerDisplayName",
                        "referenceAmount": "$steps.offer.referenceAmount",
                        "currency": "$steps.offer.currency",
                        "wholeUnitPrices": "$steps.offer.wholeUnitPrices",
                        "publicationStatus": "$steps.offer.publicationStatus",
                        "availability": "$steps.offer.availability"
                    },
                    "onError": {
                        "propagate": [
                            {
                                "sourceStatus": 400,
                                "status": 400
                            },
                            {
                                "sourceStatus": 403,
                                "status": 403
                            },
                            {
                                "sourceStatus": 404,
                                "status": 404
                            },
                            {
                                "sourceStatus": 409,
                                "status": 409
                            }
                        ]
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.policy"
        }
    }
}
