{
    "endpointId": "getProposalPolicy",
    "method": "GET",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/policy",
    "params": {
        "$include": "get-proposal-policy/params.json"
    },
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "canPropose": {
                        "type": "boolean"
                    },
                    "ineligibilityReason": {
                        "type": "string"
                    },
                    "offerId": {
                        "type": "number"
                    },
                    "referenceAmount": {
                        "type": "number"
                    },
                    "minimumAmount": {
                        "type": "number"
                    },
                    "maximumAmount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "wholeUnitPrices": {
                        "type": "boolean"
                    },
                    "expiresAfterHours": {
                        "type": "number"
                    }
                },
                "required": [
                    "enabled",
                    "canPropose",
                    "offerId",
                    "referenceAmount",
                    "minimumAmount",
                    "maximumAmount",
                    "currency",
                    "wholeUnitPrices"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "403",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "404",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        }
    ]
}
