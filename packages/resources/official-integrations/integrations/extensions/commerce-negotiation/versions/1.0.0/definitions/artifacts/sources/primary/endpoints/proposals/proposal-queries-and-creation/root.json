[
    {
        "endpointId": "health",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/health",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "ok": {
                            "type": "boolean"
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "ok",
                        "enabled"
                    ]
                }
            }
        ]
    },
    {
        "$include": "get-proposal-policy.json"
    },
    {
        "$include": "create-my-proposal.json"
    },
    {
        "$include": "my-proposals.json"
    },
    {
        "endpointId": "myProposal",
        "method": "GET",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-commerce-negotiation/proposal",
        "params": [
            {
                "name": "id",
                "in": "query",
                "type": "number"
            },
            {
                "name": "publicId",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            },
            {
                "status": "400",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            },
            {
                "status": "404",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            }
        ]
    }
