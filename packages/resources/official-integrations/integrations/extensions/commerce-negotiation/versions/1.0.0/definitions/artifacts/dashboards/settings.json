{
    "type": "dashboard",
    "dashboard": {
        "id": "{{answers.id}}-settings",
        "source": "{{answers.id}}",
        "meta": {
            "name": "Negotiation settings",
            "icon": {
                "path": "assets/icon.svg"
            }
        },
        "views": [
            {
                "widget": "w-detail",
                "id": "negotiationSettings",
                "source": {
                    "endpoint": "settings"
                },
                "title": {
                    "path": "id",
                    "fallback": "Negotiation settings"
                },
                "actions": [
                    {
                        "id": "saveSettings",
                        "label": "Save settings",
                        "tone": "primary",
                        "placement": "primary",
                        "endpoint": {
                            "endpoint": "updateSettings",
                            "body": {
                                "expectedVersion": "$resource.version",
                                "minimumPercent": "$field.minimumPercent",
                "maximumPercent": "$field.maximumPercent",
                "proposalTtlHours": "$field.proposalTtlHours",
                "acceptedCheckoutTtlHours": "$field.acceptedCheckoutTtlHours",
                "enabled": "$field.enabled"
                            }
                        },
                        "after": {
                            "resource": "$result"
                        }
                    }
                ],
                "main": [
                    {
                        "id": "policy",
                        "title": "Price bounds",
                        "fields": [
                            {
                                "id": "minimumPercent",
                                "label": "Minimum percent",
                                "path": "minimumPercent",
                                "type": "text",
                                "required": true
                            },
                            {
                                "id": "maximumPercent",
                                "label": "Maximum percent",
                                "path": "maximumPercent",
                                "type": "text",
                                "required": true
                            },
              {
                "id": "proposalTtlHours",
                "label": "Proposal lifetime in hours",
                "path": "proposalTtlHours",
                "type": "text",
                "required": true
              },
              {
                "id": "acceptedCheckoutTtlHours",
                "label": "Accepted checkout lifetime in hours",
                "path": "acceptedCheckoutTtlHours",
                "type": "text",
                "required": true
              },
                            {
                                "id": "enabled",
                                "label": "Enabled",
                                "path": "enabled",
                                "type": "checkbox"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
