{
    "type": "trigger",
    "trigger": {
        "id": "execute-buyer-payment-cancellation",
        "label": "Cancel buyer order PaymentIntent",
        "event": {
            "kind": "endpoint",
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "cancelMyOrder",
            "phase": "response"
        },
        "mode": "async",
        "failureMode": "ignore",
        "condition": {
            "all": [
                {
                    "equals": [
                        "$response.status",
                        201
                    ]
                },
                {
                    "in": [
                        "$response.body.paymentCancellationAuthorization.status",
                        [
                            "requested",
                            "processing"
                        ]
                    ]
                }
            ]
        },
        "function": {
            "id": "executeProviderPaymentCancellation",
            "body": "$response.body.paymentCancellationAuthorization"
        }
    }
}
