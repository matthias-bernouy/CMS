{
    "type": "trigger",
    "trigger": {
        "id": "execute-authorized-settlement-release",
        "label": "Execute authorized settlement release",
        "event": {
            "kind": "endpoint",
            "source": "{{dependencies.commerce.sourceId}}",
            "endpoint": "authorizeOrderRelease",
            "phase": "response"
        },
        "mode": "async",
        "failureMode": "ignore",
        "condition": {
            "all": [
                {
                    "equals": [
                        "$response.status",
                        200
                    ]
                },
                {
                    "equals": [
                        "$response.body.status",
                        "authorized"
                    ]
                }
            ]
        },
        "function": {
            "id": "executeAuthorizedSettlementRelease",
            "body": "$response.body"
        }
    }
}
