{
    "id": "reconcileProtectedPaymentSystems",
    "method": "POST",
    "access": {
        "mode": "system"
    },
    "meta": {
        "name": "Reconcile protected payment systems",
        "description": "Repair Stripe provider state and idempotently project payments, settlement operations, and card disputes into Commerce."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "runKey": {
                    "type": "string"
                },
                "limit": {
                    "type": "number"
                }
            },
            "required": [
                "runKey",
                "limit"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object"
            }
        }
    ],
    "steps": {
        "$include": "steps.json"
    },
    "return": {
        "status": 200,
        "body": {
            "platformLiabilities": "$steps.platformLiabilities",
            "platformLiabilityApplications": "$steps.platformLiabilityApplications",
            "run": "$steps.providerRun",
            "paymentProjections": "$steps.paymentProjections",
            "operationProjections": "$steps.operationProjections",
            "disputeProjections": "$steps.disputeProjections"
        }
    }
}
