{
    "id": "submitSellerOfferPrice",
    "method": "POST",
    "access": {
        "mode": "auth"
    },
    "meta": {
        "name": "Submit seller offer price",
        "description": "Idempotently enroll the authenticated seller for held platform payments with explicit current seller-terms consent when necessary, then submit the price to Commerce without promoting Commerce verification or requiring a bank payout rail."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "offerId": {
                    "type": "string"
                },
                "amount": {
                    "type": "number"
                },
                "expectedVersion": {
                    "type": "number"
                },
                "accountToken": {
                    "type": "string"
                },
                "sellerTermsAccepted": {
                    "type": "boolean"
                }
            },
            "required": [
                "offerId",
                "amount",
                "expectedVersion"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "offer": {
                        "type": "object"
                    },
                    "proposal": {
                        "type": "object"
                    }
                },
                "required": [
                    "offer",
                    "proposal"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "403",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        }
    ],
    "steps": {
        "$include": "steps/root.json"
    },
    "return": {
        "status": 200,
        "body": "$steps.result"
    }
}
