[
    {
        "id": "activate-protected-sale-capability",
        "steps": [
            {
                "id": "providerSnapshot",
                "call": {
                    "source": "{{dependencies.stripe.sourceId}}",
                    "endpoint": "listSellerHeldPaymentCapabilities",
                    "body": {}
                }
            },
            {
                "id": "activation",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "activateSellerSaleCapability",
                    "body": {
                        "capabilityKey": "protected_payment",
                        "sellerKind": "user",
                        "readySellerCmsUserIds": "$steps.providerSnapshot.readySellerCmsUserIds",
                        "snapshotAt": "$steps.providerSnapshot.snapshotAt",
                        "actorId": "commerce-stripe-payments"
                    }
                }
            }
        ]
    }
]
