{
    "type": "function",
    "function": {
        "id": "processDueOrderDeadlines",
        "method": "POST",
        "access": {
            "mode": "system"
        },
        "meta": {
            "name": "Process due order deadlines",
            "description": "Apply database-clock Commerce deadlines without inventing provider truth or automatic claim guilt."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "runKey": {
                        "type": "string"
                    },
                    "limit": {
                        "type": "number"
                    }
                },
                "required": [
                    "runKey",
                    "limit"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "runKey": {
                            "type": "string"
                        },
                        "processed": {
                            "type": "number"
                        },
                        "events": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "kind": {
                                        "type": "string"
                                    },
                                    "orderId": {
                                        "type": "number"
                                    },
                                    "orderPublicId": {
                                        "type": "string"
                                    },
                                    "claimId": {
                                        "type": "number"
                                    },
                                    "cancellationRequestId": {
                                        "type": "number"
                                    },
                                    "outcome": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "required": [
                        "runKey",
                        "processed",
                        "events"
                    ]
                }
            }
        ],
        "steps": [
            {
                "assert": {
                    "condition": {
                        "all": [
                            {
                                "gte": [
                                    "$input.body.limit",
                                    1
                                ]
                            },
                            {
                                "lte": [
                                    "$input.body.limit",
                                    10
                                ]
                            }
                        ]
                    },
                    "failure": {
                        "status": 400,
                        "error": "limit must be between 1 and 10"
                    }
                }
            },
            {
                "id": "batch",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "processDueOrderDeadlines",
                    "body": {
                        "runKey": "$input.body.runKey",
                        "limit": "$input.body.limit"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.batch"
        }
    }
}
