{
    "type": "function",
    "function": {
        "id": "dispatchPendingPaymentCancellations",
        "method": "POST",
        "access": {
            "mode": "system"
        },
        "meta": {
            "name": "Dispatch pending payment cancellations",
            "description": "Lease Commerce cancellation requests, confirm Stripe PaymentIntent cancellation, and project provider truth before inventory restoration."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "runKey": {
                        "type": "string"
                    },
                    "limit": {
                        "type": "number"
                    }
                },
                "required": [
                    "runKey",
                    "limit"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "assert": {
                    "condition": {
                        "all": [
                            {
                                "gte": [
                                    "$input.body.limit",
                                    1
                                ]
                            },
                            {
                                "lte": [
                                    "$input.body.limit",
                                    10
                                ]
                            }
                        ]
                    },
                    "failure": {
                        "status": 400,
                        "error": "limit must be between 1 and 10"
                    }
                }
            },
            {
                "id": "batch",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "pendingPaymentCancellationAuthorizations",
                    "body": {
                        "runKey": "$input.body.runKey",
                        "limit": "$input.body.limit"
                    }
                }
            },
            {
                "id": "dispatches",
                "forEach": {
                    "items": "$steps.batch.authorizations",
                    "max": 10,
                    "steps": [
                        {
                            "id": "providerCancellation",
                            "call": {
                                "source": "{{dependencies.stripe.sourceId}}",
                                "endpoint": "cancelProtectedPayment",
                                "body": {
                                    "clientReferenceId": "$item.clientReferenceId",
                                    "cancellationRequestId": "$item.cancellationRequestId",
                                    "reason": "$item.reason"
                                }
                            }
                        },
                        {
                            "id": "commercePayment",
                            "call": {
                                "source": "{{dependencies.commerce.sourceId}}",
                                "endpoint": "recordOrderPayment",
                                "body": {
                                    "orderPublicId": "$item.orderPublicId",
                                    "providerEventId": "$steps.providerCancellation.providerEventId",
                                    "providerPaymentId": "$steps.providerCancellation.providerPaymentId",
                                    "providerPaymentIntentId": "$steps.providerCancellation.providerPaymentIntentId",
                                    "providerChargeId": "$steps.providerCancellation.providerChargeId",
                                    "status": "$steps.providerCancellation.paymentStatus",
                                    "amount": "$steps.providerCancellation.amount",
                                    "currency": "$steps.providerCancellation.currency",
                                    "financialTermsHash": "$steps.providerCancellation.financialTermsHash",
                                    "occurredAt": "$steps.providerCancellation.occurredAt",
                                    "providerPaymentAbsent": "$steps.providerCancellation.providerPaymentAbsent",
                                    "cancellationRequestId": "$steps.providerCancellation.cancellationRequestId",
                                    "providerSnapshot": "$steps.providerCancellation.providerSnapshot"
                                }
                            }
                        }
                    ],
                    "yield": {
                        "authorization": "$item",
                        "providerCancellation": "$steps.providerCancellation",
                        "commercePayment": "$steps.commercePayment"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "runKey": "$steps.batch.runKey",
                "dispatches": "$steps.dispatches"
            }
        }
    }
}
