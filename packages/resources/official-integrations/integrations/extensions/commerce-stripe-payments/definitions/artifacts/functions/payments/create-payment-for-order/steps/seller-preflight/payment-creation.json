[
    {
        "id": "payment",
        "call": {
            "source": "{{dependencies.stripe.sourceId}}",
            "endpoint": "createProtectedPayment",
            "body": {
                "sellerUserId": "$steps.terms.sellerId",
                "amountTotal": "$steps.terms.buyerTotalAmount",
                "sellerTransferAmount": "$steps.terms.sellerProceedsAmount",
                "currency": "$steps.terms.currency",
                "clientReferenceId": "$steps.terms.orderPublicId",
                "financialTermsHash": "$steps.terms.financialTermsHash",
                "financialRevision": "$steps.terms.financialRevision",
                "dualApprovalThresholdAmount": "$steps.terms.dualApprovalThresholdAmount",
                "description": "$steps.terms.orderNumber"
            }
        }
    }
]
