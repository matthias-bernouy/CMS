[
    {
        "id": "operationProjections",
        "forEach": {
            "items": "$steps.providerRun.commerceOperations",
            "max": 5,
            "continueOnError": true,
            "steps": [
                {
                    "id": "commerceOperation",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "recordOrderSettlement",
                        "body": {
                            "orderPublicId": "$item.orderPublicId",
                            "providerEventId": "$item.providerEventId",
                            "operationType": "$item.operationType",
                            "providerOperationId": "$item.providerOperationId",
                            "status": "$item.status",
                            "amount": "$item.amount",
                            "currency": "$item.currency",
                            "occurredAt": "$item.occurredAt",
                            "releaseAuthorizationId": "$item.releaseAuthorizationId",
                            "refundRequestId": "$item.refundRequestId",
                            "commerceRefundRequestId": "$item.commerceRefundRequestId",
                            "providerSnapshot": "$item.providerSnapshot"
                        }
                    }
                },
                {
                    "id": "acknowledgeProjection",
                    "call": {
                        "source": "{{dependencies.stripe.sourceId}}",
                        "endpoint": "acknowledgeCommerceProjection",
                        "body": {
                            "projectionId": "$item.projectionId",
                            "claimToken": "$item.projectionClaimToken"
                        }
                    }
                }
            ],
            "yield": "$steps.commerceOperation",
            "onError": [
                {
                    "id": "failProjection",
                    "call": {
                        "source": "{{dependencies.stripe.sourceId}}",
                        "endpoint": "failCommerceProjection",
                        "body": {
                            "projectionId": "$item.projectionId",
                            "claimToken": "$item.projectionClaimToken",
                            "error": "Commerce financial projection failed"
                        }
                    }
                }
            ],
            "errorYield": {
                "projectionId": "$item.projectionId",
                "projectionFailed": true,
                "failure": "$steps.failProjection"
            }
        }
    },
    {
        "id": "disputeProjections",
        "forEach": {
            "items": "$steps.providerRun.disputes",
            "max": 5,
            "continueOnError": true,
            "steps": [
                {
                    "id": "commerceDispute",
                    "call": {
                        "source": "{{dependencies.commerce.sourceId}}",
                        "endpoint": "recordOrderStripeDispute",
                        "body": {
                            "orderPublicId": "$item.clientReferenceId",
                            "providerEventId": "$item.providerEventId",
                            "providerDisputeId": "$item.id",
                            "status": "$item.status",
                            "reason": "$item.reason",
                            "amount": "$item.amount",
                            "currency": "$item.currency",
                            "openedAt": "$item.createdAt",
                            "occurredAt": "$item.updatedAt",
                            "evidenceDueBy": "$item.evidenceDueBy",
                            "providerSnapshot": "$item"
                        }
                    }
                },
                {
                    "id": "acknowledgeDisputeProjection",
                    "call": {
                        "source": "{{dependencies.stripe.sourceId}}",
                        "endpoint": "acknowledgeCommerceProjection",
                        "body": {
                            "projectionId": "$item.projectionId",
                            "claimToken": "$item.projectionClaimToken"
                        }
                    }
                }
            ],
            "yield": "$steps.commerceDispute",
            "onError": [
                {
                    "id": "failDisputeProjection",
                    "call": {
                        "source": "{{dependencies.stripe.sourceId}}",
                        "endpoint": "failCommerceProjection",
                        "body": {
                            "projectionId": "$item.projectionId",
                            "claimToken": "$item.projectionClaimToken",
                            "error": "Commerce dispute projection failed"
                        }
                    }
                }
            ],
            "errorYield": {
                "projectionId": "$item.projectionId",
                "projectionFailed": true,
                "failure": "$steps.failDisputeProjection"
            }
        }
    }
]
