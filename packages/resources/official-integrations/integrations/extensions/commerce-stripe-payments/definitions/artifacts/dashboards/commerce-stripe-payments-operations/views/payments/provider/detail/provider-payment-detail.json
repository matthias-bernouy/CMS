{
    "widget": "w-detail",
    "id": "providerPaymentDetail",
    "source": {
        "sourceId": "{{dependencies.stripe.sourceId}}",
        "endpoint": "getProviderPayment",
        "params": {
            "paymentId": "$selection.id"
        }
    },
    "title": {
        "path": "clientReferenceId",
        "fallback": "Stripe provider payment"
    },
    "status": {
        "path": "settlementStatus"
    },
    "main": [
        {
            "id": "providerPaymentIdentity",
            "title": "Provider correlation",
            "fields": [
                {
                    "id": "providerDetailPaymentId",
                    "label": "Provider payment",
                    "path": "paymentId",
                    "type": "readonly"
                },
                {
                    "id": "providerDetailOrder",
                    "label": "Commerce order reference",
                    "path": "clientReferenceId",
                    "type": "readonly"
                },
                {
                    "id": "providerDetailIntent",
                    "label": "Stripe PaymentIntent",
                    "path": "stripePaymentIntentId",
                    "type": "readonly"
                },
                {
                    "id": "providerDetailCharge",
                    "label": "Stripe Charge",
                    "path": "stripeChargeId",
                    "type": "readonly"
                },
                {
                    "id": "providerDetailBalanceTransaction",
                    "label": "Charge balance transaction",
                    "path": "stripeChargeBalanceTransactionId",
                    "type": "readonly"
                },
                {
                    "id": "providerDetailTermsHash",
                    "label": "Financial terms hash",
                    "path": "financialTermsHash",
                    "type": "readonly"
                }
            ]
        },
        {
            "id": "providerPaymentAccounting",
            "title": "Actual Stripe accounting",
            "description": "Stripe fees are provider truth. Refund fee adjustments are signed: a negative value is a provider fee credit and is counted exactly once.",
            "fields": [
                {
                    "id": "providerDetailCaptured",
                    "label": "Captured",
                    "path": "amountTotal",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailPlatformGross",
                    "label": "Platform retained before Stripe",
                    "path": "platformRetainedAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailChargeFee",
                    "label": "Charge processing fee",
                    "path": "actualStripeChargeFeeAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailRefundFee",
                    "label": "Signed refund fee adjustment",
                    "path": "actualStripeRefundFeeAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailTotalFee",
                    "label": "Actual Stripe processing cost",
                    "path": "actualStripeProcessingFeeAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailChargeNet",
                    "label": "Charge net",
                    "path": "actualStripeChargeNetAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailMargin",
                    "label": "Platform retained after Stripe",
                    "path": "actualPlatformMarginAfterStripeAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailRefunded",
                    "label": "Refunded",
                    "path": "refundedAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailTransferred",
                    "label": "Transferred",
                    "path": "transferredAmount",
                    "type": "readonly",
                    "format": "money"
                },
                {
                    "id": "providerDetailReversed",
                    "label": "Reversed",
                    "path": "reversedAmount",
                    "type": "readonly",
                    "format": "money"
                }
            ]
        }
    ]
}
