{
    "widget": "w-detail",
    "id": "stripeDisputeDetail",
    "source": {
        "sourceId": "{{dependencies.stripe.sourceId}}",
        "endpoint": "getStripeDispute",
        "params": {
            "disputeId": "$selection.id"
        }
    },
    "title": {
        "path": "id",
        "fallback": "Stripe dispute"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "stageEvidence",
            "label": "Stage evidence",
            "placement": "primary",
            "visibleWhen": {
                "all": [
                    {
                        "value": "$field.evidenceStatus",
                        "notEquals": "submitted"
                    },
                    {
                        "value": "$field.evidenceStatus",
                        "notEquals": "accepted"
                    },
                    {
                        "value": "$field.evidenceStatus",
                        "notEquals": "closed"
                    },
                    {
                        "value": "$field.status",
                        "notEquals": "won"
                    },
                    {
                        "value": "$field.status",
                        "notEquals": "lost"
                    },
                    {
                        "value": "$field.status",
                        "notEquals": "prevented"
                    },
                    {
                        "value": "$field.status",
                        "notEquals": "warning_closed"
                    }
                ]
            },
            "endpoint": {
                "sourceId": "{{dependencies.stripe.sourceId}}",
                "endpoint": "stageStripeDisputeEvidence",
                "body": {
                    "disputeId": "$resource.id",
                    "evidenceOperationId": "$resource.updatedAt",
                    "evidenceText": "$field.evidenceText",
                    "shippingTrackingNumber": "$field.shippingTrackingNumber",
                    "shippingDate": "$field.shippingDate",
                    "shippingDocumentationFileId": "$field.shippingDocumentationFileId",
                    "customerCommunicationFileId": "$field.customerCommunicationFileId"
                }
            }
        },
        {
            "id": "submitEvidence",
            "label": "Submit final evidence",
            "tone": "danger",
            "placement": "more",
            "confirm": "Submit the final irreversible evidence response to Stripe?",
            "visibleWhen": {
                "all": [
                    {
                        "value": "$field.stagedEvidenceOperationId",
                        "notEquals": null
                    },
                    {
                        "value": "$field.evidenceStatus",
                        "equals": "staged"
                    }
                ]
            },
            "endpoint": {
                "sourceId": "{{dependencies.stripe.sourceId}}",
                "endpoint": "submitStripeDisputeEvidence",
                "body": {
                    "disputeId": "$resource.id",
                    "submissionOperationId": "$resource.updatedAt",
                    "evidenceOperationId": "$resource.stagedEvidenceOperationId",
                    "confirmation": "SUBMIT STRIPE EVIDENCE"
                }
            }
        },
        {
            "id": "acceptDispute",
            "label": "Accept dispute",
            "tone": "danger",
            "placement": "more",
            "confirm": "Accept this dispute as lost? This action is irreversible.",
            "visibleWhen": {
                "all": [
                    {
                        "any": [
                            {
                                "value": "$field.status",
                                "equals": "needs_response"
                            },
                            {
                                "value": "$field.status",
                                "equals": "warning_needs_response"
                            }
                        ]
                    },
                    {
                        "value": "$field.evidenceStatus",
                        "notEquals": "accepted"
                    },
                    {
                        "value": "$field.evidenceStatus",
                        "notEquals": "closed"
                    }
                ]
            },
            "endpoint": {
                "sourceId": "{{dependencies.stripe.sourceId}}",
                "endpoint": "acceptStripeDispute",
                "body": {
                    "disputeId": "$resource.id",
                    "acceptanceOperationId": "$resource.updatedAt",
                    "confirmation": "ACCEPT STRIPE DISPUTE"
                }
            }
        }
    ],
    "main": {
        "$include": "detail-sections/root.json"
    }
}
