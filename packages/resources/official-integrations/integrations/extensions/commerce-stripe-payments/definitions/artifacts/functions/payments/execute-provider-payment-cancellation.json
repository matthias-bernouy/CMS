{
    "type": "function",
    "function": {
        "id": "executeProviderPaymentCancellation",
        "method": "POST",
        "access": {
            "mode": "system"
        },
        "meta": {
            "name": "Execute provider payment cancellation",
            "description": "Cancel or reconcile one Stripe PaymentIntent before Commerce restores inventory."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "paymentCancellationRequestId": {
                        "type": "number"
                    },
                    "cancellationRequestId": {
                        "type": "string"
                    },
                    "orderId": {
                        "type": "number"
                    },
                    "orderPublicId": {
                        "type": "string"
                    },
                    "clientReferenceId": {
                        "type": "string"
                    },
                    "targetOrderStatus": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "financialTermsHash": {
                        "type": "string"
                    }
                },
                "required": [
                    "status",
                    "paymentCancellationRequestId",
                    "cancellationRequestId",
                    "orderId",
                    "orderPublicId",
                    "clientReferenceId",
                    "targetOrderStatus",
                    "reason",
                    "amount",
                    "currency",
                    "financialTermsHash"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "assert": {
                    "condition": {
                        "in": [
                            "$input.body.status",
                            [
                                "requested",
                                "processing"
                            ]
                        ]
                    },
                    "failure": {
                        "status": 409,
                        "error": "Payment cancellation is not dispatchable"
                    }
                }
            },
            {
                "id": "providerCancellation",
                "call": {
                    "source": "{{dependencies.stripe.sourceId}}",
                    "endpoint": "cancelProtectedPayment",
                    "body": {
                        "clientReferenceId": "$input.body.clientReferenceId",
                        "cancellationRequestId": "$input.body.cancellationRequestId",
                        "reason": "$input.body.reason"
                    }
                }
            },
            {
                "id": "commercePayment",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "recordOrderPayment",
                    "body": {
                        "orderPublicId": "$input.body.orderPublicId",
                        "providerEventId": "$steps.providerCancellation.providerEventId",
                        "providerPaymentId": "$steps.providerCancellation.providerPaymentId",
                        "providerPaymentIntentId": "$steps.providerCancellation.providerPaymentIntentId",
                        "providerChargeId": "$steps.providerCancellation.providerChargeId",
                        "status": "$steps.providerCancellation.paymentStatus",
                        "amount": "$steps.providerCancellation.amount",
                        "currency": "$steps.providerCancellation.currency",
                        "financialTermsHash": "$steps.providerCancellation.financialTermsHash",
                        "occurredAt": "$steps.providerCancellation.occurredAt",
                        "providerPaymentAbsent": "$steps.providerCancellation.providerPaymentAbsent",
                        "cancellationRequestId": "$steps.providerCancellation.cancellationRequestId",
                        "providerSnapshot": "$steps.providerCancellation.providerSnapshot"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "authorization": "$input.body",
                "providerCancellation": "$steps.providerCancellation",
                "commercePayment": "$steps.commercePayment"
            }
        }
    }
}
