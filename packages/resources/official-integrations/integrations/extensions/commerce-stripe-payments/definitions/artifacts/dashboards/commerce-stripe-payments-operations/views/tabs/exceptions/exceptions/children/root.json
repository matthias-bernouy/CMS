[
    {
        "widget": "w-table",
        "id": "commerceExceptionsTable",
        "title": "Commerce exceptions",
        "source": {
            "endpoint": "listCommerceExceptions",
            "params": {
                "status": "$filter.status",
                "limit": "100",
                "offset": "0"
            },
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "id",
        "filters": [
            {
                "id": "status",
                "label": "Status",
                "param": "status",
                "type": "text"
            }
        ],
        "columns": [
            {
                "id": "kind",
                "label": "Kind",
                "path": "kind",
                "primary": true
            },
            {
                "id": "orderId",
                "label": "Order",
                "path": "orderId"
            },
            {
                "id": "severity",
                "label": "Severity",
                "path": "severity",
                "format": "badge"
            },
            {
                "id": "status",
                "label": "Status",
                "path": "status",
                "format": "badge"
            },
            {
                "id": "reason",
                "label": "Reason",
                "path": "reason"
            },
            {
                "id": "detectedAt",
                "label": "Detected",
                "path": "detectedAt",
                "format": "date"
            }
        ]
    },
    {
        "widget": "w-table",
        "id": "providerExceptionsTable",
        "title": "Stripe provider exceptions",
        "source": {
            "sourceId": "{{dependencies.stripe.sourceId}}",
            "endpoint": "listProviderExceptions",
            "params": {
                "status": "$filter.status",
                "limit": "100"
            },
            "itemsPath": "exceptions",
            "totalPath": "total"
        },
        "rowKey": "id",
        "filters": [
            {
                "id": "status",
                "label": "Status",
                "param": "status",
                "type": "text"
            }
        ],
        "columns": [
            {
                "id": "kind",
                "label": "Kind",
                "path": "exception_type",
                "primary": true
            },
            {
                "id": "paymentId",
                "label": "Payment",
                "path": "payment_id"
            },
            {
                "id": "sellerUserId",
                "label": "Seller",
                "path": "details.userId"
            },
            {
                "id": "stripeAccountId",
                "label": "Stripe account",
                "path": "details.stripeAccountId"
            },
            {
                "id": "status",
                "label": "Status",
                "path": "status",
                "format": "badge"
            },
            {
                "id": "reason",
                "label": "Reason",
                "path": "message"
            },
            {
                "id": "holdAlertAt",
                "label": "Hold alert",
                "path": "details.manualPayoutHoldAlertAt",
                "format": "date"
            },
            {
                "id": "holdDeadlineAt",
                "label": "Hold deadline",
                "path": "details.manualPayoutHoldDeadlineAt",
                "format": "date"
            },
            {
                "id": "updatedAt",
                "label": "Detected",
                "path": "detected_at",
                "format": "date"
            }
        ],
        "selection": {
            "opens": "providerExceptionDetail"
        }
    },
    {
        "$include": "provider-exception-detail.json"
    }
]
