{
    "id": "refreshPaymentForOrder",
    "method": "POST",
    "access": {
        "mode": "auth"
    },
    "meta": {
        "name": "Refresh payment for order",
        "description": "Retrieve current Stripe provider truth and idempotently project it into Commerce."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "orderId": {
                    "type": "number"
                }
            },
            "required": [
                "orderId"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "orderId": {
                        "type": "number"
                    },
                    "orderPublicId": {
                        "type": "string"
                    },
                    "payment": {
                        "type": "object",
                        "properties": {
                            "paymentStatus": {
                                "type": "string"
                            },
                            "settlementStatus": {
                                "type": "string"
                            },
                            "disputeStatus": {
                                "type": "string"
                            },
                            "reconciliationPending": {
                                "type": "boolean"
                            },
                            "refundedAmount": {
                                "type": "number"
                            },
                            "amountTotal": {
                                "type": "number"
                            },
                            "currency": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "orderId",
                    "orderPublicId",
                    "payment"
                ]
            }
        }
    ],
    "steps": {
        "$include": "steps.json"
    },
    "return": {
        "status": 200,
        "body": {
            "orderId": "$steps.order.id",
            "orderPublicId": "$steps.order.publicId",
            "payment": "$steps.paymentLookup.payment"
        }
    }
}
