{
    "id": "executeAuthorizedSettlementRelease",
    "method": "POST",
    "access": {
        "mode": "system"
    },
    "meta": {
        "name": "Execute authorized settlement release",
        "description": "Execute one immutable Commerce release authorization and report Stripe provider truth."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "releaseAuthorizationId": {
                    "type": "string"
                },
                "orderId": {
                    "type": "number"
                },
                "orderPublicId": {
                    "type": "string"
                },
                "paymentId": {
                    "type": "number"
                },
                "businessKey": {
                    "type": "string"
                },
                "releaseKind": {
                    "type": "string"
                },
                "sellerId": {
                    "type": "string",
                    "semantic": {
                        "kind": "user-id",
                        "authority": "cms"
                    }
                },
                "sellerRequiredMinimumBalanceAmount": {
                    "type": "number"
                },
                "payoutDelayDays": {
                    "type": "number"
                },
                "amount": {
                    "type": "number"
                },
                "currency": {
                    "type": "string"
                },
                "financialTermsHash": {
                    "type": "string"
                }
            },
            "required": [
                "status",
                "releaseAuthorizationId",
                "orderId",
                "orderPublicId",
                "paymentId",
                "businessKey",
                "releaseKind",
                "sellerId",
                "sellerRequiredMinimumBalanceAmount",
                "payoutDelayDays",
                "amount",
                "currency",
                "financialTermsHash"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object"
            }
        }
    ],
    "steps": {
        "$include": "steps.json"
    },
    "return": {
        "status": 200,
        "body": {
            "orderPublicId": "$input.body.orderPublicId",
            "providerTransfer": "$steps.providerTransfer",
            "commerceSettlement": "$steps.commerceSettlement"
        }
    }
}
