{
    "id": "getSellerSaleEnrollment",
    "method": "GET",
    "access": {
        "mode": "auth"
    },
    "meta": {
        "name": "Get seller sale enrollment",
        "description": "Return the authenticated Commerce seller and independent Stripe account, terms, transfer, bank, and payout states, including whether the configured seller terms are accepted."
    },
    "input": {
        "params": []
    },
    "output": {
        "$include": "output/root.json"
    },
    "steps": [
        {
            "id": "connect",
            "call": {
                "source": "{{dependencies.stripe.sourceId}}",
                "endpoint": "getConnectStatus",
                "params": {
                    "marketplaceTermsVersion": "{{answers.sellerTermsVersion}}",
                    "marketplaceTermsHash": "{{answers.sellerTermsHash}}"
                }
            }
        },
        {
            "id": "seller",
            "call": {
                "source": "{{dependencies.commerce.sourceId}}",
                "endpoint": "mySeller"
            }
        },
        {
            "assert": {
                "condition": {
                    "all": [
                        {
                            "equals": [
                                "$steps.connect.userId",
                                "$ctx.user.id"
                            ]
                        },
                        {
                            "any": [
                                {
                                    "equals": [
                                        "$steps.seller.exists",
                                        false
                                    ]
                                },
                                {
                                    "equals": [
                                        "$steps.seller.cmsUserId",
                                        "$ctx.user.id"
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "failure": {
                    "status": 403,
                    "error": "Seller enrollment identity mismatch"
                }
            }
        }
    ],
    "return": {
        "status": 200,
        "body": {
            "connect": "$steps.connect",
            "seller": "$steps.seller"
        }
    }
}
