{
    "type": "trigger",
    "trigger": {
        "id": "schedule-process-due-order-deadlines",
        "label": "Process due order deadlines",
        "critical": true,
        "event": {
            "kind": "schedule",
            "intervalMs": 60000,
            "initialDelayMs": 10000,
            "timeoutMs": 120000
        },
        "mode": "async",
        "failureMode": "ignore",
        "function": {
            "id": "processDueOrderDeadlines",
            "body": {
                "runKey": "$schedule.runKey",
                "limit": 5
            }
        }
    }
}
