{
    "type": "trigger",
    "trigger": {
        "id": "schedule-dispatch-pending-payment-cancellations",
        "label": "Dispatch pending payment cancellations",
        "critical": true,
        "event": {
            "kind": "schedule",
            "intervalMs": 60000,
            "initialDelayMs": 15000,
            "timeoutMs": 120000
        },
        "mode": "async",
        "failureMode": "ignore",
        "function": {
            "id": "dispatchPendingPaymentCancellations",
            "body": {
                "runKey": "$schedule.runKey",
                "limit": 5
            }
        }
    }
}
