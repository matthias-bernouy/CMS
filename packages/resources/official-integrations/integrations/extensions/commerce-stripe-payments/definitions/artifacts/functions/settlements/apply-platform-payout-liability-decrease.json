{
    "type": "function",
    "function": {
        "id": "applyPlatformPayoutLiabilityDecrease",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "meta": {
            "name": "Apply platform payout liability decrease",
            "description": "Authorize one exact current Commerce aggregate revision, apply it to Stripe, and persist the provider receipt with CAS."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "expectedLiabilityRevision": {
                        "type": "number"
                    },
                    "reason": {
                        "type": "string"
                    }
                },
                "required": [
                    "expectedLiabilityRevision",
                    "reason"
                ]
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "authorization",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "authorizePlatformPayoutLiabilityDecrease",
                    "body": {
                        "expectedLiabilityRevision": "$input.body.expectedLiabilityRevision",
                        "reason": "$input.body.reason"
                    }
                }
            },
            {
                "id": "provider",
                "call": {
                    "source": "{{dependencies.stripe.sourceId}}",
                    "endpoint": "configurePlatformPayoutControls",
                    "body": {
                        "platformPayoutControlChangeId": {
                            "$concat": [
                                "commerce-finance-decrease:",
                                "$steps.authorization.liabilityRevision",
                                ":",
                                "$steps.authorization.decreaseAuthorizationId"
                            ]
                        },
                        "minimumBalanceEur": "$steps.authorization.requiredMinimumAmount",
                        "liabilityRevision": "$steps.authorization.liabilityRevision",
                        "decreaseAuthorizationId": "$steps.authorization.decreaseAuthorizationId",
                        "reason": "$input.body.reason"
                    }
                }
            },
            {
                "id": "receipt",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "recordPlatformPayoutLiabilityApplied",
                    "body": {
                        "liabilityRevision": "$steps.provider.liabilityRevision",
                        "appliedMinimumAmount": "$steps.provider.appliedMinimumBalanceEur",
                        "decreaseAuthorizationId": "$steps.provider.decreaseAuthorizationId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.receipt.accepted",
                            true
                        ]
                    },
                    "failure": {
                        "status": 409,
                        "error": "A newer Commerce liability revision won; reapply the current revision"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "authorization": "$steps.authorization",
                "provider": "$steps.provider",
                "receipt": "$steps.receipt"
            }
        }
    },
    "contractVersion": "1.0.0"
}
