{
    "type": "trigger",
    "trigger": {
        "id": "schedule-dispatch-due-protected-settlements",
        "label": "Dispatch due protected settlements",
        "critical": true,
        "event": {
            "kind": "schedule",
            "intervalMs": 60000,
            "initialDelayMs": 35000,
            "timeoutMs": 120000
        },
        "mode": "async",
        "failureMode": "ignore",
        "function": {
            "id": "dispatchDueProtectedSettlements",
            "body": {
                "runKey": "$schedule.runKey",
                "limit": 5
            }
        }
    }
}
