{
    "type": "function",
    "function": {
        "id": "getRelayPointForOrder",
        "method": "GET",
        "access": {
            "mode": "auth"
        },
        "meta": {
            "name": "Get relay point for order",
            "description": "Retrieve the validated relay point for an owned Commerce order."
        },
        "input": {
            "params": {
                "orderId": {
                    "type": "string"
                }
            }
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "steps": [
            {
                "id": "context",
                "call": {
                    "source": "{{dependencies.commerce.sourceId}}",
                    "endpoint": "getOrderDeliverySelectionContext",
                    "params": {
                        "orderId": "$input.params.orderId"
                    }
                }
            },
            {
                "assert": {
                    "condition": {
                        "equals": [
                            "$steps.context.buyerCmsUserId",
                            "$ctx.user.id"
                        ]
                    },
                    "failure": {
                        "status": 403,
                        "error": "Order does not belong to the current buyer"
                    }
                }
            },
            {
                "id": "selection",
                "call": {
                    "source": "{{dependencies.delivery.sourceId}}",
                    "endpoint": "deliveryQuote",
                    "params": {
                        "quoteId": "$steps.context.deliveryQuoteId",
                        "externalOrderId": "$steps.context.publicId",
                        "selectedForCmsUserId": "$ctx.user.id"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": {
                "quoteId": "$steps.selection.quoteId",
                "externalOrderId": "$steps.selection.externalOrderId",
                "relayLocation": "$steps.selection.relayLocation",
                "country": "$steps.selection.country",
                "number": "$steps.selection.number",
                "name": "$steps.selection.name",
                "addressLine1": "$steps.selection.addressLine1",
                "addressLine2": "$steps.selection.addressLine2",
                "postalCode": "$steps.selection.postalCode",
                "city": "$steps.selection.city",
                "nature": "$steps.selection.nature",
                "pointType": "$steps.selection.pointType",
                "weightGrams": "$steps.selection.weightGrams",
                "shippingAmount": "$steps.selection.shippingAmount",
                "currency": "$steps.selection.currency",
                "quotedAt": "$steps.selection.quotedAt",
                "expiresAt": "$steps.selection.expiresAt"
            }
        }
    }
}
