{
    "id": "setRelayPointForOrder",
    "method": "POST",
    "access": {
        "mode": "auth"
    },
    "meta": {
        "name": "Set relay point for order",
        "description": "Verify order ownership and persist a server-validated Mondial Relay point."
    },
    "input": {
        "body": {
            "type": "object",
            "properties": {
                "orderId": {
                    "type": "string"
                },
                "relayLocation": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "postalCode": {
                    "type": "string"
                },
                "city": {
                    "type": "string"
                }
            },
            "required": [
                "orderId",
                "relayLocation",
                "country",
                "postalCode"
            ]
        }
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object"
            }
        }
    ],
    "steps": {
        "$include": "steps.json"
    },
    "return": {
        "status": 200,
        "body": {
            "selection": "$steps.selection",
            "financialTerms": "$steps.financialTerms"
        }
    }
}
