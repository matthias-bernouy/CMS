{
    "type": "function",
    "function": {
        "id": "getNewsletterBroadcastStatus",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "meta": {
            "name": "Get newsletter broadcast status",
            "description": "Read one broadcast campaign status."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string"
                    }
                },
                "required": [
                    "campaignId"
                ]
            }
        },
        "steps": [
            {
                "id": "campaign",
                "call": {
                    "source": "{{answers.id}}-broadcast",
                    "endpoint": "getCampaign",
                    "params": {
                        "id": "$input.body.campaignId"
                    }
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.campaign"
        }
    }
}
