{
    "widget": "w-detail",
    "id": "templateDetail",
    "source": {
        "endpoint": "getTemplate",
        "params": {
            "key": "$selection.id"
        }
    },
    "title": {
        "path": "name",
        "fallback": "Template"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "saveTemplate",
            "label": "Save",
            "tone": "primary",
            "placement": "primary",
            "endpoint": {
                "endpoint": "upsertTemplate",
                "body": {
                    "key": "$field.key",
                    "name": "$field.name",
                    "status": "$field.status",
                    "fromEmail": "$field.fromEmail",
                    "replyTo": "$field.replyTo",
                    "subject": "$field.subject",
                    "htmlBody": "$field.htmlBody",
                    "requiredTokens": "$field.requiredTokens"
                }
            },
            "after": {
                "opens": "templateDetail",
                "row": "$result.key",
                "resource": "$result"
            }
        },
        {
            "id": "sendTestEmail",
            "label": "Send test",
            "placement": "secondary",
            "endpoint": {
                "endpoint": "sendTestEmail",
                "body": {
                    "key": "$field.key",
                    "toEmail": "$field.testRecipient"
                }
            }
        },
        {
            "id": "archiveTemplate",
            "label": "Archive",
            "tone": "danger",
            "placement": "more",
            "confirm": "Archive this template?",
            "endpoint": {
                "endpoint": "archiveTemplate",
                "params": {
                    "key": "$resource.key"
                }
            },
            "after": {
                "resource": "$result"
            }
        }
    ],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "sender",
            "title": "Sender",
            "fields": [
                {
                    "id": "fromEmail",
                    "label": "From override",
                    "type": "text",
                    "path": "fromEmail"
                },
                {
                    "id": "replyTo",
                    "label": "Reply-to override",
                    "type": "text",
                    "path": "replyTo"
                },
                {
                    "id": "testRecipient",
                    "label": "Test recipient",
                    "type": "text",
                    "path": "testRecipient"
                }
            ]
        }
    ]
}
