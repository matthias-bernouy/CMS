{
    "type": "function",
    "function": {
        "id": "cancelNewsletterBroadcast",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "meta": {
            "name": "Cancel newsletter broadcast",
            "description": "Cancel one non-terminal broadcast campaign."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string"
                    }
                },
                "required": [
                    "campaignId"
                ]
            }
        },
        "steps": [
            {
                "id": "campaign",
                "call": {
                    "source": "{{answers.id}}-broadcast",
                    "endpoint": "cancelCampaign",
                    "params": {
                        "id": "$input.body.campaignId"
                    },
                    "body": {}
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.campaign"
        }
    }
}
