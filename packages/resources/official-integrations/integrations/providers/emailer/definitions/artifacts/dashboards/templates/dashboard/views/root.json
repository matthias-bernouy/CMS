[
    {
        "widget": "w-table",
        "id": "templatesTable",
        "title": "Templates",
        "source": {
            "endpoint": "listTemplates",
            "itemsPath": "items",
            "totalPath": "total",
            "params": {
                "q": "$filter.q",
                "status": "$filter.status",
                "limit": "$param.limit",
                "offset": "$param.offset"
            }
        },
        "rowKey": "key",
        "pageSize": 25,
        "filters": [
            {
                "id": "q",
                "label": "Search",
                "param": "q",
                "type": "text",
                "placeholder": "Key, name, subject"
            },
            {
                "id": "status",
                "label": "Status",
                "param": "status",
                "type": "select",
                "options": [
                    {
                        "value": "draft",
                        "label": "Draft"
                    },
                    {
                        "value": "active",
                        "label": "Active"
                    },
                    {
                        "value": "archived",
                        "label": "Archived"
                    }
                ]
            }
        ],
        "columns": [
            {
                "id": "name",
                "label": "Template",
                "path": "name",
                "primary": true
            },
            {
                "id": "key",
                "label": "Key",
                "path": "key"
            },
            {
                "id": "status",
                "label": "Status",
                "path": "status",
                "format": "badge"
            },
            {
                "id": "updatedAt",
                "label": "Updated",
                "path": "updatedAt",
                "format": "date"
            }
        ],
        "selection": {
            "opens": "templateDetail"
        },
        "actions": [
            {
                "id": "newTemplate",
                "label": "New template",
                "tone": "primary",
                "selection": {
                    "opens": "templateDetail"
                }
            }
        ]
    },
    {
        "$include": "template-detail/root.json"
    }
]
