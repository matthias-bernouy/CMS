{
    "endpointId": "installTemplates",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-emailer/templates/install",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "templates": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string"
                        },
                        "fromEmail": {
                            "type": "string"
                        },
                        "replyTo": {
                            "type": "string"
                        },
                        "subject": {
                            "type": "string"
                        },
                        "htmlBody": {
                            "type": "string"
                        },
                        "textBody": {
                            "type": "string"
                        },
                        "requiredTokens": {
                            "type": "array",
                            "items": {
                                "type": "object"
                            }
                        },
                        "sampleData": {
                            "type": "object"
                        },
                        "sampleDataJson": {
                            "type": "string"
                        },
                        "metadata": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "key",
                        "name",
                        "subject",
                        "htmlBody"
                    ]
                }
            }
        },
        "required": [
            "templates"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "accepted": {
                        "type": "number"
                    }
                },
                "required": [
                    "accepted"
                ]
            }
        }
    ]
}
