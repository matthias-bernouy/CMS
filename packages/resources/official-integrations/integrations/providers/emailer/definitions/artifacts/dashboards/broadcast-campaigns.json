{
  "type": "dashboard-view",
  "view": {
        "id": "emailer-broadcast-campaigns",
        "meta": {
            "name": "Broadcast Campaigns",
            "icon": "send"
        },
        "source": "emailer-broadcast",
        "views": [
            {
                "widget": "w-table",
                "id": "campaignsTable",
                "title": "Campaigns",
                "source": {
                    "endpoint": "listCampaigns",
                    "params": {
                        "limit": "100"
                    },
                    "itemsPath": "items",
                    "totalPath": "total"
                },
                "rowKey": "id",
                "columns": [
                    {
                        "id": "templateKey",
                        "label": "Template",
                        "path": "templateKey",
                        "primary": true
                    },
                    {
                        "id": "status",
                        "label": "Status",
                        "path": "status"
                    },
                    {
                        "id": "totalCount",
                        "label": "Total",
                        "path": "totalCount"
                    },
                    {
                        "id": "sentCount",
                        "label": "Sent",
                        "path": "sentCount"
                    },
                    {
                        "id": "failedCount",
                        "label": "Failed",
                        "path": "failedCount"
                    }
                ]
            }
        ]
    }
}
