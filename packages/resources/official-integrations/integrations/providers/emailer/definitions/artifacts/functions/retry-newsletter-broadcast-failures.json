{
    "type": "function",
    "function": {
        "id": "retryNewsletterBroadcastFailures",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "meta": {
            "name": "Retry newsletter broadcast failures",
            "description": "Move failed recipients back to pending for one campaign."
        },
        "input": {
            "body": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string"
                    }
                },
                "required": [
                    "campaignId"
                ]
            }
        },
        "steps": [
            {
                "id": "result",
                "call": {
                    "source": "{{answers.id}}-broadcast",
                    "endpoint": "retryFailedCampaign",
                    "params": {
                        "id": "$input.body.campaignId"
                    },
                    "body": {}
                }
            }
        ],
        "return": {
            "status": 200,
            "body": "$steps.result"
        }
    },
    "contractVersion": "1.0.0"
}
