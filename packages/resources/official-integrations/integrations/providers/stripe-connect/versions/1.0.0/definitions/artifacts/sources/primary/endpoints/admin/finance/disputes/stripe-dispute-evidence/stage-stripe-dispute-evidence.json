{
    "endpointId": "stageStripeDisputeEvidence",
    "method": "POST",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/disputes/evidence/stage",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "disputeId": {
                "type": "string"
            },
            "evidenceOperationId": {
                "type": "string"
            },
            "evidence": {
                "type": "object"
            },
            "evidenceText": {
                "type": "string"
            },
            "customerCommunicationFileId": {
                "type": "string"
            },
            "shippingDocumentationFileId": {
                "type": "string"
            },
            "shippingTrackingNumber": {
                "type": "string"
            },
            "shippingDate": {
                "type": "string"
            },
            "receiptFileId": {
                "type": "string"
            },
            "productDescription": {
                "type": "string"
            },
            "customerName": {
                "type": "string"
            },
            "customerEmailAddress": {
                "type": "string"
            }
        },
        "required": [
            "disputeId",
            "evidenceOperationId"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "evidenceOperationId": {
                        "type": "string"
                    },
                    "disputeId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "stagedAt": {
                        "type": "string"
                    }
                },
                "required": [
                    "evidenceOperationId",
                    "disputeId",
                    "status",
                    "stagedAt"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "403",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "404",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object"
            }
        }
    ]
}
