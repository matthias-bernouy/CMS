{
    "endpointId": "configureSellerPayoutSchedule",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/accounts/account/payout-schedule",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "userId": {
                "type": "string",
                "semantic": {
                    "kind": "user-id",
                    "authority": "cms"
                }
            },
            "payoutScheduleChangeId": {
                "type": "string"
            },
            "interval": {
                "type": "string"
            },
            "weeklyPayoutDays": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "monthlyPayoutDays": {
                "type": "array",
                "items": {
                    "type": "number"
                }
            },
            "minimumBalanceEur": {
                "type": "number"
            },
            "delayDaysOverride": {
                "type": "number"
            },
            "debitNegativeBalances": {
                "type": "boolean"
            },
            "reason": {
                "type": "string"
            }
        },
        "required": [
            "userId",
            "payoutScheduleChangeId",
            "interval"
        ]
    },
    "output": {
        "$include": "output.json"
    }
}
