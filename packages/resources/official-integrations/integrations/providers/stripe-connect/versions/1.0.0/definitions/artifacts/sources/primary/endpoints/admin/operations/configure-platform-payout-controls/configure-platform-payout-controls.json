{
    "endpointId": "configurePlatformPayoutControls",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/platform/payout-protection",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "platformPayoutControlChangeId": {
                "type": "string"
            },
            "minimumBalanceEur": {
                "type": "number"
            },
            "liabilityRevision": {
                "type": "number"
            },
            "decreaseAuthorizationId": {
                "type": "string"
            },
            "delayDaysOverride": {
                "type": "number"
            },
            "debitNegativeBalances": {
                "type": "boolean"
            },
            "reason": {
                "type": "string"
            }
        },
        "required": [
            "platformPayoutControlChangeId",
            "minimumBalanceEur",
            "liabilityRevision"
        ]
    },
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "platformPayoutControlChangeId": {
                        "type": "string"
                    },
                    "providerOperationId": {
                        "type": "number"
                    },
                    "liabilityRevision": {
                        "type": "number"
                    },
                    "appliedMinimumBalanceEur": {
                        "type": "number"
                    },
                    "decreaseAuthorizationId": {
                        "type": "string",
                        "nullable": true
                    },
                    "payoutControl": {
                        "type": "object",
                        "properties": {
                            "interval": {
                                "type": "string"
                            },
                            "weeklyPayoutDays": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "monthlyPayoutDays": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                }
                            },
                            "minimumBalanceByCurrency": {
                                "type": "object"
                            },
                            "debitNegativeBalances": {
                                "type": "boolean"
                            },
                            "delayDays": {
                                "type": "number"
                            },
                            "delayDaysOverride": {
                                "type": "number"
                            },
                            "status": {
                                "type": "string"
                            }
                        }
                    },
                    "providerSnapshot": {
                        "type": "object"
                    }
                },
                "required": [
                    "platformPayoutControlChangeId",
                    "providerOperationId",
                    "liabilityRevision",
                    "payoutControl",
                    "providerSnapshot"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "403",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "502",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "503",
            "body": {
                "type": "object"
            }
        }
    ]
}
