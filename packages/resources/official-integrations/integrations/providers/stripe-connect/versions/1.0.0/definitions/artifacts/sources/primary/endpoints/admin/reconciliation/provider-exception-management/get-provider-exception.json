{
    "endpointId": "getProviderException",
    "method": "GET",
    "access": {
        "mode": "admin"
    },
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/admin/exceptions/exception",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "number",
            "required": true
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        },
        {
            "name": "x-cms-user-role",
            "source": {
                "from": "computed",
                "ref": "userRole"
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "deduplication_key": {
                        "type": "string"
                    },
                    "payment_id": {
                        "type": "number"
                    },
                    "operation_id": {
                        "type": "number"
                    },
                    "exception_type": {
                        "type": "string"
                    },
                    "severity": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "details": {
                        "type": "object"
                    },
                    "detected_at": {
                        "type": "string"
                    },
                    "resolved_at": {
                        "type": "string"
                    },
                    "resolved_by": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "exception_type",
                    "severity",
                    "status",
                    "message",
                    "details",
                    "detected_at"
                ]
            }
        },
        {
            "status": "403",
            "body": {
                "type": "object"
            }
        },
        {
            "status": "404",
            "body": {
                "type": "object"
            }
        }
    ]
}
