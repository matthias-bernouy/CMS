[
    {
        "endpointId": "getConnectClientConfig",
        "method": "GET",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/connect/config",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "publishableKey": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "publishableKey"
                    ]
                }
            }
        ]
    },
    {
        "$include": "get-connect-status/root.json"
    }
]
