[
    {
        "endpointId": "getProviderConfiguration",
        "method": "GET",
        "access": {
            "mode": "system"
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/system/configuration",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": {
            "$include": "output.json"
        }
    },
    {
