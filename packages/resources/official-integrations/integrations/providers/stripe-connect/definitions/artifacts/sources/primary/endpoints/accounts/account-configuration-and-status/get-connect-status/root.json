{
    "endpointId": "getConnectStatus",
    "method": "GET",
    "access": "auth",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/connect/status",
    "params": [
        {
            "name": "marketplaceTermsVersion",
            "in": "query",
            "type": "string"
        },
        {
            "name": "marketplaceTermsHash",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "output": {
        "$include": "output.json"
    }
}
