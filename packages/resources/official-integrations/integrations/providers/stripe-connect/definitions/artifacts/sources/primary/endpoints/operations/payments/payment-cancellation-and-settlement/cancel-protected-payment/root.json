{
    "endpointId": "cancelProtectedPayment",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/operations/payment-cancellation",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "clientReferenceId": {
                "type": "string"
            },
            "cancellationRequestId": {
                "type": "string"
            },
            "reason": {
                "type": "string"
            }
        },
        "required": [
            "clientReferenceId",
            "cancellationRequestId"
        ]
    },
    "output": {
        "$include": "output.json"
    }
}
