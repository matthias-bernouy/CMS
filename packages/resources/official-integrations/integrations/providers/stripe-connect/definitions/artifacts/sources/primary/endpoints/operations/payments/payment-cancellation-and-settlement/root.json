[
    {
        "$include": "cancel-protected-payment/root.json"
    },
    {
        "endpointId": "requestSettlementRelease",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-stripe-connect/operations/release",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "paymentId": {
                    "type": "number"
                },
                "releaseAuthorizationId": {
                    "type": "string"
                },
                "releaseKind": {
                    "type": "string"
                },
                "amount": {
                    "type": "number"
                },
                "currency": {
                    "type": "string"
                }
            },
            "required": [
                "paymentId",
                "releaseAuthorizationId",
                "releaseKind",
                "amount",
                "currency"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "transferId": {
                            "type": "number"
                        },
                        "providerOperationId": {
                            "type": "number"
                        },
                        "paymentId": {
                            "type": "number"
                        },
                        "releaseAuthorizationId": {
                            "type": "string"
                        },
                        "stripeTransferId": {
                            "type": "string"
                        },
                        "releaseKind": {
                            "type": "string"
                        },
                        "sourceChargeId": {
                            "type": "string",
                            "nullable": true
                        },
                        "destinationAccountId": {
                            "type": "string"
                        },
                        "amount": {
                            "type": "number"
                        },
                        "currency": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string"
                        },
                        "occurredAt": {
                            "type": "string"
                        },
                        "createdAt": {
                            "type": "string"
                        },
                        "updatedAt": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "transferId",
                        "providerOperationId",
                        "paymentId",
                        "releaseAuthorizationId",
                        "amount",
                        "currency",
                        "status",
                        "occurredAt",
                        "updatedAt"
                    ]
                }
            },
            {
                "status": "400",
                "body": {
                    "type": "object"
                }
            },
            {
                "status": "404",
                "body": {
                    "type": "object"
                }
            },
            {
                "status": "409",
                "body": {
                    "type": "object"
                }
            }
        ]
    }
]
