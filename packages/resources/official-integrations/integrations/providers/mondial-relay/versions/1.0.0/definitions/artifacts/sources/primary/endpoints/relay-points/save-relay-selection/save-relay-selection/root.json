{
    "endpointId": "saveRelaySelection",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery/relay-selections",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "requestKey": {
                "type": "string"
            },
            "externalOrderId": {
                "type": "string"
            },
            "orderVersion": {
                "type": "number"
            },
            "selectedForCmsUserId": {
                "type": "string",
                "semantic": {
                    "kind": "user-id",
                    "authority": "cms"
                }
            },
            "relayLocation": {
                "type": "string"
            },
            "country": {
                "type": "string"
            },
            "postalCode": {
                "type": "string"
            },
            "city": {
                "type": "string"
            },
            "currency": {
                "type": "string"
            },
            "merchandiseSubtotalMinorAmount": {
                "type": "number"
            },
            "recipientSnapshot": {
                "type": "object"
            },
            "sellerFulfillmentSnapshot": {
                "type": "object"
            }
        },
        "required": [
            "requestKey",
            "externalOrderId",
            "orderVersion",
            "selectedForCmsUserId",
            "relayLocation",
            "country",
            "postalCode",
            "currency",
            "merchandiseSubtotalMinorAmount",
            "recipientSnapshot",
            "sellerFulfillmentSnapshot"
        ]
    },
    "output": {
        "$include": "output.json"
    }
}
