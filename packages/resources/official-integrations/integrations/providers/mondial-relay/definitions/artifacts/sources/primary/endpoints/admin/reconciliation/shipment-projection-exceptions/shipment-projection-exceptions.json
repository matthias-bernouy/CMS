{
    "endpointId": "shipmentProjectionExceptions",
    "method": "GET",
    "access": "admin",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery-v4/admin/projection-exceptions",
    "params": [
        {
            "name": "limit",
            "in": "query",
            "type": "number"
        },
        {
            "name": "offset",
            "in": "query",
            "type": "number"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        }
    ],
    "output": [
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number"
                                },
                                "shipmentId": {
                                    "type": "string"
                                },
                                "externalOrderId": {
                                    "type": "string"
                                },
                                "expeditionNumber": {
                                    "type": "string"
                                },
                                "providerEventId": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "normalizedStatus": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "occurredAt": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "projectionStatus": {
                                    "type": "string"
                                },
                                "projectionAttempts": {
                                    "type": "number"
                                },
                                "projectionNextAttemptAt": {
                                    "type": "string"
                                },
                                "projectionLastError": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "projectionManualReviewAt": {
                                    "type": "string",
                                    "nullable": true
                                },
                                "createdAt": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "limit": {
                        "type": "number"
                    },
                    "offset": {
                        "type": "number"
                    }
                },
                "required": [
                    "items",
                    "limit",
                    "offset"
                ]
            }
        }
    ]
}
