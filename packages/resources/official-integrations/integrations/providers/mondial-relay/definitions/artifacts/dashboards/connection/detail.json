{
    "widget": "w-detail",
    "id": "connection",
    "source": {
        "endpoint": "getConnection"
    },
    "title": {
        "path": "label",
        "fallback": "Settings"
    },
    "save": {
        "label": "Save settings",
        "valuesPath": "values",
        "hiddenFields": [
            {
                "name": "expectedRevision",
                "value": "$resource.savedRevision",
                "type": "string",
                "empty": "omit"
            }
        ],
        "endpoint": "saveConnection"
    },
    "main": [
        {
            "id": "connection",
            "title": "Connection",
            "fields": {
                "$include": "fields.json"
            }
        }
    ],
    "actions": [
        {
            "id": "retryConnection",
            "label": "Retry connection",
            "placement": "secondary",
            "form": {
                "endpoint": "retryConnection",
                "hiddenFields": [
                    {
                        "name": "expectedRevision",
                        "type": "string",
                        "value": "$resource.savedRevision"
                    }
                ]
            }
        }
    ]
}
