[
    {
        "endpointId": "declareSellerHandoff",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery/system/shipments/handoff",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "externalOrderId": {
                    "type": "string"
                }
            },
            "required": [
                "externalOrderId"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "externalOrderId": {
                            "type": "string"
                        },
                        "expeditionNumber": {
                            "type": "string",
                            "nullable": true
                        },
                        "status": {
                            "type": "string"
                        },
                        "sellerHandoffDeclaredAt": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "externalOrderId",
                        "status",
                        "sellerHandoffDeclaredAt"
                    ]
                }
            }
        ]
    },
    {
        "endpointId": "cancelShipmentReservation",
        "method": "POST",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery/system/shipments/cancel",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "externalOrderId": {
                    "type": "string"
                },
                "trackingUntil": {
                    "type": "string"
                }
            },
            "required": [
                "externalOrderId",
                "trackingUntil"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "externalOrderId": {
                            "type": "string"
                        },
                        "expeditionNumber": {
                            "type": "string",
                            "nullable": true
                        },
                        "status": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "externalOrderId",
                        "status"
                    ]
                }
            },
            {
                "status": "409",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            }
        ]
    }
]
