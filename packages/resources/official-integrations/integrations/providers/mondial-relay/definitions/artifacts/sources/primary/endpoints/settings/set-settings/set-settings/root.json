{
    "endpointId": "setSettings",
    "method": "POST",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery-v3/settings",
    "params": [
        {
            "name": "id",
            "in": "query",
            "type": "string"
        }
    ],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "type": "object",
        "properties": {
            "modeCollection": {
                "type": "string",
                "enum": [
                    "REL",
                    "CCC"
                ]
            },
            "modeDelivery": {
                "type": "string"
            },
            "customerReference": {
                "type": "string"
            },
            "senderName": {
                "type": "string"
            },
            "senderFirstName": {
                "type": "string"
            },
            "senderLastName": {
                "type": "string"
            },
            "senderAddressLine1": {
                "type": "string"
            },
            "senderAddressLine2": {
                "type": "string"
            },
            "senderAddressLine3": {
                "type": "string"
            },
            "senderPostalCode": {
                "type": "string"
            },
            "senderCity": {
                "type": "string"
            },
            "senderCountry": {
                "type": "string"
            },
            "senderPhone": {
                "type": "string"
            },
            "senderMobile": {
                "type": "string"
            },
            "senderEmail": {
                "type": "string"
            },
            "defaultWeightGrams": {
                "type": "number"
            },
            "defaultPackageCount": {
                "type": "number"
            },
            "defaultLengthCm": {
                "type": "number"
            },
            "defaultWidthCm": {
                "type": "number"
            },
            "defaultHeightCm": {
                "type": "number"
            },
            "defaultContent": {
                "type": "string"
            },
            "defaultShippingAmount": {
                "type": "number"
            },
            "declaredCurrency": {
                "type": "string"
            },
            "connectCulture": {
                "type": "string"
            },
            "connectVersionApi": {
                "type": "string"
            },
            "connectOutputFormat": {
                "type": "string"
            },
            "connectOutputType": {
                "type": "string"
            }
        }
    },
    "output": {
        "$include": "output.json"
    }
}
