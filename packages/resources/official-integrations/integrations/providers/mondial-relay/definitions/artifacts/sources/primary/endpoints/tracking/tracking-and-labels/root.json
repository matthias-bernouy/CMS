[
    {
        "endpointId": "label",
        "method": "GET",
        "access": "auth",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery-v4/label",
        "responseKind": "file",
        "mediaType": "application/pdf",
        "params": [
            {
                "name": "token",
                "in": "query",
                "type": "string",
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200"
            },
            {
                "status": "206"
            },
            {
                "status": "404"
            },
            {
                "status": "410"
            }
        ]
    },
    {
        "$include": "tracking.json"
    },
    {
        "endpointId": "parseTrackingLink",
        "method": "GET",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery-v4/parse-tracking-link",
        "params": [
            {
                "name": "url",
                "in": "query",
                "type": "string",
                "required": true
            },
            {
                "name": "language",
                "in": "query",
                "type": "string"
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "carrier": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string"
                        },
                        "expeditionNumber": {
                            "type": "string"
                        },
                        "postalCode": {
                            "type": "string"
                        },
                        "tracking": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "carrier",
                        "url",
                        "expeditionNumber",
                        "tracking"
                    ]
                }
            }
        ]
    }
]
