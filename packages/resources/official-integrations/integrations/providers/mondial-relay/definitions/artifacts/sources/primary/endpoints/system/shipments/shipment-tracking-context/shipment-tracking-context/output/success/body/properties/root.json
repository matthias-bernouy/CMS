{
    "shipment": {
        "$include": "shipment/root.json"
    },
    "tracking": {
        "type": "object",
        "properties": {
            "expeditionNumber": {
                "type": "string"
            },
            "status": {
                "type": "string"
            },
            "latestEventLabel": {
                "type": "string"
            },
            "latestEventAt": {
                "type": "string"
            },
            "carrierAcceptedAt": {
                "type": "string"
            },
            "recipientHandoffAt": {
                "type": "string"
            },
            "events": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "eventLabel": {
                            "type": "string"
                        },
                        "eventDate": {
                            "type": "string",
                            "nullable": true
                        },
                        "eventTime": {
                            "type": "string",
                            "nullable": true
                        },
                        "normalizedStatus": {
                            "type": "string",
                            "nullable": true
                        },
                        "occurredAt": {
                            "type": "string",
                            "nullable": true
                        },
                        "location": {
                            "type": "string",
                            "nullable": true
                        }
                    }
                }
            }
        },
        "required": [
            "expeditionNumber",
            "status",
            "events"
        ]
    }
}
