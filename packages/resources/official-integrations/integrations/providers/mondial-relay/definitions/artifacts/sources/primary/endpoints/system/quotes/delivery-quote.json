[
    {
        "endpointId": "deliveryQuote",
        "method": "GET",
        "access": "system",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery/system/delivery-quotes/public",
        "params": [
            {
                "name": "quoteId",
                "in": "query",
                "type": "string",
                "required": true
            },
            {
                "name": "externalOrderId",
                "in": "query",
                "type": "string",
                "required": true
            },
            {
                "name": "selectedForCmsUserId",
                "in": "query",
                "type": "string",
                "semantic": {
                    "kind": "user-id",
                    "authority": "cms"
                },
                "required": true
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "quoteId": {
                            "type": "string"
                        },
                        "externalOrderId": {
                            "type": "string"
                        },
                        "orderVersion": {
                            "type": "number"
                        },
                        "revision": {
                            "type": "number"
                        },
                        "selectedForCmsUserId": {
                            "type": "string",
                            "semantic": {
                                "kind": "user-id",
                                "authority": "cms"
                            }
                        },
                        "relayLocation": {
                            "type": "string"
                        },
                        "country": {
                            "type": "string"
                        },
                        "number": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "addressLine1": {
                            "type": "string"
                        },
                        "addressLine2": {
                            "type": "string"
                        },
                        "postalCode": {
                            "type": "string"
                        },
                        "city": {
                            "type": "string"
                        },
                        "nature": {
                            "type": "string"
                        },
                        "pointType": {
                            "type": "string"
                        },
                        "weightGrams": {
                            "type": "number"
                        },
                        "shippingAmount": {
                            "type": "number"
                        },
                        "currency": {
                            "type": "string"
                        },
                        "quotedAt": {
                            "type": "string"
                        },
                        "expiresAt": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "quoteId",
                        "externalOrderId",
                        "relayLocation",
                        "country",
                        "number",
                        "name",
                        "postalCode",
                        "city",
                        "weightGrams",
                        "shippingAmount",
                        "currency",
                        "quotedAt",
                        "expiresAt"
                    ]
                }
            }
        ]
    }
]
