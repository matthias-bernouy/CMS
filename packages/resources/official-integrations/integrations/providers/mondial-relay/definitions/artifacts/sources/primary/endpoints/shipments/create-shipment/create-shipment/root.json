{
    "endpointId": "createShipment",
    "method": "POST",
    "access": "system",
    "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery-v3/shipments",
    "params": [],
    "headers": [
        {
            "name": "authorization",
            "source": {
                "from": "secret",
                "ref": "{{secrets.cmsApiKey}}",
                "prefix": "Bearer "
            }
        },
        {
            "name": "x-cms-user-id",
            "source": {
                "from": "computed",
                "ref": "userID"
            }
        }
    ],
    "body": {
        "$include": "body.json"
    },
    "output": [
        {
            "status": "201",
            "body": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "id": {
                        "type": "string"
                    },
                    "expeditionNumber": {
                        "type": "string"
                    },
                    "trackingUrl": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "idempotentReplay": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "ok",
                    "id",
                    "expeditionNumber",
                    "status"
                ]
            }
        },
        {
            "status": "200",
            "body": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "id": {
                        "type": "string"
                    },
                    "expeditionNumber": {
                        "type": "string",
                        "nullable": true
                    },
                    "trackingUrl": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "idempotentReplay": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "ok",
                    "id",
                    "expeditionNumber",
                    "status"
                ]
            }
        },
        {
            "status": "400",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        {
            "status": "409",
            "body": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ]
            }
        }
    ]
}
