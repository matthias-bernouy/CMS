[
    {
        "$include": "shipment-projection-exceptions.json"
    },
    {
        "endpointId": "reviewShipmentProjectionException",
        "method": "POST",
        "access": {
            "mode": "admin"
        },
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-delivery/admin/projection-exceptions/review",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-cms-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            },
            {
                "name": "x-cms-user-role",
                "source": {
                    "from": "computed",
                    "ref": "userRole"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "eventId": {
                    "type": "number"
                },
                "action": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                }
            },
            "required": [
                "eventId",
                "action",
                "reason"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "number"
                        },
                        "projectionStatus": {
                            "type": "string"
                        },
                        "projectionAttempts": {
                            "type": "number"
                        },
                        "projectionNextAttemptAt": {
                            "type": "string"
                        },
                        "projectionLastError": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "projectionStatus",
                        "projectionAttempts"
                    ]
                }
            },
            {
                "status": "403",
                "body": {
                    "type": "object",
                    "properties": {
                        "error": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "error"
                    ]
                }
            }
        ]
    }
]
