                                    },
                                    "trackingUrl": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "deliveryRelayLocation": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "latestEventLabel": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "latestEventAt": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "carrierAcceptedAt": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "sellerHandoffDeclaredAt": {
                                        "type": "string",
