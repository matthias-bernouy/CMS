                                                "normalizedStatus": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "occurredAt": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "location": {
                                                    "type": "string",
                                                    "nullable": true
                                                }
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "id",
                                    "status",
                                    "createdAt",
                                    "events"
