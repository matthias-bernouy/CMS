{
    "kind": "contract",
    "protocol": "ulvia-provider/v1",
    "schemaDialect": "ulvia-schema/v1",
    "contractId": "catalog.items",
    "name": "Catalog items",
    "description": "Connect a provider-owned catalog to list public items and retrieve the complete record for a selected item. Use it to power catalog pages, search experiences, and editorial dashboards without copying the provider's data into the CMS.",
    "version": "0.1.1",
    "publisherId": "ulvia.official",
    "catalogue": {
        "icon": "catalog",
        "categories": ["catalog", "commerce"]
    },
    "capabilities": [
        {
            "id": "item.list",
            "access": "public",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": { "type": "object", "properties": {}, "required": [] },
            "output": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string", "maxLength": 64 },
                                "name": { "type": "string", "maxLength": 160 }
                            },
                            "required": ["id", "name"]
                        }
                    }
                },
                "required": ["items"]
            },
            "errors": [],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/catalog/items",
                "input": {},
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": {} }
            }
        },
        {
            "id": "item.get",
            "access": "public",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": { "id": { "type": "string", "maxLength": 64 } },
                "required": ["id"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 64 },
                    "name": { "type": "string", "maxLength": 160 }
                },
                "required": ["id", "name"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/catalog/items/{id}",
                "input": { "path": { "id": "id" } },
                "response": {
                    "successStatuses": [200],
                    "contentTypes": ["application/json"],
                    "errorStatuses": { "NOT_FOUND": 404 }
                }
            }
        }
    ]
}
