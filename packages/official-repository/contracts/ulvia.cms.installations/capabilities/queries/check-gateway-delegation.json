{
    "id": "gateway.delegation.check",
    "description": "Control authority only: check a bounded invocation delegation.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "target": {
                "type": "object",
                "properties": {
                    "siteId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "sourceInstallationId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "contractId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "capabilityId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "ticket": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 43,
                        "sensitive": true
                    },
                    "sourceCredentialFingerprint": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64
                    }
                },
                "required": [
                    "siteId",
                    "sourceInstallationId",
                    "contractId",
                    "capabilityId",
                    "ticket",
                    "sourceCredentialFingerprint"
                ]
            }
        },
        "required": ["target"]
    },
    "output": {
        "type": "object",
        "properties": {
            "actor": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": ["anonymous", "user", "administrator"],
                        "maxLength": 13
                    },
                    "subjectId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "sensitive": true
                    },
                    "authorizationRevision": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "required": ["kind"]
            },
            "rootRequestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            }
        },
        "required": ["actor", "rootRequestId"]
    },
    "errors": [
        {
            "code": "FORBIDDEN",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/gateway/delegations/check",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "FORBIDDEN": 403,
                    "INVALID_INPUT": 422
                }
            }
        }
    ]
}
