{
    "id": "gateway.route.get",
    "description": "Return the complete selected Gateway route snapshot for one contract.",
    "access": "admin",
    "behavior": { "effect": "query", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "contractId": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "required": ["contractId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "route": { "type": "string", "maxLength": 1048576 }
        },
        "required": ["route"]
    },
    "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
    "binding": {
        "transport": "http",
        "method": "QUERY",
        "path": "/gateway/route",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 }
        }
    }
}
