{
    "id": "plan-collection-upgrade",
    "access": "admin",
    "description": "Analyse exact collection targets and current site usage without rewriting any content. Incomplete or blocked plans cannot be applied.",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "targets": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "approvedBrowserRiskDigest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "configurationJson": {
                            "type": "string",
                            "maxLength": 1048576
                        },
                        "textOverridesJson": {
                            "type": "string",
                            "maxLength": 1048576
                        }
                    },
                    "required": [
                        "repositoryId",
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest",
                        "approvedBrowserRiskDigest"
                    ]
                },
                "maxItems": 256,
                "minItems": 1
            }
        },
        "required": ["targets"]
    },
    "output": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            },
            "status": {
                "type": "string",
                "maxLength": 16,
                "enum": ["applicable", "blocked", "incomplete"]
            },
            "issueCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "issues": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "code": {
                            "type": "string",
                            "maxLength": 48
                        },
                        "location": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "message": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "replacement": {
                            "type": "string",
                            "maxLength": 512
                        }
                    },
                    "required": ["code", "location", "message"]
                },
                "maxItems": 1024
            },
            "resources": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "collectionId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "kind": {
                            "type": "string",
                            "maxLength": 32
                        },
                        "id": {
                            "type": "string",
                            "maxLength": 512
                        },
                        "change": {
                            "type": "string",
                            "maxLength": 16,
                            "enum": ["added", "removed", "deprecated"]
                        },
                        "replacement": {
                            "type": "string",
                            "maxLength": 512
                        }
                    },
                    "required": ["collectionId", "kind", "id", "change"]
                },
                "maxItems": 4096
            },
            "references": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "approvedBrowserRiskDigest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "configurationJson": {
                            "type": "string",
                            "maxLength": 1048576
                        },
                        "textOverridesJson": {
                            "type": "string",
                            "maxLength": 1048576
                        }
                    },
                    "required": [
                        "repositoryId",
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest",
                        "approvedBrowserRiskDigest"
                    ]
                },
                "maxItems": 256,
                "minItems": 1
            },
            "source": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "collectionId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        }
                    },
                    "required": ["collectionId", "version", "digest"]
                }
            },
            "resourceCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "usageDigest": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": [
            "expectedRevision",
            "planDigest",
            "status",
            "issueCount",
            "issues",
            "resources",
            "references",
            "source",
            "resourceCount",
            "usageDigest"
        ]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false
        },
        {
            "code": "BROWSER_CAPABILITIES_APPROVAL_REQUIRED",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/plan-collection-upgrade",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503,
                    "NOT_FOUND": 404,
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "RELEASE_MISMATCH": 409,
                    "BROWSER_CAPABILITIES_APPROVAL_REQUIRED": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_plan_collection_upgrade",
                "description": "plan collection upgrade"
            }
        }
    ]
}
