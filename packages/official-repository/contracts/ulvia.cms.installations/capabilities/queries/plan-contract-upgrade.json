{
    "id": "plan-contract-upgrade",
    "access": "admin",
    "description": "Review exact site contract selections and capability grants against actual consumers and currently served releases. An optional single selection is merged with the current graph; full selections support coordinated changes.",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "selections": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "minLength": 71,
                            "maxLength": 71
                        },
                        "installationId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        }
                    },
                    "required": ["contractId", "version", "digest", "installationId"]
                }
            },
            "grants": {
                "type": "object",
                "properties": {
                    "default": {
                        "type": "string",
                        "enum": ["allow-selected"],
                        "maxLength": 16
                    },
                    "denied": {
                        "type": "array",
                        "maxItems": 4096,
                        "items": {
                            "type": "object",
                            "properties": {
                                "contractId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 96
                                },
                                "capabilityId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 96
                                }
                            },
                            "required": ["contractId", "capabilityId"]
                        }
                    }
                },
                "required": ["default", "denied"]
            },
            "selection": {
                "type": "object",
                "properties": {
                    "contractId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                    },
                    "digest": {
                        "type": "string",
                        "minLength": 71,
                        "maxLength": 71
                    },
                    "installationId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    }
                },
                "required": ["contractId", "version", "digest", "installationId"]
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            },
            "status": {
                "type": "string",
                "maxLength": 16,
                "enum": ["applicable", "blocked", "incomplete"]
            },
            "issueCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "issues": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "code": {
                            "type": "string",
                            "maxLength": 48
                        },
                        "location": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "message": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "replacement": {
                            "type": "string",
                            "maxLength": 512
                        }
                    },
                    "required": ["code", "location", "message"]
                },
                "maxItems": 1024
            },
            "selections": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "minLength": 71,
                            "maxLength": 71
                        },
                        "installationId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        }
                    },
                    "required": ["contractId", "version", "digest", "installationId"]
                }
            },
            "grants": {
                "type": "object",
                "properties": {
                    "default": {
                        "type": "string",
                        "enum": ["allow-selected"],
                        "maxLength": 16
                    },
                    "denied": {
                        "type": "array",
                        "maxItems": 4096,
                        "items": {
                            "type": "object",
                            "properties": {
                                "contractId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 96
                                },
                                "capabilityId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 96
                                }
                            },
                            "required": ["contractId", "capabilityId"]
                        }
                    }
                },
                "required": ["default", "denied"]
            },
            "source": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "minLength": 71,
                            "maxLength": 71
                        },
                        "installationId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        }
                    },
                    "required": ["contractId", "version", "digest", "installationId"]
                }
            },
            "usageDigest": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": [
            "expectedRevision",
            "planDigest",
            "status",
            "issueCount",
            "issues",
            "selections",
            "grants",
            "source",
            "usageDigest"
        ]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false
        },
        {
            "code": "BROWSER_CAPABILITIES_APPROVAL_REQUIRED",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/plan-contract-upgrade",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503,
                    "NOT_FOUND": 404,
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "RELEASE_MISMATCH": 409,
                    "BROWSER_CAPABILITIES_APPROVAL_REQUIRED": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_plan_contract_upgrade",
                "description": "Review exact site contract selections and capability grants against actual consumers and currently served releases. An optional single selection is merged with the current graph; full selections support coordinated changes."
            }
        }
    ]
}
