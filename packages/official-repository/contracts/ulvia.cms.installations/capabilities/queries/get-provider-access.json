{
    "id": "get-provider-access",
    "description": "get provider access",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "installationId": {
                "type": "string",
                "maxLength": 128
            }
        },
        "required": ["installationId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "installationId": {
                "type": "string",
                "maxLength": 128
            },
            "providerId": {
                "type": "string",
                "maxLength": 128
            },
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "paired": {
                "type": "boolean"
            },
            "requests": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "capabilityId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "versionRange": {
                            "type": "string",
                            "maxLength": 256
                        },
                        "optional": {
                            "type": "boolean"
                        },
                        "selected": {
                            "type": "boolean"
                        }
                    },
                    "required": ["contractId", "capabilityId", "versionRange", "optional", "selected"]
                },
                "maxItems": 10000
            },
            "endpoint": {
                "type": "string",
                "maxLength": 2048
            },
            "manifestVersion": {
                "type": "string",
                "maxLength": 128
            }
        },
        "required": ["installationId", "providerId", "revision", "paired", "requests", "endpoint", "manifestVersion"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "FORBIDDEN",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/providers/access",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "FORBIDDEN": 403,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
