{
    "id": "repository.get",
    "description": "Read verified public metadata from one exact repository release before installation. Optionally inspect one Bloc or collection example. Follow nextOffset for continuation. Does not install resources, execute assets or read selected-contract documentation.",
    "docs": ["repository-discovery.md"],
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": false
    },
    "input": {
        "type": "object",
        "properties": {
            "repositoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "reference": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "enum": ["collection", "contract", "provider-manifest"]
                    },
                    "publisherId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "digest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 71
                    }
                },
                "required": ["kind", "publisherId", "id", "version", "digest"]
            },
            "blocId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "exampleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16000
            }
        },
        "required": ["repositoryId", "reference"]
    },
    "output": {
        "type": "object",
        "properties": {
            "reference": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "enum": ["collection", "contract", "provider-manifest"]
                    },
                    "publisherId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "digest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 71
                    }
                },
                "required": ["kind", "publisherId", "id", "version", "digest"]
            },
            "content": {
                "type": "string",
                "maxLength": 16000
            },
            "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
            },
            "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
            },
            "nextOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
            }
        },
        "required": ["reference", "content", "offset", "total"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CATALOGUE_TOO_LARGE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/repository/get",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "RELEASE_MISMATCH": 409,
                    "REVISION_CONFLICT": 409,
                    "CATALOGUE_TOO_LARGE": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_repository_get",
                "description": "Read verified public metadata from one exact repository release before installation. Optionally inspect one Bloc or collection example. Follow nextOffset for continuation. Does not install resources, execute assets or read selected-contract documentation."
            }
        }
    ]
}
