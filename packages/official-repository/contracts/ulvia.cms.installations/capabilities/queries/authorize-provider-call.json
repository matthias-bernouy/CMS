{
    "id": "gateway.provider.authorize",
    "description": "gateway provider authorize",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "sourceInstallationId": {
                "type": "string",
                "maxLength": 128
            },
            "targetInstallationId": {
                "type": "string",
                "maxLength": 128
            },
            "contractId": {
                "type": "string",
                "maxLength": 128
            },
            "capabilityId": {
                "type": "string",
                "maxLength": 128
            },
            "version": {
                "type": "string",
                "maxLength": 128
            },
            "sourceCredentialFingerprint": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
            }
        },
        "required": [
            "sourceInstallationId",
            "targetInstallationId",
            "contractId",
            "capabilityId",
            "version",
            "sourceCredentialFingerprint"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "allowed": {
                "type": "boolean"
            }
        },
        "required": ["allowed"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "FORBIDDEN",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/gateway/providers/authorize",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "FORBIDDEN": 403,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
