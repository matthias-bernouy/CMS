{
    "id": "list-collection-installations",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "items": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "collectionId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "repositoryId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "blocCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "exampleCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "assetCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "textCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4096
                        },
                        "themeTokenCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4096
                        },
                        "configurable": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "collectionId",
                        "publisherId",
                        "version",
                        "digest",
                        "blocCount",
                        "exampleCount",
                        "assetCount",
                        "textCount",
                        "themeTokenCount",
                        "configurable"
                    ]
                }
            }
        },
        "required": ["revision", "items"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/list-collection-installations",
            "input": {},
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_list_collection_installations",
                "description": "Read this site’s installed collection versions and current installation revision before installing or upgrading."
            }
        }
    ]
}
