{
    "id": "list-site-usage",
    "access": "admin",
    "description": "Read a bounded site usage inventory with catalogue and runtime scopes, resource locations and capability consumers. The cursor pins an exact inventory digest and becomes invalid after any analysed revision changes.",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "cursor": {
                "type": "string",
                "maxLength": 96
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "complete": {
                "type": "boolean"
            },
            "digest": {
                "type": "string",
                "maxLength": 71
            },
            "unknown": {
                "type": "array",
                "items": {
                    "type": "string",
                    "maxLength": 4096
                },
                "maxItems": 1024
            },
            "unknownCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "references": {
                "type": "array",
                "maxItems": 500,
                "items": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "maxLength": 16
                        },
                        "scope": {
                            "type": "string",
                            "maxLength": 16
                        },
                        "location": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "collectionId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "kind": {
                            "type": "string",
                            "maxLength": 32
                        },
                        "id": {
                            "type": "string",
                            "maxLength": 512
                        },
                        "contractId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "capabilityId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "bindingPath": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "versionRange": {
                            "type": "string",
                            "maxLength": 512
                        }
                    },
                    "required": ["type", "scope", "location"]
                }
            },
            "cursor": {
                "type": "string",
                "maxLength": 96
            }
        },
        "required": ["complete", "digest", "unknown", "unknownCount", "total", "references"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/list-site-usage",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503,
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_list_site_usage",
                "description": "Read a bounded site usage inventory with catalogue and runtime scopes, resource locations and capability consumers. The cursor pins an exact inventory digest and becomes invalid after any analysed revision changes."
            }
        }
    ]
}
