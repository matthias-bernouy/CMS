{
    "id": "get-operation",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "operationId": {
                "type": "string",
                "format": "uuid",
                "maxLength": 36
            }
        },
        "required": ["operationId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "operationId": {
                "type": "string",
                "format": "uuid",
                "maxLength": 36
            },
            "capabilityId": {
                "type": "string",
                "enum": [
                    "apply-collection-upgrade",
                    "resume-collection-upgrade",
                    "apply-contract-upgrade",
                    "resume-contract-upgrade"
                ],
                "maxLength": 32
            },
            "status": {
                "type": "string",
                "enum": ["queued", "running", "succeeded", "failed"],
                "maxLength": 9
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "updatedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "errorCode": {
                "type": "string",
                "maxLength": 64
            },
            "result": {
                "type": "object",
                "properties": {
                    "upgradeId": {
                        "type": "string",
                        "maxLength": 71
                    },
                    "status": {
                        "type": "string",
                        "maxLength": 16,
                        "enum": ["prepared", "applying", "completed", "cancelled"]
                    },
                    "collectionRevision": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                    },
                    "selectionRevision": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                    }
                },
                "required": ["upgradeId", "status"]
            }
        },
        "required": ["operationId", "capabilityId", "status", "revision", "createdAt", "updatedAt"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/operations/get",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_get_operation",
                "description": "Read one asynchronous operation until it succeeds or fails. Use this after a site upgrade command."
            }
        }
    ]
}
