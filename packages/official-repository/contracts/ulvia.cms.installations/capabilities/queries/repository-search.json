{
    "id": "repository.search",
    "description": "Find reusable collections, Blocs, contracts and Provider manifests in configured repositories before installing or creating resources. Inspect exact results with repository.get. Metadata does not prove compatibility or a running Provider. Partial sources and lexical fallback are explicit.",
    "docs": ["repository-discovery.md"],
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": false
    },
    "input": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
            },
            "kinds": {
                "type": "array",
                "maxItems": 4,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "enum": ["collection", "bloc", "contract", "provider-manifest"]
                }
            },
            "publisherId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "contractId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
            },
            "cursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
            },
            "repositoryIds": {
                "type": "array",
                "maxItems": 8,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96
                }
            }
        },
        "required": ["query"]
    },
    "output": {
        "type": "object",
        "properties": {
            "mode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 7,
                "enum": ["hybrid", "lexical"]
            },
            "degraded": {
                "type": "boolean"
            },
            "partial": {
                "type": "boolean"
            },
            "unavailableRepositories": {
                "type": "array",
                "maxItems": 8,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96
                }
            },
            "results": {
                "type": "array",
                "maxItems": 50,
                "items": {
                    "type": "object",
                    "properties": {
                        "reference": {
                            "type": "object",
                            "properties": {
                                "kind": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 32,
                                    "enum": ["collection", "contract", "provider-manifest"]
                                },
                                "publisherId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 96
                                },
                                "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "version": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "digest": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 71
                                }
                            },
                            "required": ["kind", "publisherId", "id", "version", "digest"]
                        },
                        "blocId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        },
                        "name": {
                            "type": "string",
                            "maxLength": 512
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 1600
                        },
                        "categories": {
                            "type": "array",
                            "maxItems": 32,
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                            }
                        },
                        "contractIds": {
                            "type": "array",
                            "maxItems": 128,
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            }
                        },
                        "repositoryId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        }
                    },
                    "required": ["reference", "name", "description", "categories", "contractIds", "repositoryId"]
                }
            },
            "nextCursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
            }
        },
        "required": ["mode", "degraded", "partial", "unavailableRepositories", "results"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CATALOGUE_TOO_LARGE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/repository/search",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "RELEASE_MISMATCH": 409,
                    "REVISION_CONFLICT": 409,
                    "CATALOGUE_TOO_LARGE": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_repository_search",
                "description": "Find reusable collections, Blocs, contracts and Provider manifests in configured repositories before installing or creating resources. Inspect exact results with repository.get. Metadata does not prove compatibility or a running Provider. Partial sources and lexical fallback are explicit."
            }
        }
    ]
}
