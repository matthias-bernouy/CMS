{
    "id": "list-operations",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "cursor": {
                "type": "string",
                "maxLength": 256
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "operationId": {
                            "type": "string",
                            "format": "uuid",
                            "maxLength": 36
                        },
                        "capabilityId": {
                            "type": "string",
                            "enum": [
                                "apply-collection-upgrade",
                                "resume-collection-upgrade",
                                "apply-contract-upgrade",
                                "resume-contract-upgrade"
                            ],
                            "maxLength": 32
                        },
                        "status": {
                            "type": "string",
                            "enum": ["queued", "running", "succeeded", "failed"],
                            "maxLength": 9
                        },
                        "revision": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "errorCode": {
                            "type": "string",
                            "maxLength": 64
                        }
                    },
                    "required": ["operationId", "capabilityId", "status", "revision", "createdAt", "updatedAt"]
                }
            },
            "nextCursor": {
                "type": "string",
                "maxLength": 256
            }
        },
        "required": ["items"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/operations",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_list_operations",
                "description": "List this instance’s asynchronous operations, including site upgrade progress."
            }
        }
    ]
}
