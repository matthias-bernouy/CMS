{
    "id": "gateway.delegation.issue",
    "description": "Control authority only: issue a bounded invocation delegation.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "sensitive": true,
        "idempotency": "none"
    },
    "input": {
        "type": "object",
        "properties": {
            "source": {
                "type": "object",
                "properties": {
                    "siteId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "requestId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "installationId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "contractId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "digest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "capabilityId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "actor": {
                        "type": "object",
                        "properties": {
                            "kind": {
                                "type": "string",
                                "enum": ["anonymous", "user", "administrator"],
                                "maxLength": 13
                            },
                            "subjectId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256,
                                "sensitive": true
                            },
                            "authorizationRevision": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "required": ["kind"]
                    },
                    "deadline": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "required": [
                    "siteId",
                    "requestId",
                    "installationId",
                    "contractId",
                    "version",
                    "digest",
                    "capabilityId",
                    "actor",
                    "deadline"
                ]
            }
        },
        "required": ["source"]
    },
    "output": {
        "type": "object",
        "properties": {
            "delegation": {
                "type": "object",
                "properties": {
                    "ticket": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 43,
                        "sensitive": true
                    },
                    "expiresAt": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "required": ["ticket", "expiresAt"],
                "nullable": true
            }
        },
        "required": ["delegation"]
    },
    "errors": [
        {
            "code": "FORBIDDEN",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/gateway/delegations/issue",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "FORBIDDEN": 403,
                    "INVALID_INPUT": 422
                }
            }
        }
    ]
}
