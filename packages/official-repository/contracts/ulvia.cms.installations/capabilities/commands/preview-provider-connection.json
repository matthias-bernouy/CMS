{
    "id": "preview-provider-connection",
    "description": "preview provider connection",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "providerId": {
                "type": "string",
                "maxLength": 128
            },
            "version": {
                "type": "string",
                "maxLength": 128
            },
            "endpoint": {
                "type": "string",
                "maxLength": 2048
            },
            "token": {
                "type": "string",
                "maxLength": 4096,
                "sensitive": true
            },
            "installationId": {
                "type": "string",
                "maxLength": 128
            },
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["providerId", "version", "endpoint", "token"]
    },
    "output": {
        "type": "object",
        "properties": {
            "ticket": {
                "type": "string",
                "maxLength": 128
            },
            "operation": {
                "type": "string",
                "maxLength": 128
            },
            "providerId": {
                "type": "string",
                "maxLength": 128
            },
            "providerName": {
                "type": "string",
                "maxLength": 128
            },
            "accountId": {
                "type": "string",
                "maxLength": 128
            },
            "accountLabel": {
                "type": "string",
                "maxLength": 128
            },
            "endpoint": {
                "type": "string",
                "maxLength": 2048
            },
            "manifestVersion": {
                "type": "string",
                "maxLength": 128
            },
            "manifestDigest": {
                "type": "string",
                "maxLength": 128
            },
            "check": {
                "type": "string",
                "maxLength": 128
            },
            "contracts": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "status": {
                            "type": "string",
                            "maxLength": 128
                        }
                    },
                    "required": ["contractId", "version", "status"]
                },
                "maxItems": 256
            },
            "requests": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "capabilityId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "versionRange": {
                            "type": "string",
                            "maxLength": 512
                        },
                        "optional": {
                            "type": "boolean"
                        }
                    },
                    "required": ["contractId", "capabilityId", "versionRange", "optional"]
                }
            },
            "authorityDigest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "delegation": {
                "type": "object",
                "properties": {
                    "policies": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "implementationContractId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "sources": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128
                                    },
                                    "maxItems": 1024
                                },
                                "allow": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "contractId": {
                                                "type": "string",
                                                "minLength": 1,
                                                "maxLength": 128
                                            },
                                            "capabilityId": {
                                                "type": "string",
                                                "minLength": 1,
                                                "maxLength": 128
                                            },
                                            "effect": {
                                                "type": "string",
                                                "enum": ["query", "command", "*"],
                                                "maxLength": 7
                                            },
                                            "sensitive": {
                                                "type": "boolean"
                                            }
                                        },
                                        "required": ["contractId", "capabilityId", "effect"]
                                    },
                                    "maxItems": 1024
                                }
                            },
                            "required": ["implementationContractId", "sources", "allow"]
                        },
                        "maxItems": 1024
                    },
                    "matches": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "sourceContractId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "sourceVersion": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "sourceDigest": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "sourceCapabilityId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "targetContractId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "targetVersion": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "targetDigest": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "targetCapabilityId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                },
                                "effect": {
                                    "type": "string",
                                    "enum": ["query", "command"],
                                    "maxLength": 7
                                },
                                "sensitive": {
                                    "type": "boolean"
                                },
                                "access": {
                                    "type": "string",
                                    "enum": ["public", "authenticated", "admin"],
                                    "maxLength": 13
                                }
                            },
                            "required": [
                                "sourceContractId",
                                "sourceVersion",
                                "sourceDigest",
                                "sourceCapabilityId",
                                "targetContractId",
                                "targetVersion",
                                "targetDigest",
                                "targetCapabilityId",
                                "effect",
                                "sensitive",
                                "access"
                            ]
                        },
                        "maxItems": 1024
                    }
                },
                "required": ["policies", "matches"]
            }
        },
        "required": [
            "ticket",
            "operation",
            "providerId",
            "providerName",
            "accountId",
            "accountLabel",
            "endpoint",
            "manifestVersion",
            "manifestDigest",
            "check",
            "contracts",
            "requests",
            "authorityDigest",
            "delegation"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "FORBIDDEN",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/providers/preview",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "FORBIDDEN": 403,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
