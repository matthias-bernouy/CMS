{
    "id": "resume-collection-upgrade",
    "access": "admin",
    "description": "Resolve a pending release switch using its original pins after an interrupted commit.",
    "behavior": {
        "effect": "command",
        "execution": "operation",
        "idempotency": "keyed",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "upgradeId": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": ["upgradeId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "upgradeId": {
                "type": "string",
                "maxLength": 71
            },
            "status": {
                "type": "string",
                "maxLength": 16,
                "enum": ["prepared", "applying", "completed", "cancelled"]
            },
            "collectionRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["upgradeId", "status", "collectionRevision"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "UPGRADE_IN_PROGRESS",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "IDEMPOTENCY_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/resume-collection-upgrade",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [202],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503,
                    "NOT_FOUND": 404,
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "UPGRADE_IN_PROGRESS": 423,
                    "IDEMPOTENCY_CONFLICT": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_resume_collection_upgrade",
                "description": "resume collection upgrade"
            }
        }
    ]
}
