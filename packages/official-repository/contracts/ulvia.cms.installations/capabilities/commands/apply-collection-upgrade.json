{
    "id": "apply-collection-upgrade",
    "access": "admin",
    "description": "Apply one current reviewed release-switch plan. Page documents are never transformed.",
    "behavior": {
        "effect": "command",
        "execution": "operation",
        "idempotency": "keyed",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "targets": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "approvedBrowserRiskDigest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "configurationJson": {
                            "type": "string",
                            "maxLength": 1048576
                        },
                        "textOverridesJson": {
                            "type": "string",
                            "maxLength": 1048576
                        }
                    },
                    "required": [
                        "repositoryId",
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest",
                        "approvedBrowserRiskDigest"
                    ]
                },
                "maxItems": 256,
                "minItems": 1
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": ["targets", "planDigest"]
    },
    "output": {
        "type": "object",
        "properties": {
            "upgradeId": {
                "type": "string",
                "maxLength": 71
            },
            "status": {
                "type": "string",
                "maxLength": 16,
                "enum": ["prepared", "applying", "completed", "cancelled"]
            },
            "collectionRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["upgradeId", "status", "collectionRevision"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "BROWSER_CAPABILITIES_APPROVAL_REQUIRED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "UPGRADE_IN_PROGRESS",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "IDEMPOTENCY_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/apply-collection-upgrade",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [202],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503,
                    "NOT_FOUND": 404,
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "RELEASE_MISMATCH": 409,
                    "BROWSER_CAPABILITIES_APPROVAL_REQUIRED": 409,
                    "UPGRADE_IN_PROGRESS": 423,
                    "IDEMPOTENCY_CONFLICT": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_apply_collection_upgrade",
                "description": "apply collection upgrade"
            }
        }
    ],
    "docs": ["overview.md"]
}
