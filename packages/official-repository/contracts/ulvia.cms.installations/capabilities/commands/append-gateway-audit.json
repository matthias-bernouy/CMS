{
    "id": "gateway.audit.append",
    "description": "Edge control connection only. Persist one immutable Gateway command audit event.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "event": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
            }
        },
        "required": ["event"]
    },
    "output": {
        "type": "object",
        "properties": {
            "accepted": {
                "type": "boolean"
            }
        },
        "required": ["accepted"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        },
        {
            "code": "FORBIDDEN",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/gateway/audit",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503,
                    "FORBIDDEN": 403
                }
            }
        }
    ]
}
