{
    "id": "approve-provider-connection",
    "description": "approve provider connection",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "ticket": {
                "type": "string",
                "maxLength": 128
            }
        },
        "required": ["ticket"]
    },
    "output": {
        "type": "object",
        "properties": {
            "installationId": {
                "type": "string",
                "maxLength": 128
            },
            "providerId": {
                "type": "string",
                "maxLength": 128
            },
            "operation": {
                "type": "string",
                "maxLength": 128
            },
            "observed": {
                "type": "boolean"
            }
        },
        "required": ["installationId", "providerId", "operation", "observed"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "FORBIDDEN",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/providers/approve",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "FORBIDDEN": 403,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
