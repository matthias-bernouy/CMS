{
    "id": "resume-contract-upgrade",
    "access": "admin",
    "description": "Resume one durable site contract release switch.",
    "behavior": {
        "effect": "command",
        "execution": "operation",
        "idempotency": "keyed"
    },
    "input": {
        "type": "object",
        "properties": {
            "upgradeId": {
                "type": "string",
                "minLength": 71,
                "maxLength": 71
            }
        },
        "required": ["upgradeId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "upgradeId": {
                "type": "string",
                "maxLength": 71
            },
            "status": {
                "type": "string",
                "maxLength": 16,
                "enum": ["prepared", "applying", "completed", "cancelled"]
            },
            "selectionRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["upgradeId", "status", "selectionRevision"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false
        },
        {
            "code": "BROWSER_CAPABILITIES_APPROVAL_REQUIRED",
            "retryable": false
        },
        {
            "code": "UPGRADE_IN_PROGRESS",
            "retryable": false
        },
        {
            "code": "IDEMPOTENCY_CONFLICT",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/resume-contract-upgrade",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [202],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503,
                    "NOT_FOUND": 404,
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "RELEASE_MISMATCH": 409,
                    "BROWSER_CAPABILITIES_APPROVAL_REQUIRED": 409,
                    "UPGRADE_IN_PROGRESS": 423,
                    "IDEMPOTENCY_CONFLICT": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_resume_contract_upgrade",
                "description": "Resume one durable site contract release switch."
            }
        }
    ]
}
