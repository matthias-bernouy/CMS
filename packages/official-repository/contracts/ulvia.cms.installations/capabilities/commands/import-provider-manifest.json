{
    "id": "import-provider-manifest",
    "description": "import provider manifest",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "repositoryId": {
                "type": "string",
                "maxLength": 256
            },
            "publisherId": {
                "type": "string",
                "maxLength": 128
            },
            "id": {
                "type": "string",
                "maxLength": 128
            },
            "version": {
                "type": "string",
                "maxLength": 128
            },
            "digest": {
                "type": "string",
                "maxLength": 128
            }
        },
        "required": ["repositoryId", "publisherId", "id", "version", "digest"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 128
            },
            "version": {
                "type": "string",
                "maxLength": 128
            },
            "digest": {
                "type": "string",
                "maxLength": 128
            }
        },
        "required": ["id", "version", "digest"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "FORBIDDEN",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/providers/import",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "FORBIDDEN": 403,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ],
    "docs": ["overview.md"]
}
