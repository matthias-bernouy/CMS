                            "maximum": 1024
                        },
                        "pageCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "assetCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "textCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4096
                        },
                        "themeTokenCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4096
                        },
                        "configurable": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "collectionId",
                        "publisherId",
                        "version",
                        "digest",
                        "dataGeneration",
                        "blocCount",
                        "pageCount",
                        "assetCount",
                        "textCount",
                        "themeTokenCount",
                        "configurable"
                    ]
                }
            }
