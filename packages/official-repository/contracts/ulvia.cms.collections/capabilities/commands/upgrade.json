        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "target": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "publisherId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "collectionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                    },
                    "digest": {
                        "type": "string",
                        "maxLength": 71
                    }
                },
                "required": [
                    "repositoryId",
                    "publisherId",
                    "collectionId",
                    "version",
                    "digest"
                ]
            }
        },
        "required": [
