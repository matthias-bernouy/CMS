        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_FOUND": 404,
                "RELEASE_MISMATCH": 409,
                "INVALID_STATE": 409,
                "REVISION_CONFLICT": 409,
                "MIGRATION_REQUIRED": 409,
