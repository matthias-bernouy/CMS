{
    "id": "apply-migration",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "keyed",
        "execution": "operation"
    },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            },
            "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        }
                    },
                    "required": [
                        "repositoryId",
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest"
                    ]
                }
            }
        },
        "required": [
            "expectedRevision",
            "planDigest",
            "targets"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "operationId": {
                "type": "string",
                "format": "uuid",
                "maxLength": 36
            }
        },
        "required": [
            "operationId"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": true
        },
        {
            "code": "MIGRATION_IN_PROGRESS",
            "retryable": true
        },
        {
            "code": "IDEMPOTENCY_CONFLICT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/apply-migration",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                202
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_FOUND": 404,
                "RELEASE_MISMATCH": 409,
                "REVISION_CONFLICT": 409,
                "MIGRATION_IN_PROGRESS": 423,
                "IDEMPOTENCY_CONFLICT": 409,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
