{
    "id": "get",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": [
            "collectionId"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "name": {
                "type": "string",
                "maxLength": 300
            },
            "description": {
                "type": "string",
                "maxLength": 2000
            },
            "publisherId": {
                "type": "string",
                "maxLength": 96
            },
            "version": {
                "type": "string",
                "maxLength": 64
            },
            "digest": {
                "type": "string",
                "maxLength": 71
            },
            "repositoryId": {
                "type": "string",
                "maxLength": 96
            },
            "dataGeneration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "blocCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
            },
            "pageCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
            },
            "assetCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
            },
            "textCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
            },
            "themeTokenCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
            },
            "configurable": {
                "type": "boolean"
            },
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "configurationJson": {
                "type": "string",
                "maxLength": 1048576
            },
            "overriddenLocaleCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
            },
            "blocs": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "label": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 2000
                        },
                        "generation": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        "internal": {
                            "type": "boolean"
                        },
                        "surfaces": {
                            "type": "array",
                            "maxItems": 2,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "control",
                                    "delivery"
                                ],
                                "maxLength": 8
                            }
                        }
                    },
                    "required": [
                        "id",
                        "label",
                        "description",
                        "generation",
                        "internal",
                        "surfaces"
                    ]
                }
            }
        },
        "required": [
            "collectionId",
            "name",
            "description",
            "publisherId",
            "version",
            "digest",
            "dataGeneration",
            "blocCount",
            "pageCount",
            "assetCount",
            "textCount",
            "themeTokenCount",
            "configurable",
            "revision",
            "configurationJson",
            "overriddenLocaleCount",
            "blocs"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/v1/cms/collections/installed/{collectionId}",
        "input": {
            "path": {
                "collectionId": "collectionId"
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
