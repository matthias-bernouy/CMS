{
    "id": "get-migration",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "migrationId": {
                "type": "string",
                "format": "uuid",
                "maxLength": 36
            }
        },
        "required": [
            "migrationId"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "format": "uuid",
                "maxLength": 36
            },
            "siteId": {
                "type": "string",
                "maxLength": 128
            },
            "status": {
                "type": "string",
                "maxLength": 32
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "updatedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "error": {
                "type": "string",
                "maxLength": 4096
            },
            "totalPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "pendingPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "appliedPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "rolledBackPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": [
            "id",
            "siteId",
            "status",
            "createdAt",
            "updatedAt",
            "totalPages",
            "pendingPages",
            "appliedPages",
            "rolledBackPages"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/get-migration",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
