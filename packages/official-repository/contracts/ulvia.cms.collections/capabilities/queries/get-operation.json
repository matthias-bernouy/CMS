{
    "id": "get-operation",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "operationId": {
                "type": "string",
                "format": "uuid",
                "maxLength": 36
            }
        },
        "required": ["operationId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "operationId": {
                "type": "string",
                "format": "uuid",
                "maxLength": 36
            },
            "capabilityId": {
                "type": "string",
                "enum": ["apply-migration", "resume-migration", "rollback-migration"],
                "maxLength": 18
            },
            "status": {
                "type": "string",
                "enum": ["queued", "running", "succeeded", "failed"],
                "maxLength": 9
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "updatedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "errorCode": {
                "type": "string",
                "maxLength": 64
            },
            "result": {
                "type": "object",
                "properties": {
                    "migrationId": {
                        "type": "string",
                        "format": "uuid",
                        "maxLength": 36
                    },
                    "status": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "collectionRevision": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                    },
                    "totalPages": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                    },
                    "operationCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                    }
                },
                "required": ["migrationId", "status", "collectionRevision", "totalPages", "operationCount"]
            }
        },
        "required": ["operationId", "capabilityId", "status", "revision", "createdAt", "updatedAt"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "QUERY",
        "path": "/operations/get",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "INVALID_INPUT": 422,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
