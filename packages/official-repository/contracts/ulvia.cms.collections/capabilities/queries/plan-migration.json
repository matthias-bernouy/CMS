{
    "id": "plan-migration",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        }
                    },
                    "required": [
                        "repositoryId",
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest"
                    ]
                }
            }
        },
        "required": [
            "targets"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            },
            "targets": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "collectionId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "fromDigest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "toDigest": {
                            "type": "string",
                            "maxLength": 71
                        }
                    },
                    "required": [
                        "collectionId",
                        "fromDigest",
                        "toDigest"
                    ]
                }
            },
            "totalPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "operationCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "blockedReasons": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                    "type": "string",
                    "maxLength": 4096
                }
            },
            "references": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        }
                    },
                    "required": [
                        "repositoryId",
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest"
                    ]
                }
            }
        },
        "required": [
            "expectedRevision",
            "planDigest",
            "targets",
            "totalPages",
            "operationCount",
            "blockedReasons",
            "references"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "QUERY",
        "path": "/plan-migration",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_FOUND": 404,
                "RELEASE_MISMATCH": 409,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
