{
    "id": "catalogue",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "repositories": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "string",
                    "maxLength": 96
                }
            },
            "releases": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "name": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "blocCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "hasTheme": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "repositoryId",
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest",
                        "name",
                        "description",
                        "blocCount",
                        "hasTheme"
                    ]
                }
            },
            "installed": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "repositoryId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "publisherId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "collectionId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "configurable": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "publisherId",
                        "collectionId",
                        "version",
                        "digest",
                        "configurable"
                    ]
                }
            }
        },
        "required": [
            "revision",
            "repositories",
            "releases",
            "installed"
        ]
    },
    "errors": [
        {
            "code": "CATALOGUE_TOO_LARGE",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/catalogue",
        "input": {},
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "CATALOGUE_TOO_LARGE": 422,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
