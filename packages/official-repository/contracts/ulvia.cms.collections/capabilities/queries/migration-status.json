{
    "id": "migration-status",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "maintenance": {
                "type": "boolean"
            },
            "activeMigration": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "maxLength": 96
                    },
                    "status": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "maxLength": 40
                    }
                },
                "required": [
                    "id",
                    "status",
                    "updatedAt"
                ]
            },
            "migrations": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "status": {
                            "type": "string",
                            "enum": [
                                "completed",
                                "rolled-back"
                            ],
                            "maxLength": 11
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "totalPages": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        },
                        "operationCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        }
                    },
                    "required": [
                        "id",
                        "status",
                        "createdAt",
                        "updatedAt",
                        "totalPages",
                        "operationCount"
                    ]
                }
            }
        },
        "required": [
            "maintenance",
            "migrations"
        ]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/migration-status",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
