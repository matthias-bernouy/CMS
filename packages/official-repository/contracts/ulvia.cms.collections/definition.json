{
    "kind": "contract",
    "protocol": "ulvia-provider/v1",
    "schemaDialect": "ulvia-schema/v1",
    "contractId": "ulvia.cms.collections",
    "name": "CMS Collections",
    "description": "Inspect, configure, install and migrate immutable collection releases in one provider-selected CMS instance.",
    "version": "1.0.0",
    "publisherId": "ulvia.official",
    "catalogue": { "icon": "collections", "categories": ["administration", "content"] },
    "capabilities": [
        {
            "id": "list",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": { "type": "object", "properties": {}, "required": [] },
            "output": {
                "type": "object",
                "properties": {
                    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "items": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "collectionId": { "type": "string", "maxLength": 96 },
                                "publisherId": { "type": "string", "maxLength": 96 },
                                "version": { "type": "string", "maxLength": 64 },
                                "digest": { "type": "string", "maxLength": 71 },
                                "repositoryId": { "type": "string", "maxLength": 96 },
                                "dataGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                                "blocCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
                                "pageCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
                                "assetCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
                                "textCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
                                "themeTokenCount": { "type": "integer", "minimum": 0, "maximum": 4096 }
                            },
                            "required": ["collectionId", "publisherId", "version", "digest", "dataGeneration", "blocCount", "pageCount", "assetCount", "textCount", "themeTokenCount"]
                        }
                    }
                },
                "required": ["revision", "items"]
            },
            "errors": [{ "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/collections/installed",
                "input": {},
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "get",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": { "collectionId": { "type": "string", "minLength": 1, "maxLength": 96 } },
                "required": ["collectionId"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "collectionId": { "type": "string", "maxLength": 96 },
                    "publisherId": { "type": "string", "maxLength": 96 },
                    "version": { "type": "string", "maxLength": 64 },
                    "digest": { "type": "string", "maxLength": 71 },
                    "repositoryId": { "type": "string", "maxLength": 96 },
                    "dataGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "blocCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
                    "pageCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
                    "assetCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
                    "textCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
                    "themeTokenCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
                    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "configurationJson": { "type": "string", "maxLength": 1048576 },
                    "overriddenLocaleCount": { "type": "integer", "minimum": 0, "maximum": 64 }
                },
                "required": ["collectionId", "publisherId", "version", "digest", "dataGeneration", "blocCount", "pageCount", "assetCount", "textCount", "themeTokenCount", "revision", "configurationJson", "overriddenLocaleCount"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/collections/installed/{collectionId}",
                "input": { "path": { "collectionId": "collectionId" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "install",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "targets": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": { "digest": { "type": "string", "maxLength": 71 }, "repositoryId": { "type": "string", "maxLength": 96 } },
                            "required": ["digest"]
                        }
                    }
                },
                "required": ["expectedRevision", "targets"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "items": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "collectionId": { "type": "string", "maxLength": 96 }, "publisherId": { "type": "string", "maxLength": 96 }, "version": { "type": "string", "maxLength": 64 }, "digest": { "type": "string", "maxLength": 71 }, "repositoryId": { "type": "string", "maxLength": 96 }, "dataGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "blocCount": { "type": "integer", "minimum": 0, "maximum": 1024 }, "pageCount": { "type": "integer", "minimum": 0, "maximum": 1024 }, "assetCount": { "type": "integer", "minimum": 0, "maximum": 1024 }, "textCount": { "type": "integer", "minimum": 0, "maximum": 4096 }, "themeTokenCount": { "type": "integer", "minimum": 0, "maximum": 4096 }
                            },
                            "required": ["collectionId", "publisherId", "version", "digest", "dataGeneration", "blocCount", "pageCount", "assetCount", "textCount", "themeTokenCount"]
                        }
                    }
                },
                "required": ["revision", "items"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": true }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "POST",
                "path": "/v1/cms/collections/installations",
                "input": { "body": true },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "update-configuration",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "collectionId": { "type": "string", "minLength": 1, "maxLength": 96 },
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "configurationJson": { "type": "string", "maxLength": 1048576 }
                },
                "required": ["collectionId", "expectedRevision", "configurationJson"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "items": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "collectionId": { "type": "string", "maxLength": 96 }, "publisherId": { "type": "string", "maxLength": 96 }, "version": { "type": "string", "maxLength": 64 }, "digest": { "type": "string", "maxLength": 71 }, "repositoryId": { "type": "string", "maxLength": 96 }, "dataGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "blocCount": { "type": "integer", "minimum": 0, "maximum": 1024 }, "pageCount": { "type": "integer", "minimum": 0, "maximum": 1024 }, "assetCount": { "type": "integer", "minimum": 0, "maximum": 1024 }, "textCount": { "type": "integer", "minimum": 0, "maximum": 4096 }, "themeTokenCount": { "type": "integer", "minimum": 0, "maximum": 4096 }
                            },
                            "required": ["collectionId", "publisherId", "version", "digest", "dataGeneration", "blocCount", "pageCount", "assetCount", "textCount", "themeTokenCount"]
                        }
                    }
                },
                "required": ["revision", "items"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": true }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "PUT",
                "path": "/v1/cms/collections/installed/{collectionId}/configuration",
                "input": { "path": { "collectionId": "collectionId" }, "body": { "properties": ["expectedRevision", "configurationJson"] } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "plan-migration",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "natural", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "targets": {
                        "type": "array", "minItems": 1, "maxItems": 256,
                        "items": { "type": "object", "properties": { "digest": { "type": "string", "maxLength": 71 }, "repositoryId": { "type": "string", "maxLength": 96 } }, "required": ["digest"] }
                    }
                },
                "required": ["expectedRevision", "targets"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "planDigest": { "type": "string", "maxLength": 71 },
                    "targets": { "type": "array", "maxItems": 256, "items": { "type": "object", "properties": { "collectionId": { "type": "string", "maxLength": 96 }, "fromDigest": { "type": "string", "maxLength": 71 }, "toDigest": { "type": "string", "maxLength": 71 } }, "required": ["collectionId", "fromDigest", "toDigest"] } },
                    "totalPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "operationCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "blockedReasons": { "type": "array", "maxItems": 1024, "items": { "type": "string", "maxLength": 4096 } }
                },
                "required": ["expectedRevision", "planDigest", "targets", "totalPages", "operationCount", "blockedReasons"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": true }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http", "method": "POST", "path": "/v1/cms/collections/migration-plans", "input": { "body": true },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "apply-migration",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "keyed", "execution": "operation" },
            "input": {
                "type": "object",
                "properties": {
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "planDigest": { "type": "string", "maxLength": 71 },
                    "targets": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "properties": { "digest": { "type": "string", "maxLength": 71 }, "repositoryId": { "type": "string", "maxLength": 96 } }, "required": ["digest"] } }
                },
                "required": ["expectedRevision", "planDigest", "targets"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "migrationId": { "type": "string", "format": "uuid", "maxLength": 36 },
                    "status": { "type": "string", "maxLength": 32 },
                    "collectionRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "totalPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "operationCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["migrationId", "status", "collectionRevision", "totalPages", "operationCount"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": true }, { "code": "MIGRATION_IN_PROGRESS", "retryable": true }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http", "method": "POST", "path": "/v1/cms/collections/migration-runs", "input": { "body": true },
                "response": { "successStatuses": [202], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "REVISION_CONFLICT": 409, "MIGRATION_IN_PROGRESS": 423, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "get-migration",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": { "type": "object", "properties": { "migrationId": { "type": "string", "format": "uuid", "maxLength": 36 } }, "required": ["migrationId"] },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "format": "uuid", "maxLength": 36 }, "siteId": { "type": "string", "maxLength": 128 }, "status": { "type": "string", "maxLength": 32 }, "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 }, "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }, "error": { "type": "string", "maxLength": 4096 }, "totalPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "pendingPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "appliedPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "rolledBackPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["id", "siteId", "status", "createdAt", "updatedAt", "totalPages", "pendingPages", "appliedPages", "rolledBackPages"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http", "method": "GET", "path": "/v1/cms/collections/migration-runs/{migrationId}", "input": { "path": { "migrationId": "migrationId" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "resume-migration",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "keyed", "execution": "operation" },
            "input": { "type": "object", "properties": { "migrationId": { "type": "string", "format": "uuid", "maxLength": 36 } }, "required": ["migrationId"] },
            "output": {
                "type": "object",
                "properties": { "migrationId": { "type": "string", "format": "uuid", "maxLength": 36 }, "status": { "type": "string", "maxLength": 32 }, "collectionRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "totalPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "operationCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
                "required": ["migrationId", "status", "collectionRevision", "totalPages", "operationCount"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "MIGRATION_IN_PROGRESS", "retryable": true }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http", "method": "POST", "path": "/v1/cms/collections/migration-runs/{migrationId}/resume", "input": { "path": { "migrationId": "migrationId" } },
                "response": { "successStatuses": [202], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "MIGRATION_IN_PROGRESS": 423, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "rollback-migration",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "keyed", "execution": "operation" },
            "input": { "type": "object", "properties": { "migrationId": { "type": "string", "format": "uuid", "maxLength": 36 } }, "required": ["migrationId"] },
            "output": {
                "type": "object",
                "properties": { "migrationId": { "type": "string", "format": "uuid", "maxLength": 36 }, "status": { "type": "string", "maxLength": 32 }, "collectionRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "totalPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "operationCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
                "required": ["migrationId", "status", "collectionRevision", "totalPages", "operationCount"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "MIGRATION_IN_PROGRESS", "retryable": true }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http", "method": "POST", "path": "/v1/cms/collections/migration-runs/{migrationId}/rollback", "input": { "path": { "migrationId": "migrationId" } },
                "response": { "successStatuses": [202], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "MIGRATION_IN_PROGRESS": 423, "CORE_UNAVAILABLE": 503 } }
            }
        }
    ]
}
