{
    "id": "documentation.search",
    "description": "Ask a natural-language question about the selected contracts. Search their versioned documentation before unfamiliar, multi-step or ambiguous work. Results include document references for documentation.get. A lexical-only result explicitly reports degraded semantic retrieval.",
    "docs": ["overview.md", "documentation.md"],
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": false
    },
    "input": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
            },
            "contractId": {
                "type": "string",
                "maxLength": 193
            },
            "capabilityId": {
                "type": "string",
                "maxLength": 128
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
            }
        },
        "required": ["query"]
    },
    "output": {
        "type": "object",
        "properties": {
            "mode": {
                "type": "string",
                "enum": ["hybrid", "lexical"],
                "maxLength": 7
            },
            "degraded": {
                "type": "boolean"
            },
            "results": {
                "type": "array",
                "maxItems": 10,
                "items": {
                    "type": "object",
                    "properties": {
                        "reference": {
                            "type": "object",
                            "properties": {
                                "contractId": {
                                    "type": "string",
                                    "maxLength": 193
                                },
                                "releaseDigest": {
                                    "type": "string",
                                    "maxLength": 71
                                },
                                "path": {
                                    "type": "string",
                                    "maxLength": 256
                                }
                            },
                            "required": ["contractId", "releaseDigest", "path"]
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "title": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "heading": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "excerpt": {
                            "type": "string",
                            "maxLength": 1600
                        },
                        "capabilities": {
                            "type": "array",
                            "maxItems": 512,
                            "items": {
                                "type": "string",
                                "maxLength": 128
                            }
                        }
                    },
                    "required": ["reference", "version", "title", "heading", "excerpt", "capabilities"]
                }
            }
        },
        "required": ["mode", "degraded", "results"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/documentation/search",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_documentation_search",
                "description": "Ask a natural-language question about the selected contracts. Search their versioned documentation before unfamiliar, multi-step or ambiguous work. Results include document references for documentation.get. A lexical-only result explicitly reports degraded semantic retrieval."
            }
        }
    ]
}
