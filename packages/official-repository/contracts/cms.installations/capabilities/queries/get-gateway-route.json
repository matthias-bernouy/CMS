{
    "id": "gateway.route.get",
    "description": "Edge control connection only. Return the complete selected Gateway route snapshot for one contract.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "contractId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 193
            }
        },
        "required": ["contractId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "route": {
                "type": "string",
                "maxLength": 1048576
            }
        },
        "required": ["route"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "FORBIDDEN",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/gateway/route",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503,
                    "FORBIDDEN": 403
                }
            }
        }
    ],
    "docs": ["overview.md"]
}
