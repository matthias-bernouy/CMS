{
    "id": "update-collection-configuration",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 193
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Current revision returned by the corresponding read operation. Read again after a conflict."
            },
            "configurationJson": {
                "type": "string",
                "maxLength": 1048576
            }
        },
        "required": ["collectionId", "expectedRevision", "configurationJson"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "items": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "collectionId": {
                            "type": "string",
                            "maxLength": 193
                        },
                        "publisherId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "repositoryId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "blocCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "exampleCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "assetCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1024
                        },
                        "textCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4096
                        },
                        "themeTokenCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4096
                        },
                        "configurable": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "collectionId",
                        "publisherId",
                        "version",
                        "digest",
                        "blocCount",
                        "exampleCount",
                        "assetCount",
                        "textCount",
                        "themeTokenCount",
                        "configurable"
                    ]
                }
            }
        },
        "required": ["revision", "items"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/update-collection-configuration",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_update_collection_configuration",
                "description": "Update site-owned configuration for an installed collection using the current installation expectedRevision."
            }
        }
    ],
    "docs": ["overview.md"]
}
