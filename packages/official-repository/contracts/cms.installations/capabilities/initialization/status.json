{
    "id": "initialization.status",
    "access": "admin",
    "description": "Read durable site initialization progress. An empty site alone never implies pending setup.",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "status": {
                "type": "string",
                "enum": ["unavailable", "pending", "running", "completed"],
                "maxLength": 16
            },
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "completedPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "totalPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            },
            "rootJson": {
                "type": "string",
                "maxLength": 2048
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "redirectPath": {
                "type": "string",
                "maxLength": 2048
            },
            "operationId": {
                "type": "string",
                "maxLength": 64
            },
            "operationStatus": {
                "type": "string",
                "enum": ["none", "queued", "running", "succeeded", "failed"],
                "maxLength": 9
            },
            "errorMessage": {
                "type": "string",
                "maxLength": 2048
            }
        },
        "required": [
            "status",
            "revision",
            "completedPages",
            "totalPages",
            "planDigest",
            "rootJson",
            "locale",
            "redirectPath",
            "operationId",
            "operationStatus",
            "errorMessage"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "UPGRADE_IN_PROGRESS",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "FORBIDDEN",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/initialization/status",
            "input": {},
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "UPGRADE_IN_PROGRESS": 423,
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503,
                    "FORBIDDEN": 403,
                    "RELEASE_MISMATCH": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_initialization_status",
                "description": "Status site initialization through the ordinary Gateway. Read the review and approve its exact digest before applying."
            }
        }
    ],
    "docs": ["initialization.md"]
}
