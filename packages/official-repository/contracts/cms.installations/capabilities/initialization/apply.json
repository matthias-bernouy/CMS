{
    "id": "initialization.apply",
    "access": "admin",
    "description": "Apply or resume one explicitly reviewed initialization. Approval covers the exact resources and browser-code risks shown by the review.",
    "behavior": {
        "effect": "command",
        "execution": "operation",
        "sensitive": true,
        "idempotency": "keyed"
    },
    "input": {
        "type": "object",
        "properties": {
            "root": {
                "type": "object",
                "properties": {
                    "publisherId": {
                        "type": "string",
                        "maxLength": 96
                    },
                    "collectionId": {
                        "type": "string",
                        "maxLength": 193
                    },
                    "version": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "digest": {
                        "type": "string",
                        "maxLength": 71
                    },
                    "bootstrapId": {
                        "type": "string",
                        "maxLength": 96
                    }
                },
                "required": ["publisherId", "collectionId", "version", "digest", "bootstrapId"],
                "nullable": true
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": ["root", "planDigest"]
    },
    "output": {
        "type": "object",
        "properties": {
            "status": {
                "type": "string",
                "enum": ["unavailable", "pending", "running", "completed"],
                "maxLength": 16
            },
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "completedPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "totalPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "planDigest": {
                "type": "string",
                "maxLength": 71
            },
            "rootJson": {
                "type": "string",
                "maxLength": 2048
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "redirectPath": {
                "type": "string",
                "maxLength": 2048
            }
        },
        "required": [
            "status",
            "revision",
            "completedPages",
            "totalPages",
            "planDigest",
            "rootJson",
            "locale",
            "redirectPath"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "UPGRADE_IN_PROGRESS",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "FORBIDDEN",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "IDEMPOTENCY_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "IDEMPOTENCY_KEY_REQUIRED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "PROVIDER_SHUTTING_DOWN",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/initialization/apply",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [202],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "UPGRADE_IN_PROGRESS": 423,
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503,
                    "FORBIDDEN": 403,
                    "RELEASE_MISMATCH": 409,
                    "IDEMPOTENCY_CONFLICT": 409,
                    "IDEMPOTENCY_KEY_REQUIRED": 422,
                    "PROVIDER_SHUTTING_DOWN": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_initialization_apply",
                "description": "Apply site initialization through the ordinary Gateway. Read the review and approve its exact digest before applying."
            }
        }
    ],
    "docs": ["initialization.md"]
}
