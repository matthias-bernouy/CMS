{
    "id": "initialization.list",
    "access": "admin",
    "description": "List bootstrap recipes from four latest stable collections per page, using metadata only.",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "cursor": {
                "type": "string",
                "maxLength": 256
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 64,
                "items": {
                    "type": "object",
                    "properties": {
                        "root": {
                            "type": "object",
                            "properties": {
                                "publisherId": {
                                    "type": "string",
                                    "maxLength": 96
                                },
                                "collectionId": {
                                    "type": "string",
                                    "maxLength": 193
                                },
                                "version": {
                                    "type": "string",
                                    "maxLength": 64
                                },
                                "digest": {
                                    "type": "string",
                                    "maxLength": 71
                                },
                                "bootstrapId": {
                                    "type": "string",
                                    "maxLength": 96
                                }
                            },
                            "required": ["publisherId", "collectionId", "version", "digest", "bootstrapId"]
                        },
                        "label": {
                            "type": "string",
                            "maxLength": 16384
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 16384
                        },
                        "pageCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        },
                        "includeCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        }
                    },
                    "required": ["root", "label", "description", "pageCount", "includeCount"]
                }
            },
            "cursor": {
                "type": "string",
                "maxLength": 256
            }
        },
        "required": ["items", "cursor"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "UPGRADE_IN_PROGRESS",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "FORBIDDEN",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 2048,
                        "minLength": 1
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RELEASE_MISMATCH",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/initialization/recipes",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "UPGRADE_IN_PROGRESS": 423,
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503,
                    "FORBIDDEN": 403,
                    "RELEASE_MISMATCH": 409
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "installations_initialization_list",
                "description": "List site initialization through the ordinary Gateway. Read the review and approve its exact digest before applying."
            }
        }
    ],
    "docs": ["initialization.md"]
}
