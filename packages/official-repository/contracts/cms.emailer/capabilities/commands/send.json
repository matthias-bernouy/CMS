{
    "id": "emailer.send",
    "description": "Deliver one fully composed outbound email through the configured transport.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "keyed",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "toEmail": {
                "type": "string",
                "format": "email",
                "maxLength": 320
            },
            "toName": {
                "type": "string",
                "maxLength": 160
            },
            "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 998
            },
            "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
            },
            "html": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
            }
        },
        "required": ["toEmail", "subject", "text"]
    },
    "output": {
        "type": "object",
        "properties": {
            "sent": {
                "type": "boolean"
            }
        },
        "required": ["sent"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "EMAIL_DISABLED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/send",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "EMAIL_DISABLED": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ],
    "docs": ["overview.md"]
}
