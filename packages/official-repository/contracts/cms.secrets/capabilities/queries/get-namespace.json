{
    "id": "namespace.get",
    "description": "Read one secret namespace with a management credential.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "sensitive": true,
                "minLength": 20,
                "maxLength": 512
            }
        },
        "required": ["namespaceId", "namespaceKey"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 128
            },
            "name": {
                "type": "string",
                "maxLength": 160
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "createdBy": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "maxLength": 13,
                        "enum": ["administrator", "provider", "system"]
                    },
                    "id": {
                        "type": "string",
                        "maxLength": 256
                    }
                },
                "required": ["kind", "id"]
            }
        },
        "required": ["id", "name", "createdAt", "createdBy"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/namespace.get",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_AUTHORIZED": 403,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ],
    "docs": ["overview.md"]
}
