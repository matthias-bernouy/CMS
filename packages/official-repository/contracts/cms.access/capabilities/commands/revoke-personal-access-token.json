{
    "id": "revoke-personal-access-token",
    "description": "Revoke one token owned by the authenticated account.",
    "access": "authenticated",
    "behavior": {
        "sensitive": true,
        "effect": "command",
        "execution": "sync",
        "idempotency": "none"
    },
    "input": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": ["id"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revoked": {
                "type": "boolean"
            }
        },
        "required": ["revoked"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "ACTOR_UNAVAILABLE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "DELETE",
            "path": "/personal-access-tokens/{id}",
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "ACTOR_UNAVAILABLE": 403,
                    "CORE_UNAVAILABLE": 503,
                    "NOT_FOUND": 404
                }
            },
            "input": {
                "path": {
                    "id": "id"
                }
            }
        }
    ]
}
