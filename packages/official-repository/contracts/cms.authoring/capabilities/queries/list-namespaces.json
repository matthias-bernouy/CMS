{
    "id": "list-namespaces",
    "description": "Read the configured Repository account namespace inventory live. Follow nextCursor; only active owned namespaces permit publication.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "cursor": {
                "type": "string",
                "maxLength": 96
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
            },
            "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "object",
                    "properties": {
                        "namespace": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "repositoryId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "access": {
                            "type": "string",
                            "enum": ["owned", "suspended"],
                            "maxLength": 16
                        },
                        "revision": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "checkedAt": {
                            "type": "string",
                            "maxLength": 64,
                            "format": "date-time"
                        }
                    },
                    "required": ["namespace", "repositoryId", "access", "revision", "checkedAt"]
                }
            },
            "nextCursor": {
                "type": "string",
                "maxLength": 96,
                "nullable": true
            }
        },
        "required": ["items", "nextCursor"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/list-namespaces",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_list_namespaces",
                "description": "Read the configured Repository account namespace inventory live. Follow nextCursor; only active owned namespaces permit publication."
            }
        }
    ],
    "docs": ["overview.md", "collection-authoring.md"]
}
