{
    "id": "get-provider-manifest-sources",
    "description": "Read private provider-manifest sources owned by the connected Repository account.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "maxLength": 96
            },
            "version": {
                "type": "string",
                "maxLength": 64
            },
            "providerId": {
                "type": "string",
                "maxLength": 193
            }
        },
        "required": ["namespace", "providerId", "version"]
    },
    "output": {
        "type": "object",
        "nullable": true,
        "properties": {
            "sourceJson": {
                "type": "string",
                "maxLength": 1048576,
                "sensitive": true
            },
            "releaseDigest": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": ["sourceJson", "releaseDigest"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/get-provider-manifest-sources",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_get_provider_manifest_sources",
                "description": "Read private provider-manifest sources owned by the connected Repository account."
            }
        }
    ],
    "docs": ["overview.md", "artifact-authoring.md", "provider-manifest-source.md"]
}
