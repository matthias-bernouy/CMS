{
    "id": "publish-contract",
    "description": "Publish the exact prepared contract digest and retain its private sources. This does not install or deploy it.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "preparationId": {
                "type": "string",
                "maxLength": 36
            },
            "expectedDigest": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": ["preparationId", "expectedDigest"]
    },
    "output": {
        "type": "object",
        "properties": {
            "repositoryId": {
                "type": "string",
                "maxLength": 96
            },
            "publisherId": {
                "type": "string",
                "maxLength": 96
            },
            "version": {
                "type": "string",
                "maxLength": 64
            },
            "digest": {
                "type": "string",
                "maxLength": 71
            },
            "kind": {
                "type": "string",
                "maxLength": 8,
                "enum": ["contract"]
            },
            "added": {
                "type": "boolean"
            },
            "contractId": {
                "type": "string",
                "maxLength": 193
            }
        },
        "required": ["repositoryId", "publisherId", "contractId", "version", "digest", "kind", "added"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    },
                    "publicationCode": {
                        "type": "string",
                        "maxLength": 32,
                        "enum": [
                            "immutable_conflict",
                            "identity_changed",
                            "version_order",
                            "stable_resource",
                            "major_required",
                            "minor_required"
                        ]
                    },
                    "publicationResource": {
                        "type": "object",
                        "properties": {
                            "kind": {
                                "type": "string",
                                "maxLength": 16,
                                "enum": ["bloc", "theme-token", "configuration", "text", "asset", "state"]
                            },
                            "id": {
                                "type": "string",
                                "maxLength": 512
                            }
                        },
                        "required": ["kind", "id"]
                    },
                    "publicationState": {
                        "type": "string",
                        "maxLength": 15,
                        "enum": ["sources-pending", "unknown"]
                    },
                    "preparationId": {
                        "type": "string",
                        "maxLength": 36
                    },
                    "digest": {
                        "type": "string",
                        "maxLength": 71
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    },
                    "publicationState": {
                        "type": "string",
                        "maxLength": 15,
                        "enum": ["sources-pending", "unknown"]
                    },
                    "preparationId": {
                        "type": "string",
                        "maxLength": 36
                    },
                    "digest": {
                        "type": "string",
                        "maxLength": 71
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/publish-contract",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_publish_contract",
                "description": "Publish the exact prepared contract digest and retain its private sources. This does not install or deploy it."
            }
        }
    ],
    "docs": ["overview.md", "artifact-authoring.md", "contract-source.md"]
}
