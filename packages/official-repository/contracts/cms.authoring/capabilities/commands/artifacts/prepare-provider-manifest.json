{
    "id": "prepare-provider-manifest",
    "description": "Validate and prepare provider-manifest source files without publication or installation.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "sourceJson": {
                "type": "string",
                "maxLength": 1048576,
                "sensitive": true,
                "description": "Complete JSON source snapshot with files: [{path, content}] and optional immutable fixture asset references. Read the linked source guide first."
            }
        },
        "required": ["sourceJson"]
    },
    "output": {
        "type": "object",
        "properties": {
            "repositoryId": {
                "type": "string",
                "maxLength": 96
            },
            "publisherId": {
                "type": "string",
                "maxLength": 96
            },
            "version": {
                "type": "string",
                "maxLength": 64
            },
            "digest": {
                "type": "string",
                "maxLength": 71
            },
            "preparationId": {
                "type": "string",
                "maxLength": 36
            },
            "sourceDigest": {
                "type": "string",
                "maxLength": 71
            },
            "valid": {
                "type": "boolean",
                "description": "Publish only when valid is true and a preparationId and digest were returned."
            },
            "diagnostics": {
                "type": "array",
                "maxItems": 16,
                "items": {
                    "type": "object",
                    "properties": {
                        "code": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "severity": {
                            "type": "string",
                            "enum": ["error", "warning"],
                            "maxLength": 7
                        },
                        "message": {
                            "type": "string",
                            "maxLength": 2048
                        },
                        "location": {
                            "type": "object",
                            "properties": {
                                "blocId": {
                                    "type": "string",
                                    "maxLength": 512
                                },
                                "path": {
                                    "type": "string",
                                    "maxLength": 2048
                                },
                                "attribute": {
                                    "type": "string",
                                    "maxLength": 64
                                }
                            },
                            "required": []
                        },
                        "relatedResources": {
                            "type": "array",
                            "maxItems": 8,
                            "items": {
                                "type": "string",
                                "maxLength": 200
                            }
                        },
                        "suggestion": {
                            "type": "string",
                            "maxLength": 512
                        }
                    },
                    "required": ["code", "severity", "message"]
                }
            },
            "providerId": {
                "type": "string",
                "maxLength": 193
            }
        },
        "required": ["valid", "diagnostics"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/prepare-provider-manifest",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_prepare_provider_manifest",
                "description": "Validate and prepare provider-manifest source files without publication or installation."
            }
        }
    ],
    "docs": ["overview.md", "artifact-authoring.md", "provider-manifest-source.md"]
}
