{
    "id": "claim-namespace",
    "description": "Claim a namespace for the Repository account authenticated by the configured PAT. Existing ownership is preserved.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "maxLength": 96
            }
        },
        "required": ["namespace"]
    },
    "output": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "revision": {
                "type": "integer",
                "minimum": 1
            },
            "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "enum": ["active", "suspended"]
            },
            "updatedAt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
            }
        },
        "required": ["namespace", "revision", "state", "updatedAt"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/claim-namespace",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_claim_namespace",
                "description": "Claim a namespace for the Repository account authenticated by the configured PAT. Existing ownership is preserved."
            }
        }
    ],
    "docs": ["overview.md", "collection-authoring.md"]
}
