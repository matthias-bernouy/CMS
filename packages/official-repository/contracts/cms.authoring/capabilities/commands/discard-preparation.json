{
    "id": "discard-preparation",
    "description": "Discard one local unpublished collection preparation. Published Repository releases are preserved.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "preparationId": {
                "type": "string",
                "maxLength": 36
            }
        },
        "required": ["preparationId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "discarded": {
                "type": "boolean"
            }
        },
        "required": ["discarded"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/discard-preparation",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_discard_preparation",
                "description": "Discard one local unpublished collection preparation. Published Repository releases are preserved."
            }
        }
    ],
    "docs": ["overview.md", "collection-authoring.md"]
}
