{
    "id": "delete",
    "description": "Delete a secret by identifier and expected version.",
    "access": "admin",
    "behavior": { "effect": "command", "idempotency": "natural", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "secretId": { "type": "string", "minLength": 1, "maxLength": 160 },
            "expectedVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        },
        "required": ["secretId", "expectedVersion"]
    },
    "output": {
        "type": "object",
        "properties": { "deleted": { "type": "boolean" } },
        "required": ["deleted"]
    },
    "errors": [
        { "code": "INVALID_INPUT", "retryable": false },
        { "code": "VERSION_CONFLICT", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "binding": {
        "transport": "http",
        "method": "DELETE",
        "path": "/secrets/{secretId}",
        "input": { "path": { "secretId": "secretId" }, "query": { "expectedVersion": "expectedVersion" } },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_INPUT": 422, "VERSION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 }
        }
    }
}
