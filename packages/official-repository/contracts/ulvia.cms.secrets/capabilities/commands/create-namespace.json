{
    "id": "namespace.create",
    "description": "Create a credential-owned secret namespace.",
    "access": "admin",
    "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "required": ["name"]
    },
    "output": {
        "type": "object",
        "properties": {
            "namespaceId": { "type": "string", "maxLength": 128 },
            "keyId": { "type": "string", "maxLength": 128 },
            "namespaceKey": { "type": "string", "sensitive": true, "minLength": 20, "maxLength": 512 }
        },
        "required": ["namespaceId", "keyId", "namespaceKey"]
    },
    "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/namespaces",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_INPUT": 422, "CORE_UNAVAILABLE": 503 }
        }
    }
}
