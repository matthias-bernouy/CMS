{
    "id": "namespace.keys.rotate",
    "description": "Replace and revoke one secret namespace credential.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "sensitive": true,
                "minLength": 20,
                "maxLength": 512
            },
            "keyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            }
        },
        "required": ["namespaceId", "namespaceKey", "keyId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "keyId": {
                "type": "string",
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "sensitive": true,
                "minLength": 20,
                "maxLength": 512
            }
        },
        "required": ["keyId", "namespaceKey"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/namespaces/{namespaceId}/keys/{keyId}/rotate",
            "input": {
                "path": {
                    "namespaceId": "namespaceId",
                    "keyId": "keyId"
                },
                "body": {
                    "properties": ["namespaceKey"]
                }
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_AUTHORIZED": 403,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
