{
    "id": "namespace.keys.create",
    "description": "Create another scoped secret namespace credential.",
    "access": "admin",
    "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "namespaceKey": { "type": "string", "sensitive": true, "minLength": 20, "maxLength": 512 },
            "permissions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                    "type": "string",
                    "maxLength": 32,
                    "enum": [
                        "secrets.metadata.read",
                        "secrets.resolve",
                        "secrets.write",
                        "secrets.delete",
                        "namespace.manage"
                    ]
                }
            },
            "expiresAt": { "type": "string", "format": "date-time", "maxLength": 40, "nullable": true }
        },
        "required": ["namespaceId", "namespaceKey", "permissions"]
    },
    "output": {
        "type": "object",
        "properties": {
            "keyId": { "type": "string", "maxLength": 128 },
            "namespaceKey": { "type": "string", "sensitive": true, "minLength": 20, "maxLength": 512 }
        },
        "required": ["keyId", "namespaceKey"]
    },
    "errors": [
        { "code": "INVALID_INPUT", "retryable": false },
        { "code": "NOT_AUTHORIZED", "retryable": false },
        { "code": "NOT_FOUND", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/namespaces/{namespaceId}/keys",
        "input": {
            "path": { "namespaceId": "namespaceId" },
            "body": { "properties": ["namespaceKey", "permissions", "expiresAt"] }
        },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_INPUT": 422, "NOT_AUTHORIZED": 403, "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 }
        }
    }
}
