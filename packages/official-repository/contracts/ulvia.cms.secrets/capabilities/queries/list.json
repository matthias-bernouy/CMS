{
    "id": "list",
    "description": "List bounded secret metadata without values.",
    "access": "admin",
    "behavior": { "effect": "query", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "secretId": { "type": "string", "maxLength": 160 },
                        "name": { "type": "string", "maxLength": 96 },
                        "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
                    },
                    "required": ["secretId", "name", "version"]
                }
            }
        },
        "required": ["items"]
    },
    "errors": [{ "code": "CORE_UNAVAILABLE", "retryable": true }],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/secrets",
        "input": { "query": { "limit": "limit" } },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "CORE_UNAVAILABLE": 503 }
        }
    }
}
