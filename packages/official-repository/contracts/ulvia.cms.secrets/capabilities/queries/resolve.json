{
    "id": "secrets.resolve",
    "description": "Resolve one secret value using a namespace credential with explicit resolve permission.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "sensitive": true,
                "minLength": 20,
                "maxLength": 512
            },
            "secretId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
            }
        },
        "required": ["namespaceId", "namespaceKey", "secretId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "maxLength": 128
            },
            "secretId": {
                "type": "string",
                "maxLength": 160
            },
            "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "value": {
                "type": "string",
                "sensitive": true,
                "minLength": 1,
                "maxLength": 16384
            }
        },
        "required": ["namespaceId", "secretId", "version", "value"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/secrets.resolve",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_AUTHORIZED": 403,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
