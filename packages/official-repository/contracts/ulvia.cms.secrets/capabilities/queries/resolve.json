{
    "id": "resolve",
    "description": "Resolve one secret value for an administrator or trusted CMS runtime.",
    "access": "admin",
    "behavior": { "effect": "query", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": { "secretId": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "required": ["secretId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "secretId": { "type": "string", "maxLength": 160 },
            "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "value": { "type": "string", "sensitive": true, "minLength": 1, "maxLength": 16384 }
        },
        "required": ["secretId", "version", "value"]
    },
    "errors": [
        { "code": "NOT_FOUND", "retryable": false },
        { "code": "NOT_AUTHORIZED", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "binding": {
        "transport": "http",
        "method": "QUERY",
        "path": "/resolve",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "NOT_FOUND": 404, "NOT_AUTHORIZED": 403, "CORE_UNAVAILABLE": 503 }
        }
    }
}
