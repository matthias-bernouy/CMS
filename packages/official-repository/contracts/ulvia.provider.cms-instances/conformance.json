{
    "kind": "contract-conformance-suite",
    "protocol": "ulvia-conformance/v1",
    "contractId": "ulvia.provider.cms-instances",
    "contractVersion": "1.0.0",
    "contractDigest": "sha256:09806efae5f8cae5f125c90dc41c2e13ba791e2f5ce34a8826b11f1a83d640a3",
    "publisherId": "ulvia.official",
    "version": "1.0.0",
    "isolation": "disposable-tenant",
    "scenarios": [
        {
            "id": "discover-current-instance",
            "calls": [
                {
                    "id": "list",
                    "capabilityId": "list",
                    "actor": { "kind": "admin" },
                    "input": { "limit": 10 },
                    "expect": {
                        "kind": "success",
                        "checks": [{ "path": "/items", "present": true }]
                    }
                },
                {
                    "id": "current",
                    "capabilityId": "get-current",
                    "actor": { "kind": "admin" },
                    "input": {},
                    "expect": {
                        "kind": "success",
                        "checks": [
                            { "path": "/id", "present": true },
                            { "path": "/coreVersion", "present": true },
                            { "path": "/contracts", "present": true }
                        ]
                    }
                }
            ]
        }
    ],
    "coverageExemptions": [
        {
            "capabilityId": "get-current",
            "errorCode": "INSTANCE_UNAVAILABLE",
            "reason": "The runner-independent suite must not prescribe how a provider makes its managed Core unavailable."
        }
    ]
}
