{
    "kind": "contract",
    "protocol": "ulvia-provider/v1",
    "schemaDialect": "ulvia-schema/v1",
    "contractId": "ulvia.cms.access",
    "name": "CMS Access And Settings",
    "description": "Manage CMS membership, administrator grants, authentication methods and non-secret site settings.",
    "version": "1.0.0",
    "publisherId": "ulvia.official",
    "catalogue": { "icon": "users", "categories": ["administration", "access"] },
    "capabilities": [
        {
            "id": "overview",
            "description": "Return bounded users, login providers and safe site settings.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": { "type": "object", "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }, "required": [] },
            "output": {
                "type": "object",
                "properties": {
                    "site": {
                        "type": "object",
                        "properties": {
                            "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                            "name": { "type": "string", "maxLength": 160 },
                            "host": { "type": "string", "maxLength": 2048 },
                            "language": { "type": "string", "maxLength": 64 },
                            "visible": { "type": "boolean" }
                        },
                        "required": ["revision", "name", "host", "language", "visible"]
                    },
                    "users": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                            "type": "object",
                            "properties": {
                                "sub": { "type": "string", "maxLength": 200 },
                                "email": { "type": "string", "format": "email", "maxLength": 320 },
                                "provider": { "type": "string", "maxLength": 96 },
                                "administrator": { "type": "boolean" },
                                "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                                "lastSeenAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                            },
                            "required": ["sub", "administrator", "createdAt", "lastSeenAt"]
                        }
                    },
                    "totalUsers": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "loginProviders": {
                        "type": "array",
                        "maxItems": 32,
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string", "maxLength": 96 },
                                "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                                "kind": { "type": "string", "enum": ["local", "oidc"], "maxLength": 5 },
                                "displayName": { "type": "string", "maxLength": 160 },
                                "enabled": { "type": "boolean" },
                                "icon": { "type": "string", "maxLength": 2048 },
                                "issuer": { "type": "string", "maxLength": 2048 },
                                "authorizationEndpoint": { "type": "string", "maxLength": 2048 },
                                "tokenEndpoint": { "type": "string", "maxLength": 2048 },
                                "jwksUri": { "type": "string", "maxLength": 2048 },
                                "clientId": { "type": "string", "maxLength": 512 },
                                "scopes": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 160 } },
                                "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                                "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                            },
                            "required": ["id", "revision", "kind", "displayName", "enabled", "createdAt", "updatedAt"]
                        }
                    }
                },
                "required": ["site", "users", "totalUsers", "loginProviders"]
            },
            "errors": [{ "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/access",
                "input": { "query": { "limit": "limit" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "list-users",
            "description": "List CMS members with exact email search and bounded pagination.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "search": { "type": "string", "maxLength": 320 },
                    "page": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                    "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
                },
                "required": []
            },
            "output": {
                "type": "object",
                "properties": {
                    "users": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                            "type": "object",
                            "properties": {
                                "sub": { "type": "string", "maxLength": 200 },
                                "email": { "type": "string", "format": "email", "maxLength": 320 },
                                "provider": { "type": "string", "maxLength": 96 },
                                "administrator": { "type": "boolean" },
                                "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                                "lastSeenAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                            },
                            "required": ["sub", "administrator", "createdAt", "lastSeenAt"]
                        }
                    },
                    "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "page": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
                    "hasMore": { "type": "boolean" }
                },
                "required": ["users", "total", "page", "limit", "hasMore"]
            },
            "errors": [{ "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/access/users",
                "input": { "query": { "search": "search", "page": "page", "limit": "limit" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "get-user",
            "description": "Read one CMS member and its administrator state.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": { "sub": { "type": "string", "minLength": 1, "maxLength": 200 } },
                "required": ["sub"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "sub": { "type": "string", "maxLength": 200 },
                    "email": { "type": "string", "format": "email", "maxLength": 320 },
                    "provider": { "type": "string", "maxLength": 96 },
                    "administrator": { "type": "boolean" },
                    "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                    "lastSeenAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                },
                "required": ["sub", "administrator", "createdAt", "lastSeenAt"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/access/user",
                "input": { "query": { "sub": "sub" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "set-administrator",
            "description": "Grant or revoke administrator access with revision control and self-lockout protection.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "sub": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "enabled": { "type": "boolean" },
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["sub", "enabled", "expectedRevision"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "sub": { "type": "string", "maxLength": 200 },
                    "administrator": { "type": "boolean" },
                    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "bootstrap": { "type": "boolean" }
                },
                "required": ["sub", "administrator", "revision", "bootstrap"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "CANNOT_REMOVE_SELF", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": false }, { "code": "ACTOR_UNAVAILABLE", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "PUT",
                "path": "/v1/cms/access/administrator",
                "input": { "body": true },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "CANNOT_REMOVE_SELF": 409, "REVISION_CONFLICT": 409, "ACTOR_UNAVAILABLE": 403, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "delete-user",
            "description": "Delete one member, its local credential and personal access tokens.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": { "sub": { "type": "string", "minLength": 1, "maxLength": 200 } },
                "required": ["sub"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "sub": { "type": "string", "maxLength": 200 },
                    "deleted": { "type": "boolean" }
                },
                "required": ["sub", "deleted"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "CANNOT_REMOVE_SELF", "retryable": false }, { "code": "PROTECTED_USER", "retryable": false }, { "code": "ACTOR_UNAVAILABLE", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "DELETE",
                "path": "/v1/cms/access/user",
                "input": { "query": { "sub": "sub" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "CANNOT_REMOVE_SELF": 409, "PROTECTED_USER": 409, "ACTOR_UNAVAILABLE": 403, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "update-login-provider",
            "description": "Update non-secret login-provider configuration with revision control.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "providerId": { "type": "string", "minLength": 1, "maxLength": 96 },
                    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "enabled": { "type": "boolean" },
                    "icon": { "type": "string", "minLength": 1, "maxLength": 2048 },
                    "issuer": { "type": "string", "minLength": 1, "maxLength": 2048 },
                    "authorizationEndpoint": { "type": "string", "minLength": 1, "maxLength": 2048 },
                    "tokenEndpoint": { "type": "string", "minLength": 1, "maxLength": 2048 },
                    "jwksUri": { "type": "string", "minLength": 1, "maxLength": 2048 },
                    "clientId": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "scopes": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
                },
                "required": ["providerId", "expectedRevision"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 96 },
                    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "kind": { "type": "string", "enum": ["local", "oidc"], "maxLength": 5 },
                    "displayName": { "type": "string", "maxLength": 160 },
                    "enabled": { "type": "boolean" },
                    "icon": { "type": "string", "maxLength": 2048 },
                    "issuer": { "type": "string", "maxLength": 2048 },
                    "authorizationEndpoint": { "type": "string", "maxLength": 2048 },
                    "tokenEndpoint": { "type": "string", "maxLength": 2048 },
                    "jwksUri": { "type": "string", "maxLength": 2048 },
                    "clientId": { "type": "string", "maxLength": 512 },
                    "scopes": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 160 } },
                    "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                    "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                },
                "required": ["id", "revision", "kind", "displayName", "enabled", "createdAt", "updatedAt"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "INVALID_STATE", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "PATCH",
                "path": "/v1/cms/access/login-providers/{providerId}",
                "input": { "path": { "providerId": "providerId" }, "body": { "properties": ["expectedRevision", "displayName", "enabled", "icon", "issuer", "authorizationEndpoint", "tokenEndpoint", "jwksUri", "clientId", "scopes"] } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "INVALID_STATE": 409, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "update-site",
            "description": "Update safe site identity and availability settings with revision control.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "host": { "type": "string", "maxLength": 2048 },
                    "visible": { "type": "boolean" }
                },
                "required": ["expectedRevision"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "name": { "type": "string", "maxLength": 160 },
                    "host": { "type": "string", "maxLength": 2048 },
                    "language": { "type": "string", "maxLength": 64 },
                    "visible": { "type": "boolean" }
                },
                "required": ["revision", "name", "host", "language", "visible"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "PATCH",
                "path": "/v1/cms/access/site",
                "input": { "body": true },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        }
    ]
}
