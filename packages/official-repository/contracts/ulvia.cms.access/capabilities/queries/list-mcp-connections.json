{
    "id": "list-mcp-connections",
    "description": "List mcp connections",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "requestJson": {
                "type": "string",
                "maxLength": 16384,
                "sensitive": true
            }
        },
        "required": ["requestJson"]
    },
    "output": {
        "type": "object",
        "properties": {
            "resultJson": {
                "type": "string",
                "maxLength": 1048576,
                "sensitive": true
            }
        },
        "required": ["resultJson"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/list-mcp-connections",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
