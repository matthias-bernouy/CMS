{
    "id": "list-users",
    "description": "List CMS members with exact email search and bounded pagination.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "search": {
                "type": "string",
                "maxLength": 320
            },
            "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "users": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "sub": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "email": {
                            "type": "string",
                            "format": "email",
                            "maxLength": 320
                        },
                        "provider": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "administrator": {
                            "type": "boolean"
                        },
                        "administratorRevision": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "lastSeenAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        }
                    },
                    "required": [
                        "sub",
                        "administrator",
                        "administratorRevision",
                        "createdAt",
                        "lastSeenAt"
                    ]
                }
            },
            "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            },
            "hasMore": {
                "type": "boolean"
            }
        },
        "required": [
            "users",
            "total",
            "page",
            "limit",
            "hasMore"
        ]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/list-users",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
