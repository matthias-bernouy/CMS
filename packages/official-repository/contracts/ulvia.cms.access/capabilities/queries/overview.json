{
    "id": "overview",
    "description": "Return bounded users and safe site settings.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "site": {
                "type": "object",
                "properties": {
                    "revision": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 160
                    },
                    "host": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "language": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "visible": {
                        "type": "boolean"
                    }
                },
                "required": ["revision", "name", "host", "language", "visible"]
            },
            "users": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "sub": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "email": {
                            "type": "string",
                            "format": "email",
                            "maxLength": 320
                        },
                        "provider": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "administrator": {
                            "type": "boolean"
                        },
                        "administratorRevision": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "lastSeenAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        }
                    },
                    "required": ["sub", "administrator", "administratorRevision", "createdAt", "lastSeenAt"]
                }
            },
            "totalUsers": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["site", "users", "totalUsers"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "QUERY",
        "path": "/overview",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": {
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
