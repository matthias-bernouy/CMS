{
    "id": "inspect-actor",
    "description": "Inspect live membership and authorization revision for a gateway delegation. Signed gateway system authority only.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "subjectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "sensitive": true
            }
        },
        "required": ["subjectId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "state": {
                "type": "string",
                "enum": ["anonymous", "authenticated"],
                "maxLength": 13
            },
            "subjectId": {
                "type": "string",
                "maxLength": 200
            },
            "administrator": {
                "type": "boolean"
            },
            "authorizationRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["state"]
    },
    "errors": [
        {
            "code": "FORBIDDEN",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/access/actors/inspect",
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "FORBIDDEN": 403
                }
            },
            "input": {
                "body": true
            }
        }
    ]
}
