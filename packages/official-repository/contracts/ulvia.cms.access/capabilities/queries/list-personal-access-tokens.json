{
    "id": "list-personal-access-tokens",
    "description": "List the authenticated account's tokens without their secrets.",
    "access": "authenticated",
    "behavior": {
        "sensitive": true,
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "tokens": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                        },
                        "createdAt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40,
                            "format": "date-time"
                        },
                        "expiresAt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40,
                            "format": "date-time",
                            "nullable": true
                        },
                        "lastUsedAt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40,
                            "format": "date-time"
                        }
                    },
                    "required": ["id", "name", "createdAt", "expiresAt"]
                },
                "minItems": 0,
                "maxItems": 32
            }
        },
        "required": ["tokens"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "ACTOR_UNAVAILABLE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/personal-access-tokens",
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "ACTOR_UNAVAILABLE": 403,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
