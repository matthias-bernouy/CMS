{
    "id": "login-password",
    "description": "Authenticate a local account and establish a CMS session.",
    "access": "public",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "email": {
                "type": "string",
                "format": "email",
                "maxLength": 320
            },
            "password": {
                "type": "string",
                "sensitive": true,
                "minLength": 1,
                "maxLength": 4096
            }
        },
        "required": ["email", "password"]
    },
    "output": {
        "type": "object",
        "properties": {
            "subjectId": {
                "type": "string",
                "maxLength": 200
            },
            "administrator": {
                "type": "boolean"
            }
        },
        "required": ["subjectId", "administrator"]
    },
    "errors": [
        {
            "code": "INVALID_CREDENTIALS",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RATE_LIMITED",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "responseEffects": ["session"],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/login-password",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_CREDENTIALS": 401,
                    "RATE_LIMITED": 429,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ],
    "docs": ["overview.md"]
}
