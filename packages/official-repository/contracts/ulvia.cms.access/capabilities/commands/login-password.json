{
    "id": "login-password",
    "description": "Authenticate a local account and establish a CMS session.",
    "access": "public",
    "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "email": { "type": "string", "format": "email", "maxLength": 320 },
            "password": { "type": "string", "sensitive": true, "minLength": 1, "maxLength": 4096 }
        },
        "required": ["email", "password"]
    },
    "output": {
        "type": "object",
        "properties": {
            "subjectId": { "type": "string", "maxLength": 200 },
            "administrator": { "type": "boolean" }
        },
        "required": ["subjectId", "administrator"]
    },
    "errors": [
        { "code": "INVALID_CREDENTIALS", "retryable": false },
        { "code": "RATE_LIMITED", "retryable": true },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "responseEffects": ["session"],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/login-password",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_CREDENTIALS": 401, "RATE_LIMITED": 429, "CORE_UNAVAILABLE": 503 }
        }
    }
}
