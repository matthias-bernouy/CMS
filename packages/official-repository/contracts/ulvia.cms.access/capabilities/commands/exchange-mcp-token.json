{
    "id": "exchange-mcp-token",
    "description": "Exchange mcp token",
    "access": "public",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "requestJson": {
                "type": "string",
                "maxLength": 16384,
                "sensitive": true
            }
        },
        "required": ["requestJson"]
    },
    "output": {
        "type": "object",
        "properties": {
            "resultJson": {
                "type": "string",
                "maxLength": 1048576,
                "sensitive": true
            }
        },
        "required": ["resultJson"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/exchange-mcp-token",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
