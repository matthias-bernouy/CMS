{
    "id": "signup",
    "description": "Create or resume a local CMS account signup.",
    "access": "public",
    "behavior": { "effect": "command", "idempotency": "natural", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "email": { "type": "string", "format": "email", "maxLength": 320 },
            "password": { "type": "string", "sensitive": true, "minLength": 8, "maxLength": 4096 }
        },
        "required": ["email", "password"]
    },
    "output": {
        "type": "object",
        "properties": { "accepted": { "type": "boolean" } },
        "required": ["accepted"]
    },
    "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/signup",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_INPUT": 422, "CORE_UNAVAILABLE": 503 }
        }
    }
}
