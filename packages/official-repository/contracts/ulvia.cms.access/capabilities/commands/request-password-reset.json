{
    "id": "request-password-reset",
    "description": "Request a password reset without disclosing account existence.",
    "access": "public",
    "behavior": { "effect": "command", "idempotency": "natural", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": { "email": { "type": "string", "format": "email", "maxLength": 320 } },
        "required": ["email"]
    },
    "output": { "type": "object", "properties": { "sent": { "type": "boolean" } }, "required": ["sent"] },
    "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
    "requires": [
        {
            "contractId": "ulvia.cms.emailer",
            "versionRange": "^1.0.0",
            "capabilityId": "emailer.send"
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/request-password-reset",
            "input": { "body": true },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": { "INVALID_INPUT": 422, "CORE_UNAVAILABLE": 503 }
            }
        }
    ]
}
