{
    "id": "save",
    "description": "Validate and save the complete structured site theme with revision control.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "themeJson": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1048576
            }
        },
        "required": [
            "expectedRevision",
            "themeJson"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "activeThemeId": {
                "type": "string",
                "maxLength": 96
            },
            "themeJson": {
                "type": "string",
                "maxLength": 1048576
            }
        },
        "required": [
            "revision",
            "activeThemeId",
            "themeJson"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/save",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "REVISION_CONFLICT": 409,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
