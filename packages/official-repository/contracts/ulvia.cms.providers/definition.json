{
    "kind": "contract",
    "protocol": "ulvia-provider/v1",
    "schemaDialect": "ulvia-schema/v1",
    "contractId": "ulvia.cms.providers",
    "name": "CMS Providers",
    "description": "Inspect CMS-owned provider installations and exact contract selections without disclosing credentials.",
    "version": "1.0.0",
    "publisherId": "ulvia.official",
    "catalogue": { "icon": "providers", "categories": ["administration", "infrastructure"] },
    "capabilities": [
        {
            "id": "list",
            "description": "List approved provider installations and selected contract releases.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": { "type": "object", "properties": {}, "required": [] },
            "output": {
                "type": "object",
                "properties": {
                    "selectionRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "installations": {
                        "type": "array",
                        "maxItems": 128,
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string", "maxLength": 96 },
                                "providerId": { "type": "string", "maxLength": 96 },
                                "accountId": { "type": "string", "maxLength": 160 },
                                "endpoint": { "type": "string", "format": "uri", "maxLength": 2048 },
                                "status": { "type": "string", "enum": ["enabled", "disabled", "revoked"], "maxLength": 8 },
                                "manifestVersion": { "type": "string", "maxLength": 64 },
                                "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                                "observedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                            },
                            "required": ["id", "providerId", "accountId", "endpoint", "status", "manifestVersion", "revision"]
                        }
                    },
                    "selections": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "contractId": { "type": "string", "maxLength": 96 },
                                "version": { "type": "string", "maxLength": 64 },
                                "digest": { "type": "string", "maxLength": 71 },
                                "installationId": { "type": "string", "maxLength": 96 }
                            },
                            "required": ["contractId", "version", "digest", "installationId"]
                        }
                    }
                },
                "required": ["selectionRevision", "installations", "selections"]
            },
            "errors": [{ "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/providers",
                "input": {},
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "get",
            "description": "Read one provider installation, its observed implementations and its selected contracts.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": { "installationId": { "type": "string", "minLength": 1, "maxLength": 96 } },
                "required": ["installationId"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 96 },
                    "providerId": { "type": "string", "maxLength": 96 },
                    "accountId": { "type": "string", "maxLength": 160 },
                    "endpoint": { "type": "string", "format": "uri", "maxLength": 2048 },
                    "status": { "type": "string", "enum": ["enabled", "disabled", "revoked"], "maxLength": 8 },
                    "manifestVersion": { "type": "string", "maxLength": 64 },
                    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "observedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                    "contracts": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "contractId": { "type": "string", "maxLength": 96 },
                                "version": { "type": "string", "maxLength": 64 },
                                "digest": { "type": "string", "maxLength": 71 },
                                "status": { "type": "string", "enum": ["ready", "setup-required", "unavailable"], "maxLength": 14 }
                            },
                            "required": ["contractId", "version", "digest", "status"]
                        }
                    },
                    "selections": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "contractId": { "type": "string", "maxLength": 96 },
                                "version": { "type": "string", "maxLength": 64 },
                                "digest": { "type": "string", "maxLength": 71 },
                                "installationId": { "type": "string", "maxLength": 96 }
                            },
                            "required": ["contractId", "version", "digest", "installationId"]
                        }
                    }
                },
                "required": ["id", "providerId", "accountId", "endpoint", "status", "manifestVersion", "revision", "contracts", "selections"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/providers/{installationId}",
                "input": { "path": { "installationId": "installationId" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "replace-selections",
            "description": "Atomically validate and replace the complete site contract selection graph.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "selections": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "contractId": { "type": "string", "minLength": 1, "maxLength": 96 },
                                "version": { "type": "string", "minLength": 1, "maxLength": 64 },
                                "digest": { "type": "string", "minLength": 71, "maxLength": 71 },
                                "installationId": { "type": "string", "minLength": 1, "maxLength": 96 }
                            },
                            "required": ["contractId", "version", "digest", "installationId"]
                        }
                    }
                },
                "required": ["expectedRevision", "selections"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "selections": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "object",
                            "properties": {
                                "contractId": { "type": "string", "maxLength": 96 },
                                "version": { "type": "string", "maxLength": 64 },
                                "digest": { "type": "string", "maxLength": 71 },
                                "installationId": { "type": "string", "maxLength": 96 }
                            },
                            "required": ["contractId", "version", "digest", "installationId"]
                        }
                    }
                },
                "required": ["revision", "selections"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "INVALID_SELECTION", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "PUT",
                "path": "/v1/cms/providers/selections",
                "input": { "body": true },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "INVALID_SELECTION": 422, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "set-status",
            "description": "Enable, disable or terminally revoke one provider installation with revision control.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "installationId": { "type": "string", "minLength": 1, "maxLength": 96 },
                    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "action": { "type": "string", "enum": ["enable", "disable", "revoke"], "maxLength": 7 }
                },
                "required": ["installationId", "expectedRevision", "action"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "installationId": { "type": "string", "maxLength": 96 },
                    "status": { "type": "string", "enum": ["enabled", "disabled", "revoked"], "maxLength": 8 },
                    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "credentialsDeleted": { "type": "boolean" }
                },
                "required": ["installationId", "status", "revision", "credentialsDeleted"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "INVALID_STATE", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "PUT",
                "path": "/v1/cms/providers/{installationId}/status",
                "input": { "path": { "installationId": "installationId" }, "body": { "properties": ["expectedRevision", "action"] } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "INVALID_STATE": 409, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        }
    ]
}
