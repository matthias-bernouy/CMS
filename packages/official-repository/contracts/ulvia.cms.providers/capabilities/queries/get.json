{
    "id": "get",
    "description": "Read one provider installation, its observed implementations and its selected contracts.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "installationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": [
            "installationId"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 96
            },
            "providerId": {
                "type": "string",
                "maxLength": 96
            },
            "accountId": {
                "type": "string",
                "maxLength": 160
            },
            "endpoint": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
            },
            "status": {
                "type": "string",
                "enum": [
                    "enabled",
                    "disabled",
                    "revoked"
                ],
                "maxLength": 8
            },
            "manifestVersion": {
                "type": "string",
                "maxLength": 64
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "observedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "contracts": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "status": {
                            "type": "string",
                            "enum": [
                                "ready",
                                "setup-required",
                                "unavailable"
                            ],
                            "maxLength": 14
                        }
                    },
                    "required": [
                        "contractId",
                        "version",
                        "digest",
                        "status"
                    ]
                }
            },
            "selections": {
                "type": "array",
                "maxItems": 256,
                "items": {
                    "type": "object",
                    "properties": {
                        "contractId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "digest": {
                            "type": "string",
                            "maxLength": 71
                        },
                        "installationId": {
                            "type": "string",
                            "maxLength": 96
                        }
                    },
                    "required": [
                        "contractId",
                        "version",
                        "digest",
                        "installationId"
                    ]
                }
            }
        },
        "required": [
            "id",
            "providerId",
            "accountId",
            "endpoint",
            "status",
            "manifestVersion",
            "revision",
            "contracts",
            "selections"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/get",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
