{
    "id": "list",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "cursor": {
                "type": "string",
                "maxLength": 256
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uuid",
                            "maxLength": 36
                        },
                        "contractId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "capabilityId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "status": {
                            "type": "string",
                            "enum": [
                                "queued",
                                "running",
                                "succeeded",
                                "failed"
                            ],
                            "maxLength": 9
                        },
                        "revision": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "errorCode": {
                            "type": "string",
                            "maxLength": 64
                        }
                    },
                    "required": [
                        "id",
                        "contractId",
                        "capabilityId",
                        "status",
                        "revision",
                        "createdAt",
                        "updatedAt"
                    ]
                }
            },
            "nextCursor": {
                "type": "string",
                "maxLength": 256
            }
        },
        "required": [
            "items"
        ]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/list",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
