{
    "access": "public",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": false
    },
    "id": "representations.read",
    "description": "Stream one immutable image representation.",
    "input": {
        "type": "object",
        "properties": {
            "fileId": {
                "type": "string",
                "maxLength": 128
            },
            "generation": {
                "type": "string",
                "maxLength": 128
            },
            "profile": {
                "type": "string",
                "maxLength": 10,
                "enum": ["thumbnail", "responsive"]
            },
            "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
            },
            "access": {
                "type": "string",
                "maxLength": 2048,
                "sensitive": true
            },
            "range": {
                "type": "string",
                "maxLength": 128
            },
            "ifRange": {
                "type": "string",
                "maxLength": 160
            }
        },
        "required": ["fileId", "generation", "profile", "width"]
    },
    "output": {
        "type": "binary",
        "maxBytes": 10737418240
    },
    "errors": [
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "RANGE_NOT_SATISFIABLE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/files/{fileId}/{generation}/representations/{profile}/{width}.webp",
            "input": {
                "path": {
                    "fileId": "fileId",
                    "generation": "generation",
                    "profile": "profile",
                    "width": "width"
                },
                "query": {
                    "access": "access"
                },
                "headers": {
                    "range": {
                        "property": "range",
                        "encoding": "http-field"
                    },
                    "if-range": {
                        "property": "ifRange",
                        "encoding": "http-field"
                    }
                }
            },
            "response": {
                "successStatuses": [200, 206],
                "contentTypes": [],
                "errorStatuses": {
                    "NOT_AUTHORIZED": 403,
                    "NOT_FOUND": 404,
                    "RANGE_NOT_SATISFIABLE": 416,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ],
    "docs": ["overview.md", "site-files.md"]
}
