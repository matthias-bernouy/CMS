{
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none",
        "sensitive": true
    },
    "id": "namespace.delete",
    "description": "Delete a namespace and all of its files.",
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "maxLength": 512,
                "minLength": 20,
                "sensitive": true
            }
        },
        "required": ["namespaceId", "namespaceKey"]
    },
    "output": {
        "type": "null"
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "DELETE",
            "path": "/namespaces/{namespaceId}",
            "input": {
                "path": {
                    "namespaceId": "namespaceId"
                },
                "body": {
                    "properties": ["namespaceKey"]
                }
            },
            "response": {
                "successStatuses": [204],
                "contentTypes": [],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_AUTHORIZED": 403,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ],
    "docs": ["overview.md", "site-files.md"]
}
