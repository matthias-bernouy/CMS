{
    "id": "workspace.files.set-visibility",
    "description": "Set whether a site workspace file is public or private.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "natural",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "fileId": {
                "type": "string",
                "maxLength": 128
            },
            "visibility": {
                "type": "string",
                "maxLength": 7,
                "enum": ["private", "public"]
            }
        },
        "required": ["fileId", "visibility"]
    },
    "output": {
        "type": "null"
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/workspace.files.set-visibility",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "files_workspace_files_set_visibility",
                "description": "Make one site file public or private without replacing its bytes."
            }
        }
    ],
    "docs": ["overview.md", "site-files.md"]
}
