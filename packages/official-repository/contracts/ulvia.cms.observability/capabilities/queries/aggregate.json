{
    "id": "logs.aggregate",
    "description": "Count retained diagnostic records by one predefined dimension. These counts are not request-rate or performance metrics.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "from": {
                "type": "string",
                "maxLength": 32
            },
            "to": {
                "type": "string",
                "maxLength": 32
            },
            "levels": {
                "type": "array",
                "items": {
                    "type": "string",
                    "maxLength": 5,
                    "enum": ["trace", "debug", "info", "warn", "error", "fatal"]
                },
                "maxItems": 6
            },
            "service": {
                "type": "string",
                "maxLength": 128
            },
            "component": {
                "type": "string",
                "maxLength": 128
            },
            "event": {
                "type": "string",
                "maxLength": 128
            },
            "eventPrefix": {
                "type": "string",
                "maxLength": 128
            },
            "requestId": {
                "type": "string",
                "maxLength": 128
            },
            "invocationId": {
                "type": "string",
                "maxLength": 128
            },
            "contractId": {
                "type": "string",
                "maxLength": 128
            },
            "capabilityId": {
                "type": "string",
                "maxLength": 128
            },
            "groupBy": {
                "type": "string",
                "maxLength": 32,
                "enum": ["level", "service", "event", "component", "contractId", "capabilityId"]
            },
            "minLevel": {
                "type": "string",
                "maxLength": 5
            },
            "timeField": {
                "type": "string",
                "maxLength": 10,
                "enum": ["time", "receivedAt"]
            }
        },
        "required": ["groupBy"]
    },
    "output": {
        "type": "object",
        "properties": {
            "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "groups": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "count": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        }
                    },
                    "required": ["key", "count"]
                },
                "maxItems": 50
            },
            "truncated": {
                "type": "boolean"
            }
        },
        "required": ["total", "groups", "truncated"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/observability/logs/aggregate",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
