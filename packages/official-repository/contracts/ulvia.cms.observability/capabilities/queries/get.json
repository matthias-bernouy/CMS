{
    "id": "logs.get",
    "description": "Read one retained log entry in the authenticated instance.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 36,
                "format": "uuid"
            }
        },
        "required": ["id"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 36,
                "format": "uuid"
            },
            "time": {
                "type": "string",
                "maxLength": 32,
                "format": "date-time"
            },
            "level": {
                "type": "string",
                "maxLength": 5,
                "enum": ["trace", "debug", "info", "warn", "error", "fatal"]
            },
            "event": {
                "type": "string",
                "maxLength": 128
            },
            "component": {
                "type": "string",
                "maxLength": 128
            },
            "requestId": {
                "type": "string",
                "maxLength": 128
            },
            "invocationId": {
                "type": "string",
                "maxLength": 128
            },
            "contractId": {
                "type": "string",
                "maxLength": 128
            },
            "capabilityId": {
                "type": "string",
                "maxLength": 128
            },
            "durationMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400000
            },
            "instanceId": {
                "type": "string",
                "maxLength": 128
            },
            "service": {
                "type": "string",
                "maxLength": 128
            },
            "receivedAt": {
                "type": "string",
                "maxLength": 32,
                "format": "date-time"
            },
            "attributes": {
                "type": "map",
                "maxKeyLength": 128,
                "maxProperties": 24,
                "values": {
                    "type": "string",
                    "maxLength": 1024
                }
            },
            "error": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "message": {
                        "type": "string",
                        "maxLength": 2048
                    },
                    "stack": {
                        "type": "string",
                        "maxLength": 2048
                    }
                },
                "required": ["name", "message"]
            },
            "sourceEntryId": {
                "type": "string",
                "maxLength": 36,
                "format": "uuid"
            }
        },
        "required": ["id", "time", "level", "event", "instanceId", "service", "receivedAt", "attributes"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/observability/logs/get",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503,
                    "NOT_FOUND": 404
                }
            }
        }
    ]
}
