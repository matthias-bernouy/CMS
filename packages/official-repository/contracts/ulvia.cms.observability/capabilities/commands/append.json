{
    "id": "logs.append",
    "description": "Append an authenticated machine batch. Instance and emitter identity are supplied by verified invocation context.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "entries": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 36,
                            "format": "uuid"
                        },
                        "time": {
                            "type": "string",
                            "maxLength": 32,
                            "format": "date-time"
                        },
                        "level": {
                            "type": "string",
                            "maxLength": 5,
                            "enum": ["trace", "debug", "info", "warn", "error", "fatal"]
                        },
                        "event": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "component": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "requestId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "invocationId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "contractId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "capabilityId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "durationMs": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 86400000
                        },
                        "attributes": {
                            "type": "map",
                            "maxKeyLength": 128,
                            "maxProperties": 24,
                            "values": {
                                "type": "string",
                                "maxLength": 1024
                            }
                        },
                        "error": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "maxLength": 2048
                                },
                                "message": {
                                    "type": "string",
                                    "maxLength": 2048
                                },
                                "stack": {
                                    "type": "string",
                                    "maxLength": 2048
                                }
                            },
                            "required": ["name", "message"]
                        },
                        "traceId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "parentInvocationId": {
                            "type": "string",
                            "maxLength": 128
                        }
                    },
                    "required": ["id", "time", "level", "event", "attributes"]
                },
                "maxItems": 50,
                "minItems": 1
            }
        },
        "required": ["entries"]
    },
    "output": {
        "type": "object",
        "properties": {
            "accepted": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "stored": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "duplicates": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["accepted", "stored", "duplicates"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        },
        {
            "code": "FORBIDDEN",
            "retryable": false
        },
        {
            "code": "ENTRY_CONFLICT",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/observability/logs/append",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503,
                    "FORBIDDEN": 403,
                    "ENTRY_CONFLICT": 409
                }
            }
        }
    ]
}
