{
    "id": "publication-begin",
    "description": "Stage a bounded account-authorized publication manifest; assets are uploaded separately.",
    "access": "authenticated",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "natural",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "manifest": {
                "type": "binary",
                "maxBytes": 20971520
            },
            "namespaceRevision": {
                "type": "integer",
                "minimum": 1
            }
        },
        "required": ["namespace", "manifest", "namespaceRevision"]
    },
    "output": {
        "type": "object",
        "properties": {
            "uploadId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 36,
                "format": "uuid"
            },
            "expiresAt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
            },
            "uploadedAssetIds": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                }
            }
        },
        "required": ["uploadId", "expiresAt", "uploadedAssetIds"]
    },
    "errors": [
        {
            "code": "REJECTED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "ACTOR_UNAVAILABLE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/v1/uploads",
            "input": {
                "headers": {
                    "x-repository-namespace": {
                        "property": "namespace",
                        "encoding": "uri-component"
                    },
                    "x-repository-namespace-revision": {
                        "property": "namespaceRevision",
                        "encoding": "uri-component"
                    }
                },
                "body": {
                    "binaryProperty": "manifest"
                }
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "REJECTED": 409,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503,
                    "ACTOR_UNAVAILABLE": 403
                }
            }
        }
    ],
    "docs": ["overview.md"]
}
