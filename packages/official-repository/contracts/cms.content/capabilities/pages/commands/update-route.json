{
    "id": "pages.update-route",
    "description": "Update one localized Page route with optimistic revision control.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Current revision returned by the corresponding read operation. Read again after a conflict."
            },
            "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 35
            },
            "path": {
                "type": "string",
                "maxLength": 2048
            }
        },
        "required": ["id", "expectedRevision", "language", "path"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 200
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "path": {
                "type": "string",
                "maxLength": 2048
            },
            "routes": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "object",
                    "properties": {
                        "language": {
                            "type": "string",
                            "maxLength": 35
                        },
                        "path": {
                            "type": "string",
                            "maxLength": 2048
                        },
                        "primary": {
                            "type": "boolean"
                        }
                    },
                    "required": ["language", "path", "primary"]
                }
            }
        },
        "required": ["id", "revision", "path", "routes"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "PATH_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_PAGE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    },
                    "diagnostics": {
                        "type": "array",
                        "maxItems": 16,
                        "items": {
                            "type": "object",
                            "properties": {
                                "code": {
                                    "type": "string",
                                    "maxLength": 128
                                },
                                "severity": {
                                    "type": "string",
                                    "enum": ["error", "warning"],
                                    "maxLength": 7
                                },
                                "message": {
                                    "type": "string",
                                    "maxLength": 2048
                                },
                                "location": {
                                    "type": "object",
                                    "properties": {
                                        "blocId": {
                                            "type": "string",
                                            "maxLength": 512
                                        },
                                        "path": {
                                            "type": "string",
                                            "maxLength": 2048
                                        },
                                        "attribute": {
                                            "type": "string",
                                            "maxLength": 64
                                        }
                                    },
                                    "required": []
                                },
                                "relatedResources": {
                                    "type": "array",
                                    "maxItems": 8,
                                    "items": {
                                        "type": "string",
                                        "maxLength": 200
                                    }
                                },
                                "suggestion": {
                                    "type": "string",
                                    "maxLength": 512
                                }
                            },
                            "required": ["code", "severity", "message"]
                        }
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/pages/update-route",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "PATH_CONFLICT": 409,
                    "INVALID_PAGE": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_pages_update_route",
                "description": "Change a Page\u2019s route for one language using its current expectedRevision."
            }
        }
    ],
    "docs": ["overview.md", "pages/create-and-publish.md", "pages/verify.md", "pages/revisions.md"]
}
