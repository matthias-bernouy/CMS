{
    "id": "update",
    "description": "Rename or move one item when its revision is still current.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "fileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
            },
            "parentId": {
                "type": "string",
                "nullable": true,
                "maxLength": 96
            }
        },
        "required": [
            "fileId",
            "expectedRevision"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 96
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "type": {
                "type": "string",
                "enum": [
                    "folder",
                    "file"
                ],
                "maxLength": 6
            },
            "name": {
                "type": "string",
                "maxLength": 255
            },
            "parentId": {
                "type": "string",
                "nullable": true,
                "maxLength": 96
            },
            "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10737418240
            },
            "mimeType": {
                "type": "string",
                "maxLength": 255
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "updatedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            }
        },
        "required": [
            "id",
            "revision",
            "type",
            "name",
            "parentId",
            "createdAt",
            "updatedAt"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "NAME_CONFLICT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "PATCH",
        "path": "/v1/cms/files/{fileId}",
        "input": {
            "path": {
                "fileId": "fileId"
            },
            "body": {
                "properties": [
                    "expectedRevision",
                    "name",
                    "parentId"
                ]
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_FOUND": 404,
                "NAME_CONFLICT": 409,
                "REVISION_CONFLICT": 409,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
