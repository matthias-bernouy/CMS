{
    "id": "workspace.upload.create",
    "description": "Create an upload session in the server-managed site workspace.",
    "access": "admin",
    "behavior": { "effect": "command", "execution": "sync", "idempotency": "none" },
    "input": {
        "type": "object",
        "properties": {
            "filename": { "type": "string", "minLength": 1, "maxLength": 255 },
            "contentType": { "type": "string", "maxLength": 255, "nullable": true },
            "size": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
            "visibility": { "type": "string", "maxLength": 7, "enum": ["private", "public"] },
            "imageProfile": { "type": "string", "maxLength": 10, "nullable": true, "enum": ["thumbnail", "responsive"] },
            "fileId": { "type": "string", "maxLength": 128, "nullable": true }
        },
        "required": ["filename", "size"]
    },
    "output": {
        "type": "object",
        "properties": {
            "uploadId": { "type": "string", "maxLength": 128 },
            "uploadToken": { "type": "string", "minLength": 20, "maxLength": 512, "sensitive": true },
            "expiresAt": { "type": "string", "maxLength": 64 },
            "maxBytes": { "type": "integer", "minimum": 1 }
        },
        "required": ["uploadId", "uploadToken", "expiresAt", "maxBytes"]
    },
    "errors": [
        { "code": "INVALID_INPUT", "retryable": false },
        { "code": "NOT_FOUND", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true },
        { "code": "QUOTA_EXCEEDED", "retryable": false }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/workspace.upload.create",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503, "QUOTA_EXCEEDED": 409 }
        }
    }
}
