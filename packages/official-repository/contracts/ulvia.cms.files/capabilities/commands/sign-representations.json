{
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none"
    },
    "id": "representations.sign",
    "description": "Mint temporary private URLs for available image representations.",
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "maxLength": 512,
                "minLength": 20,
                "sensitive": true
            },
            "fileId": {
                "type": "string",
                "maxLength": 128
            },
            "generation": {
                "type": "string",
                "maxLength": 128
            },
            "expiresIn": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
            }
        },
        "required": [
            "namespaceId",
            "namespaceKey",
            "fileId",
            "generation",
            "expiresIn"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "expiresAt": {
                "type": "string",
                "maxLength": 64
            },
            "representations": {
                "type": "array",
                "maxItems": 10,
                "items": {
                    "type": "object",
                    "properties": {
                        "profile": {
                            "type": "string",
                            "maxLength": 10,
                            "enum": [
                                "thumbnail",
                                "responsive"
                            ]
                        },
                        "width": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 16384
                        },
                        "height": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 16384
                        },
                        "mimeType": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "url": {
                            "type": "string",
                            "maxLength": 4096
                        }
                    },
                    "required": [
                        "profile",
                        "width",
                        "height",
                        "mimeType",
                        "url"
                    ]
                }
            }
        },
        "required": [
            "expiresAt",
            "representations"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/files/{fileId}/{generation}/representations/sign",
        "input": {
            "path": {
                "fileId": "fileId",
                "generation": "generation"
            },
            "body": {
                "properties": [
                    "namespaceId",
                    "namespaceKey",
                    "expiresIn"
                ]
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_AUTHORIZED": 403,
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
