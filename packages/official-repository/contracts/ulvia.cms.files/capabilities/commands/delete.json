{
    "id": "delete",
    "description": "Delete one item when its revision is still current.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "fileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "recursive": {
                "type": "boolean"
            }
        },
        "required": [
            "fileId",
            "expectedRevision"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 96
            },
            "deleted": {
                "type": "boolean"
            },
            "deletedFileCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
            }
        },
        "required": [
            "id",
            "deleted",
            "deletedFileCount"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "FOLDER_NOT_EMPTY",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "DELETE",
        "path": "/v1/cms/files/{fileId}",
        "input": {
            "path": {
                "fileId": "fileId"
            },
            "query": {
                "expectedRevision": "expectedRevision",
                "recursive": "recursive"
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_FOUND": 404,
                "REVISION_CONFLICT": 409,
                "FOLDER_NOT_EMPTY": 409,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
