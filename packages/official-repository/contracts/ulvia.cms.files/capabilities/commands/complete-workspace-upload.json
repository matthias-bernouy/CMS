{
    "id": "workspace.upload.complete",
    "description": "Complete an upload in the server-managed site workspace.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none"
    },
    "input": {
        "type": "object",
        "properties": {
            "uploadId": {
                "type": "string",
                "maxLength": 128
            }
        },
        "required": ["uploadId"]
    },
    "output": {
        "type": "null"
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "UPLOAD_NOT_READY",
            "retryable": true
        },
        {
            "code": "QUOTA_EXCEEDED",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/workspace.upload.complete",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "UPLOAD_NOT_READY": 409,
                    "QUOTA_EXCEEDED": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "files_workspace_upload_complete",
                "description": "Finalize a completed byte upload and return the current site file listing. Upload all bytes before calling this tool."
            }
        }
    ]
}
