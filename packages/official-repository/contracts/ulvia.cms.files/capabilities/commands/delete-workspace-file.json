{
    "id": "workspace.files.delete",
    "description": "Delete every generation of a file in the server-managed site workspace.",
    "access": "admin",
    "behavior": { "effect": "command", "execution": "sync", "idempotency": "none" },
    "input": {
        "type": "object",
        "properties": { "fileId": { "type": "string", "maxLength": 128 } },
        "required": ["fileId"]
    },
    "output": { "type": "null" },
    "errors": [
        { "code": "INVALID_INPUT", "retryable": false },
        { "code": "NOT_FOUND", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/workspace.files.delete",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 }
        }
    }
}
