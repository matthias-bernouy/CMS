{
    "id": "list",
    "description": "List one bounded folder of the author file library.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "parentId": {
                "type": "string",
                "maxLength": 96
            },
            "search": {
                "type": "string",
                "maxLength": 200
            },
            "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "revision": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "folder",
                                "file"
                            ],
                            "maxLength": 6
                        },
                        "name": {
                            "type": "string",
                            "maxLength": 255
                        },
                        "parentId": {
                            "type": "string",
                            "nullable": true,
                            "maxLength": 96
                        },
                        "size": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10737418240
                        },
                        "mimeType": {
                            "type": "string",
                            "maxLength": 255
                        },
                        "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        },
                        "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "maxLength": 40
                        }
                    },
                    "required": [
                        "id",
                        "revision",
                        "type",
                        "name",
                        "parentId",
                        "createdAt",
                        "updatedAt"
                    ]
                }
            },
            "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            },
            "hasMore": {
                "type": "boolean"
            }
        },
        "required": [
            "items",
            "total",
            "page",
            "limit",
            "hasMore"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/v1/cms/files",
        "input": {
            "query": {
                "parentId": "parentId",
                "search": "search",
                "page": "page",
                "limit": "limit"
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
