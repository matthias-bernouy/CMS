{
    "id": "get",
    "description": "Read one file or folder by its stable identity.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "fileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": [
            "fileId"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 96
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "type": {
                "type": "string",
                "enum": [
                    "folder",
                    "file"
                ],
                "maxLength": 6
            },
            "name": {
                "type": "string",
                "maxLength": 255
            },
            "parentId": {
                "type": "string",
                "nullable": true,
                "maxLength": 96
            },
            "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10737418240
            },
            "mimeType": {
                "type": "string",
                "maxLength": 255
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "updatedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            }
        },
        "required": [
            "id",
            "revision",
            "type",
            "name",
            "parentId",
            "createdAt",
            "updatedAt"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/v1/cms/files/{fileId}",
        "input": {
            "path": {
                "fileId": "fileId"
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
