{
    "id": "workspace.get",
    "description": "Read the server-managed site file workspace without disclosing its namespace credential.",
    "access": "admin",
    "behavior": { "effect": "query", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "offset": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 128 },
                    "name": { "type": "string", "maxLength": 160 },
                    "defaultVisibility": { "type": "string", "maxLength": 7, "enum": ["private", "public"] },
                    "createdAt": { "type": "string", "maxLength": 64 },
                    "createdBy": {
                        "type": "object",
                        "properties": {
                            "kind": {
                                "type": "string",
                                "maxLength": 13,
                                "enum": ["administrator", "provider", "system"]
                            },
                            "id": { "type": "string", "maxLength": 256 }
                        },
                        "required": ["kind", "id"]
                    },
                    "quota": {
                        "type": "object",
                        "properties": {
                            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                            "maxFiles": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
                        },
                        "required": ["maxBytes", "maxFiles"]
                    }
                },
                "required": ["id", "name", "defaultVisibility", "createdAt", "createdBy", "quota"]
            },
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "namespaceId": { "type": "string", "maxLength": 128 },
                        "fileId": { "type": "string", "maxLength": 128 },
                        "generation": { "type": "string", "maxLength": 128 },
                        "name": { "type": "string", "maxLength": 255 },
                        "mimeType": { "type": "string", "maxLength": 255 },
                        "size": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
                        "visibility": { "type": "string", "maxLength": 7, "enum": ["private", "public"] },
                        "url": { "type": "string", "maxLength": 4096 },
                        "width": { "type": "integer", "minimum": 1, "maximum": 16384, "nullable": true },
                        "height": { "type": "integer", "minimum": 1, "maximum": 16384, "nullable": true },
                        "variants": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                                "type": "object",
                                "properties": {
                                    "profile": {
                                        "type": "string",
                                        "maxLength": 10,
                                        "enum": ["thumbnail", "responsive"]
                                    },
                                    "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
                                    "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
                                    "mimeType": { "type": "string", "maxLength": 64 },
                                    "url": { "type": "string", "maxLength": 4096 }
                                },
                                "required": ["profile", "width", "height", "mimeType", "url"]
                            }
                        }
                    },
                    "required": ["namespaceId", "fileId", "generation", "name", "mimeType", "size", "visibility", "url"]
                }
            },
            "offset": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        },
        "required": ["namespace", "items", "offset", "limit"]
    },
    "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
    "binding": {
        "transport": "http",
        "method": "QUERY",
        "path": "/workspace.get",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "INVALID_INPUT": 422, "CORE_UNAVAILABLE": 503 }
        }
    }
}
