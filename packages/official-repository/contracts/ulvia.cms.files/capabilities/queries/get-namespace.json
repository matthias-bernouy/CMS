{
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "id": "namespace.get",
    "description": "Read one namespace with a management credential.",
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "maxLength": 512,
                "minLength": 20,
                "sensitive": true
            }
        },
        "required": [
            "namespaceId",
            "namespaceKey"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 128
            },
            "name": {
                "type": "string",
                "maxLength": 160
            },
            "defaultVisibility": {
                "type": "string",
                "maxLength": 7,
                "enum": [
                    "private",
                    "public"
                ]
            },
            "createdAt": {
                "type": "string",
                "maxLength": 64
            },
            "quota": {
                "type": "object",
                "properties": {
                    "maxBytes": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "maxFiles": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "maxBytes",
                    "maxFiles"
                ]
            }
        },
        "required": [
            "id",
            "name",
            "defaultVisibility",
            "createdAt",
            "quota"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/namespaces/{namespaceId}",
        "input": {
            "path": {
                "namespaceId": "namespaceId"
            },
            "headers": {
                "namespace-key": "namespaceKey"
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_AUTHORIZED": 403,
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
