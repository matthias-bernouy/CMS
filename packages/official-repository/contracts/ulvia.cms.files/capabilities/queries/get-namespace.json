{
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "id": "namespace.get",
    "description": "Read one namespace with a management credential.",
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "maxLength": 512,
                "minLength": 20,
                "sensitive": true
            }
        },
        "required": ["namespaceId", "namespaceKey"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 128
            },
            "name": {
                "type": "string",
                "maxLength": 160
            },
            "defaultVisibility": {
                "type": "string",
                "maxLength": 7,
                "enum": ["private", "public"]
            },
            "createdAt": {
                "type": "string",
                "maxLength": 64
            },
            "quota": {
                "type": "object",
                "properties": {
                    "maxBytes": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "maxFiles": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": ["maxBytes", "maxFiles"]
            }
        },
        "required": ["id", "name", "defaultVisibility", "createdAt", "quota"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/namespaces/{namespaceId}",
            "input": {
                "path": {
                    "namespaceId": "namespaceId"
                },
                "headers": {
                    "namespace-key": {
                        "property": "namespaceKey",
                        "encoding": "uri-component"
                    }
                }
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_AUTHORIZED": 403,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ],
    "docs": ["overview.md", "site-files.md"]
}
