{
    "access": "public",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": false
    },
    "id": "files.read",
    "description": "Stream one immutable public or signed private file generation.",
    "input": {
        "type": "object",
        "properties": {
            "fileId": {
                "type": "string",
                "maxLength": 128
            },
            "generation": {
                "type": "string",
                "maxLength": 128
            },
            "access": {
                "type": "string",
                "maxLength": 2048,
                "sensitive": true
            },
            "range": {
                "type": "string",
                "maxLength": 128
            },
            "ifRange": {
                "type": "string",
                "maxLength": 160
            }
        },
        "required": ["fileId", "generation"]
    },
    "output": {
        "type": "binary",
        "maxBytes": 10737418240
    },
    "errors": [
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "RANGE_NOT_SATISFIABLE",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/files/{fileId}/{generation}",
            "input": {
                "path": {
                    "fileId": "fileId",
                    "generation": "generation"
                },
                "query": {
                    "access": "access"
                },
                "headers": {
                    "range": {
                        "property": "range",
                        "encoding": "http-field"
                    },
                    "if-range": {
                        "property": "ifRange",
                        "encoding": "http-field"
                    }
                }
            },
            "response": {
                "successStatuses": [200, 206],
                "contentTypes": [],
                "errorStatuses": {
                    "NOT_AUTHORIZED": 403,
                    "NOT_FOUND": 404,
                    "RANGE_NOT_SATISFIABLE": 416,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
