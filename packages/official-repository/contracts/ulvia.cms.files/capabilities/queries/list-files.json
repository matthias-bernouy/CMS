{
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "id": "files.list",
    "description": "List immutable file generations in a namespace.",
    "input": {
        "type": "object",
        "properties": {
            "namespaceId": {
                "type": "string",
                "maxLength": 128
            },
            "namespaceKey": {
                "type": "string",
                "maxLength": 512,
                "minLength": 20,
                "sensitive": true
            },
            "offset": {
                "type": "integer",
                "minimum": 0
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": [
            "namespaceId",
            "namespaceKey"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "namespaceId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "fileId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "generation": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "name": {
                            "type": "string",
                            "maxLength": 255
                        },
                        "mimeType": {
                            "type": "string",
                            "maxLength": 255
                        },
                        "size": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10737418240
                        },
                        "visibility": {
                            "type": "string",
                            "maxLength": 7,
                            "enum": [
                                "private",
                                "public"
                            ]
                        },
                        "url": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "width": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 16384,
                            "nullable": true
                        },
                        "height": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 16384,
                            "nullable": true
                        },
                        "variants": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                                "type": "object",
                                "properties": {
                                    "profile": {
                                        "type": "string",
                                        "maxLength": 10,
                                        "enum": [
                                            "thumbnail",
                                            "responsive"
                                        ]
                                    },
                                    "width": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 16384
                                    },
                                    "height": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 16384
                                    },
                                    "mimeType": {
                                        "type": "string",
                                        "maxLength": 64
                                    },
                                    "url": {
                                        "type": "string",
                                        "maxLength": 4096
                                    }
                                },
                                "required": [
                                    "profile",
                                    "width",
                                    "height",
                                    "mimeType",
                                    "url"
                                ]
                            }
                        }
                    },
                    "required": [
                        "namespaceId",
                        "fileId",
                        "generation",
                        "name",
                        "mimeType",
                        "size",
                        "visibility",
                        "url"
                    ]
                }
            },
            "offset": {
                "type": "integer",
                "minimum": 0
            },
            "limit": {
                "type": "integer",
                "minimum": 1
            }
        },
        "required": [
            "items",
            "offset",
            "limit"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_AUTHORIZED",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/namespaces/{namespaceId}/files",
        "input": {
            "path": {
                "namespaceId": "namespaceId"
            },
            "headers": {
                "namespace-key": "namespaceKey"
            },
            "query": {
                "offset": "offset",
                "limit": "limit"
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_AUTHORIZED": 403,
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
