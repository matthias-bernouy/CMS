{
    "kind": "contract",
    "protocol": "ulvia-provider/v1",
    "schemaDialect": "ulvia-schema/v1",
    "contractId": "ulvia.cms.files",
    "name": "CMS Files",
    "description": "Browse and organize the author file library while binary upload, replacement and download remain dedicated CMS transports.",
    "version": "1.0.0",
    "publisherId": "ulvia.official",
    "catalogue": { "icon": "media", "categories": ["administration", "content"] },
    "capabilities": [
        {
            "id": "list",
            "description": "List one bounded folder of the author file library.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "parentId": { "type": "string", "maxLength": 96 },
                    "search": { "type": "string", "maxLength": 200 },
                    "page": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                    "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
                },
                "required": []
            },
            "output": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string", "maxLength": 96 },
                                "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                                "type": { "type": "string", "enum": ["folder", "file"], "maxLength": 6 },
                                "name": { "type": "string", "maxLength": 255 },
                                "parentId": { "type": "string", "nullable": true, "maxLength": 96 },
                                "size": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
                                "mimeType": { "type": "string", "maxLength": 255 },
                                "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                                "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                            },
                            "required": ["id", "revision", "type", "name", "parentId", "createdAt", "updatedAt"]
                        }
                    },
                    "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "page": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
                    "hasMore": { "type": "boolean" }
                },
                "required": ["items", "total", "page", "limit", "hasMore"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/files",
                "input": { "query": { "parentId": "parentId", "search": "search", "page": "page", "limit": "limit" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "get",
            "description": "Read one file or folder by its stable identity.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": { "fileId": { "type": "string", "minLength": 1, "maxLength": 96 } },
                "required": ["fileId"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 96 },
                    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "type": { "type": "string", "enum": ["folder", "file"], "maxLength": 6 },
                    "name": { "type": "string", "maxLength": 255 },
                    "parentId": { "type": "string", "nullable": true, "maxLength": 96 },
                    "size": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
                    "mimeType": { "type": "string", "maxLength": 255 },
                    "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                    "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                },
                "required": ["id", "revision", "type", "name", "parentId", "createdAt", "updatedAt"]
            },
            "errors": [{ "code": "NOT_FOUND", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/files/{fileId}",
                "input": { "path": { "fileId": "fileId" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "NOT_FOUND": 404, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "create-folder",
            "description": "Create one folder in the author file library.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "parentId": { "type": "string", "nullable": true, "maxLength": 96 }
                },
                "required": ["name"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 96 },
                    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "type": { "type": "string", "enum": ["folder"], "maxLength": 6 },
                    "name": { "type": "string", "maxLength": 255 },
                    "parentId": { "type": "string", "nullable": true, "maxLength": 96 },
                    "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                    "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                },
                "required": ["id", "revision", "type", "name", "parentId", "createdAt", "updatedAt"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NAME_CONFLICT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "POST",
                "path": "/v1/cms/files/folders",
                "input": { "body": true },
                "response": { "successStatuses": [201], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NAME_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "update",
            "description": "Rename or move one item when its revision is still current.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "fileId": { "type": "string", "minLength": 1, "maxLength": 96 },
                    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "parentId": { "type": "string", "nullable": true, "maxLength": 96 }
                },
                "required": ["fileId", "expectedRevision"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 96 },
                    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "type": { "type": "string", "enum": ["folder", "file"], "maxLength": 6 },
                    "name": { "type": "string", "maxLength": 255 },
                    "parentId": { "type": "string", "nullable": true, "maxLength": 96 },
                    "size": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
                    "mimeType": { "type": "string", "maxLength": 255 },
                    "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                    "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                },
                "required": ["id", "revision", "type", "name", "parentId", "createdAt", "updatedAt"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "NAME_CONFLICT", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "PATCH",
                "path": "/v1/cms/files/{fileId}",
                "input": { "path": { "fileId": "fileId" }, "body": { "properties": ["expectedRevision", "name", "parentId"] } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "NAME_CONFLICT": 409, "REVISION_CONFLICT": 409, "CORE_UNAVAILABLE": 503 } }
            }
        },
        {
            "id": "delete",
            "description": "Delete one item when its revision is still current.",
            "access": "admin",
            "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
            "input": {
                "type": "object",
                "properties": {
                    "fileId": { "type": "string", "minLength": 1, "maxLength": 96 },
                    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "recursive": { "type": "boolean" }
                },
                "required": ["fileId", "expectedRevision"]
            },
            "output": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "maxLength": 96 },
                    "deleted": { "type": "boolean" },
                    "deletedFileCount": { "type": "integer", "minimum": 0, "maximum": 1000000 }
                },
                "required": ["id", "deleted", "deletedFileCount"]
            },
            "errors": [{ "code": "INVALID_INPUT", "retryable": false }, { "code": "NOT_FOUND", "retryable": false }, { "code": "REVISION_CONFLICT", "retryable": false }, { "code": "FOLDER_NOT_EMPTY", "retryable": false }, { "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "DELETE",
                "path": "/v1/cms/files/{fileId}",
                "input": { "path": { "fileId": "fileId" }, "query": { "expectedRevision": "expectedRevision", "recursive": "recursive" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "INVALID_INPUT": 422, "NOT_FOUND": 404, "REVISION_CONFLICT": 409, "FOLDER_NOT_EMPTY": 409, "CORE_UNAVAILABLE": 503 } }
            }
        }
    ]
}
