{
    "id": "editor-catalogue",
    "description": "List the author-visible Blocs and bounded insertion metadata available to one Page surface.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "surface": {
                "type": "string",
                "enum": [
                    "control",
                    "delivery"
                ],
                "maxLength": 8
            }
        },
        "required": [
            "surface"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "name": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "group": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 2000
                        },
                        "kind": {
                            "type": "string",
                            "enum": [
                                "component",
                                "composition"
                            ],
                            "maxLength": 11
                        },
                        "ownership": {
                            "type": "string",
                            "enum": [
                                "code-managed",
                                "site-builder"
                            ],
                            "maxLength": 12
                        },
                        "order": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        },
                        "defaultContent": {
                            "type": "string",
                            "maxLength": 1048576
                        },
                        "authoringJson": {
                            "type": "string",
                            "maxLength": 1048576
                        }
                    },
                    "required": [
                        "id",
                        "name",
                        "group",
                        "description",
                        "kind",
                        "ownership",
                        "order",
                        "defaultContent",
                        "authoringJson"
                    ]
                }
            }
        },
        "required": [
            "items"
        ]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/editor-catalogue",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
