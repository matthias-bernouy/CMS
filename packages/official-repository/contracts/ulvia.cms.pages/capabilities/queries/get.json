{
    "id": "get",
    "description": "Read one complete editable Page by stable identity.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
            }
        },
        "required": [
            "id"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 200
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "surface": {
                "type": "string",
                "enum": [
                    "control",
                    "delivery"
                ],
                "maxLength": 8
            },
            "path": {
                "type": "string",
                "maxLength": 2048
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
            },
            "description": {
                "type": "string",
                "maxLength": 200
            },
            "content": {
                "type": "string",
                "maxLength": 1048576
            },
            "tags": {
                "type": "array",
                "maxItems": 64,
                "items": {
                    "type": "string",
                    "maxLength": 64
                }
            },
            "visible": {
                "type": "boolean"
            },
            "routes": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "object",
                    "properties": {
                        "language": { "type": "string", "maxLength": 35 },
                        "path": { "type": "string", "maxLength": 2048 },
                        "primary": { "type": "boolean" }
                    },
                    "required": ["language", "path", "primary"]
                }
            },
            "seoEntries": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "object",
                    "properties": {
                        "language": { "type": "string", "maxLength": 35 },
                        "title": { "type": "string", "maxLength": 70 },
                        "description": { "type": "string", "maxLength": 200 }
                    },
                    "required": ["language", "title", "description"]
                }
            }
        },
        "required": [
            "id",
            "revision",
            "surface",
            "path",
            "title",
            "description",
            "content",
            "tags",
            "visible",
            "routes",
            "seoEntries"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/v1/cms/pages/{id}",
        "input": {
            "path": {
                "id": "id"
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
