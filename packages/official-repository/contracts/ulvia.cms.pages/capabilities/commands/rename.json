{
    "id": "rename",
    "description": "Rename one Page with optimistic revision control and naturally idempotent retries.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            }
        },
        "required": [
            "id",
            "title",
            "expectedRevision"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 200
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "surface": {
                "type": "string",
                "enum": [
                    "control",
                    "delivery"
                ],
                "maxLength": 8
            },
            "path": {
                "type": "string",
                "maxLength": 2048
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
            },
            "visible": {
                "type": "boolean"
            }
        },
        "required": [
            "id",
            "revision",
            "surface",
            "path",
            "title",
            "visible"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": true
        },
        {
            "code": "INVALID_TITLE",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "PATCH",
        "path": "/v1/cms/pages/{id}",
        "input": {
            "path": {
                "id": "id"
            },
            "body": {
                "properties": [
                    "title",
                    "expectedRevision"
                ]
            }
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "REVISION_CONFLICT": 409,
                "INVALID_TITLE": 422,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
