{
    "id": "update-languages",
    "description": "Update the default, available and active site languages with revision control.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
            },
            "additionalLanguages": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                }
            },
            "activeLanguages": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                }
            }
        },
        "required": [
            "expectedRevision",
            "language",
            "additionalLanguages",
            "activeLanguages"
        ]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "language": {
                "type": "string",
                "maxLength": 64
            },
            "additionalLanguages": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "string",
                    "maxLength": 64
                }
            },
            "activeLanguages": {
                "type": "array",
                "maxItems": 32,
                "items": {
                    "type": "string",
                    "maxLength": 64
                }
            }
        },
        "required": [
            "revision",
            "language",
            "additionalLanguages",
            "activeLanguages"
        ]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "MIGRATION_IN_PROGRESS",
            "retryable": true
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/update-languages",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [
                200
            ],
            "contentTypes": [
                "application/json"
            ],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "REVISION_CONFLICT": 409,
                "MIGRATION_IN_PROGRESS": 423,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
