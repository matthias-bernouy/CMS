{
    "id": "prepare-collection",
    "description": "Validate and build a complete collection source snapshot before publishing. Read ulvia://cms/collection-authoring for the source format.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none"
    },
    "input": {
        "type": "object",
        "properties": {
            "sourceJson": {
                "type": "string",
                "maxLength": 1048576,
                "sensitive": true,
                "description": "JSON object with files: [{path, content}] and optional exact asset references. Read ulvia://cms/collection-authoring first. Maximum 1 MiB of source JSON."
            }
        },
        "required": ["sourceJson"]
    },
    "output": {
        "type": "object",
        "properties": {
            "repositoryId": {
                "type": "string",
                "maxLength": 96
            },
            "publisherId": {
                "type": "string",
                "maxLength": 96
            },
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "version": {
                "type": "string",
                "maxLength": 64
            },
            "digest": {
                "type": "string",
                "maxLength": 71
            },
            "preparationId": {
                "type": "string",
                "maxLength": 36
            },
            "sourceDigest": {
                "type": "string",
                "maxLength": 71
            },
            "approvedBrowserRiskDigest": {
                "type": "string",
                "maxLength": 71
            },
            "browserRisk": {
                "type": "string",
                "maxLength": 64
            },
            "valid": {
                "type": "boolean",
                "description": "Publish only when valid is true and a preparationId and digest were returned."
            },
            "diagnostics": {
                "type": "array",
                "maxItems": 16,
                "items": {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": "string",
                            "maxLength": 2048
                        }
                    },
                    "required": ["message"]
                }
            }
        },
        "required": ["valid", "diagnostics"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/prepare-collection",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "repository_prepare_collection",
                "description": "Validate and build a complete collection source snapshot before publishing. Read ulvia://cms/collection-authoring for the source format."
            }
        }
    ]
}
