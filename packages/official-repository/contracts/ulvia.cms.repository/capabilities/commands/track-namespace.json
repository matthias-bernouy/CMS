{
    "id": "track-namespace",
    "description": "Remember an existing namespace owned by this instance signing key. No claim or key transfer is performed.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "natural",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": ["namespace"]
    },
    "output": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "repositoryId": {
                "type": "string",
                "maxLength": 128
            },
            "access": {
                "type": "string",
                "enum": ["owned", "transferred", "revoked", "missing"],
                "maxLength": 16
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "nullable": true
            },
            "publicKey": {
                "type": "string",
                "maxLength": 59,
                "nullable": true
            },
            "checkedAt": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time"
            }
        },
        "required": ["namespace", "repositoryId", "access", "revision", "publicKey", "checkedAt"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/track-namespace",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "repository_track_namespace",
                "description": "Remember an existing namespace owned by this instance signing key. No claim or key transfer is performed."
            }
        }
    ]
}
