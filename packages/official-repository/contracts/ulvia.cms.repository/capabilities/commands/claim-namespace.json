{
    "id": "claim-namespace",
    "description": "Claim a namespace using this instance signing identity. Existing ownership is preserved.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none"
    },
    "input": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "maxLength": 96
            }
        },
        "required": ["namespace"]
    },
    "output": {
        "type": "object",
        "properties": {
            "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "revision": {
                "type": "integer",
                "minimum": 1
            },
            "publicKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 59
            },
            "revoked": {
                "type": "boolean"
            },
            "updatedAt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
            },
            "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "enum": ["claim", "rotate", "revoke"]
            },
            "previousDigest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 71,
                "nullable": true
            }
        },
        "required": ["namespace", "revision", "publicKey", "revoked", "updatedAt", "action", "previousDigest"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/claim-namespace",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "repository_claim_namespace",
                "description": "Claim a namespace using this instance signing identity. Existing ownership is preserved."
            }
        }
    ]
}
