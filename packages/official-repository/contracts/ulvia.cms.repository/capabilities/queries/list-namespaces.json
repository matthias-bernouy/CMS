{
    "id": "list-namespaces",
    "description": "List remembered namespaces and verify current ownership live. Follow nextCursor; cached inventory never grants publication rights.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "cursor": {
                "type": "string",
                "maxLength": 96
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "namespace": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 96
                        },
                        "repositoryId": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "access": {
                            "type": "string",
                            "enum": ["owned", "transferred", "revoked", "missing"],
                            "maxLength": 16
                        },
                        "revision": {
                            "type": "integer",
                            "minimum": 1,
                            "nullable": true
                        },
                        "publicKey": {
                            "type": "string",
                            "maxLength": 59,
                            "nullable": true
                        },
                        "checkedAt": {
                            "type": "string",
                            "maxLength": 64,
                            "format": "date-time"
                        }
                    },
                    "required": ["namespace", "repositoryId", "access", "revision", "publicKey", "checkedAt"]
                }
            },
            "nextCursor": {
                "type": "string",
                "maxLength": 96,
                "nullable": true
            }
        },
        "required": ["items", "nextCursor"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/list-namespaces",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "repository_list_namespaces",
                "description": "List remembered namespaces and verify current ownership live. Follow nextCursor; cached inventory never grants publication rights."
            }
        }
    ]
}
