{
    "id": "publish-collection",
    "description": "Publish the exact prepared collection digest and retain its private sources in the Repository. This does not install the release on the site.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "idempotency": "none",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "preparationId": {
                "type": "string",
                "maxLength": 36
            },
            "expectedDigest": {
                "type": "string",
                "maxLength": 71
            }
        },
        "required": ["preparationId", "expectedDigest"]
    },
    "output": {
        "type": "object",
        "properties": {
            "repositoryId": {
                "type": "string",
                "maxLength": 96
            },
            "publisherId": {
                "type": "string",
                "maxLength": 96
            },
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "version": {
                "type": "string",
                "maxLength": 64
            },
            "digest": {
                "type": "string",
                "maxLength": 71
            },
            "kind": {
                "type": "string",
                "maxLength": 16
            },
            "added": {
                "type": "boolean"
            }
        },
        "required": ["repositoryId", "publisherId", "collectionId", "version", "digest", "kind", "added"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/publish-collection",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_publish_collection",
                "description": "Publish the exact prepared collection digest and retain its private sources in the Repository. This does not install the release on the site."
            }
        }
    ],
    "docs": ["overview.md", "collection-authoring.md"]
}
