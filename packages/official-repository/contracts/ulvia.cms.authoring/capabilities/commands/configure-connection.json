{
    "id": "configure-connection",
    "description": "Verify and store a personal access token for the configured Repository in the encrypted authoring secret namespace.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "execution": "sync",
        "sensitive": true,
        "idempotency": "none"
    },
    "input": {
        "type": "object",
        "properties": {
            "token": {
                "type": "string",
                "minLength": 47,
                "maxLength": 47,
                "sensitive": true
            }
        },
        "required": ["token"]
    },
    "output": {
        "type": "object",
        "properties": {
            "configured": {
                "type": "boolean"
            },
            "repositoryUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
            },
            "repositoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "nullable": true
            }
        },
        "required": ["configured", "repositoryUrl", "repositoryId"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/configure-connection",
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            },
            "input": {
                "body": true
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_configure_connection",
                "description": "Verify and store a personal access token for the configured Repository in the encrypted authoring secret namespace."
            }
        }
    ],
    "docs": ["overview.md", "collection-authoring.md"]
}
