{
    "id": "get-connection",
    "description": "Read the configured publication Repository origin and identity without revealing its PAT.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "configured": {
                "type": "boolean"
            },
            "repositoryUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
            },
            "repositoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "nullable": true
            }
        },
        "required": ["configured", "repositoryUrl", "repositoryId"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/get-connection",
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "authoring_get_connection",
                "description": "Read the configured publication Repository origin and identity without revealing its PAT."
            }
        }
    ],
    "docs": ["overview.md", "collection-authoring.md"]
}
