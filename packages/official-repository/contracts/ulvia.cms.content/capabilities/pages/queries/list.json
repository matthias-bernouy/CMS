{
    "id": "pages.list",
    "description": "List a bounded, stable Page batch for administration interfaces.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "cursor": {
                "type": "string",
                "maxLength": 256
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            },
            "query": {
                "type": "string",
                "maxLength": 120
            },
            "visibility": {
                "type": "string",
                "maxLength": 9,
                "enum": ["all", "published", "draft"]
            }
        },
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "path": {
                            "type": "string",
                            "maxLength": 2048
                        },
                        "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 70
                        },
                        "visible": {
                            "type": "boolean"
                        }
                    },
                    "required": ["id", "path", "title", "visible"]
                }
            },
            "nextCursor": {
                "type": "string",
                "maxLength": 256
            }
        },
        "required": ["items"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/pages/list",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_pages_list",
                "description": "Find this site\u2019s Pages by text or visibility. Follow the returned cursor and read a Page before changing it."
            }
        }
    ]
}
