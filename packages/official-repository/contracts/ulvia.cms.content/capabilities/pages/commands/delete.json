{
    "id": "pages.delete",
    "description": "Delete one Page with optimistic revision control.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Current revision returned by the corresponding read operation. Read again after a conflict."
            }
        },
        "required": ["id", "expectedRevision"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 200
            },
            "deleted": {
                "type": "boolean"
            }
        },
        "required": ["id", "deleted"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "PAGE_REFERENCED",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_PAGE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    },
                    "diagnostics": {
                        "type": "array",
                        "maxItems": 16,
                        "items": {
                            "type": "object",
                            "properties": {
                                "code": {
                                    "type": "string",
                                    "maxLength": 128
                                },
                                "severity": {
                                    "type": "string",
                                    "enum": ["error", "warning"],
                                    "maxLength": 7
                                },
                                "message": {
                                    "type": "string",
                                    "maxLength": 2048
                                },
                                "location": {
                                    "type": "object",
                                    "properties": {
                                        "blocId": {
                                            "type": "string",
                                            "maxLength": 200
                                        },
                                        "path": {
                                            "type": "string",
                                            "maxLength": 2048
                                        },
                                        "attribute": {
                                            "type": "string",
                                            "maxLength": 64
                                        }
                                    },
                                    "required": []
                                },
                                "relatedResources": {
                                    "type": "array",
                                    "maxItems": 8,
                                    "items": {
                                        "type": "string",
                                        "maxLength": 200
                                    }
                                },
                                "suggestion": {
                                    "type": "string",
                                    "maxLength": 512
                                }
                            },
                            "required": ["code", "severity", "message"]
                        }
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/pages/delete",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503,
                    "PAGE_REFERENCED": 409,
                    "INVALID_PAGE": 422
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_pages_delete",
                "description": "Delete a Page using its current expectedRevision. Read the Page first to verify the target."
            }
        }
    ],
    "docs": ["overview.md", "pages/create-and-publish.md", "pages/verify.md", "pages/revisions.md"]
}
