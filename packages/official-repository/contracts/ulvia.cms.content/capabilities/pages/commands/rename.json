{
    "id": "pages.rename",
    "description": "Rename one Page with optimistic revision control and naturally idempotent retries.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Current revision returned by the corresponding read operation. Read again after a conflict."
            }
        },
        "required": ["id", "title", "expectedRevision"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 200
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "path": {
                "type": "string",
                "maxLength": 2048
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
            },
            "visible": {
                "type": "boolean"
            }
        },
        "required": ["id", "revision", "path", "title", "visible"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "INVALID_TITLE",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/pages/rename",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "INVALID_TITLE": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_pages_rename",
                "description": "Rename an existing Page using its current expectedRevision."
            }
        }
    ]
}
