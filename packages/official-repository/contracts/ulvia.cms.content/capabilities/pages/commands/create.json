{
    "id": "pages.create",
    "description": "Create one Page.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
            },
            "content": {
                "type": "string",
                "maxLength": 1048576
            }
        },
        "required": ["path", "title"]
    },
    "output": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "maxLength": 200
            },
            "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "path": {
                "type": "string",
                "maxLength": 2048
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70
            },
            "description": {
                "type": "string",
                "maxLength": 200
            },
            "content": {
                "type": "string",
                "maxLength": 1048576
            },
            "tags": {
                "type": "array",
                "maxItems": 64,
                "items": {
                    "type": "string",
                    "maxLength": 64
                }
            },
            "visible": {
                "type": "boolean"
            }
        },
        "required": ["id", "revision", "path", "title", "description", "content", "tags", "visible"]
    },
    "errors": [
        {
            "code": "PATH_CONFLICT",
            "retryable": false
        },
        {
            "code": "INVALID_PAGE",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/pages/create",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [201],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "PATH_CONFLICT": 409,
                    "INVALID_PAGE": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_pages_create",
                "description": "Create a Page draft at a site path. Use installed Blocs from the editor catalogue; publication is a separate action."
            }
        }
    ]
}
