{
    "id": "delivery.read",
    "description": "Read one system delivery projection used by the public CMS surface.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "operation": {
                "type": "string",
                "maxLength": 64,
                "enum": [
                    "content.texts",
                    "content.revision",
                    "content.rendering-revision",
                    "content.editorial-route",
                    "content.renderable-page",
                    "content.renderable-pages",
                    "content.resolve-page-reference",
                    "content.resolve-page-paths",
                    "content.resolve-renderable-route",
                    "content.published-page",
                    "content.published-page-by-id",
                    "content.published-pages",
                    "content.resolve-published-route",
                    "content.renderable-blocs",
                    "content.bloc-view-js",
                    "content.bloc-views",
                    "content.page-render-inputs",
                    "content.page-render-revision",
                    "content.rendering-settings",
                    "assets.metadata",
                    "assets.metadata-batch"
                ]
            },
            "inputJson": {
                "type": "string",
                "maxLength": 1048576
            }
        },
        "required": ["operation"]
    },
    "output": {
        "type": "object",
        "properties": {
            "chunks": {
                "type": "array",
                "maxItems": 7,
                "items": {
                    "type": "string",
                    "maxLength": 1048576
                }
            }
        },
        "required": ["chunks"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "RESPONSE_TOO_LARGE",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/delivery/read",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "RESPONSE_TOO_LARGE": 413,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
