{
    "id": "delivery.collection-asset",
    "description": "Read bytes from one immutable asset of the currently installed collection release.",
    "access": "public",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
            },
            "expectedDigest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
            },
            "rangeStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "rangeEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            }
        },
        "required": ["collectionId", "assetId", "expectedDigest"]
    },
    "output": {
        "type": "binary",
        "maxBytes": 10737418240
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/delivery/collections/{collectionId}/assets/{assetId}",
            "input": {
                "path": {
                    "collectionId": "collectionId",
                    "assetId": "assetId"
                },
                "query": {
                    "digest": "expectedDigest",
                    "start": "rangeStart",
                    "end": "rangeEnd"
                }
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": [],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
