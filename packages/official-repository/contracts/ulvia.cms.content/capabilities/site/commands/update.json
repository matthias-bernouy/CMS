{
    "id": "site.update",
    "description": "Update safe site identity and availability settings with revision control.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Current revision returned by the corresponding read operation. Read again after a conflict."
            },
            "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
            },
            "host": {
                "type": "string",
                "maxLength": 2048
            },
            "visible": {
                "type": "boolean"
            }
        },
        "required": ["expectedRevision"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "name": {
                "type": "string",
                "maxLength": 160
            },
            "host": {
                "type": "string",
                "maxLength": 2048
            },
            "visible": {
                "type": "boolean"
            }
        },
        "required": ["revision", "name", "host", "visible"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "MIGRATION_IN_PROGRESS",
            "retryable": true
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/site",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "MIGRATION_IN_PROGRESS": 423,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_site_update",
                "description": "Update site name, host or visibility using the current settings expectedRevision."
            }
        }
    ]
}
