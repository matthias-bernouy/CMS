{
    "id": "site.update",
    "description": "Update site identity, availability and system Page references with revision control.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Current revision returned by the corresponding read operation. Read again after a conflict."
            },
            "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
            },
            "host": {
                "type": "string",
                "maxLength": 2048
            },
            "visible": {
                "type": "boolean"
            },
            "notFound": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered for missing content (404). Omit to preserve the current selection; null clears it.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "forbidden": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered when an authenticated visitor is denied access (403). Omit to preserve the current selection; null clears it.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "serverError": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered for server errors (500 or 503). Omit to preserve the current selection; null clears it.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "login": {
                "type": "object",
                "nullable": true,
                "description": "Public login Page used for anonymous visitors who need to authenticate. Omit to preserve the current selection; null clears it.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            }
        },
        "required": ["expectedRevision"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "name": {
                "type": "string",
                "maxLength": 160
            },
            "host": {
                "type": "string",
                "maxLength": 2048
            },
            "visible": {
                "type": "boolean"
            },
            "notFound": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered for missing content (404). Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "forbidden": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered when an authenticated visitor is denied access (403). Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "serverError": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered for server errors (500 or 503). Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "login": {
                "type": "object",
                "nullable": true,
                "description": "Public login Page used for anonymous visitors who need to authenticate. Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            }
        },
        "required": ["revision", "name", "host", "visible", "notFound", "forbidden", "serverError", "login"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "UPGRADE_IN_PROGRESS",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/site",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "REVISION_CONFLICT": 409,
                    "UPGRADE_IN_PROGRESS": 423,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_site_update",
                "description": "Update site name, host, visibility or the 404, forbidden, server-error and login Page references using expectedRevision. References must identify Pages on this instance; null clears a selection."
            }
        }
    ],
    "docs": ["site/system-pages.md", "overview.md"]
}
