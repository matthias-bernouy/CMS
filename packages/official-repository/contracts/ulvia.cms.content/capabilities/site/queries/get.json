{
    "id": "site.get",
    "description": "Return site identity, availability and system Page references.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "name": {
                "type": "string",
                "maxLength": 160
            },
            "host": {
                "type": "string",
                "maxLength": 2048
            },
            "visible": {
                "type": "boolean"
            },
            "notFound": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered for missing content (404). Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "forbidden": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered when an authenticated visitor is denied access (403). Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "serverError": {
                "type": "object",
                "nullable": true,
                "description": "Page rendered for server errors (500 or 503). Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            },
            "login": {
                "type": "object",
                "nullable": true,
                "description": "Public login Page used for anonymous visitors who need to authenticate. Null means no Page is selected.",
                "properties": {
                    "pageId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": ["pageId"]
            }
        },
        "required": ["revision", "name", "host", "visible", "notFound", "forbidden", "serverError", "login"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true,
            "output": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                    }
                },
                "required": ["message"]
            }
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "GET",
            "path": "/site",
            "input": {},
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_site_get",
                "description": "Read this instance’s site identity, visibility, 404, forbidden, server-error and login Page references, and current revision before updating them."
            }
        }
    ],
    "docs": ["site/system-pages.md", "overview.md"]
}
