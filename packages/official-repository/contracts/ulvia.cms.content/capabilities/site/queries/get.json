{
    "id": "site.get",
    "description": "Return safe site identity and availability settings.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {},
        "required": []
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "name": {
                "type": "string",
                "maxLength": 160
            },
            "host": {
                "type": "string",
                "maxLength": 2048
            },
            "visible": {
                "type": "boolean"
            }
        },
        "required": ["revision", "name", "host", "visible"]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/site",
        "input": {},
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": {
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
