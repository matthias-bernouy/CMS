{
    "id": "examples.get",
    "description": "Read one generic example document with ordinary collection text references. It has no locale, theme, Page path or publication state.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "exampleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": ["collectionId", "exampleId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "id": {
                "type": "string",
                "maxLength": 96
            },
            "document": {
                "type": "object",
                "properties": {
                    "html": {
                        "type": "string",
                        "maxLength": 1048576
                    }
                },
                "required": ["html"]
            }
        },
        "required": ["collectionId", "id", "document"]
    },
    "errors": [
        {
            "code": "INVALID_PAGE",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/examples/get",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_PAGE": 422
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_examples_get",
                "description": "Read a generic example document. Its HTML can be edited and submitted as ordinary Page content; no link to the example is stored."
            }
        }
    ]
}
