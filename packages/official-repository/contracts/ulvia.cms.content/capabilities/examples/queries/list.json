{
    "id": "examples.list",
    "description": "Browse a bounded page of generic document examples from one installed collection. Examples have no routes or publication lifecycle.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            },
            "cursor": {
                "type": "string",
                "maxLength": 16
            }
        },
        "required": ["collectionId", "locale"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "label": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "previews": {
                            "type": "array",
                            "maxItems": 16,
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "maxLength": 96
                                    },
                                    "frame": {
                                        "type": "object",
                                        "properties": {
                                            "width": {
                                                "type": "integer",
                                                "minimum": 1,
                                                "maximum": 4096
                                            },
                                            "height": {
                                                "type": "integer",
                                                "minimum": 1,
                                                "maximum": 4096
                                            }
                                        },
                                        "required": ["width", "height"]
                                    }
                                },
                                "required": ["id", "frame"]
                            }
                        }
                    },
                    "required": ["id", "label", "description", "previews"]
                }
            },
            "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "nextCursor": {
                "type": "string",
                "maxLength": 16
            }
        },
        "required": ["revision", "collectionId", "items", "total", "offset", "limit", "locale", "nextCursor"]
    },
    "errors": [
        {
            "code": "INVALID_PAGE",
            "retryable": false
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/examples/list",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_PAGE": 422
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_examples_list",
                "description": "List descriptions and viewport frames of examples in one installed collection. Read one document with examples.get."
            }
        }
    ]
}
