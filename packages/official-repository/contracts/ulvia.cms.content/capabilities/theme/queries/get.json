{
    "id": "theme.get",
    "description": "Read a filtered collection theme workspace with resolved profile values.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "profileId": {
                "type": "string",
                "maxLength": 96
            },
            "mode": {
                "type": "string",
                "enum": ["light", "dark"],
                "maxLength": 5
            },
            "tokenId": {
                "type": "string",
                "maxLength": 96
            },
            "search": {
                "type": "string",
                "maxLength": 300
            }
        },
        "required": ["collectionId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "activeThemeId": {
                "type": "string",
                "maxLength": 96
            },
            "profiles": {
                "type": "array",
                "maxItems": 128,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "name": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "active": {
                            "type": "boolean"
                        }
                    },
                    "required": ["id", "name", "active"]
                }
            },
            "profileId": {
                "type": "string",
                "maxLength": 96
            },
            "profileActive": {
                "type": "boolean"
            },
            "mode": {
                "type": "string",
                "enum": ["light", "dark"],
                "maxLength": 5
            },
            "search": {
                "type": "string",
                "maxLength": 300
            },
            "sourceFound": {
                "type": "boolean"
            },
            "sourceLabel": {
                "type": "string",
                "maxLength": 300
            },
            "supportsModes": {
                "type": "boolean"
            },
            "tokens": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "label": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 2000
                        },
                        "variable": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "type": {
                            "type": "string",
                            "enum": ["color", "font-family", "length", "number", "shadow", "value"],
                            "maxLength": 11
                        },
                        "value": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "overridden": {
                            "type": "boolean"
                        },
                        "categoryId": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "categoryLabel": {
                            "type": "string",
                            "maxLength": 300
                        }
                    },
                    "required": [
                        "id",
                        "label",
                        "description",
                        "variable",
                        "type",
                        "value",
                        "overridden",
                        "categoryId",
                        "categoryLabel"
                    ]
                }
            },
            "hasToken": {
                "type": "boolean"
            },
            "token": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "maxLength": 96
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 300
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2000
                    },
                    "variable": {
                        "type": "string",
                        "maxLength": 96
                    },
                    "type": {
                        "type": "string",
                        "enum": ["color", "font-family", "length", "number", "shadow", "value"],
                        "maxLength": 11
                    },
                    "value": {
                        "type": "string",
                        "maxLength": 4096
                    },
                    "overridden": {
                        "type": "boolean"
                    },
                    "categoryId": {
                        "type": "string",
                        "maxLength": 96
                    },
                    "categoryLabel": {
                        "type": "string",
                        "maxLength": 300
                    }
                },
                "required": [
                    "id",
                    "label",
                    "description",
                    "variable",
                    "type",
                    "value",
                    "overridden",
                    "categoryId",
                    "categoryLabel"
                ]
            }
        },
        "required": [
            "revision",
            "collectionId",
            "activeThemeId",
            "profiles",
            "profileId",
            "profileActive",
            "mode",
            "search",
            "sourceFound",
            "sourceLabel",
            "supportsModes",
            "tokens",
            "hasToken",
            "token"
        ]
    },
    "errors": [
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/theme",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_theme_get",
                "description": "Read an installed collection\u2019s theme, available modes, tokens and current site values."
            }
        }
    ]
}
