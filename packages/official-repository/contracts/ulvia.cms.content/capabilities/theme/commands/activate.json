{
    "id": "theme.activate",
    "description": "Activate one existing site theme profile.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Current revision returned by the corresponding read operation. Read again after a conflict."
            },
            "themeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            }
        },
        "required": ["expectedRevision", "themeId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "activeThemeId": {
                "type": "string",
                "maxLength": 96
            }
        },
        "required": ["revision", "activeThemeId"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/theme/activate",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "NOT_FOUND": 404,
                    "REVISION_CONFLICT": 409,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_theme_activate",
                "description": "Activate an installed theme using the current settings expectedRevision."
            }
        }
    ]
}
