{
    "id": "theme.activate",
    "description": "Activate one existing site theme profile.",
    "access": "admin",
    "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "themeId": { "type": "string", "minLength": 1, "maxLength": 96 }
        },
        "required": ["expectedRevision", "themeId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "activeThemeId": { "type": "string", "maxLength": 96 }
        },
        "required": ["revision", "activeThemeId"]
    },
    "errors": [
        { "code": "INVALID_INPUT", "retryable": false },
        { "code": "NOT_FOUND", "retryable": false },
        { "code": "REVISION_CONFLICT", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/theme/activate",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_FOUND": 404,
                "REVISION_CONFLICT": 409,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
