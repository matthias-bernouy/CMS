{
    "id": "site-blocs.create",
    "description": "Create a draft site-owned reusable composition from validated Page markup.",
    "access": "admin",
    "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "tag": { "type": "string", "minLength": 6, "maxLength": 200 },
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "group": { "type": "string", "minLength": 1, "maxLength": 120 },
            "description": { "type": "string", "maxLength": 500 },
            "content": { "type": "string", "minLength": 1, "maxLength": 1048576 },
            "groupId": { "type": "string", "maxLength": 200 }
        },
        "required": ["tag", "name", "group", "content"]
    },
    "output": {
        "type": "object",
        "properties": {
            "tag": { "type": "string", "maxLength": 200 },
            "name": { "type": "string", "maxLength": 120 },
            "group": { "type": "string", "maxLength": 120 },
            "description": { "type": "string", "maxLength": 500 },
            "lifecycle": { "type": "string", "enum": ["active", "archived"], "maxLength": 8 },
            "draftRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "publishedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "nullable": true },
            "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
            "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
        },
        "required": [
            "tag",
            "name",
            "group",
            "description",
            "lifecycle",
            "draftRevision",
            "publishedRevision",
            "createdAt",
            "updatedAt"
        ]
    },
    "errors": [
        { "code": "TAG_CONFLICT", "retryable": false },
        { "code": "INVALID_SITE_BLOC", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/site-blocs/create",
        "input": { "body": true },
        "response": {
            "successStatuses": [201],
            "contentTypes": ["application/json"],
            "errorStatuses": { "TAG_CONFLICT": 409, "INVALID_SITE_BLOC": 422, "CORE_UNAVAILABLE": 503 }
        }
    }
}
