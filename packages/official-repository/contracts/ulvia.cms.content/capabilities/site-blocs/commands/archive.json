{
    "id": "site-blocs.archive",
    "description": "Archive a site-owned reusable composition.",
    "access": "admin",
    "behavior": { "effect": "command", "idempotency": "none", "execution": "sync" },
    "input": {
        "type": "object",
        "properties": {
            "tag": { "type": "string", "minLength": 1, "maxLength": 200 },
            "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        },
        "required": ["tag", "revision"]
    },
    "output": {
        "type": "object",
        "properties": {
            "tag": { "type": "string", "maxLength": 200 },
            "name": { "type": "string", "maxLength": 120 },
            "group": { "type": "string", "maxLength": 120 },
            "description": { "type": "string", "maxLength": 500 },
            "lifecycle": { "type": "string", "enum": ["active", "archived"], "maxLength": 8 },
            "draftRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "publishedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "nullable": true },
            "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
            "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
        },
        "required": [
            "tag",
            "name",
            "group",
            "description",
            "lifecycle",
            "draftRevision",
            "publishedRevision",
            "createdAt",
            "updatedAt"
        ]
    },
    "errors": [
        { "code": "NOT_FOUND", "retryable": false },
        { "code": "REVISION_CONFLICT", "retryable": false },
        { "code": "TAG_CONFLICT", "retryable": false },
        { "code": "CORE_UNAVAILABLE", "retryable": true }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/site-blocs/archive",
        "input": { "body": true },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": {
                "NOT_FOUND": 404,
                "REVISION_CONFLICT": 409,
                "TAG_CONFLICT": 409,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
