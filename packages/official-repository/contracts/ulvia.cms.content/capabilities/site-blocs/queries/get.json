{
    "id": "site-blocs.get",
    "description": "Read one site-owned reusable composition.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
            }
        },
        "required": ["tag"]
    },
    "output": {
        "type": "object",
        "properties": {
            "tag": {
                "type": "string",
                "maxLength": 200
            },
            "name": {
                "type": "string",
                "maxLength": 120
            },
            "group": {
                "type": "string",
                "maxLength": 120
            },
            "description": {
                "type": "string",
                "maxLength": 500
            },
            "lifecycle": {
                "type": "string",
                "enum": ["active", "archived"],
                "maxLength": 8
            },
            "draftRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
            },
            "publishedRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "nullable": true
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            },
            "updatedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
            }
        },
        "required": [
            "tag",
            "name",
            "group",
            "description",
            "lifecycle",
            "draftRevision",
            "publishedRevision",
            "createdAt",
            "updatedAt"
        ]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/site-blocs/get",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_site_blocs_get",
                "description": "Read one site-local content Bloc and its current revision before editing its lifecycle."
            }
        }
    ]
}
