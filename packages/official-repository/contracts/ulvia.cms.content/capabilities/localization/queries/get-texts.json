{
    "id": "localization.texts.get",
    "description": "Read and filter one installed collection's text catalogue for declarative administration.",
    "access": "admin",
    "behavior": {
        "effect": "query",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "group": {
                "type": "string",
                "maxLength": 300
            },
            "search": {
                "type": "string",
                "maxLength": 300
            }
        },
        "required": ["collectionId"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "locales": {
                "type": "array",
                "maxItems": 64,
                "items": {
                    "type": "string",
                    "maxLength": 64
                }
            },
            "group": {
                "type": "string",
                "maxLength": 300
            },
            "groups": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "count": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4096
                        }
                    },
                    "required": ["id", "count"]
                }
            },
            "search": {
                "type": "string",
                "maxLength": 300
            },
            "items": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "maxLength": 96
                        },
                        "label": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 2000
                        },
                        "category": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "group": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "sourceValue": {
                            "type": "string",
                            "maxLength": 65536
                        },
                        "overrideValue": {
                            "type": "string",
                            "maxLength": 65536
                        }
                    },
                    "required": ["id", "label", "description", "category", "group", "sourceValue", "overrideValue"]
                }
            }
        },
        "required": ["revision", "collectionId", "locale", "locales", "group", "groups", "search", "items"]
    },
    "errors": [
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "QUERY",
            "path": "/localization/texts",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "NOT_FOUND": 404,
                    "CORE_UNAVAILABLE": 503
                }
            }
        },
        {
            "id": "mcp",
            "transport": "mcp",
            "tool": {
                "name": "content_localization_texts_get",
                "description": "Read installed collection texts and their site overrides, optionally filtered by locale, group or search."
            }
        }
    ]
}
