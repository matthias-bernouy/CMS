{
    "id": "localization.text.save",
    "description": "Set or clear one locale override for one installed collection text.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "none",
        "execution": "sync"
    },
    "input": {
        "type": "object",
        "properties": {
            "collectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "locale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
            },
            "textId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
            },
            "value": {
                "type": "string",
                "maxLength": 65536
            }
        },
        "required": ["collectionId", "expectedRevision", "locale", "textId", "value"]
    },
    "output": {
        "type": "object",
        "properties": {
            "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
            },
            "collectionId": {
                "type": "string",
                "maxLength": 96
            },
            "textId": {
                "type": "string",
                "maxLength": 96
            },
            "locale": {
                "type": "string",
                "maxLength": 64
            },
            "overridden": {
                "type": "boolean"
            }
        },
        "required": ["revision", "collectionId", "textId", "locale", "overridden"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "NOT_FOUND",
            "retryable": false
        },
        {
            "code": "REVISION_CONFLICT",
            "retryable": false
        },
        {
            "code": "MIGRATION_IN_PROGRESS",
            "retryable": true
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "binding": {
        "transport": "http",
        "method": "POST",
        "path": "/localization/text",
        "input": {
            "body": true
        },
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": {
                "INVALID_INPUT": 422,
                "NOT_FOUND": 404,
                "REVISION_CONFLICT": 409,
                "MIGRATION_IN_PROGRESS": 423,
                "CORE_UNAVAILABLE": 503
            }
        }
    }
}
