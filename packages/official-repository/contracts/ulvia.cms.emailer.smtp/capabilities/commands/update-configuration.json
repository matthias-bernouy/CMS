{
    "id": "smtp.configuration.update",
    "description": "Replace SMTP email delivery configuration and optionally rotate its password.",
    "access": "admin",
    "behavior": {
        "effect": "command",
        "idempotency": "natural",
        "execution": "sync",
        "sensitive": true
    },
    "input": {
        "type": "object",
        "properties": {
            "enabled": {
                "type": "boolean"
            },
            "fromEmail": {
                "type": "string",
                "maxLength": 320
            },
            "fromName": {
                "type": "string",
                "maxLength": 160
            },
            "replyTo": {
                "type": "string",
                "maxLength": 320
            },
            "smtp": {
                "type": "object",
                "properties": {
                    "host": {
                        "type": "string",
                        "maxLength": 253
                    },
                    "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                    },
                    "secure": {
                        "type": "boolean"
                    },
                    "username": {
                        "type": "string",
                        "maxLength": 320
                    },
                    "password": {
                        "type": "string",
                        "sensitive": true,
                        "minLength": 1,
                        "maxLength": 4096
                    }
                },
                "required": ["host", "port", "secure", "username"]
            }
        },
        "required": ["enabled", "fromEmail", "fromName", "replyTo", "smtp"]
    },
    "output": {
        "type": "object",
        "properties": {
            "enabled": {
                "type": "boolean"
            },
            "fromEmail": {
                "type": "string",
                "maxLength": 320
            },
            "fromName": {
                "type": "string",
                "maxLength": 160
            },
            "replyTo": {
                "type": "string",
                "maxLength": 320
            },
            "smtp": {
                "type": "object",
                "properties": {
                    "host": {
                        "type": "string",
                        "maxLength": 253
                    },
                    "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                    },
                    "secure": {
                        "type": "boolean"
                    },
                    "username": {
                        "type": "string",
                        "maxLength": 320
                    },
                    "passwordConfigured": {
                        "type": "boolean"
                    }
                },
                "required": ["host", "port", "secure", "username", "passwordConfigured"]
            }
        },
        "required": ["enabled", "fromEmail", "fromName", "replyTo", "smtp"]
    },
    "errors": [
        {
            "code": "INVALID_INPUT",
            "retryable": false
        },
        {
            "code": "CORE_UNAVAILABLE",
            "retryable": true
        }
    ],
    "bindings": [
        {
            "id": "http",
            "transport": "http",
            "method": "POST",
            "path": "/configuration",
            "input": {
                "body": true
            },
            "response": {
                "successStatuses": [200],
                "contentTypes": ["application/json"],
                "errorStatuses": {
                    "INVALID_INPUT": 422,
                    "CORE_UNAVAILABLE": 503
                }
            }
        }
    ]
}
