{
    "id": "emailer.configuration.get",
    "description": "Read outbound email delivery configuration without returning credentials.",
    "access": "admin",
    "behavior": { "effect": "query", "execution": "sync" },
    "input": { "type": "object", "properties": {}, "required": [] },
    "output": {
        "type": "object",
        "properties": {
            "enabled": { "type": "boolean" },
            "fromEmail": { "type": "string", "maxLength": 320 },
            "fromName": { "type": "string", "maxLength": 160 },
            "replyTo": { "type": "string", "maxLength": 320 },
            "transport": { "type": "string", "maxLength": 4, "enum": ["smtp"] },
            "smtp": {
                "type": "object",
                "properties": {
                    "host": { "type": "string", "maxLength": 253 },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "secure": { "type": "boolean" },
                    "username": { "type": "string", "maxLength": 320 },
                    "passwordConfigured": { "type": "boolean" }
                },
                "required": ["host", "port", "secure", "username", "passwordConfigured"]
            }
        },
        "required": ["enabled", "fromEmail", "fromName", "replyTo", "transport", "smtp"]
    },
    "errors": [{ "code": "CORE_UNAVAILABLE", "retryable": true }],
    "requires": [
        {
            "contractId": "ulvia.cms.secrets",
            "versionRange": "^1.0.0",
            "capabilityId": "secrets.get-metadata-by-name"
        },
        {
            "contractId": "ulvia.cms.secrets",
            "versionRange": "^1.0.0",
            "capabilityId": "secrets.resolve"
        }
    ],
    "binding": {
        "transport": "http",
        "method": "GET",
        "path": "/configuration",
        "response": {
            "successStatuses": [200],
            "contentTypes": ["application/json"],
            "errorStatuses": { "CORE_UNAVAILABLE": 503 }
        }
    }
}
