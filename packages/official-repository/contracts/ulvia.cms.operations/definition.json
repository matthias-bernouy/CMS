{
    "kind": "contract",
    "protocol": "ulvia-provider/v1",
    "schemaDialect": "ulvia-schema/v1",
    "contractId": "ulvia.cms.operations",
    "name": "CMS Operations",
    "description": "Inspect maintenance state, collection migration history and local Core diagnostics.",
    "version": "1.0.0",
    "publisherId": "ulvia.official",
    "catalogue": { "icon": "health", "categories": ["administration", "operations"] },
    "capabilities": [
        {
            "id": "status",
            "description": "Return current maintenance state and recent terminal migration summaries.",
            "access": "admin",
            "behavior": { "effect": "query", "execution": "sync" },
            "input": { "type": "object", "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }, "required": [] },
            "output": {
                "type": "object",
                "properties": {
                    "core": { "type": "string", "enum": ["ready"], "maxLength": 5 },
                    "maintenance": { "type": "boolean" },
                    "activeMigration": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string", "maxLength": 96 },
                            "status": { "type": "string", "maxLength": 32 },
                            "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
                        },
                        "required": ["id", "status", "updatedAt"]
                    },
                    "migrations": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string", "maxLength": 96 },
                                "status": { "type": "string", "enum": ["completed", "rolled-back"], "maxLength": 11 },
                                "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                                "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
                                "totalPages": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                                "operationCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                            },
                            "required": ["id", "status", "createdAt", "updatedAt", "totalPages", "operationCount"]
                        }
                    }
                },
                "required": ["core", "maintenance", "migrations"]
            },
            "errors": [{ "code": "CORE_UNAVAILABLE", "retryable": true }],
            "binding": {
                "transport": "http",
                "method": "GET",
                "path": "/v1/cms/operations",
                "input": { "query": { "limit": "limit" } },
                "response": { "successStatuses": [200], "contentTypes": ["application/json"], "errorStatuses": { "CORE_UNAVAILABLE": 503 } }
            }
        }
    ]
}
