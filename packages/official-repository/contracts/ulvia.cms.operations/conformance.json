{
    "kind": "contract-conformance-suite",
    "protocol": "ulvia-conformance/v1",
    "contractId": "ulvia.cms.operations",
    "contractVersion": "1.0.0",
    "contractDigest": "sha256:386f1b58017287dd5bdde6f72110da128c19334f09a809e1cf16c3e99ee1d214",
    "publisherId": "ulvia.official",
    "version": "1.0.0",
    "isolation": "disposable-tenant",
    "scenarios": [
        {
            "id": "read-core-state",
            "description": "Verify the portable, non-destructive administration projections exposed by a fresh CMS tenant.",
            "calls": [
                {
                    "id": "status",
                    "capabilityId": "status",
                    "actor": {
                        "kind": "admin"
                    },
                    "input": {
                        "limit": 25
                    },
                    "expect": {
                        "kind": "success",
                        "checks": [
                            {
                                "path": "/core",
                                "present": true
                            },
                            {
                                "path": "/maintenance",
                                "present": true
                            },
                            {
                                "path": "/migrations",
                                "present": true
                            }
                        ]
                    }
                },
                {
                    "id": "list",
                    "capabilityId": "list",
                    "actor": {
                        "kind": "admin"
                    },
                    "input": {
                        "limit": 25
                    },
                    "expect": {
                        "kind": "success",
                        "checks": [
                            {
                                "path": "/items",
                                "present": true
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "coverageExemptions": [
        {
            "capabilityId": "get",
            "reason": "This capability requires a stable resource identity that a portable fresh-tenant suite cannot assume."
        },
        {
            "capabilityId": "status",
            "errorCode": "CORE_UNAVAILABLE",
            "reason": "A runner-independent suite must not prescribe how a provider disconnects its selected managed Core."
        },
        {
            "capabilityId": "list",
            "errorCode": "CORE_UNAVAILABLE",
            "reason": "A runner-independent suite must not prescribe how a provider disconnects its selected managed Core."
        },
        {
            "capabilityId": "get",
            "errorCode": "NOT_FOUND",
            "reason": "The portable smoke suite does not prescribe the state or concurrency fault needed to produce this domain error."
        },
        {
            "capabilityId": "get",
            "errorCode": "INVALID_INPUT",
            "reason": "The portable smoke suite does not prescribe the state or concurrency fault needed to produce this domain error."
        },
        {
            "capabilityId": "get",
            "errorCode": "CORE_UNAVAILABLE",
            "reason": "A runner-independent suite must not prescribe how a provider disconnects its selected managed Core."
        }
    ]
}
