[
    {
        "id": "size",
        "label": "setting.size.label",
        "group": "setting.group.layout",
        "type": "string",
        "default": "md",
        "control": {
            "kind": "segmented",
            "options": [
                { "value": "sm", "label": "setting.option.small" },
                { "value": "md", "label": "setting.option.medium" },
                { "value": "lg", "label": "setting.option.large" }
            ]
        }
    },
    {
        "id": "placeholder",
        "label": "setting.tag-placeholder.label",
        "group": "setting.group.content",
        "type": "string",
        "default": "Type and press Enter",
        "maxLength": 80,
        "control": { "kind": "text" }
    },
    {
        "id": "hint",
        "label": "setting.tag-hint.label",
        "group": "setting.group.content",
        "type": "string",
        "default": "Press Enter to add. Backspace removes the last tag.",
        "maxLength": 140,
        "control": { "kind": "text" }
    },
    {
        "id": "separator",
        "label": "setting.tag-separator.label",
        "group": "setting.group.behavior",
        "type": "string",
        "default": ",",
        "maxLength": 1,
        "control": { "kind": "text" }
    },
    {
        "id": "max-tags",
        "label": "setting.max-tags.label",
        "group": "setting.group.behavior",
        "type": "integer",
        "default": 20,
        "minimum": 1,
        "maximum": 100,
        "control": { "kind": "number", "step": 1 }
    },
    {
        "id": "add-on-blur",
        "label": "setting.add-on-blur.label",
        "group": "setting.group.behavior",
        "type": "boolean",
        "default": false,
        "control": { "kind": "toggle" }
    }
]
