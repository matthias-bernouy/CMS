[
    {
        "id": "size",
        "label": "setting.size.label",
        "group": "setting.group.layout",
        "type": "string",
        "default": "md",
        "control": {
            "kind": "segmented",
            "options": [
                { "value": "sm", "label": "setting.option.small" },
                { "value": "md", "label": "setting.option.medium" },
                { "value": "lg", "label": "setting.option.large" }
            ]
        }
    },
    {
        "id": "parts",
        "label": "setting.time-parts.label",
        "group": "setting.group.behavior",
        "type": "string",
        "default": "hours-minutes",
        "control": {
            "kind": "segmented",
            "options": [
                { "value": "hours", "label": "setting.option.hours" },
                { "value": "minutes", "label": "setting.option.minutes" },
                { "value": "hours-minutes", "label": "setting.option.hours-minutes" },
                { "value": "hours-minutes-seconds", "label": "setting.option.hours-minutes-seconds" }
            ]
        }
    },
    {
        "id": "show-units",
        "label": "setting.show-time-units.label",
        "group": "setting.group.content",
        "type": "boolean",
        "default": false,
        "control": { "kind": "toggle" }
    }
]
