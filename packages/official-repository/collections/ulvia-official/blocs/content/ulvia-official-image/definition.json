{
    "kind": "component",
    "id": "ulvia-official-image",
    "label": "bloc.image.label",
    "description": "bloc.image.description",
    "order": 5,
    "uses": [],
    "requires": [
        {
            "contractId": "ulvia.cms.files",
            "capabilityId": "files.read",
            "versionRange": "^1.0.0"
        }
    ],
    "slots": {
        "default": {
            "accepts": [
                {
                    "kind": "native-element",
                    "accepts": ["img"],
                    "attributes": { "src": { "required": false } },
                    "defaults": { "alt": "", "loading": "lazy", "decoding": "async" }
                }
            ],
            "min": 1,
            "max": 1
        }
    },
    "root": {
        "accepts": ["div", "span"]
    },
    "categories": ["bloc.category.media"],
    "examples": ["image-default"],
    "defaultExample": "image-default"
}
