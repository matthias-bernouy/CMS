        "control": {
            "kind": "segmented",
            "options": [
                { "value": "contained", "label": "setting.option.contained" },
                { "value": "wide", "label": "setting.option.wide" },
                { "value": "full", "label": "setting.option.width-full" }
            ]
        }
    },
    {
        "id": "sticky-header",
        "label": "setting.sticky-header.label",
