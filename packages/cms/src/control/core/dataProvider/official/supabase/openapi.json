{
    "openapi": "3.0.3",
    "info": {
        "title": "Supabase Auth (GoTrue) — email/password",
        "version": "1.0.0",
        "description": "Subset of the Supabase GoTrue HTTP API covering credentials-based sign-up, sign-in, session refresh, sign-out, current user read/update and password recovery."
    },
    "servers": [
        { "url": "{{PROJECT_URL}}/auth/v1" }
    ],
    "paths": {
        "/signup": {
            "post": {
                "summary": "Sign up with email and password.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User created or pending confirmation.",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
                    },
                    "400": { "description": "Validation error" },
                    "422": { "description": "Invalid email or weak password" }
                }
            }
        },
        "/token": {
            "post": {
                "summary": "Sign in (grant_type=password) or refresh (grant_type=refresh_token).",
                "parameters": [
                    {
                        "name": "grant_type", "in": "query", "required": true,
                        "schema": { "type": "string", "enum": ["password", "refresh_token"] }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": { "schema": { "$ref": "#/components/schemas/TokenRequest" } }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Authenticated.",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
                    },
                    "400": { "description": "Invalid grant" }
                }
            }
        },
        "/logout": {
            "post": {
                "summary": "Sign out the current session.",
                "responses": { "204": { "description": "No Content" } }
            }
        },
        "/user": {
            "get": {
                "summary": "Get the current authenticated user.",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
                    },
                    "401": { "description": "Unauthenticated" }
                }
            },
            "put": {
                "summary": "Update the current authenticated user (email, password or metadata).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": { "schema": { "$ref": "#/components/schemas/UserUpdate" } }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
                    },
                    "401": { "description": "Unauthenticated" }
                }
            }
        },
        "/recover": {
            "post": {
                "summary": "Send a password recovery email.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["email"],
                                "properties": { "email": { "type": "string", "format": "email" } }
                            }
                        }
                    }
                },
                "responses": { "200": { "description": "Recovery email queued" } }
            }
        }
    },
    "components": {
        "schemas": {
            "Credentials": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                    "email":    { "type": "string", "format": "email" },
                    "password": { "type": "string", "minLength": 6 }
                }
            },
            "TokenRequest": {
                "type": "object",
                "properties": {
                    "email":         { "type": "string", "format": "email" },
                    "password":      { "type": "string" },
                    "refresh_token": { "type": "string" }
                }
            },
            "AuthResponse": {
                "type": "object",
                "properties": {
                    "access_token":  { "type": "string" },
                    "refresh_token": { "type": "string" },
                    "token_type":    { "type": "string", "example": "bearer" },
                    "expires_in":    { "type": "integer" },
                    "user":          { "$ref": "#/components/schemas/User" }
                }
            },
            "User": {
                "type": "object",
                "properties": {
                    "id":            { "type": "string", "format": "uuid" },
                    "email":         { "type": "string", "format": "email" },
                    "role":          { "type": "string" },
                    "confirmed_at":  { "type": "string", "format": "date-time", "nullable": true },
                    "created_at":    { "type": "string", "format": "date-time" },
                    "updated_at":    { "type": "string", "format": "date-time" },
                    "user_metadata": { "type": "object", "additionalProperties": true },
                    "app_metadata":  { "type": "object", "additionalProperties": true }
                }
            },
            "UserUpdate": {
                "type": "object",
                "properties": {
                    "email":    { "type": "string", "format": "email" },
                    "password": { "type": "string" },
                    "data":     { "type": "object", "additionalProperties": true }
                }
            }
        }
    }
}
