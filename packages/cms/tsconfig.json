{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir":   "dist",
        "rootDir":  ".",
        "baseUrl":  ".",
        "paths": {
            "@bernouy/cms":           ["index.ts"],
            "@bernouy/cms/component": ["component.ts"],
            "@bernouy/cms/editor":    ["editor.ts"]
        }
    },
    "include": [
        "src/**/*.ts",
        "index.ts",
        "component.ts",
        "editor.ts",
        "build.ts",
        "types/**/*.ts",
        "tests/**/*.ts"
    ],
    "references": [
        { "path": "../core" },
        { "path": "../runner-bun" }
    ]
}
