{
    "name": "@bernouy/cms-repository-server",
    "version": "0.1.0",
    "description": "Dedicated filesystem integration repository runtime with separate public read and internal management listeners.",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./candidate-policy": "./src/core/candidates/policy.ts",
        "./catalog-runtime": "./src/core/catalogRuntime.ts",
        "./management": "./src/management.ts",
        "./production": "./src/production.ts",
        "./registry-root": "./src/registryRoot.ts",
        "./runtime-env": "./src/runtimeEnv.ts",
        "./server": "./src/core/repositoryServer.ts"
    },
    "scripts": {
        "start": "bun run src/index.ts"
    },
    "dependencies": {
        "@bernouy/cms-integration-packages": "workspace:*",
        "@bernouy/cms-integration-registry": "workspace:*",
        "@bernouy/cms-integration-verification": "workspace:*",
        "@bernouy/cms-repository": "workspace:*",
        "@bernouy/cms-repository-management": "workspace:*",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/rate-limiter": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    }
}
