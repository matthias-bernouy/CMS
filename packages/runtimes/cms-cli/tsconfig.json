{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir":   "dist",
        "rootDir":  "./src",
        "baseUrl":  ".",
        "paths": {
            "cms-cli/*": ["./src/*"]
        },
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/resources/**"],
    "references": [
        { "path": "../../features/cms-permissions" },
        { "path": "../../foundation/http-runner" },
        { "path": "../../features/cms-auth" },
        { "path": "../../features/cms-bloc-compile" },
        { "path": "../../features/cms-content" },
        { "path": "../../features/cms-files" },
        { "path": "../../features/cms-secrets" },
        { "path": "../../surfaces/cms-control" },
        { "path": "../../surfaces/cms-delivery" }
    ]
}
