{
    "name": "@bernouy/cms-cli",
    "version": "0.1.0",
    "description": "p9r CLI — run or preview a local `site/` folder (`p9r dev`, `p9r preview`), and push/pull content between the workstation and a remote CMS (`p9r push`, `p9r pull`, `p9r secrets`).",
    "license": "UNLICENSED",
    "type": "module",
    "bin": {
        "p9r": "./src/index.ts"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src/",
        "tsconfig.json",
        "README.md"
    ],
    "dependencies": {
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/cms-auth": "workspace:*",
        "@bernouy/cms-bloc-compile": "workspace:*",
        "@bernouy/cms-control": "workspace:*",
        "@bernouy/cms-delivery": "workspace:*",
        "@bernouy/cms-files": "workspace:*",
        "@bernouy/cms-integrations": "workspace:*",
        "@bernouy/cms-identities": "workspace:*",
        "@bernouy/cms-official-integrations": "workspace:*",
        "@bernouy/cms-permissions": "workspace:*",
        "@bernouy/cms-repository": "workspace:*",
        "@bernouy/cms-sources": "workspace:*",
        "@bernouy/cms-functions": "workspace:*",
        "@bernouy/cms-triggers": "workspace:*",
        "@bernouy/cms-relations": "workspace:*",
        "@bernouy/cms-content": "workspace:*",
        "@bernouy/cms-secrets": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    }
}
