{
    "name": "@bernouy/ulvia-cli",
    "version": "0.1.0",
    "description": "Ulvia CMS installation and release CLI.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "ulvia": "./src/index.ts"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src/",
        "dist/bootstrap/",
        "tsconfig.json",
        "README.md"
    ],
    "scripts": {
        "generate:bootstrap": "bun run src/bootstrap/generate.ts",
        "prepack": "bun run generate:bootstrap"
    },
    "dependencies": {
        "@bernouy/binary-media": "workspace:*",
        "@bernouy/cms-content": "workspace:*",
        "@bernouy/cms-repository": "workspace:*",
        "@bernouy/http-runner": "workspace:*",
        "@bernouy/logging": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    }
}
